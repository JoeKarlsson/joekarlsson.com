# REFERENCE ONLY — not deployed by deploy.sh
# The live Caddyfile is managed by OpenTofu:
#   ~/claude/opentofu/services/joekarlsson-astro/provision.sh.tpl
# To update Caddy config: edit that file and run tofu apply from that directory.

:80 {
	# Serve static files from Astro build output
	root * /var/www/joekarlsson.com

	# Block requests with empty User-Agent (common bot signature)
	@empty_ua {
		header User-Agent ""
	}
	# no-store: the status depends on a header outside Cloudflare's cache key, so a
	# cached 403 would be served to every visitor of that URL (security audit run-1)
	header @empty_ua Cache-Control "no-store"
	respond @empty_ua 403

	# Tools that guess /sitemap.xml get the index Astro builds (robots.txt names it)
	redir /sitemap.xml /sitemap-index.xml 301

	# Moved and retired pages, one 301 each. Astro's own `redirects` can't do this in a
	# static build: it writes a 200 page with a meta refresh and noindex, which Search
	# Console reported as "Excluded by noindex" (2026-11-27). Keep every move here.
	map {path} {moved_to} {
		~^/newsletter/its-been-a-while/?$ /newsletter/taste-matters-more-with-ai/
		~^/blog/why-i-joined-singlestore/?$ /about/
		~^/blog/why-i-joined-viam /about/
		~^/blog/how-i-work/?$ /uses/
		# The same CData article imported twice under two slugs (2026-11-05)
		~^/blog/connect-enterprise-data-meta-muse/?$ /blog/connect-business-apps-meta-muse/
		# Thin, off-topic or dead-product posts cut in the 2027 content audit (2026-11-09)
		~^/blog/(overwhelmed-by-the-web|my-relationship-with-the-internet|how-to-explain-to-your-dad-why-snapchat-is-so-awesome|one-week-in-oahu-a-tourists-travel-itinerary|a-brief-cuba-travel-guide)/?$ /blog/category/life/
		~^/blog/(10-things-i-learned-at-startup-weekend|how-to-find-a-technical-co-founder)/?$ /blog/category/career/
		~^/blog/(psa-activate-2-step-verification-on-your-email-account|a-gentle-introduction-to-setting-up-a-react-and-mongodb-stitch-app-from-scratch-in-10-minutes)/?$ /blog/
		~^/blog/save-the-world-and-money-with-mongodb-atlas-data-lake/?$ /blog/how-to-manage-mongodb-data-at-scale/
		~^/blog/(getting-started-with-graphql-and-atlas|a-gentle-introduction-to-building-serverless-apps)/?$ /talks/
		~^/blog/iot-and-js-a-gentle-introduction-to-the-internet-of-things/?$ /talks/an-introduction-to-iot-internet-of-toilets/
		~^/blog/i-was-on-hawaii-public-radio-to-talk-about-the-stupid-shit-hackathon/?$ /blog/i-ran-my-first-hackathon-and-so-can-you/
		~^/blog/(devrel-as-dev-zero|developer-advocacy-in-2023|treat-content-development-for-your-open-source-project-like-your-open-source-project)/?$ /blog/running-devrel/
		# Talk write-ups moved out of the blog to their own pages (2026-11-09)
		~^/blog/mongodb-schema-design-best-practices/?$ /talks/mongodb-schema-design-best-practices/
		~^/blog/from-sql-to-nosql-a-gentle-introduction-for-devs/?$ /talks/from-sql-to-nosql-a-gentle-introduction-for-devs/
		~^/blog/the-art-of-computer-science/?$ /talks/the-art-of-computer-science/
		~^/blog/bechdel-io-how-we-used-javascript-to-help-make-film-more-inclusive/?$ /talks/bechdel-io-how-we-used-javascript-to-help-make-film-more-inclusive/
		~^/blog/building-high-performance-react-applications/?$ /talks/building-high-performance-react-applications/
		~^/blog/an-introduction-to-iot-internet-of-toilets/?$ /talks/an-introduction-to-iot-internet-of-toilets/
		# Old blog categories, folded into the six current ones (2026-11-05); Work was a
		# catch-all for employer posts, now shown by /blog/written-for/
		~^/blog/category/work/?$ /blog/
		~^/blog/category/(dev-tools|databases|javascript)/?$ /blog/category/web-dev/
		~^/blog/category/(smart-home|iot|networking)/?$ /blog/category/homelab/
		~^/blog/category/devrel/?$ /blog/category/career/
		~^/blog/category/(personal|film|travel)/?$ /blog/category/life/
		# WordPress pages
		~^/talk-archive/?$ /talks/
		~^/portfolio/?$ /work/
		default ""
	}
	@moved not vars {moved_to} ""
	redir @moved {moved_to} 301

	# 301 redirects: WordPress date-based blog URLs → /blog/slug
	# Matches /YYYY/MM/slug/ or /YYYY/MM/slug
	# Old WordPress per-post feeds (/YYYY/MM/slug/feed/) → RSS
	@wp-post-feed path_regexp ^/\d{4}/\d{2}/[^/]+/feed/?$
	redir @wp-post-feed /rss.xml 301

	# A WordPress post that is a newsletter issue now (its old slug ended in an emoji);
	# before @wp-blog, which would send it to a /blog/ URL that doesn't exist
	@wp-viam path_regexp ^/2022/06/why-i-joined-viam
	redir @wp-viam /newsletter/why-i-joined-viam/ 301

	@wp-blog path_regexp wp ^/(\d{4})/(\d{2})/([^/]+)/?$
	redir @wp-blog /blog/{re.wp.3}/ 301

	# 301 redirects: Astro legacy year-based blog URLs → /blog/slug
	# Matches /YYYY/slug/ or /YYYY/slug (no month component)
	@year-blog path_regexp yb ^/(\d{4})/([a-z0-9-]+[a-z0-9-]*)/?$
	redir @year-blog /blog/{re.yb.2}/ 301

	# 301 redirects: WordPress tag pages → blog index
	@tags path_regexp ^/tag/.*
	redir @tags /blog/ 301

	# 301 redirects: WordPress category pages → blog index
	@categories path_regexp ^/category/.*
	redir @categories /blog/ 301

	# 301 redirects: Blog pagination → blog index (no pagination in Astro site)
	@blog-pages path_regexp ^/blog/page/.*
	redir @blog-pages /blog/ 301

	# A film review Letterboxd logged twice; the second copy (/1/) folded into the first
	@review-theater-camp-dup path /reviews/theater-camp-2023-1 /reviews/theater-camp-2023-1/
	redir @review-theater-camp-dup /reviews/theater-camp-2023/ 301

	# 301 redirects: WordPress portfolio items that have a project page now. Before the catch-all
	# below, since redirects with named matchers run in the order written
	@portfolio-bechdel-io path /portfolio/bechdel-test-visualizer /portfolio/bechdel-test-visualizer/
	redir @portfolio-bechdel-io /work/bechdel-script-test/ 301
	# 301 redirects: renamed project pages (Bechdel.io became Bechdel Script Test in November 2026)
	@work-bechdel-io path /work/bechdel-io /work/bechdel-io/
	redir @work-bechdel-io /work/bechdel-script-test/ 301
	@portfolio-best-buy-product-locator path /portfolio/best-buy-chrome-extension /portfolio/best-buy-chrome-extension/
	redir @portfolio-best-buy-product-locator /work/best-buy-product-locator/ 301
	@portfolio-gaptcha path /portfolio/gaptcha /portfolio/gaptcha/
	redir @portfolio-gaptcha /work/gaptcha/ 301
	@portfolio-go-home-tanuki path /portfolio/go-home-tanuki-youre-drunk-a-phaser-js-game /portfolio/go-home-tanuki-youre-drunk-a-phaser-js-game/
	redir @portfolio-go-home-tanuki /work/go-home-tanuki/ 301
	@portfolio-iot-kitty-litter-box path /portfolio/iot-kitty-litter-box /portfolio/iot-kitty-litter-box/
	redir @portfolio-iot-kitty-litter-box /work/iot-kitty-litter-box/ 301
	@portfolio-movie-script-scraper path /portfolio/movie-script-scraper /portfolio/movie-script-scraper/
	redir @portfolio-movie-script-scraper /work/movie-script-scraper/ 301
	@portfolio-night-out path /portfolio/night-out /portfolio/night-out/
	redir @portfolio-night-out /work/night-out/ 301
	@portfolio-pixelate path /portfolio/pixelate-js-html5-image-pixelator /portfolio/pixelate-js-html5-image-pixelator/
	redir @portfolio-pixelate /work/pixelate/ 301
	@portfolio-poststream path /portfolio/poststream /portfolio/poststream/
	redir @portfolio-poststream /work/poststream/ 301
	@portfolio-rose-hobart path /portfolio/rose-hobart /portfolio/rose-hobart/
	redir @portfolio-rose-hobart /work/rose-hobart/ 301
	@portfolio-wave-jump path /portfolio/wave-jump /portfolio/wave-jump/
	redir @portfolio-wave-jump /work/wave-jump/ 301

	# 301 redirects: other WordPress portfolio items → work page
	@portfolio-items path_regexp ^/portfolio/.+
	redir @portfolio-items /work/ 301

	# 301 redirects: WordPress portfolio tags → work page
	@portfolio-tags path_regexp ^/portfolio-tag/.*
	redir @portfolio-tags /work/ 301

	# 301 redirects: WordPress portfolio categories → work page
	@portfolio-cats path_regexp ^/portfolio-category/.*
	redir @portfolio-cats /work/ 301

	# 301 redirects: WordPress page URLs
	@speaking path_regexp ^/speaking(/.*)?$
	redir @speaking /talks/ 301

	@speaker-rider path /speaker-rider /speaker-rider/
	redir @speaker-rider /about/ 301

	@all-work path /all-work /all-work/
	redir @all-work /work/ 301

	# Blog post renames - year updates
	# Evergreen guides lost the year in their URL (2026-11-09). Caddy answers every old
	# slug with one real 301; Astro's own redirect for them is a 200 meta-refresh page.
	@ha-old path_regexp ^/blog/how-to-get-started-with-home-assistant-in-20\d\d/?$
	redir @ha-old /blog/how-to-get-started-with-home-assistant/ 301

	@devrel-2026 path /blog/running-devrel-2026 /blog/running-devrel-2026/
	redir @devrel-2026 /blog/running-devrel/ 301

	@music-2025 path /blog/self-hosted-music-still-sucks-in-2025 /blog/self-hosted-music-still-sucks-in-2025/
	redir @music-2025 /blog/self-hosted-music-still-sucks-in-2026/ 301

	# The homelab server post's original slug and every yearly one (-in-2024 was its
	# top Google landing page when it moved)
	@homelab-old path_regexp ^/blog/how-to-get-started-building-a-(not-expensive-homelab-server|homelab-server-in-20\d\d).*$
	redir @homelab-old /blog/how-to-get-started-building-a-homelab-server/ 301

	# Outdated MongoDB post - redirect to blog
	@mongodb-credits path /blog/how-to-activate-your-mongodb-atlas-credits /blog/how-to-activate-your-mongodb-atlas-credits/
	redir @mongodb-credits /blog/ 301

	# WordPress feed → RSS
	@feed path /feed /feed/
	redir @feed /rss.xml 301

	# WordPress remnants — return 410 Gone
	@wp-remnants path /xmlrpc.php /wp-admin* /wp-login.php /wp-content* /wp-includes* /wp-json*
	respond @wp-remnants 410

	# Browsers post CSP violations, deprecations and crashes here (Reporting-Endpoints below).
	# Only these requests are logged, each with its report, to the journal Alloy ships to Loki
	@reports {
		method POST
		path /reports
	}
	handle @reports {
		request_body {
			max_size 64KB
		}
		log_append report {http.request.body}
		respond 204
	}
	@not_reports not path /reports
	log_skip @not_reports
	log

	# Serve files, fall back to 404
	file_server
	handle_errors {
		# A revalidation (Cloudflare refreshing its copy, or a browser that saw this 404
		# before) carries If-None-Match / If-Modified-Since; file_server then answered with
		# the 404 status and an empty body, so 1 in 6 visitors got a blank page. Serve the
		# whole page every time
		request_header -If-None-Match
		request_header -If-Modified-Since
		rewrite * /404.html
		file_server
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=()"
		# Opens other sites in their own window group; share links still open as popups
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Reporting-Endpoints `default="/reports"`
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'report-sample' https://plausible.joekarlsson.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; frame-src https://www.youtube-nocookie.com https://cdatasoftware.github.io https://linger.joekarlsson.com https://rosehobart.joekarlsson.com https://bechdel.joekarlsson.com https://wavejump.joekarlsson.com https://tanuki.joekarlsson.com https://poststream.joekarlsson.com https://pixelate.joekarlsson.com https://night-out.joekarlsson.com https://gaptcha.joekarlsson.com https://punc.joekarlsson.com https://corners.joekarlsson.com; connect-src 'self' https://plausible.joekarlsson.io; base-uri 'none'; object-src 'none'; form-action 'self' https://newsletter.joekarlsson.com; frame-ancestors 'none'; report-to default"
	}

	# Who may load a file from another site: pictures, media and feeds anyone (feed readers
	# and webmail show them), everything else only *.joekarlsson.com
	@embeddable path *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.mp4 *.webm *.mp3 *.m4a *.xml
	header @embeddable Cross-Origin-Resource-Policy cross-origin
	@not_embeddable not path *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.mp4 *.webm *.mp3 *.m4a *.xml
	header @not_embeddable Cross-Origin-Resource-Policy same-site

	# Astro's build output carries a content hash in every filename, so it can be cached forever
	@hashed {
		path /_astro/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else in public/ (images, video, audio, icons) keeps its name across edits,
	# so cache it for 30 days, not forever. The deploy purges Cloudflare; a returning
	# browser picks up a replaced file within a month.
	@static {
		path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.woff *.ttf *.gif *.mp4 *.webm *.mp3
		not path /_astro/*
		file
	}
	header @static Cache-Control "public, max-age=2592000"

	# HTML pages: always revalidate with origin to prevent stale cache
	# This ensures users always get fresh HTML that references current CSS/JS hashes
	# - no-cache: must revalidate before using cached copy
	# - s-maxage=0: CDNs must not cache (prevents the HTML/CSS mismatch bug)
	# - must-revalidate: treat stale responses as errors
	@html path *.html */
	header @html Cache-Control "no-cache, s-maxage=0, must-revalidate"
}
