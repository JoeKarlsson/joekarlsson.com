# REFERENCE ONLY — not deployed by deploy.sh
# The live Caddyfile is managed by OpenTofu:
#   ~/claude/opentofu/services/joekarlsson-astro/provision.sh.tpl
# To update Caddy config: edit that file and run tofu apply from that directory.

:80 {
	# Serve static files from Astro build output
	root * /var/www/joekarlsson.com

	# Block requests with empty User-Agent (common bot signature)
	@empty_ua {
		header User-Agent ""
	}
	# no-store: the status depends on a header outside Cloudflare's cache key, so a
	# cached 403 would be served to every visitor of that URL (security audit run-1)
	header @empty_ua Cache-Control "no-store"
	respond @empty_ua 403

	# 301 redirects: WordPress date-based blog URLs → /blog/slug
	# Matches /YYYY/MM/slug/ or /YYYY/MM/slug
	# Old WordPress per-post feeds (/YYYY/MM/slug/feed/) → RSS
	@wp-post-feed path_regexp ^/\d{4}/\d{2}/[^/]+/feed/?$
	redir @wp-post-feed /rss.xml 301

	# A WordPress post that is a newsletter issue now (its old slug ended in an emoji);
	# before @wp-blog, which would send it to a /blog/ URL that doesn't exist
	@wp-viam path_regexp ^/2022/06/why-i-joined-viam
	redir @wp-viam /newsletter/why-i-joined-viam/ 301

	@wp-blog path_regexp wp ^/(\d{4})/(\d{2})/([^/]+)/?$
	redir @wp-blog /blog/{re.wp.3}/ 301

	# 301 redirects: Astro legacy year-based blog URLs → /blog/slug
	# Matches /YYYY/slug/ or /YYYY/slug (no month component)
	@year-blog path_regexp yb ^/(\d{4})/([a-z0-9-]+[a-z0-9-]*)/?$
	redir @year-blog /blog/{re.yb.2}/ 301

	# 301 redirects: WordPress tag pages → blog index
	@tags path_regexp ^/tag/.*
	redir @tags /blog/ 301

	# 301 redirects: WordPress category pages → blog index
	@categories path_regexp ^/category/.*
	redir @categories /blog/ 301

	# 301 redirects: Blog pagination → blog index (no pagination in Astro site)
	@blog-pages path_regexp ^/blog/page/.*
	redir @blog-pages /blog/ 301

	# 301 redirects: WordPress portfolio items → work page
	@portfolio-items path_regexp ^/portfolio/.+
	redir @portfolio-items /work/ 301

	# 301 redirects: WordPress portfolio tags → work page
	@portfolio-tags path_regexp ^/portfolio-tag/.*
	redir @portfolio-tags /work/ 301

	# 301 redirects: WordPress portfolio categories → work page
	@portfolio-cats path_regexp ^/portfolio-category/.*
	redir @portfolio-cats /work/ 301

	# 301 redirects: WordPress page URLs
	@speaking path_regexp ^/speaking(/.*)?$
	redir @speaking /talks/ 301

	@speaker-rider path /speaker-rider /speaker-rider/
	redir @speaker-rider /about/ 301

	@all-work path /all-work /all-work/
	redir @all-work /work/ 301

	# Blog post renames - year updates
	@ha-2023 path /blog/how-to-get-started-with-home-assistant-in-2023 /blog/how-to-get-started-with-home-assistant-in-2023/
	redir @ha-2023 /blog/how-to-get-started-with-home-assistant-in-2026/ 301

	@music-2025 path /blog/self-hosted-music-still-sucks-in-2025 /blog/self-hosted-music-still-sucks-in-2025/
	redir @music-2025 /blog/self-hosted-music-still-sucks-in-2026/ 301

	# The homelab server post's original slug
	@homelab-not-expensive path /blog/how-to-get-started-building-a-not-expensive-homelab-server /blog/how-to-get-started-building-a-not-expensive-homelab-server/
	redir @homelab-not-expensive /blog/how-to-get-started-building-a-homelab-server-in-2024/ 301

	# Homelab server post - people searching for 2026 version
	@homelab-2026 path_regexp ^/blog/how-to-get-started-building-a-homelab-server-in-2026.*
	redir @homelab-2026 /blog/how-to-get-started-building-a-homelab-server-in-2024/ 301

	# Outdated MongoDB post - redirect to blog
	@mongodb-credits path /blog/how-to-activate-your-mongodb-atlas-credits /blog/how-to-activate-your-mongodb-atlas-credits/
	redir @mongodb-credits /blog/ 301

	# WordPress feed → RSS
	@feed path /feed /feed/
	redir @feed /rss.xml 301

	# WordPress remnants — return 410 Gone
	@wp-remnants path /xmlrpc.php /wp-admin* /wp-login.php /wp-content* /wp-includes* /wp-json*
	respond @wp-remnants 410

	# Serve files, fall back to 404
	file_server
	handle_errors {
		# A revalidation (Cloudflare refreshing its copy, or a browser that saw this 404
		# before) carries If-None-Match / If-Modified-Since; file_server then answered with
		# the 404 status and an empty body, so 1 in 6 visitors got a blank page. Serve the
		# whole page every time
		request_header -If-None-Match
		request_header -If-Modified-Since
		rewrite * /404.html
		file_server
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=()"
		# Opens other sites in their own window group; share links still open as popups
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.joekarlsson.io; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; frame-src https://www.youtube-nocookie.com https://cdatasoftware.github.io https://linger.joekarlsson.com https://rosehobart.joekarlsson.com https://bechdel.joekarlsson.com https://wavejump.joekarlsson.com https://tanuki.joekarlsson.com https://poststream.joekarlsson.com https://pixelate.joekarlsson.com https://night-out.joekarlsson.com https://gaptcha.joekarlsson.com https://punc.joekarlsson.com https://corners.joekarlsson.com; connect-src 'self' https://plausible.joekarlsson.io; base-uri 'none'; object-src 'none'; form-action 'self' https://newsletter.joekarlsson.com; frame-ancestors 'none'"
	}

	# Who may load a file from another site: pictures, media and feeds anyone (feed readers
	# and webmail show them), everything else only *.joekarlsson.com
	@embeddable path *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.mp4 *.webm *.mp3 *.m4a *.xml
	header @embeddable Cross-Origin-Resource-Policy cross-origin
	@not_embeddable not path *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.mp4 *.webm *.mp3 *.m4a *.xml
	header @not_embeddable Cross-Origin-Resource-Policy same-site

	# Astro's build output carries a content hash in every filename, so it can be cached forever
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else in public/ (images, video, audio, icons) keeps its name across edits,
	# so cache it for 30 days, not forever. The deploy purges Cloudflare; a returning
	# browser picks up a replaced file within a month.
	@static {
		path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.woff2 *.woff *.ttf *.gif *.mp4 *.webm *.mp3
		not path /_astro/*
	}
	header @static Cache-Control "public, max-age=2592000"

	# HTML pages: always revalidate with origin to prevent stale cache
	# This ensures users always get fresh HTML that references current CSS/JS hashes
	# - no-cache: must revalidate before using cached copy
	# - s-maxage=0: CDNs must not cache (prevents the HTML/CSS mismatch bug)
	# - must-revalidate: treat stale responses as errors
	@html path *.html /
	header @html Cache-Control "no-cache, s-maxage=0, must-revalidate"
}
