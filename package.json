{
	"name": "astro-blog-init",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"test:images": "bash scripts/validate-images.sh",
		"test:spelling": "cspell \"src/content/blog/**/*.md\" --no-progress",
		"test:markdown": "markdownlint-cli2 \"src/content/blog/**/*.md\"",
		"test:feeds": "bash scripts/validate-feeds.sh",
		"test:caddyfile": "bash scripts/validate-caddyfile.sh",
		"test:a11y": "pa11y-ci --config .pa11yci.json",
		"test:lighthouse": "lhci autorun",
		"test:links": "lychee --offline --no-progress --root-dir dist/ --config .lychee.toml dist/",
		"test:build-output": "vitest run tests/build-output.test.ts",
		"test:content": "vitest run tests/content-schema.test.ts",
		"test:unused": "knip",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"generate:resume": "node scripts/generate-resume-pdf.mjs",
		"generate:resume:webflow": "node scripts/generate-resume-pdf.mjs --page resume-webflow-pdf --out joe-karlsson-resume-webflow.pdf",
		"test:outdated": "npm outdated || true",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "npm run format:check && npm run lint && npm run check && npm run build && npm run test:images && npm run test:spelling && npm run test:markdown && npm run test:build-output && npm run test:content",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.2",
		"@astrojs/rss": "^4.0.17",
		"@astrojs/sitemap": "^3.7.1",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@tailwindcss/vite": "^4.2.2",
		"astro": "^6.0.6",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"sharp": "^0.34.3",
		"tailwindcss": "^4.2.2",
		"unist-util-visit": "^5.1.0"
	},
	"overrides": {
		"fast-xml-parser": "^5.5.6",
		"lodash": "^4.18.1",
		"smol-toml": "^1.6.1",
		"tmp": "^0.2.4",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.2",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.58.2",
		"@types/jsdom": "^28.0.1",
		"cspell": "^9.7.0",
		"eslint": "^10.0.3",
		"eslint-plugin-astro": "^1.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.0.2",
		"knip": "^6.0.3",
		"lint-staged": "^16.4.0",
		"markdownlint-cli2": "^0.22.0",
		"pa11y-ci": "^4.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"serve": "^14.2.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vitest": "^4.1.0"
	},
	"lint-staged": {
		"*.{js,mjs,ts,astro}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{md,mdx,json,css,yml,yaml}": [
			"prettier --write"
		]
	}
}
