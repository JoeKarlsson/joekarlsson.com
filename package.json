{
	"name": "astro-blog-init",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"deploy": "bash deploy.sh",
		"preview": "astro preview",
		"update:popular": "node scripts/update-popular-posts.mjs",
		"analytics:agents": "node scripts/agent-markdown-traffic.mjs",
		"update:now": "node scripts/update-now-feed.mjs",
		"newsletter:cards": "node scripts/generate-issue-cards.mjs",
		"thumbnails:work": "node scripts/generate-work-thumbnails.mjs",
		"youtube:thumbnails": "node scripts/fetch-youtube-thumbnails.mjs",
		"media:dither": "python3 scripts/media/halftone.py",
		"media:dither:video": "bash scripts/media/dither-video.sh",
		"media:loop": "bash scripts/media/loop.sh",
		"media:text": "node scripts/media/find-text-images.mjs",
		"media:cards": "node scripts/media/card-clips.mjs",
		"media:reel": "node scripts/media/work-reel.mjs",
		"media:flash-check": "python3 scripts/media/flash-check.py",
		"astro": "astro",
		"check": "astro check",
		"test:images": "bash scripts/validate-images.sh",
		"test:spelling": "cspell \"src/content/blog/**/*.md\" \"src/content/talks/**/*.md\" --no-progress",
		"test:markdown": "markdownlint-cli2 \"src/content/blog/**/*.md\" \"src/content/talks/**/*.md\"",
		"test:feeds": "bash scripts/validate-feeds.sh",
		"test:caddyfile": "bash scripts/validate-caddyfile.sh",
		"test:a11y": "pa11y-ci --config .pa11yci.json",
		"test:lighthouse": "lhci autorun",
		"test:links": "lychee --offline --no-progress --root-dir dist/ --config .lychee.toml dist/",
		"test:unit": "vitest run",
		"test:unused": "knip",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"generate:resume": "node scripts/generate-resume-pdf.mjs",
		"generate:resume:webflow": "node scripts/generate-resume-pdf.mjs --page resume-webflow-pdf --out joe-karlsson-resume-webflow.pdf",
		"import:cdata": "node scripts/import-cdata-posts.mjs",
		"vale": "vale --minAlertLevel error src/content/blog/ src/content/talks/",
		"test:voice": "bash scripts/vale-changed.sh",
		"test:outdated": "npm outdated || true",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"brand": "node scripts/generate-brand.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"diagrams": "node scripts/diagrams/render.mjs",
		"collage": "node scripts/collage/render.mjs",
		"collage:cutout": "node scripts/collage/cutout.mjs",
		"test": "npm run test:workflows && npm run format:check && npm run lint && npm run check && npm run build && npm run test:images && npm run test:spelling && npm run test:markdown && npm run test:voice && npm run test:unit",
		"prepare": "husky",
		"test:workflows": "node scripts/validate-workflows.mjs",
		"talks:videos": "node scripts/sync-talk-videos.mjs",
		"talks:covers": "node scripts/fetch-talk-event-covers.mjs",
		"youtube:thumbnail": "node scripts/youtube-thumbnail.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.6",
		"@astrojs/mdx": "^8.1.3",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.4",
		"astro": "^7.4.7",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.2.2",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.0.0"
	},
	"overrides": {
		"basic-ftp": "^6.2.3",
		"compression": "^1.8.2",
		"fast-xml-parser": "^5.10.1",
		"katex": "^0.19.1",
		"lodash": "^4.18.1",
		"minimatch@^10": "^11.0.5",
		"re2js": "^2.9.1",
		"smol-toml": "^1.6.1",
		"tmp": "^0.2.4",
		"uuid": "^11.1.1",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.16.0",
		"@playwright/test": "^1.65.0",
		"@types/jsdom": "^30.0.0",
		"@typescript-eslint/parser": "^8.72.1",
		"cspell": "^10.0.0",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.0.1",
		"fontkitten": "^1.0.3",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"knip": "^6.44.1",
		"lint-staged": "^17.0.5",
		"markdownlint-cli2": "^0.24.0",
		"pa11y-ci": "^5.0.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "^1.1.2",
		"serve": "^14.2.4",
		"turndown": "^7.2.5",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0",
		"yaml": "^2.8.3"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,astro}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{md,mdx,json,css,yml,yaml}": [
			"prettier --write"
		]
	},
	"allowScripts": {
		"puppeteer": true,
		"fsevents": true
	}
}
