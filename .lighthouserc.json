{
	"ci": {
		"collect": {
			"staticDistDir": "./dist",
			"url": [
				"http://localhost/",
				"http://localhost/blog/",
				"http://localhost/reviews/",
				"http://localhost/reviews/zodiac/",
				"http://localhost/about/",
				"http://localhost/work/",
				"http://localhost/uses/",
				"http://localhost/talks/an-introduction-to-iot-internet-of-toilets/",
				"http://localhost/blog/recording-setup-tour/",
				"http://localhost/blog/sentence-length-semicolons-punctuation/",
				"http://localhost/reviews/stats/"
			],
			"numberOfRuns": 3
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.8
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.95
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.95
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"total-byte-weight": [
					"error",
					{
						"maxNumericValue": 1572864
					}
				],
				"cumulative-layout-shift": [
					"error",
					{
						"maxNumericValue": 0.05
					}
				],
				"total-blocking-time": [
					"error",
					{
						"maxNumericValue": 150
					}
				],
				"resource-summary:script:size": [
					"error",
					{
						"maxNumericValue": 25600
					}
				],
				"resource-summary:font:size": [
					"error",
					{
						"maxNumericValue": 174080
					}
				],
				"resource-summary:image:size": [
					"error",
					{
						"maxNumericValue": 460800
					}
				],
				"largest-contentful-paint": [
					"error",
					{
						"maxNumericValue": 3200
					}
				]
			},
			"aggregationMethod": "median"
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./.lighthouseci"
		}
	}
}
