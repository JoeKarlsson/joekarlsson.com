# The commit pushed to the test runner below is the one being tested: don't test it twice
case "$2" in runner@*) exit 0 ;; esac

# nvm only as a fallback: node from PATH (e.g. mise shims) wins, since nvm's default may be too old for Astro
command -v node >/dev/null 2>&1 || { [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh"; }

# CI installs with the npm 10 bundled with Node 22. A lockfile written by a newer
# npm can look fine locally and still fail `npm ci` there, so check it the CI way.
if ! npx -y npm@10.9.10 ci --dry-run --ignore-scripts >/dev/null 2>&1; then
	echo "package-lock.json is out of sync for npm 10 (CI). Regenerate it with:"
	echo "  npx npm@10 install --package-lock-only --ignore-scripts"
	exit 1
fi

# The commit being pushed (the last ref line that isn't a branch delete)
SHA=$(awk '$2 !~ /^0+$/ { sha = $2 } END { print sha }')
[ -n "$SHA" ] || exit 0

# Run the checks on the homelab's test runner (CT 273), so several sessions pushing at
# once queue there instead of starving this Mac's CPU. Off the home network, run here.
RUNNER=runner@192.168.0.69
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new"
# shellcheck disable=SC2086
if ssh $SSH_OPTS "$RUNNER" true 2>/dev/null; then
	GIT_SSH_COMMAND="ssh $SSH_OPTS" git push -q "$RUNNER:site" "$SHA:refs/runs/$(hostname -s)-$$"
	# The changes' fingerprint: a push rejected because main moved while it queued
	# comes back rebased with the same one, and the runner lets it through
	PATCH=$(git diff "$(git merge-base "$SHA" origin/main)" "$SHA" | git patch-id --stable | cut -d' ' -f1)
	# shellcheck disable=SC2086
	exec ssh $SSH_OPTS "$RUNNER" site-checks "$SHA" "$PATCH"
fi
echo "Test runner (CT 273) unreachable: running the checks on this Mac"

npm test

# e2e otherwise runs only in CI, where nobody looks after pushing (2026-11-10: it was red
# for a dozen pushes). A free port so it never tests another session's dev server, and
# the line reporter because the html one opens a report and waits on failure. The port is
# checked on IPv6 as well: Astro listens on ::1, so an IPv4-only check can pick a busy one.
PORT=$(python3 -c 'import socket; s = socket.socket(socket.AF_INET6); s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0); s.bind(("::", 0)); print(s.getsockname()[1])') \
	npx playwright test --reporter=line
