---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoverBox from '../components/HoverBox.astro';
import IndexRow from '../components/IndexRow.astro';
import KeepExploring from '../components/KeepExploring.astro';
import PosterHero from '../components/PosterHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Scribble from '../components/Scribble.astro';
import { ERAS, REEL_SLICE_SECONDS, REEL_VIDEO, SELECTED_WORKS, projects } from '../data/projects';
import { CHALK, MARKS } from '../data/scribbles';
import {
	HERO_LEAD,
	META,
	MORE_LINK,
	PAGE_CONTAINER,
	SECTION_HEADING,
	TEXT_LINK,
} from '../utils/ui';
import { SOCIAL_LINKS } from '../consts';
import { cardClip, cardHalftone } from '../utils/halftone';

const selected = SELECTED_WORKS.map((title) => {
	const project = projects.find((p) => p.title === title);
	if (!project) throw new Error(`SELECTED_WORKS names "${title}", which isn't in projects.ts`);
	return project;
});
const eras = ERAS.map((era) => ({
	...era,
	projects: projects
		.filter((p) => !SELECTED_WORKS.includes(p.title))
		.filter((p) => Number(p.date.slice(0, 4)) >= era.from && Number(p.date.slice(0, 4)) <= era.to)
		.sort((a, b) => b.date.localeCompare(a.date)),
}));
const workUrl = (p: (typeof projects)[number]) =>
	(p.page && `/work/${p.page.slug}/`) || p.sourceUrl || p.blogUrl || p.demoUrl || '#';
// The pink band pushes the newest piece that isn't already a selected work
const [newestPiece] = eras.flatMap((era) => era.projects);
if (!newestPiece) throw new Error('No project outside SELECTED_WORKS for the featured band');
const newestPieceMonth = new Date(`${newestPiece.date}-01T00:00:00Z`).toLocaleDateString('en-US', {
	timeZone: 'UTC',
	month: 'short',
	year: 'numeric',
});
const pieces = (n: number) => `${n} ${n === 1 ? 'piece' : 'pieces'}`;
const reelPieces = selected.map((p) => ({ title: p.title, href: workUrl(p) }));
const SECTION = 'relative mb-12 scroll-mt-24 md:mb-16';
---

<BaseLayout
	title="Works | Joe Karlsson"
	description="Joe Karlsson's art, software and hardware: selected works, an artist statement and ten years of projects by era."
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- The site's standard page top: a reel of the selected works plays where other pages
		have a picture, 16:9 like every clip in it so nothing is cropped. Its caption and link
		follow the piece on screen (src/scripts/work-reel.ts) -->
		<PosterHero
			title="Works"
			wordRatio={2.6}
			featured={{
				label: 'New',
				title: newestPiece.title,
				href: workUrl(newestPiece),
				meta: newestPieceMonth,
			}}
		>
			<a
				slot="media"
				href={reelPieces[0].href}
				data-reel-pieces={JSON.stringify(reelPieces)}
				data-reel-slice={REEL_SLICE_SECONDS}
				class="plausible-event-name=Reel+Click ring-host group relative z-10 flex flex-col overflow-hidden rounded-xl bg-surface-1 no-underline"
			>
				<video
					src={REEL_VIDEO}
					poster={REEL_VIDEO.replace(/\.mp4$/, '-poster.webp')}
					loop
					muted
					playsinline
					preload="none"
					aria-label={`Clips of my selected works: ${SELECTED_WORKS.join(', ')}`}
					data-autoplay-in-view
					data-halftone="flat"
					class="block aspect-video w-full object-cover md:aspect-auto md:min-h-0 md:flex-1"
				/>
				<span class="flex flex-none flex-col justify-end px-6 pt-4 pb-5">
					<span class="block font-display text-[clamp(26px,2.6vw,40px)] leading-[0.95] text-paper uppercase group-hover:text-pink">
						<span data-reel-title>{reelPieces[0].title}</span> →
					</span>
				</span>
				<HoverBox featured />
			</a>
			<p class={HERO_LEAD}>
				I make art with code, paint and hardware, and I want artists and engineers to try each
				other's tools.
			</p>
		</PosterHero>

		<section id="selected" class={SECTION}>
			<h2 class={SECTION_HEADING}>
				Selected works
				<Scribble
					{...MARKS.rays}
					color="#ff4fd8"
					duration="8s"
					class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
				/>
			</h2>
			<!-- Big rows, the clip alternating sides from md up -->
			<div class="grid gap-y-12 md:gap-y-16">
				{selected.map((project, i) => (
					<a
						href={workUrl(project)}
						class:list={[
							'plausible-event-name=Selected+Work+Click ring-host group grid items-center gap-6 no-underline md:gap-10',
							i % 2
								? 'md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]'
								: 'md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]',
						]}
					>
						<span class:list={['relative block', i % 2 && 'md:order-2']}>
							<span class="block overflow-hidden rounded-xl bg-ink">
								{project.video ? (
									<video
										src={cardClip(project.video)}
										poster={project.poster ?? project.image}
										loop
										muted
										playsinline
										preload="none"
										aria-label={project.imageAlt}
										data-autoplay-in-view
										data-halftone="flat"
										class="block aspect-video w-full object-cover"
									/>
								) : (
									<img
										src={project.card?.src ?? project.image}
										alt={project.card?.alt ?? project.imageAlt}
										data-halftone={cardHalftone(project.card?.src ?? project.image)}
										width="1120"
										height="630"
										class="block aspect-video w-full object-cover"
										loading="lazy"
									/>
								)}
							</span>
							<HoverBox index={i} />
						</span>
						<span class="block">
							<span class="mb-3 block font-display text-[clamp(2.4rem,1.6rem+3.2vw,4.25rem)] leading-[0.95] text-paper uppercase group-hover:text-pink">
								{project.title}
							</span>
							<span class="block font-serif text-xl leading-snug text-paper">
								{project.page?.tagline ?? project.description}
							</span>
							<span class={`mt-2 block ${META}`}>{project.date.slice(0, 4)}</span>
						</span>
					</a>
				))}
			</div>
		</section>

		<section id="statement" class={SECTION}>
			<h2 class={SECTION_HEADING}>
				Artist statement
				<Scribble
					{...MARKS.underline}
					color={CHALK}
					duration="8s"
					class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
				/>
			</h2>
			<!-- Phones get one short paragraph of the same argument; the Markdown copy skips it
			(data-phone-copy) since the full statement is there -->
			<div class="prose md:hidden" data-phone-copy>
				<p>
					The early web was homemade pages, built by amateurs for each other, and I think money
					crushed most of it. I still work in that spirit, on a site I host myself. I paint too, and
					every scribble here started as one of those drawings. Plenty of artists still find code
					scary, and plenty of engineers think the humanities are a waste of time. I want each of
					them to see the other side, to come away wanting to make something, and to feel a little
					freer of the idea that everything they make has to earn money.
				</p>
			</div>
			<!-- The container's full width in two columns, so each line stays a reading length -->
			<div
				class="prose max-md:hidden md:columns-2 md:gap-12 [&>p]:break-inside-avoid"
				style="max-width: none"
			>
				<p>
					The early web was full of people who hosted their own sites, linked to each other and gave
					away what they knew.{' '}
					<a class={TEXT_LINK} href="https://art.teleportacia.org/observation/vernacular/">
						Olia Lialina called it the vernacular web
					</a>
					: homemade pages, built by amateurs for each other. I think money crushed most of it, and
					what people picture when they hear "tech" now is what came after: startups, crypto and AI,
					each with a plan to make money.
				</p>
				<p>
					I host this site myself, on my own hardware, because that early web is still what I love
					about the medium. Code is easy to share, it bends into almost any shape, and almost
					nothing made with it lasts. I love that, even though I just rebuilt three of my old apps
					after they died on Heroku. Some ideas only work on the web.{' '}
					<a class={TEXT_LINK} href="/work/linger/">
						linger
					</a>{' '}
					is a set of poems that fill in only if you scroll slowly, because a page knows how fast
					you're reading and paper doesn't.
				</p>
				<p>
					Some of my work isn't code at all. I've started painting, mostly subconscious scribbling
					and color field work, and it's where I chase what I'm drawn to most: the strange, the
					surreal and the unexplained. Every scribble on this site started as one of those drawings.
					Now that AI can generate almost anything, I think a person's hand and taste are the most
					important things they have to offer.
				</p>
				<p>
					In 1959,{' '}
					<a class={TEXT_LINK} href="https://en.wikipedia.org/wiki/The_Two_Cultures">
						C. P. Snow warned
					</a>{' '}
					that scientists and literary intellectuals had split into two cultures that could barely
					talk to each other. Plenty of artists still find code and math scary, and plenty of
					engineers think the humanities are a waste of time. I want each of them to see what's on
					the other side, and to come away wanting to make something, whether it's a painting, a web
					page or a piece of hardware. Most of all, I want people to leave a little freer of the
					idea that everything they make has to earn money.
				</p>
			</div>
		</section>

		<!-- A quick index of the eras below, two columns like /about/'s Follow me -->
		<nav aria-label="Eras" class="mb-12 grid gap-x-10 md:mb-16 md:grid-cols-2">
			{eras.map((era, i) => (
				<IndexRow
					href={`#${era.slug}`}
					label={era.years}
					meta={pieces(era.projects.length)}
					index={i}
					compact
				/>
			))}
		</nav>

		{eras.map((era, i) => (
			<section id={era.slug} class={SECTION}>
				<h2 class={SECTION_HEADING}>
					{era.years}
					<Scribble
						{...MARKS.rays}
						color={i % 2 ? '#ff4fd8' : CHALK}
						duration="8s"
						delay={`${i * 0.4}s`}
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<p class={`mb-8 ${HERO_LEAD}`}>{era.label}</p>
				{era.note && <p class={`mb-8 max-w-[40em] ${META}`}>{era.note}</p>}
				{/* Phones: one column of compact rows (ProjectCard), so the gap between them tightens */}
				<div class="era-grid grid gap-x-8 gap-y-6 md:grid-cols-2 md:gap-y-14 lg:grid-cols-3">
					{era.projects.map((project, j) => (
						<ProjectCard project={project} index={j} />
					))}
				</div>
			</section>
		))}

		<p class="mb-12 md:mb-16">
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class={MORE_LINK}>
				View all repos on GitHub →
			</a>
		</p>

		<KeepExploring
			heading="Where to next"
			from="/work/"
			posts={[
				'why-i-use-doom-to-visualize-mcp-data',
				'followspot-local-whisper-teleprompter',
				'pixelpane-pixel-art-home-assistant',
			]}
		/>
	</div>
</BaseLayout>

<script>
	import '../scripts/work-reel';
</script>
