---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeepExploring from '../components/KeepExploring.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, CATEGORY_META } from '../data/projects';
import HoverBox from '../components/HoverBox.astro';
import Scribble from '../components/Scribble.astro';
import PosterHero from '../components/PosterHero.astro';
import {
	FILTER_ACTIVE,
	FILTER_INACTIVE,
	FILTER_ROW,
	HERO_LEAD,
	MORE_LINK,
	PAGE_CONTAINER,
} from '../utils/ui';
import { SOCIAL_LINKS } from '../consts';
import { CHALK, MARKS } from '../data/scribbles';
import { cardClip } from '../utils/halftone';

const featuredProject = projects.find((p) => p.featured);
const nonFeatured = projects.filter((p) => !p.featured);
const featuredUrl =
	(featuredProject?.page && `/work/${featuredProject.page.slug}/`) ||
	featuredProject?.sourceUrl ||
	featuredProject?.blogUrl ||
	'#';
const featuredExternal = featuredUrl.startsWith('http');

const sortedProjects = [...nonFeatured].sort((a, b) => b.date.localeCompare(a.date));

const categoryFilters = (Object.keys(CATEGORY_META) as (keyof typeof CATEGORY_META)[])
	.map((catKey) => ({
		key: catKey,
		label: CATEGORY_META[catKey].label,
		count: nonFeatured.filter((p) => p.category === catKey).length,
	}))
	.filter((c) => c.count > 0);
---

<BaseLayout
	title="Projects | Joe Karlsson"
	description="Joe Karlsson's projects, demos, open source work, and portfolio."
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- Built like the blog's hero: the featured project's clip (its title on a dark
		strip) beside a pink ticker of the project categories and a dark panel whose
		PROJECTS fills it. On phones the clip is a 16:9 banner with the title under it. -->
		<PosterHero
			title="Projects"
			wordRatio={3.65}
			tickerItems={categoryFilters.map(({ label }) => label)}
		>
			{featuredProject && (
				<a
					slot="media"
					href={featuredUrl}
					target={featuredExternal ? '_blank' : undefined}
					rel={featuredExternal ? 'noopener noreferrer' : undefined}
					class="plausible-event-name=Featured+Project+Click ring-host group relative z-10 block no-underline"
				>
					<span class="block overflow-hidden rounded-xl bg-ink md:absolute md:inset-0">
						{featuredProject.video ? (
							<video
								src={cardClip(featuredProject.video)}
								poster={featuredProject.image}
								loop
								muted
								playsinline
								preload="none"
								aria-label={featuredProject.imageAlt}
								data-autoplay-in-view
								data-halftone="flat"
								class="block aspect-video w-full object-cover md:aspect-auto md:size-full"
							/>
						) : (
							<img
								src={featuredProject.image}
								alt={featuredProject.imageAlt}
								data-halftone="flat"
								width="1120"
								height="630"
								class="block aspect-video w-full object-cover md:aspect-auto md:size-full"
								loading="eager"
							/>
						)}
						<span class="block bg-ink px-6 pt-4 pb-5 md:absolute md:inset-x-0 md:bottom-0 md:z-10">
							<span class="mb-1.5 block text-sm text-muted">
								<span class="font-semibold text-pink">Featured</span>
								{' · '}
								{featuredProject.tech.join(' · ')}
							</span>
							<span class="block font-display text-[clamp(26px,2.6vw,40px)] leading-[0.95] text-paper uppercase group-hover:text-pink">
								{featuredProject.title}
							</span>
						</span>
					</span>
					<Scribble
						{...MARKS.burst}
						color={CHALK}
						strokeWidth={6}
						duration="8s"
						delay="1.6s"
						class="-top-[7%] -left-[7%] z-10 size-[22%]"
					/>
					<Scribble
						{...MARKS.lines}
						color={CHALK}
						duration="11s"
						delay="1s"
						class="-bottom-[7%] -left-[6%] z-10 h-[12%] w-[70%]"
					/>
					<HoverBox featured />
				</a>
			)}
			<p class={HERO_LEAD}>Software, hardware, and IoT projects I've built over the years.</p>
		</PosterHero>

		<div
			class={`mb-12 rounded-xl bg-surface-1 p-5 sm:p-7 ${FILTER_ROW}`}
			role="group"
			aria-label="Filter projects by category"
		>
			<button
				type="button"
				class={`project-filter ${FILTER_ACTIVE}`}
				data-filter="all"
				aria-pressed="true"
			>
				All <span class="text-muted">{nonFeatured.length}</span>
			</button>
			{categoryFilters.map((c) => (
				<button
					type="button"
					class={`project-filter ${FILTER_INACTIVE}`}
					data-filter={c.key}
					aria-pressed="false"
				>
					{c.label} <span class="text-muted">{c.count}</span>
				</button>
			))}
		</div>

		<!-- The cards are h3s; this names their section so the outline doesn't skip from h1 -->
		<h2 class="sr-only">All projects</h2>
		<!-- Phones: one column of compact rows (ProjectCard), so the gap between them tightens -->
		<div
			id="projects-grid"
			class="mb-12 md:mb-14 grid gap-x-8 gap-y-6 md:grid-cols-2 md:gap-y-14 lg:grid-cols-3"
		>
			{sortedProjects.map((project) => (
				<div data-category={project.category}>
					<ProjectCard project={project} />
				</div>
			))}
		</div>

		<p class="mb-12 md:mb-16">
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class={MORE_LINK}>
				View all repos on GitHub →
			</a>
		</p>

		<KeepExploring
			heading="Where to next"
			from="/work/"
			posts={[
				'why-i-use-doom-to-visualize-mcp-data',
				'followspot-local-whisper-teleprompter',
				'pixelpane-pixel-art-home-assistant',
			]}
		/>
	</div>

	<script>
		import { FILTER_ACTIVE, FILTER_INACTIVE } from '../utils/ui';

		// The chosen category lives in the URL hash (/work/#hardware), so a filtered view
		// can be linked to and survives a reload
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('.project-filter');
		const projectCells = document.querySelectorAll<HTMLElement>('#projects-grid > [data-category]');

		function showCategory(filter: string) {
			filterButtons.forEach((b) => {
				const isActive = b.dataset.filter === filter;
				b.setAttribute('aria-pressed', String(isActive));
				b.className = `project-filter ${isActive ? FILTER_ACTIVE : FILTER_INACTIVE}`;
			});
			projectCells.forEach((cell) => {
				cell.hidden = filter !== 'all' && cell.dataset.category !== filter;
			});
		}

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter || 'all';
				showCategory(filter);
				history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
				if (typeof window.plausible === 'function') {
					window.plausible('Project Filter', { props: { category: filter } });
				}
			});
		});

		const fromHash = location.hash.slice(1);
		if ([...filterButtons].some((b) => b.dataset.filter === fromHash)) showCategory(fromHash);
	</script>
</BaseLayout>
