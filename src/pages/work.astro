---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, CATEGORY_META } from '../data/projects';
import { SOCIAL_LINKS } from '../consts';

const featuredProject = projects.find((p) => p.featured);
const nonFeatured = projects.filter((p) => !p.featured);
const featuredUrl =
	(featuredProject?.page && `/work/${featuredProject.page.slug}/`) ||
	featuredProject?.sourceUrl ||
	featuredProject?.blogUrl ||
	'#';
const featuredExternal = featuredUrl.startsWith('http');

const sortedProjects = [...nonFeatured].sort((a, b) => b.date.localeCompare(a.date));

const categoryFilters = (Object.keys(CATEGORY_META) as (keyof typeof CATEGORY_META)[])
	.map((catKey) => ({
		key: catKey,
		label: CATEGORY_META[catKey].label,
		count: nonFeatured.filter((p) => p.category === catKey).length,
	}))
	.filter((c) => c.count > 0);
---

<BaseLayout
	title="Projects | Joe Karlsson"
	description="Joe Karlsson's projects, demos, open source work, and portfolio."
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Projects</h1>
		<p class="mb-10 text-gray-400">
			I build things - software, hardware, IoT contraptions, and the occasional questionable idea.
			Here's a collection of projects I've shipped over the years.
		</p>

		{/* Featured Project */}
		{featuredProject && (
			<a
				href={featuredUrl}
				target={featuredExternal ? '_blank' : undefined}
				rel={featuredExternal ? 'noopener noreferrer' : undefined}
				class="plausible-event-name=Featured+Project+Click group mb-12 block no-underline"
				data-hover-target
			>
				<div class="md:flex md:gap-6">
					{/* shrink-0 keeps the long description from squeezing the media */}
					<div class="overflow-hidden rounded-md bg-black md:w-1/2" style="flex-shrink: 0">
						{featuredProject.video ? (
							<video
								src={featuredProject.video}
								poster={featuredProject.image}
								loop
								muted
								playsinline
								preload="metadata"
								role="img"
								aria-label={featuredProject.imageAlt}
								data-hover-play
								class="aspect-video h-full w-full object-cover"
							/>
						) : (
							<img
								src={featuredProject.image}
								alt={featuredProject.imageAlt}
								class="aspect-video h-full w-full object-cover"
								loading="eager"
							/>
						)}
					</div>
					<div class="flex flex-col justify-center pt-4 md:pt-0">
						<h2 class="mb-2 text-2xl font-bold text-white transition-colors group-hover:text-coral">
							{featuredProject.title}
						</h2>
						<p class="mb-3 text-sm text-gray-400">{featuredProject.tech.join(' · ')}</p>
						{featuredProject.stars && (
							<p class="mb-2 text-sm text-gray-400">{featuredProject.stars} stars on GitHub</p>
						)}
						<p class="text-sm text-gray-400">{featuredProject.description}</p>
						<div class="mt-4 flex items-center gap-4">
							{featuredProject.sourceUrl && (
								<span class="flex items-center gap-1 text-sm text-coral">
									<svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
									</svg>
									Source
								</span>
							)}
							{featuredProject.blogUrl && (
								<span class="flex items-center gap-1 text-sm text-coral">
									<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
										/>
									</svg>
									Blog Post
								</span>
							)}
						</div>
					</div>
				</div>
			</a>
		)}

		<div>
			<div>
				<div
					class="mb-6 flex flex-wrap gap-x-5 gap-y-2"
					role="group"
					aria-label="Filter projects by category"
				>
					<button
						type="button"
						class="project-filter text-sm text-coral underline underline-offset-4 transition-colors"
						data-filter="all"
						aria-pressed="true"
					>
						All ({nonFeatured.length})
					</button>
					{categoryFilters.map((c) => (
						<button
							type="button"
							class="project-filter text-sm text-gray-400 transition-colors hover:text-white"
							data-filter={c.key}
							aria-pressed="false"
						>
							{c.label} ({c.count})
						</button>
					))}
				</div>

				<div id="projects-grid" class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{sortedProjects.map((project) => (
						<div data-category={project.category}>
							<ProjectCard project={project} />
						</div>
					))}
				</div>

				<p class="mb-10 text-gray-400">
					Want to see everything?{' '}
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="text-coral"
					>
						View all repos on GitHub &rarr;
					</a>
				</p>

				<h2 class="mb-4 text-3xl font-extrabold text-white">Keep exploring</h2>
				<ul class="mb-10 space-y-2">
					<li>
						<a href="/blog/" class="text-coral">
							Blog
						</a>
					</li>
					<li>
						<a href="/about/" class="text-coral">
							About me
						</a>
					</li>
					<li>
						<a href="/resume/" class="text-coral">
							Resume
						</a>
					</li>
					<li>
						<a href="/talk-archive/" class="text-coral">
							Talk archive
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<script>
		// Must match the server-rendered classes on .project-filter above
		const ACTIVE_FILTER_CLASSES =
			'text-sm text-coral underline underline-offset-4 transition-colors';
		const INACTIVE_FILTER_CLASSES = 'text-sm text-gray-400 transition-colors hover:text-white';
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('.project-filter');
		const projectCells = document.querySelectorAll<HTMLElement>('#projects-grid > [data-category]');
		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;
				filterButtons.forEach((b) => {
					const isActive = b === button;
					b.setAttribute('aria-pressed', String(isActive));
					b.className = `project-filter ${isActive ? ACTIVE_FILTER_CLASSES : INACTIVE_FILTER_CLASSES}`;
				});
				projectCells.forEach((cell) => {
					cell.hidden = filter !== 'all' && cell.dataset.category !== filter;
				});
				if (typeof window.plausible === 'function') {
					window.plausible('Project Filter', { props: { category: filter || 'all' } });
				}
			});
		});
	</script>
</BaseLayout>
