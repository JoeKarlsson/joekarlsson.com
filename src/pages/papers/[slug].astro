---
// A research paper, set like a journal article inside the site's frame (mockup B,
// DECISIONS.md 2026-11-22): sentence-case Fraunces title, byline, a ruled ledger of dates and
// DOI, PDF and "Cite this", a shaded abstract, then the paper with its numbered sections,
// tables and figures, Chicago author-date citations in the margin and the reference list.
// The text comes from the paper's repo through scripts/sync-paper.mjs.
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ArticleFrame from '../../components/ArticleFrame.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import MetaParts from '../../components/MetaParts.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/papers.css';
import { bibtex, chicagoCitation, scholarMeta } from '../../utils/paper-citation';

export async function getStaticPaths() {
	const papers = await getCollection('papers');
	return papers.map((paper) => ({ params: { slug: paper.id }, props: paper }));
}
type Props = CollectionEntry<'papers'>;

const paper = Astro.props;
const data = paper.data;
const { Content, headings } = await render(paper);
const section = { name: 'Papers', path: '/papers/' };
const pageUrl = new URL(`/papers/${paper.id}/`, Astro.site).href;
const blogPost = data.blogPost
	? (await getCollection('blog')).find((p) => p.data.slug === data.blogPost)
	: undefined;
if (data.blogPost && !blogPost) throw new Error(`paper ${paper.id}: no blog post ${data.blogPost}`);

const chicago = chicagoCitation(data, pageUrl);
const bib = bibtex(data, pageUrl, paper.id);
const toc = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
const abstractText = data.abstract
	.replace(/<[^>]+>/g, '')
	.replace(/\u2060/g, '')
	.trim();
---

<BaseLayout
	title={`${data.seoTitle ?? data.displayTitle} | Joe Karlsson`}
	description={data.description}
	type="article"
	publishedDate={data.published}
	modifiedDate={data.revised}
	keywords={data.keywords}
	section={section}
	paper={{
		meta: scholarMeta(data, pageUrl, Astro.site!),
		schema: {
			name: data.title,
			abstract: abstractText,
			keywords: data.keywords.join(', '),
			encoding: {
				'@type': 'MediaObject',
				contentUrl: new URL(data.pdf, Astro.site).href,
				encodingFormat: 'application/pdf',
			},
			...(data.doi && { sameAs: `https://doi.org/${data.doi}` }),
			...(data.repository && { isBasedOn: data.repository }),
			citation: data.references,
		},
	}}
>
	<ArticleFrame
		title={data.displayTitle}
		section={section}
		paper
		toc={toc}
		inlineToc={toc.filter((h) => h.depth === 2)}
		share={{ url: pageUrl, title: data.displayTitle, noun: 'paper' }}
		ask={{
			location: 'paper-end',
			blurb:
				'Get the next one by email. My newsletter covers research like this, homelab builds, AI tools and open source, and it goes out when I have something to say.',
		}}
		articleData={{ 'data-post-title': data.displayTitle }}
	>
		<Fragment slot="kicker">
			<MetaParts parts={[data.version.split(',')[0], 'Research paper']} />
		</Fragment>
		<div slot="top" class="paper-front">
			<p class="paper-byline">
				{data.authors.map((a) => (
					<>
						<span class="text-paper">{a.name}</span>{' '}
						{a.orcid && (
							<a class="paper-orcid" href={`https://orcid.org/${a.orcid}`}>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<circle cx="12" cy="12" r="12" fill="#a6ce39" />
									<path
										fill="#fff"
										d="M8.3 17.3H6.9V7.9h1.4zm2.2-9.4h3.7c3.5 0 5.1 2.5 5.1 4.7 0 2.4-1.9 4.7-5.1 4.7h-3.7zm1.4 8.2h2.2c3.1 0 3.8-2.4 3.8-3.5 0-1.8-1.1-3.5-3.9-3.5h-2.1zM8.5 6.1c0 .5-.4.9-.9.9s-.9-.4-.9-.9.4-.9.9-.9.9.4.9.9z"
									/>
								</svg>
								<span class="sr-only">ORCID iD</span>
								{a.orcid}
							</a>
						)}{' '}
						{a.affiliation && <span>{a.affiliation}</span>}
					</>
				))}
			</p>
			<dl class="paper-ledger">
				<div>
					<dt>Published</dt>
					<dd>
						<FormattedDate date={data.published} />
					</dd>
				</div>
				<div>
					<dt>Revised</dt>
					<dd>
						<FormattedDate date={data.revised} /> ({data.version})
					</dd>
				</div>
				{data.doi && (
					<div>
						<dt>DOI</dt>
						<dd>
							<a href={`https://doi.org/${data.doi}`}>{data.doi}</a>
						</dd>
					</div>
				)}
				{blogPost && (
					<div>
						<dt>Blog version</dt>
						<dd>
							<a href={`/blog/${blogPost.data.slug}/`}>{blogPost.data.title}</a>
						</dd>
					</div>
				)}
			</dl>
			<div class="paper-actions">
				<a class="paper-act" href={data.pdf} data-plausible-event="Paper+PDF">
					PDF <small>{Math.round(data.pdfBytes / 1024)} KB</small>
				</a>
				{data.repository && (
					<a class="paper-act paper-act-quiet" href={data.repository}>
						Code and data
					</a>
				)}
				{/* Native disclosure: works without JS, and find in page reaches the citations */}
				<details class="paper-cite">
					<summary class="paper-act paper-act-quiet">Cite this</summary>
					<div class="paper-cite-panel">
						{[
							{ label: 'Chicago', value: chicago },
							{ label: 'BibTeX', value: bib },
						].map(({ label, value }) => (
							<div>
								<div class="paper-cite-head">
									<span>{label}</span>
									<button type="button" class="copy-button paper-copy" data-copy={value}>
										<span class="icon-swap">
											<span data-icon-off>Copy {label}</span>
											<span data-icon-on aria-hidden="true">
												Copied!
											</span>
										</span>
									</button>
								</div>
								{label === 'BibTeX' ? (
									<pre tabindex="0" aria-label="BibTeX citation">{value}</pre>
								) : (
									<p>{value}</p>
								)}
							</div>
						))}
					</div>
				</details>
			</div>
			<section class="paper-abstract">
				<h2 id="abstract">Abstract</h2>
				<Fragment set:html={data.abstract} />
				<p class="paper-keywords">
					<b>Keywords</b>
					{data.keywords.join('; ')}
				</p>
			</section>
		</div>
		<div class="prose wide-media paper-body">
			<Content />
		</div>
	</ArticleFrame>
	<ImageLightbox />
</BaseLayout>

<script>
	// One polite live region says "Copied" for both buttons
	const status = document.createElement('span');
	status.setAttribute('role', 'status');
	status.className = 'sr-only';
	document.body.append(status);
	document.querySelectorAll<HTMLButtonElement>('.paper-copy').forEach((button) => {
		const idleLabel = button.querySelector<HTMLElement>('[data-icon-off]')!;
		const idleText = idleLabel.textContent;
		let reset: ReturnType<typeof setTimeout> | undefined;
		button.addEventListener('click', async () => {
			clearTimeout(reset);
			status.textContent = '';
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.toggleAttribute('data-copied', true);
				button.classList.remove('copied');
				void button.offsetWidth; // restart the pop on a second copy
				button.classList.add('copied');
				status.textContent = 'Copied';
			} catch {
				idleLabel.textContent = 'Failed';
				status.textContent = 'Copy failed: select the text and copy it instead';
			}
			reset = setTimeout(() => {
				button.removeAttribute('data-copied');
				idleLabel.textContent = idleText;
				status.textContent = '';
			}, 2000);
		});
	});
</script>
