---
// /reviews/stats/: the numbers behind Joe's reviews (src/utils/review-stats.ts). The
// dashboard's numbers and two charts on top, then stats built from the posters
// themselves (DECISIONS.md). Hovering a poster shows its one-liner and clicking opens the
// review; the motion lives in src/scripts/review-stats.ts.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PosterHero from '../../components/PosterHero.astro';
import HoverBox from '../../components/HoverBox.astro';
import Scribble from '../../components/Scribble.astro';
import { CHALK, MARKS } from '../../data/scribbles';
import {
	ARTICLE_HEADING,
	GROUP_HEADING,
	HERO_LEAD,
	META,
	MORE_LINK,
	PAGE_CONTAINER,
	formatDate,
} from '../../utils/ui';
import { cardHalftone } from '../../utils/halftone';
import { jsonForScript } from '../../utils/json-for-script';
import { reviewStats, type StatsReview } from '../../utils/review-stats';
import { stars } from '../../../scripts/update-reviews.mjs';
import { SPOILER_MARK } from '../../plugins/rehype-spoilers.mjs';

const entries = (await getCollection('reviews')).map((e) => e.data);
const s = reviewStats(entries);
const bySlug = new Map(entries.map((r) => [r.slug, r]));
const firstYear = Math.min(...entries.map((r) => r.date.getUTCFullYear()));
const featured = s.fiveStars.find((r) => bySlug.get(r.slug)?.heroImage) ?? s.fiveStars[0];
const hero = bySlug.get(featured.slug)!;

// What the hover card shows for each film: title, year, stars, rewatch, one-liner, poster.
// The card can't blur, so a spoiler review shows no one-liner and a marked spoiler is cut.
const oneLiner = (r: (typeof entries)[number]) =>
	r.spoilers ? '' : r.description.replace(SPOILER_MARK, '(spoiler)');
const films = Object.fromEntries(
	entries.map((r) => [
		r.slug,
		[r.title, r.year, r.rating ? stars(r.rating) : '', r.rewatch, oneLiner(r), r.poster ?? ''],
	]),
);

const SECTION = 'relative mb-12 md:mb-16';
const H2 = ARTICLE_HEADING.replace('mb-5', 'mb-2');
const SUB = `${META} mb-6`;
const PANEL = 'relative min-w-0 rounded-xl bg-surface-1 p-5 md:p-7';
const half = (step: number) => (step % 1 ? `${Math.floor(step) || ''}½` : String(step));
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const maxRating = Math.max(...s.ratings.map((r) => r.count));
const maxMonth = Math.max(...s.months.map((m) => m.count));
const maxDecade = Math.max(...s.decades.map((d) => d.count));
const maxGenre = s.genres[0].count;
const topGenre = [...s.genres].sort((a, b) => b.average - a.average)[0];
const posterLabel = (r: StatsReview) =>
	`${r.title} (${r.year})${r.rating ? `, ${r.rating} stars` : ''}`;
---

<BaseLayout
	title="Film review stats | Joe Karlsson"
	description={`The numbers behind my ${s.reviews} film reviews: how I rate, what I watch, which decades and directors I keep coming back to.`}
	schemaType="CollectionPage"
>
	<!-- The cut-paper edge the bars get (motion.css has the site's other filters) -->
	<svg width="0" height="0" class="absolute" aria-hidden="true">
		<filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
			<feTurbulence
				type="fractalNoise"
				baseFrequency="0.09"
				numOctaves="2"
				seed="5"
				result="n"
			></feTurbulence>
			<feDisplacementMap in="SourceGraphic" in2="n" scale="4"></feDisplacementMap>
		</filter>
	</svg>

	<div class={PAGE_CONTAINER} data-review-stats>
		<PosterHero
			title="Stats"
			wordRatio={2.4}
			featured={{
				label: 'Top',
				title: `${featured.title} (${featured.year})`,
				href: `/reviews/${featured.slug}/`,
				meta: [stars(5), formatDate(featured.date)].join('  '),
			}}
		>
			<a
				slot="media"
				href={`/reviews/${hero.slug}/`}
				class="ring-host group relative z-10 block no-underline"
			>
				<span class="block overflow-hidden rounded-xl bg-ink md:absolute md:inset-0">
					<img
						src={hero.heroImage ?? hero.poster}
						alt=""
						aria-hidden="true"
						data-halftone={cardHalftone((hero.heroImage ?? hero.poster)!)}
						width="1200"
						height="675"
						sizes="(min-width: 768px) 50vw, 100vw"
						class="block aspect-video w-full object-cover md:aspect-auto md:size-full"
						loading="eager"
						fetchpriority="high"
					/>
					<span class="block bg-ink px-6 pt-4 pb-5 md:absolute md:inset-x-0 md:bottom-0 md:z-10">
						<span class="block font-display text-[clamp(1.625rem,2.6vw,2.5rem)] leading-[0.95] text-paper uppercase group-hover:text-pink">
							{hero.title}
						</span>
						<span class="mt-2 block text-sm text-muted">{oneLiner(hero)}</span>
					</span>
				</span>
				<HoverBox featured />
			</a>
			<p class={HERO_LEAD}>
				{s.reviews} reviews of {s.films} films since {firstYear}.{' '}
				<a href="/reviews/" class={MORE_LINK}>
					All reviews
				</a>
			</p>
		</PosterHero>

		<div class="mb-3 grid grid-cols-2 gap-3 md:grid-cols-4">
			{[
				[s.reviews, 'reviews'],
				[s.average.toFixed(2), 'average rating'],
				[s.directors, 'directors'],
				[s.rewatches, 'rewatches'],
			].map(([n, label]) => (
				<div class="rounded-xl bg-surface-1 p-5 md:p-7">
					<div class="font-display text-[clamp(2.75rem,6vw,4rem)] leading-none" data-roll>
						{n}
					</div>
					<div class="mt-1 text-sm text-muted">{label}</div>
				</div>
			))}
		</div>

		<div class={`${SECTION} grid gap-3 md:grid-cols-2`}>
			<div class={PANEL}>
				<h2 class={`${GROUP_HEADING} mb-2`}>Ratings</h2>
				<p class={SUB}>Stars given, all time</p>
				<div
					class="stats-chart"
					style={`--n:${s.ratings.length}`}
					aria-hidden="true"
					data-rating-chart
				>
					{s.ratings.map(({ step, count }, i) => (
						<>
							<span class="stats-count relative" style={`grid-column:${i + 1}`}>
								{count}
								{count === maxRating && (
									<Scribble
										{...MARKS.oval}
										color="#ff4fd8"
										strokeWidth={4}
										once
										stretch
										duration="2.6s"
										class="stats-note -top-2 left-[calc(50%-1.5rem)] h-[calc(100%+1rem)] w-12"
									/>
								)}
							</span>
							<span
								class="stats-bar"
								style={`grid-column:${i + 1};height:${Math.max(2, (count / maxRating) * 160)}px`}
								data-step={step}
							/>
							{/* The figure sits in its own layer over the bar: the bar's rough filter would crop it */}
							{step === 5 && (
								<span
									class="stats-over"
									style={`grid-column:${i + 1};height:${Math.max(2, (count / maxRating) * 160)}px`}
								>
									<svg class="stats-stick" viewBox="0 0 60 70" aria-hidden="true">
										<g
											fill="none"
											stroke={CHALK}
											stroke-width="2.6"
											stroke-linecap="round"
											stroke-linejoin="round"
											filter="url(#crayon)"
										>
											<circle cx="30" cy="12" r="7" />
											<path d="M30 19 Q31 32 30 46" />
											<path class="leg" d="M30 46 Q38 48 40 58 Q40 64 44 68" />
											<path class="leg leg2" d="M30 46 Q35 50 34 60 Q34 65 38 69" />
											<path d="M30 28 Q22 34 18 40" />
											<path class="arm" d="M31 30 Q40 34 44 38" />
										</g>
										<g
											fill="none"
											stroke="#ff4fd8"
											stroke-width="2.4"
											stroke-linecap="round"
											filter="url(#crayon)"
										>
											<path d="M10 40 L13 54 L23 54 L26 40 Z M15 40 L16 54 M20 40 L20 54" />
										</g>
										<g fill={CHALK}>
											<circle cx="13" cy="38" r="2.4" />
											<circle cx="18" cy="36.5" r="2.6" />
											<circle cx="23" cy="38" r="2.4" />
											<circle class="kernel" cx="44" cy="38" r="2.2" />
										</g>
									</svg>
								</span>
							)}
							<span class="stats-label" style={`grid-column:${i + 1}`}>
								{half(step)}
							</span>
						</>
					))}
					<span class="stats-note-text" aria-hidden="true">
						my default
					</span>
				</div>
				<table class="sr-only">
					<caption>Reviews by star rating</caption>
					<tr>
						<th scope="col">Stars</th>
						<th scope="col">Reviews</th>
					</tr>
					{s.ratings.map(({ step, count }) => (
						<tr>
							<td>{step}</td>
							<td>{count}</td>
						</tr>
					))}
				</table>
			</div>
			<div class={PANEL}>
				<h2 class={`${GROUP_HEADING} mb-2`}>By month</h2>
				<p class={SUB}>
					{s.thisYear} so far, {s.months.reduce((a, m) => a + m.count, 0)} reviews
				</p>
				<div class="stats-chart" style={`--n:${s.months.length}`} aria-hidden="true">
					{s.months.map(({ month, count }, i) => (
						<>
							<span class="stats-count" style={`grid-column:${i + 1}`}>
								{count}
							</span>
							<span
								class="stats-bar"
								style={`grid-column:${i + 1};height:${Math.max(2, (count / maxMonth) * 160)}px`}
							/>
							<span class="stats-label" style={`grid-column:${i + 1}`}>
								{MONTHS[month]}
							</span>
						</>
					))}
				</div>
				<table class="sr-only">
					<caption>Reviews by month,{s.thisYear}</caption>
					<tr>
						<th scope="col">Month</th>
						<th scope="col">Reviews</th>
					</tr>
					{s.months.map(({ month, count }) => (
						<tr>
							<td>{MONTHS[month]}</td>
							<td>{count}</td>
						</tr>
					))}
				</table>
			</div>
		</div>

		<section class={SECTION}>
			<h2 class={H2}>Every review, by rating</h2>
			<p class={SUB}>Each row is one star rating, each tile one review</p>
			<!-- An overview: every film here is also on /reviews/, so the tiles stay out of
			the tab order and away from screen readers -->
			<div class="flex flex-col-reverse gap-3" aria-hidden="true" data-rating-wall>
				{s.ratings.map(({ step, count }) => (
					<div class="grid gap-1 md:grid-cols-[88px_1fr] md:gap-3" data-step={step}>
						<div class="flex items-baseline gap-2 md:block">
							<div class="text-sm text-pink">{stars(step)}</div>
							<div class="text-xs text-muted">{count} reviews</div>
						</div>
						<div class="stats-wall flex flex-wrap gap-0.5">
							{entries
								.filter((r) => r.rating === step)
								.sort((a, b) => b.date.valueOf() - a.date.valueOf())
								.map((r) => (
									<a
										href={`/reviews/${r.slug}/`}
										tabindex="-1"
										aria-hidden="true"
										data-film={r.slug}
									>
										<img
											src={r.poster}
											alt=""
											aria-hidden="true"
											width="100"
											height="150"
											sizes="22px"
											loading="lazy"
										/>
									</a>
								))}
						</div>
					</div>
				))}
			</div>
		</section>

		<section class={SECTION}>
			<h2 class={H2}>Through the decades</h2>
			<p class={SUB}>How many films from each decade, and my favorite from each, newest first</p>
			<div class="stats-decades">
				{s.decades.map(({ decade, count, best }) => (
					<div class="text-center">
						<a href={`/reviews/${best.slug}/`} class="stats-poster sticker" data-film={best.slug}>
							<img
								src={best.poster}
								alt=""
								aria-hidden="true"
								width="400"
								height="600"
								sizes="96px"
								loading="lazy"
							/>
							<span class="sr-only">{posterLabel(best)}</span>
						</a>
						<div
							class="stats-bar mt-2"
							style={`height:${Math.max(3, (count / maxDecade) * 140)}px`}
						/>
						<b class="mt-2 block font-display text-lg leading-none font-normal">{decade}s</b>
						<span class="mt-1 block text-xs text-muted">{count} films</span>
					</div>
				))}
			</div>
		</section>

		<section class={SECTION}>
			<h2 class={H2}>Directors I keep coming back to</h2>
			<p class={SUB}>Most reviewed, every film counted once</p>
			{s.topDirectors.map(({ name, films: list, average }) => (
				<div class="grid items-center gap-3 border-t border-surface-4 py-[18px] md:grid-cols-[220px_1fr] md:gap-5">
					<div>
						<h3 class={GROUP_HEADING}>{name}</h3>
						<p class={`${META} meta-parts mt-2 flex`}>
							<span>{list.length} films</span> <span>{average.toFixed(1)} average</span>
						</p>
					</div>
					<div class="grid grid-cols-5 gap-x-1.5 gap-y-4 md:grid-cols-9">
						{list.map((r) => (
							<div>
								<a href={`/reviews/${r.slug}/`} class="stats-poster sticker" data-film={r.slug}>
									<img
										src={r.poster}
										alt=""
										aria-hidden="true"
										width="400"
										height="600"
										sizes="(min-width: 768px) 96px, 18vw"
										loading="lazy"
									/>
									<span class="sr-only">{posterLabel(r)}</span>
								</a>
								{r.rating && (
									<div class="mt-2 text-sm" aria-hidden="true">
										<span class="text-pink">★</span> {half(r.rating)}
									</div>
								)}
							</div>
						))}
					</div>
				</div>
			))}
		</section>

		<section class={SECTION}>
			<h2 class={H2}>Genres</h2>
			<p class={SUB}>Most watched, with average rating</p>
			{s.genres.map(({ genre, count, average }) => (
				<div class="stats-genre">
					<span>{genre}</span>
					<span class="stats-track">
						<i style={`width:${(count / maxGenre) * 100}%`} />
					</span>
					<span class="relative">
						<span class="meta-parts flex justify-end text-muted tabular-nums">
							<span>{count} films</span>{' '}
							<span>
								<span class="text-pink" aria-hidden="true">
									★
								</span>{' '}
								{average.toFixed(2)}
								<span class="sr-only">average</span>
							</span>
						</span>
						{genre === topGenre.genre && (
							<>
								<Scribble
									{...MARKS.oval}
									color="#ff4fd8"
									strokeWidth={4}
									once
									stretch
									duration="2.6s"
									class="stats-note -top-2 -left-3 h-[calc(100%+1rem)] w-[calc(100%+1.5rem)]"
								/>
								<span class="stats-note-text stats-note-side" aria-hidden="true">
									rated highest
								</span>
							</>
						)}
					</span>
				</div>
			))}
		</section>

		<section class={SECTION}>
			<h2 class={H2}>Five stars</h2>
			<p class={SUB}>All {s.fiveStars.length} films, newest first</p>
			<div class="grid grid-cols-5 gap-1.5 md:grid-cols-10">
				{s.fiveStars.map((r) => (
					<a href={`/reviews/${r.slug}/`} class="stats-poster sticker" data-film={r.slug}>
						<img
							src={r.poster}
							alt=""
							aria-hidden="true"
							width="400"
							height="600"
							sizes="(min-width: 768px) 104px, 18vw"
							loading="lazy"
						/>
						<span class="sr-only">{posterLabel(r)}</span>
						<Scribble
							{...MARKS.star}
							color="#ff4fd8"
							strokeWidth={4}
							ring={false}
							once
							class="stats-star"
						/>
					</a>
				))}
			</div>
		</section>

		<a href="/reviews/" class={MORE_LINK}>
			All {s.reviews} reviews
		</a>
	</div>

	<script type="application/json" id="review-stats-films" set:html={jsonForScript(films)} />
</BaseLayout>

<style is:global>
	/* Colors are the tailwind.config.mjs tokens, which aren't CSS variables here.
	   Bar charts: counts, bars and labels share one grid, so every label sits under its bar */
	.stats-chart {
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--n), minmax(0, 1fr));
		column-gap: 2px;
	}
	.stats-count,
	.stats-label {
		text-align: center;
		font-size: 0.75rem;
		line-height: 1rem;
		color: #a3a3a3;
		white-space: nowrap;
	}
	.stats-count {
		grid-row: 1;
		align-self: end;
		margin-bottom: 4px;
	}
	.stats-chart :is(.stats-bar, .stats-over) {
		grid-row: 2;
		align-self: end;
	}
	.stats-over {
		position: relative;
		pointer-events: none;
	}
	.stats-label {
		grid-row: 3;
		margin-top: 8px;
	}
	.stats-bar {
		position: relative;
		display: block;
		min-height: 2px;
		border-radius: 4px 4px 0 0;
		background: #ff4fd8;
		filter: url(#rough);
	}
	.stats-bar.lit,
	.stats-chart .stats-bar:hover,
	.stats-decades > div:hover .stats-bar {
		background: #ededed;
	}
	@media (prefers-reduced-motion: no-preference) {
		.stats-bar.lit,
		.stats-chart .stats-bar:hover,
		.stats-decades > div:hover .stats-bar {
			filter: url(#boil);
		}
	}
	[data-rating-chart] .stats-bar {
		cursor: pointer;
	}

	/* Crayon notes: drawn from the start without JS; with it, they draw once in view */
	.stats-note {
		position: absolute;
		z-index: 2;
	}
	.stats-note-text {
		grid-area: 2 / 2 / 3 / 7;
		justify-self: end;
		align-self: start;
		margin-top: 40px;
		pointer-events: none;
		font-family: var(--font-anton);
		font-size: 1.25rem;
		line-height: 1;
		color: #ff4fd8;
		text-transform: uppercase;
		transform: rotate(-4deg);
		white-space: nowrap;
	}
	.stats-note-side {
		position: absolute;
		right: calc(100% + 20px);
		top: 0;
		margin: 0;
	}
	[data-note-wait] path {
		animation: none !important;
		stroke-dashoffset: 1 !important;
	}

	/* The stick figure on the 5-star bar: legs swing and it eats popcorn, on steps like
	   the site's other paper motion */
	.stats-stick {
		position: absolute;
		bottom: 100%;
		left: 50%;
		width: min(64px, 130%);
		translate: -50% 34%;
		overflow: visible;
	}
	@media (prefers-reduced-motion: no-preference) {
		.stats-stick {
			filter: url(#boil);
		}
		.stats-stick .leg {
			transform-origin: 30px 46px;
			animation: stats-swing 1.6s steps(1) infinite;
		}
		.stats-stick .leg2 {
			animation-delay: 0.8s;
		}
		.stats-stick .arm {
			transform-origin: 31px 30px;
			animation: stats-eat 2.4s steps(1) infinite;
		}
		.stats-stick .kernel {
			animation: stats-kernel 2.4s steps(1) infinite;
		}
		@keyframes stats-swing {
			50% {
				transform: rotate(-12deg);
			}
		}
		@keyframes stats-eat {
			61%,
			85% {
				transform: rotate(-70deg);
			}
		}
		@keyframes stats-kernel {
			61%,
			85% {
				transform: translate(-4px, -14px);
			}
			86%,
			100% {
				opacity: 0;
			}
		}
	}

	/* Rating wall: tiny tiles that swell under the pointer like a dock (review-stats.ts) */
	.stats-wall a {
		display: block;
		transform-origin: 50% 100%;
		transition: transform 90ms ease-out;
	}
	.stats-wall img {
		display: block;
		width: 22px;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 2px;
	}
	.stats-wall a:hover img {
		outline: 2px solid #ededed;
		outline-offset: -2px;
	}
	[data-rating-wall] > div {
		transition: opacity 150ms ease-out;
	}
	[data-rating-wall].focus > div:not(.lit) {
		opacity: 0.2;
	}
	@media (width < 48rem) {
		.stats-wall img {
			width: 12px;
		}
		.stats-wall a {
			pointer-events: none;
		}
	}

	/* Posters: peel like stickers (motion.css .sticker), five-star ones draw a crayon star */
	.stats-poster {
		position: relative;
		display: block;
		border-radius: 6px;
	}
	.stats-poster img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 6px;
		background: #222;
	}
	.stats-poster:is(:hover, :focus-visible) img {
		outline: 2px solid #ededed;
		outline-offset: -2px;
	}
	.stats-star {
		top: -18%;
		right: -18%;
		width: 56%;
		visibility: hidden;
	}
	.stats-poster:is(:hover, :focus-visible) .stats-star {
		visibility: visible;
