---
// Every blog post written for one employer (a crosspost of their blog), or the
// personal ones: /blog/written-for/cloudquery/, /blog/written-for/personal/.
import { getCollection } from 'astro:content';
import PageTitle from '../../../components/PageTitle.astro';
import PostFinder from '../../../components/PostFinder.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PERSONAL, categorySlug, getWrittenForCounts } from '../../../utils/categories';
import { getFeedPosts } from '../../../utils/posts';
import { MORE_LINK, PAGE_CONTAINER } from '../../../utils/ui';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
	);
	return getWrittenForCounts(posts).map(({ name, slug }) => ({
		params: { employer: slug },
		props: {
			name,
			posts: posts.filter((p) => (p.data.writtenFor ?? PERSONAL) === name),
		},
	}));
}

const { name, posts } = Astro.props;
const writtenFor = getWrittenForCounts(await getCollection('blog'));
const isPersonal = name === PERSONAL;
const feedPosts = await getFeedPosts();
// Same count as the blog index header, which also lists newsletter posts
const allPostCount = feedPosts.length;
// Newsletter posts have no writtenFor, so leave them out rather than count them as personal
const employerPosts = feedPosts.filter(
	(p) => !p.isNewsletter && (p.data.writtenFor ?? PERSONAL) === name,
);
const heading = isPersonal ? 'Personal' : `For ${name}`;
const summary = isPersonal
	? `${posts.length} posts I wrote on my own`
	: `${posts.length} posts I wrote for ${name}, first published on their blog`;
---

<BaseLayout
	title={`${isPersonal ? 'Personal posts' : `Posts written for ${name}`} | Blog | Joe Karlsson`}
	description={
		isPersonal
			? `${posts.length} personal posts by Joe Karlsson.`
			: `${posts.length} posts Joe Karlsson wrote for ${name}.`
	}
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<PageTitle title={heading} back={{ href: '/blog/', label: 'Blog' }} summary={summary} />

		<PostFinder
			posts={employerPosts}
			filter={{
				label: 'Who the posts were written for',
				heading: 'Written for',
				items: writtenFor,
				basePath: '/blog/written-for/',
				currentSlug: categorySlug(name),
			}}
		/>
		<p class="mt-[18px]">
			<a href="/blog/" class={MORE_LINK}>
				All {allPostCount} posts →
			</a>
		</p>
	</div>
</BaseLayout>
