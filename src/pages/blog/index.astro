---
import BlogCard from '../../components/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE } from '../../consts';
import { getCategoryCounts } from '../../utils/categories';
import { getFeedPosts } from '../../utils/posts';
import popularPosts from '../../data/popular-posts.json';

function getReadingTime(body: string): number {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 250));
}

const allPosts = await getFeedPosts();

const featuredSlug = 'homelab-two-years-later';
const featuredPost = allPosts.find((p) => p.data.slug === featuredSlug);
const posts = allPosts.filter((p) => p.data.slug !== featuredSlug);

// Blog posts only: newsletter posts have no category page
const categories = getCategoryCounts(allPosts.filter((p) => !p.isNewsletter));

const POSTS_PER_PAGE = 12;

// Serialize post data for client-side search/sort/pagination
const postsData = posts.map((p) => ({
	title: p.data.title,
	description: p.data.description,
	slug: p.data.slug,
	date: p.data.date.toISOString(),
	heroImage: p.data.heroImage || '',
	heroAlt: p.data.heroAlt || '',
	categories: p.data.categories || [],
	readingTime: getReadingTime(p.body || ''),
	visitors: (popularPosts.visitorsByPath as Record<string, number>)[p.href] || 0,
}));

const featuredReadingTime = featuredPost ? getReadingTime(featuredPost.body || '') : 0;
---

<BaseLayout
	title="Blog | Joe Karlsson"
	description="Posts about databases, developer tools, smart homes, and the things I build."
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-white md:text-4xl">Blog</h1>
			<p class="mt-2 text-gray-400">{allPosts.length} posts</p>
		</div>

		<nav class="mb-10 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Blog categories">
			<a href="/blog/" class="text-coral underline underline-offset-4" aria-current="page">
				All
			</a>
			{categories.map(({ name, slug, count }) => (
				<a href={`/blog/category/${slug}/`} class="text-gray-300 no-underline hover:text-coral">
					{name} <span class="text-gray-400">{count}</span>
				</a>
			))}
		</nav>

		{featuredPost && (
			<a href={`/blog/${featuredPost.data.slug}/`} class="group mb-12 block no-underline">
				<div class="gap-8 md:flex md:items-center">
					<img
						src={featuredPost.data.heroImage || DEFAULT_HERO_IMAGE}
						alt={featuredPost.data.heroAlt || `Hero image for ${featuredPost.data.title}`}
						class="mb-4 h-48 w-full rounded-lg object-cover md:mb-0 md:h-64 md:w-1/2"
						loading="eager"
					/>
					<div class="md:w-1/2">
						<h2 class="mb-2 text-3xl font-extrabold text-white transition-colors group-hover:text-coral">
							{featuredPost.data.title}
						</h2>
						<p class="mb-3 text-sm text-gray-400">
							{featuredPost.data.date.toLocaleDateString('en-us', {
								timeZone: 'UTC',
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
							{featuredReadingTime > 0 && <> · {featuredReadingTime} min read</>}
							{featuredPost.data.categories.length > 0 && (
								<> · {featuredPost.data.categories.join(' · ')}</>
							)}
						</p>
						{featuredPost.data.description && (
							<p class="line-clamp-3 text-gray-400">{featuredPost.data.description}</p>
						)}
					</div>
				</div>
			</a>
		)}

		<!-- Search and sort controls -->
		<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			<div class="relative flex-1 max-w-md">
				<label for="blog-search" class="sr-only">
					Search posts
				</label>
				<input
					type="text"
					id="blog-search"
					placeholder="Search posts..."
					class="w-full rounded-lg border border-surface-3 bg-surface-1 px-4 py-2 pl-10 text-sm text-white placeholder-gray-500 outline-hidden transition-colors focus:border-coral"
				/>
				<svg
					class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
					></path>
				</svg>
			</div>
			<div class="flex items-center gap-4 text-sm">
				<span class="text-gray-400">Sort:</span>
				<button
					id="sort-newest"
					class="sort-btn cursor-pointer text-coral underline underline-offset-4"
					aria-pressed="true"
					data-sort="newest"
				>
					Newest
				</button>
				<button
					id="sort-oldest"
					class="sort-btn cursor-pointer text-gray-300 hover:text-coral"
					aria-pressed="false"
					data-sort="oldest"
				>
					Oldest
				</button>
				<button
					id="sort-popular"
					class="sort-btn cursor-pointer text-gray-300 hover:text-coral"
					aria-pressed="false"
					data-sort="popular"
					title={`Most visitors over the last 12 months, as of ${popularPosts.updatedAt}`}
				>
					Popular
				</button>
			</div>
		</div>

		<!-- Post count display (updates with search) -->
		<p id="results-count" class="mb-4 text-sm text-gray-400"></p>

		<!-- No results message -->
		<div id="no-results" class="hidden py-12 text-center">
			<p class="text-gray-400">No posts found matching your search.</p>
		</div>

		<div id="posts-grid" class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					heroAlt={post.data.heroAlt}
					categories={post.data.categories}
					readingTime={getReadingTime(post.body || '')}
					href={post.href}
				/>
			))}
		</div>

		<!-- Infinite scroll sentinel -->
		<div id="load-more-sentinel" class="mt-8 h-4"></div>
	</div>

	<script is:inline define:vars={{ postsData, POSTS_PER_PAGE }}>
		(function () {
			const grid = document.getElementById('posts-grid');
			const cards = Array.from(grid.children);
			const searchInput = document.getElementById('blog-search');
			const sentinel = document.getElementById('load-more-sentinel');
			const noResults = document.getElementById('no-results');
			const resultsCount = document.getElementById('results-count');
			const sortBtns = document.querySelectorAll('.sort-btn');

			let currentSort = 'newest';
			let searchQuery = '';
			let visibleCount = POSTS_PER_PAGE;

			// Map cards to their data
			const cardData = cards.map((card, i) => ({
				el: card,
				data: postsData[i],
			}));

			function getFiltered() {
				const q = searchQuery.toLowerCase();
				let filtered = cardData;
				if (q) {
					filtered = cardData.filter(
						({ data }) =>
							data.title.toLowerCase().includes(q) ||
							data.description.toLowerCase().includes(q) ||
							data.categories.some((c) => c.toLowerCase().includes(q)),
					);
				}
				// Sort
				filtered.sort((a, b) => {
					const da = new Date(a.data.date).getTime();
					const db = new Date(b.data.date).getTime();
					if (currentSort === 'popular') return b.data.visitors - a.data.visitors || db - da;
					return currentSort === 'newest' ? db - da : da - db;
				});
				return filtered;
			}

			function render() {
				const filtered = getFiltered();
				const total = filtered.length;
				const showing = Math.min(visibleCount, total);

				// Hide all cards first
				cardData.forEach(({ el }) => {
					el.style.display = 'none';
					el.style.order = '';
				});

				// Show filtered cards up to visibleCount
				filtered.forEach(({ el }, i) => {
					el.style.display = i < showing ? '' : 'none';
					el.style.order = String(i);
				});

				// Results count
				if (searchQuery) {
					resultsCount.textContent = `${total} post${total !== 1 ? 's' : ''} found`;
					resultsCount.classList.remove('hidden');
				} else {
					resultsCount.classList.add('hidden');
				}

				// No results
				noResults.classList.toggle('hidden', total > 0);
				grid.classList.toggle('hidden', total === 0);

				// Hide sentinel when all posts visible or searching
				sentinel.classList.toggle('hidden', showing >= total || searchQuery !== '');
			}

			// Search
			let searchTimeout;
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value;
				visibleCount = POSTS_PER_PAGE;
				render();
				// Debounced tracking - only track after user stops typing
				clearTimeout(searchTimeout);
				if (searchQuery.trim()) {
					searchTimeout = setTimeout(() => {
						if (typeof window.plausible === 'function') {
							window.plausible('Blog Search', { props: { query: searchQuery.trim() } });
						}
					}, 1000);
				}
			});

			// Sort
			sortBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					currentSort = btn.dataset.sort;
					if (typeof window.plausible === 'function') {
						window.plausible('Blog Sort', { props: { sort: currentSort } });
					}
					sortBtns.forEach((b) => {
						const isActive = b === btn;
						b.className = isActive
							? 'sort-btn cursor-pointer text-coral underline underline-offset-4'
							: 'sort-btn cursor-pointer text-gray-300 hover:text-coral';
						b.setAttribute('aria-pressed', String(isActive));
					});
					render();
				});
			});

			// Infinite scroll
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						visibleCount += POSTS_PER_PAGE;
						render();
					}
				},
				{ rootMargin: '200px' },
			);
			observer.observe(sentinel);

			// Initial render - hide posts beyond first page
			render();
		})();
	</script>
</BaseLayout>
