---
import KeepExploring from '../../components/KeepExploring.astro';
import HoverBox from '../../components/HoverBox.astro';
import Scribble from '../../components/Scribble.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE } from '../../consts';
import { HERO_LEAD, PAGE_CONTAINER, formatDate } from '../../utils/ui';
import { cardHalftone } from '../../utils/halftone';
import { CHALK, MARKS } from '../../data/scribbles';
import PosterHero from '../../components/PosterHero.astro';
import PostFinder from '../../components/PostFinder.astro';
import { getCategoryCounts } from '../../utils/categories';
import { getFeedPosts } from '../../utils/posts';

function getReadingTime(body: string): number {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 250));
}

const allPosts = await getFeedPosts();

const featuredSlug = 'homelab-two-years-later';
const featuredPost = allPosts.find((p) => p.data.slug === featuredSlug);
const posts = allPosts.filter((p) => p.data.slug !== featuredSlug);

// Blog posts only: newsletter posts have no category page
const blogPosts = allPosts.filter((p) => !p.isNewsletter);
const categories = getCategoryCounts(blogPosts);

const firstPostYear = Math.min(...allPosts.map((p) => p.data.date.getUTCFullYear()));
const featuredReadingTime = featuredPost ? getReadingTime(featuredPost.body || '') : 0;
---

<BaseLayout
	title="Blog | Joe Karlsson"
	description="Posts about databases, developer tools, smart homes, and the things I build."
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- Mirrors the homepage hero: the featured post's picture (its title on a dark
		strip) beside a pink ticker of the topics and a dark panel whose BLOG fills it.
		Only the picture is clipped; the marks sit in front. On phones the picture is a
		16:9 banner with the title under it, so it doesn't fill the screen. -->
		<PosterHero title="Blog" wordRatio={1.86} tickerItems={categories.map(({ name }) => name)}>
			{featuredPost && (
				<a
					slot="media"
					href={featuredPost.href}
					class="ring-host group relative z-10 block no-underline"
				>
					<span class="block overflow-hidden rounded-xl bg-ink md:absolute md:inset-0">
						<img
							src={featuredPost.data.heroImage || DEFAULT_HERO_IMAGE}
							alt=""
							aria-hidden="true"
							data-halftone={cardHalftone(featuredPost.data.heroImage || DEFAULT_HERO_IMAGE)}
							width="1120"
							height="630"
							sizes="(min-width: 768px) 50vw, 100vw"
							class="block aspect-video w-full object-cover md:aspect-auto md:size-full"
							loading="eager"
						/>
						<span class="block bg-ink px-6 pt-4 pb-5 md:absolute md:inset-x-0 md:bottom-0 md:z-10">
							<span class="mb-1.5 block text-sm text-muted">
								<span class="font-semibold text-pink">Featured</span>
								{' · '}
								{formatDate(featuredPost.data.date)}
								{featuredReadingTime > 0 && <> · {featuredReadingTime} min read</>}
							</span>
							<span class="block font-display text-[clamp(26px,2.6vw,40px)] leading-[0.95] text-paper uppercase group-hover:text-pink">
								{featuredPost.data.title}
							</span>
						</span>
					</span>
					<Scribble
						{...MARKS.burst}
						color={CHALK}
						strokeWidth={6}
						duration="8s"
						delay="1.6s"
						class="-top-[7%] -left-[7%] z-10 size-[22%]"
					/>
					<Scribble
						{...MARKS.lines}
						color={CHALK}
						duration="11s"
						delay="1s"
						class="-bottom-[7%] -left-[6%] z-10 h-[12%] w-[70%]"
					/>
					<HoverBox featured />
				</a>
			)}
			<!-- Phones skip the count: the title panel is just BLOG -->
			<p class={`${HERO_LEAD} max-md:hidden`}>
				{allPosts.length} posts since {firstPostYear}
			</p>
		</PosterHero>

		<PostFinder
			posts={posts}
			filter={{
				label: 'Blog categories',
				items: categories,
				basePath: '/blog/category/',
				allLink: true,
			}}
		/>
		<KeepExploring heading="Pick one for me" from="/blog/" pickRandom />
	</div>
</BaseLayout>
