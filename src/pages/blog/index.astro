---
import BlogCard from '../../components/BlogCard.astro';
import Scribble from '../../components/Scribble.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE } from '../../consts';
import { CHALK, MARKS } from '../../data/scribbles';
import BlogFilterNav from '../../components/BlogFilterNav.astro';
import { getCategoryCounts } from '../../utils/categories';
import { getFeedPosts } from '../../utils/posts';
import popularPosts from '../../data/popular-posts.json';

function getReadingTime(body: string): number {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 250));
}

const allPosts = await getFeedPosts();

const featuredSlug = 'homelab-two-years-later';
const featuredPost = allPosts.find((p) => p.data.slug === featuredSlug);
const posts = allPosts.filter((p) => p.data.slug !== featuredSlug);

// Blog posts only: newsletter posts have no category page
const blogPosts = allPosts.filter((p) => !p.isNewsletter);
const categories = getCategoryCounts(blogPosts);

const POSTS_PER_PAGE = 12;

const visitorsByPath = popularPosts.visitorsByPath as Record<string, number>;
const TOP_POSTS = 10;
const topPostHrefs = new Set(
	posts
		.filter((p) => visitorsByPath[p.href])
		.sort((a, b) => visitorsByPath[b.href] - visitorsByPath[a.href])
		.slice(0, TOP_POSTS)
		.map((p) => p.href),
);

// Serialize post data for client-side search/sort/pagination
const postsData = posts.map((p) => ({
	title: p.data.title,
	description: p.data.description,
	slug: p.data.slug,
	date: p.data.date.toISOString(),
	categories: p.data.categories || [],
	readingTime: getReadingTime(p.body || ''),
	visitors: visitorsByPath[p.href] || 0,
}));

// The sort switch; the inline script swaps these as the choice changes
const SORT_ACTIVE = 'sort-btn cursor-pointer rounded-md bg-pink px-3 py-1.5 font-semibold text-ink';
const SORT_INACTIVE = 'sort-btn cursor-pointer rounded-md px-3 py-1.5 text-paper hover:text-pink';

const featuredReadingTime = featuredPost ? getReadingTime(featuredPost.body || '') : 0;
---

<BaseLayout
	title="Blog | Joe Karlsson"
	description="Posts about databases, developer tools, smart homes, and the things I build."
	schemaType="CollectionPage"
>
	<div class="relative px-4 pt-10 pb-10 sm:px-7">
		<!-- Built like the homepage and About heroes: a big picture (the featured post)
		beside a pink panel with the page name filling it and a dark panel for the post.
		Only the picture is clipped; the mark sits in front of it. -->
		<header class="relative mb-6 grid gap-4 md:grid-cols-2">
			{featuredPost && (
				<a
					href={featuredPost.href}
					tabindex="-1"
					aria-hidden="true"
					class="relative z-10 block aspect-video md:aspect-auto"
				>
					<img
						src={featuredPost.data.heroImage || DEFAULT_HERO_IMAGE}
						alt=""
						aria-hidden="true"
						data-halftone="flat"
						width="1120"
						height="630"
						class="block size-full rounded-xl object-cover"
						loading="eager"
					/>
					<Scribble
						{...MARKS.box}
						color={CHALK}
						duration="10s"
						delay="0.8s"
						class="-inset-[5%] z-10 h-[110%] w-[110%]"
					/>
				</a>
			)}
			<div class="grid min-w-0 grid-rows-[auto_1fr] gap-4">
				<div class="rounded-xl bg-pink px-7 pt-6 pb-5 text-ink">
					<div class="@container">
						<h1 class="font-display text-[min(calc(100cqw/2.1),220px)] leading-[0.84] font-normal whitespace-nowrap text-ink uppercase">
							Blog
						</h1>
					</div>
					<p class="mt-3 font-semibold">{allPosts.length} posts</p>
				</div>
				{featuredPost && (
					<a
						href={featuredPost.href}
						class="group flex flex-col justify-end gap-3 rounded-xl bg-surface-1 p-7 no-underline"
					>
						<span class="text-sm text-muted">
							<span class="font-semibold text-pink">Featured</span>
							{' · '}
							{featuredPost.data.date.toLocaleDateString('en-us', {
								timeZone: 'UTC',
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
							{featuredReadingTime > 0 && <> · {featuredReadingTime} min read</>}
							{featuredPost.data.categories.length > 0 && (
								<> · {featuredPost.data.categories.join(' · ')}</>
							)}
							{featuredPost.data.writtenFor && <> · Written for {featuredPost.data.writtenFor}</>}
						</span>
						<h2 class="font-display text-[clamp(34px,3.6vw,60px)] leading-[0.95] font-normal text-paper uppercase group-hover:text-pink">
							{featuredPost.data.title}
						</h2>
						{featuredPost.data.description && (
							<span class="line-clamp-3 block max-w-[52ch] text-muted">
								{featuredPost.data.description}
							</span>
						)}
					</a>
				)}
			</div>
		</header>

		<!-- One bar for finding posts: search and sort on top, then the categories,
		which go to their own pages -->
		<div class="mb-8 rounded-xl bg-surface-1 p-5 sm:p-7">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center">
				<div class="relative flex-1">
					<label for="blog-search" class="sr-only">
						Search posts
					</label>
					<input
						type="search"
						id="blog-search"
						placeholder="Search posts"
						class="w-full rounded-md border border-surface-4 bg-ink py-3 pr-4 pl-11 text-lg text-paper placeholder-muted outline-hidden transition-colors focus:border-pink"
					/>
					<svg
						class="absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-muted"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
						></path>
					</svg>
				</div>
				<div
					class="flex items-center gap-1 self-start rounded-md border border-surface-4 bg-ink p-1 text-[15px] sm:self-auto"
					role="group"
					aria-label="Sort posts"
				>
					<button id="sort-newest" class={SORT_ACTIVE} aria-pressed="true" data-sort="newest">
						Newest
					</button>
					<button id="sort-oldest" class={SORT_INACTIVE} aria-pressed="false" data-sort="oldest">
						Oldest
					</button>
					<button
						id="sort-popular"
						class={SORT_INACTIVE}
						aria-pressed="false"
						data-sort="popular"
						title={`Most visitors over the last 12 months, as of ${popularPosts.updatedAt}`}
					>
						Popular
					</button>
				</div>
			</div>
			<BlogFilterNav
				label="Blog categories"
				items={categories}
				basePath="/blog/category/"
				allLink
				class="mt-5 border-t border-surface-4 pt-5"
			/>
		</div>

		<!-- Post count display (updates with search) -->
		<p id="results-count" class="mb-4 text-sm text-muted" aria-live="polite"></p>

		<!-- No results message -->
		<div id="no-results" class="hidden py-12">
			<p class="font-display text-[clamp(32px,4vw,56px)] leading-none text-paper uppercase">
				No posts found matching your search.
			</p>
		</div>

		<ul id="posts-grid" class="flex flex-col">
			{posts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					categories={post.data.categories}
					writtenFor={post.data.writtenFor}
					readingTime={getReadingTime(post.body || '')}
					href={post.href}
					popular={topPostHrefs.has(post.href)}
				/>
			))}
		</ul>

		<!-- Infinite scroll sentinel -->
		<div id="load-more-sentinel" class="mt-8 h-4"></div>
	</div>

	<script is:inline define:vars={{ postsData, POSTS_PER_PAGE, SORT_ACTIVE, SORT_INACTIVE }}>
		(function () {
			const grid = document.getElementById('posts-grid');
			const cards = Array.from(grid.children);
			const searchInput = document.getElementById('blog-search');
			const sentinel = document.getElementById('load-more-sentinel');
			const noResults = document.getElementById('no-results');
			const resultsCount = document.getElementById('results-count');
			const sortBtns = document.querySelectorAll('.sort-btn');

			let currentSort = 'newest';
			let searchQuery = '';
			let visibleCount = POSTS_PER_PAGE;

			// Map cards to their data
			const cardData = cards.map((card, i) => ({
				el: card,
				data: postsData[i],
			}));

			function getFiltered() {
				const q = searchQuery.toLowerCase();
				let filtered = cardData;
				if (q) {
					filtered = cardData.filter(
						({ data }) =>
							data.title.toLowerCase().includes(q) ||
							data.description.toLowerCase().includes(q) ||
							data.categories.some((c) => c.toLowerCase().includes(q)),
					);
				}
				// Sort
				filtered.sort((a, b) => {
					const da = new Date(a.data.date).getTime();
					const db = new Date(b.data.date).getTime();
					if (currentSort === 'popular') return b.data.visitors - a.data.visitors || db - da;
					return currentSort === 'newest' ? db - da : da - db;
				});
				return filtered;
			}

			function render() {
				const filtered = getFiltered();
				const total = filtered.length;
				const showing = Math.min(visibleCount, total);

				// Hide all cards first
				cardData.forEach(({ el }) => {
					el.style.display = 'none';
					el.style.order = '';
				});

				// Show filtered cards up to visibleCount
				filtered.forEach(({ el }, i) => {
					el.style.display = i < showing ? '' : 'none';
					el.style.order = String(i);
				});

				// Results count
				if (searchQuery) {
					resultsCount.textContent = `${total} post${total !== 1 ? 's' : ''} found`;
					resultsCount.classList.remove('hidden');
				} else {
					resultsCount.classList.add('hidden');
				}

				// No results
				noResults.classList.toggle('hidden', total > 0);
				grid.classList.toggle('hidden', total === 0);

				// Hide sentinel when all posts visible or searching
				sentinel.classList.toggle('hidden', showing >= total || searchQuery !== '');
			}

			// Search
			let searchTimeout;
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value;
				visibleCount = POSTS_PER_PAGE;
				render();
				// Debounced tracking - only track after user stops typing
				clearTimeout(searchTimeout);
				if (searchQuery.trim()) {
					searchTimeout = setTimeout(() => {
						if (typeof window.plausible === 'function') {
							window.plausible('Blog Search', { props: { query: searchQuery.trim() } });
						}
					}, 1000);
				}
			});

			// Sort
			sortBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					currentSort = btn.dataset.sort;
					if (typeof window.plausible === 'function') {
						window.plausible('Blog Sort', { props: { sort: currentSort } });
					}
					sortBtns.forEach((b) => {
						const isActive = b === btn;
						b.className = isActive ? SORT_ACTIVE : SORT_INACTIVE;
						b.setAttribute('aria-pressed', String(isActive));
					});
					render();
				});
			});

			// Infinite scroll
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						visibleCount += POSTS_PER_PAGE;
						render();
					}
				},
				{ rootMargin: '200px' },
			);
			observer.observe(sentinel);

			// Initial render - hide posts beyond first page
			render();
		})();
	</script>
</BaseLayout>
