---
import { getCollection } from 'astro:content';
import BackLink from '../../../components/BackLink.astro';
import PostFinder from '../../../components/PostFinder.astro';
import Scribble from '../../../components/Scribble.astro';
import { MARKS } from '../../../data/scribbles';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categorySlug, getCategoryCounts } from '../../../utils/categories';
import { getFeedPosts } from '../../../utils/posts';
import { MORE_LINK } from '../../../utils/ui';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Collect all unique categories
	const categoryMap = new Map<string, typeof posts>();
	for (const post of posts) {
		for (const cat of post.data.categories) {
			const slug = categorySlug(cat);
			if (!categoryMap.has(slug)) categoryMap.set(slug, []);
			categoryMap.get(slug)!.push(post);
		}
	}

	return [...categoryMap.entries()].map(([slug, catPosts]) => ({
		params: { category: slug },
		props: {
			category: catPosts[0].data.categories.find((c: string) => categorySlug(c) === slug)!,
			posts: catPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;

// Get all categories for the filter bar
const allBlogPosts = await getCollection('blog');
const categories = getCategoryCounts(allBlogPosts);
const feedPosts = await getFeedPosts();
// Same count as the blog index header, which also lists newsletter posts
const allPostCount = feedPosts.length;
const currentSlug = categorySlug(category);
const categoryPosts = feedPosts.filter(
	(p) => !p.isNewsletter && p.data.categories.includes(category),
);
---

<BaseLayout
	title={`${category} | Blog | Joe Karlsson`}
	description={`Browse ${posts.length} posts about ${category.toLowerCase()} by Joe Karlsson - developer marketing engineer.`}
	schemaType="CollectionPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-7">
		<header class="relative mb-10">
			<BackLink href="/blog/" label="Blog" />
			<h1 class="relative inline-block font-display text-[clamp(56px,11vw,170px)] leading-[0.88] font-normal text-paper uppercase">
				{category}
				<Scribble
					{...MARKS.underline}
					color="#ff4fd8"
					strokeWidth={10}
					duration="8s"
					delay="0.4s"
					class="-bottom-[0.12em] left-0 h-[0.18em] w-full"
				/>
			</h1>
			<p class="mt-6 text-muted">{posts.length} posts</p>
		</header>

		<PostFinder
			posts={categoryPosts}
			filter={{
				label: 'Blog categories',
				items: categories,
				basePath: '/blog/category/',
				currentSlug,
				allLink: true,
			}}
		/>
		<p class="mt-[18px]">
			<a href="/blog/" class={MORE_LINK}>
				All {allPostCount} posts →
			</a>
		</p>
	</div>
</BaseLayout>
