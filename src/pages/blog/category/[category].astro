---
import { getCollection } from 'astro:content';
import BlogCard from '../../../components/BlogCard.astro';
import BlogFilterNav from '../../../components/BlogFilterNav.astro';
import Scribble from '../../../components/Scribble.astro';
import { MARKS } from '../../../data/scribbles';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categorySlug, getCategoryCounts } from '../../../utils/categories';
import { getFeedPosts } from '../../../utils/posts';

function getReadingTime(body: string): number {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 250));
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Collect all unique categories
	const categoryMap = new Map<string, typeof posts>();
	for (const post of posts) {
		for (const cat of post.data.categories) {
			const slug = categorySlug(cat);
			if (!categoryMap.has(slug)) categoryMap.set(slug, []);
			categoryMap.get(slug)!.push(post);
		}
	}

	return [...categoryMap.entries()].map(([slug, catPosts]) => ({
		params: { category: slug },
		props: {
			category: catPosts[0].data.categories.find((c: string) => categorySlug(c) === slug)!,
			posts: catPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;

// Get all categories for the filter bar
const allBlogPosts = await getCollection('blog');
const categories = getCategoryCounts(allBlogPosts);
// Same count as the blog index header, which also lists newsletter posts
const allPostCount = (await getFeedPosts()).length;
const currentSlug = categorySlug(category);
---

<BaseLayout
	title={`${category} | Blog | Joe Karlsson`}
	description={`Browse ${posts.length} posts about ${category.toLowerCase()} by Joe Karlsson - developer marketing engineer.`}
	schemaType="CollectionPage"
>
	<div class="relative px-4 pt-10 pb-10 sm:px-7">
		<header class="relative mb-10">
			<p class="mb-3 text-[15px]">
				<a href="/blog/" class="text-muted no-underline hover:text-pink">
					← Blog
				</a>
			</p>
			<h1 class="relative inline-block font-display text-[clamp(56px,11vw,170px)] leading-[0.88] font-normal text-paper uppercase">
				{category}
				<Scribble
					{...MARKS.underline}
					color="#ff4fd8"
					strokeWidth={10}
					duration="8s"
					delay="0.4s"
					class="-bottom-[0.12em] left-0 h-[0.18em] w-full"
				/>
			</h1>
			<p class="mt-6 text-muted">{posts.length} posts</p>
		</header>

		<BlogFilterNav
			label="Blog categories"
			items={categories}
			basePath="/blog/category/"
			currentSlug={currentSlug}
			allLink
			class="mb-12"
		/>

		<ul class="relative">
			{posts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					categories={post.data.categories}
					writtenFor={post.data.writtenFor}
					readingTime={getReadingTime(post.body || '')}
				/>
			))}
		</ul>
		<p class="mt-[18px]">
			<a href="/blog/" class="font-semibold text-pink no-underline hover:text-white">
				All {allPostCount} posts →
			</a>
		</p>
	</div>
</BaseLayout>
