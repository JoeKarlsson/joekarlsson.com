---
import { getCollection } from 'astro:content';
import BlogCard from '../../../components/BlogCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

function getReadingTime(body: string): number {
	const words = body.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 250));
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Collect all unique categories
	const categoryMap = new Map<string, typeof posts>();
	for (const post of posts) {
		for (const cat of post.data.categories) {
			const slug = cat.toLowerCase().replace(/\s+/g, '-');
			if (!categoryMap.has(slug)) categoryMap.set(slug, []);
			categoryMap.get(slug)!.push(post);
		}
	}

	return [...categoryMap.entries()].map(([slug, catPosts]) => ({
		params: { category: slug },
		props: {
			category: catPosts[0].data.categories.find(
				(c: string) => c.toLowerCase().replace(/\s+/g, '-') === slug,
			)!,
			posts: catPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;

// Get all categories for the filter bar
const allPosts = await getCollection('blog');
const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
	for (const cat of post.data.categories) {
		categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
	}
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const currentSlug = category.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout
	title={`${category} | Blog | Joe Karlsson`}
	description={`Browse ${posts.length} posts about ${category.toLowerCase()} by Joe Karlsson - developer marketing engineer.`}
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-5xl px-4 py-8">
		<div class="mb-8">
			<h1 class="text-3xl font-bold text-white md:text-4xl">{category}</h1>
			<p class="mt-2 text-gray-400">{posts.length} posts</p>
		</div>

		<nav class="mb-10 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Blog categories">
			<a href="/blog/" class="text-gray-300 no-underline hover:text-coral">
				All
			</a>
			{categories.map(([cat, count]) => {
				const slug = cat.toLowerCase().replace(/\s+/g, '-');
				const isActive = slug === currentSlug;
				return (
					<a
						href={`/blog/category/${slug}/`}
						class={
							isActive
								? 'text-coral underline underline-offset-4'
								: 'text-gray-300 no-underline hover:text-coral'
						}
						aria-current={isActive ? 'page' : undefined}
					>
						{cat} <span class="text-gray-500">{count}</span>
					</a>
				);
			})}
		</nav>

		<div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					categories={post.data.categories}
					readingTime={getReadingTime(post.body || '')}
				/>
			))}
		</div>
	</div>
</BaseLayout>
