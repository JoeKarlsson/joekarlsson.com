---
import { getCollection } from 'astro:content';
import BackLink from '../components/BackLink.astro';
import HoverBox from '../components/HoverBox.astro';
import IndexRow from '../components/IndexRow.astro';
import KeepExploring from '../components/KeepExploring.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHero from '../components/PosterHero.astro';
import Scribble from '../components/Scribble.astro';
import TalkCard from '../components/TalkCard.astro';
import TalkSeriesCard from '../components/TalkSeriesCard.astro';
import { CHALK, MARKS } from '../data/scribbles';
import { TALK_ERAS, TALK_GROUPS, countByGroup, foldSeries, groupOf, talks } from '../data/talks';
import {
	FILTER_ACTIVE,
	FILTER_INACTIVE,
	FILTER_ROW,
	HERO_LEAD,
	META,
	PAGE_CONTAINER,
	SECTION_HEADING,
	TEXT_LINK,
} from '../utils/ui';

const eras = TALK_ERAS.filter((era) => era.talks.length > 0);

// The totals: how much, all in, without a per-year comparison
const firstYear = Math.min(...talks.map((t) => Number(t.date.slice(0, 4))));
const GROUP_NAMES = ['Talks', 'Podcasts', 'Livestreams', 'Demos'];
const totals = [
	...TALK_GROUPS.map((group, g) => ({
		n: talks.filter((t) => groupOf(t) === group).length,
		label: GROUP_NAMES[g],
	})),
	{ n: eras.length, label: 'Companies' },
	{ n: firstYear, label: 'Since' },
];

// Every talk I wrote up in full, shown first: each has its own /talks/ page, except the IoT
// write-up, which is still a blog post
const FEATURED = [
	'/talks/the-art-of-computer-science/',
	'/talks/mongodb-schema-design-best-practices/',
	'/talks/bechdel-io-how-we-used-javascript-to-help-make-film-more-inclusive/',
	'/talks/from-sql-to-nosql-a-gentle-introduction-for-devs/',
	'/blog/an-introduction-to-iot-internet-of-toilets/',
];
const posts = [
	...(await getCollection('talks')).map((p) => ({ ...p.data, href: `/talks/${p.data.slug}/` })),
	...(await getCollection('blog')).map((p) => ({ ...p.data, href: `/blog/${p.data.slug}/` })),
];
const featured = FEATURED.map((href) => {
	const post = posts.find((p) => p.href === href);
	if (!post?.heroImage) throw new Error(`/talks/ features ${href}, which has no post or heroImage`);
	return post;
});

const FILTERS = [
	{ value: 'all', label: 'All' },
	{ value: 'talk', label: 'Talks' },
	{ value: 'podcast', label: 'Podcasts' },
	{ value: 'livestream', label: 'Livestreams' },
	{ value: 'demo', label: 'Demos' },
	{ value: 'video', label: 'Has video' },
];
---

<BaseLayout
	title="Talks | Joe Karlsson"
	description="Every conference talk, podcast, livestream and demo video Joe Karlsson has done, with recordings, sorted by the job he had at the time."
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- Clear of the crayon burst that sticks up off the hero picture (phones skip the picture) -->
		<div class="mb-1 md:mb-10">
			<BackLink href="/about/" label="About" />
		</div>
		<PosterHero
			decorativeMedia
			title="Talks"
			wordRatio={2.2}
			tickerItems={eras.map((era) => era.years)}
		>
			<div slot="media" class="relative z-10 aspect-video md:aspect-auto">
				<!-- Four talks, oldest first: Web Rebels 2018 on stage, TEDxYouth 2021, the 8 Bits show
				2021 and CData's Developer View 2026 (media-sources/talks-montage.sh builds it) -->
				<video
					src="/images/talks/joe-talks.mp4"
					poster="/images/talks/joe-talks-poster.webp"
					data-halftone="flat"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Montage of Joe Karlsson giving talks: on stage at Web Rebels in 2018, his TEDx talk, the 8 Bits show, and CData's Developer View in 2026"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[9%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class={HERO_LEAD}>
				Every talk, podcast, livestream and demo video I've done, recorded or not, sorted by the job
				I had at the time. <span class="font-semibold text-pink">100K+ followers</span> across my
				channels. More of my recordings are on my{' '}
				<a
					href="https://www.youtube.com/joekarlsson"
					target="_blank"
					rel="noopener noreferrer"
					class={TEXT_LINK}
				>
					YouTube channel
				</a>
				.
			</p>
		</PosterHero>

		<!-- The totals, all in: big numbers, no per-year comparison -->
		<dl class="mb-12 grid grid-cols-3 gap-x-6 gap-y-6 md:mb-16 md:grid-cols-6">
			{totals.map((t) => (
				<div class="border-t border-surface-4 pt-3">
					<dt class={META}>{t.label}</dt>
					<dd class="font-display text-[clamp(48px,7vw,104px)] leading-none text-pink">{t.n}</dd>
				</div>
			))}
		</dl>

		<section id="featured" class="relative mb-12 scroll-mt-24 md:mb-16">
			<h2 class={SECTION_HEADING}>
				Talk pages
				<Scribble
					{...MARKS.underline}
					color={CHALK}
					duration="8s"
					class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
				/>
			</h2>
			<div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
				{featured.map((post, i) => (
					<a href={post.href} class="ring-host group block no-underline">
						<span class="relative block">
							<img
								src={post.heroImage}
								alt={post.heroAlt ?? ''}
								width="1120"
								height="630"
								class="block aspect-video w-full rounded-lg object-cover"
								loading="lazy"
								decoding="async"
							/>
							<HoverBox index={i} />
						</span>
						<span class="mt-4 block font-display text-[clamp(28px,2.4vw,36px)] leading-none text-paper uppercase group-hover:text-pink">
							{post.title}
						</span>
						<span class="mt-2 block text-paper">{post.description}</span>
						<span class="mt-2 block font-semibold text-pink group-hover:text-paper">
							Watch + read the talk →
						</span>
					</a>
				))}
			</div>
		</section>

		<!-- A quick index of the eras below, two columns like /work/'s -->
		<nav aria-label="Eras" class="mb-12 grid gap-x-10 md:mb-16 md:grid-cols-2">
			{eras.map((era, i) => (
				<IndexRow
					href={`#${era.slug}`}
					label={era.years}
					meta={`${era.label} · ${countByGroup(era.talks)}`}
					index={i}
					compact
					class="talk-era-link"
				/>
			))}
		</nav>

		<!-- Hidden until talk-filter's script runs: without JavaScript everything shows -->
		<div class={`mb-10 ${FILTER_ROW}`} role="group" aria-label="Show" data-talk-filters hidden>
			{FILTERS.map((filter, i) => (
				<button
					type="button"
					class={i === 0 ? FILTER_ACTIVE : FILTER_INACTIVE}
					aria-pressed={i === 0 ? 'true' : 'false'}
					data-talk-filter={filter.value}
				>
					{filter.label}
				</button>
			))}
		</div>

		<!-- Phones open on the two newest eras; older ones fold behind a + (phone-collapse.ts) -->
		{eras.map((era, i) => (
			<section
				id={era.slug}
				class="talk-era relative mb-12 scroll-mt-24 md:mb-16 max-md:data-collapsed:mb-6"
				data-phone-collapse={i < 2 ? 'open' : ''}
			>
				<h2 data-collapse-heading class={`${SECTION_HEADING} max-md:w-full`}>
					{era.years}
					<Scribble
						{...MARKS.rays}
						color={i % 2 ? '#ff4fd8' : CHALK}
						duration="8s"
						delay={`${i * 0.4}s`}
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<p class={`mb-8 ${HERO_LEAD}`}>
					{era.label} <span class="text-muted">· {countByGroup(era.talks)}</span>
				</p>
				<div
					data-collapse-body
					class="grid gap-x-8 gap-y-6 md:grid-cols-2 md:gap-y-14 lg:grid-cols-3"
				>
					{foldSeries(era.talks).map((item, j) =>
						'talk' in item ? (
							<TalkCard talk={item.talk} index={j} />
						) : (
							<TalkSeriesCard title={item.series} runs={item.runs} />
						),
					)}
				</div>
			</section>
		))}

		<KeepExploring
			heading="Book me"
			from="/talks/"
			door={{
				href: '/contact/',
				label: 'Get in touch',
				blurb:
					'If something here is close to what your event needs, these are the fastest ways to reach me.',
			}}
		/>
	</div>
</BaseLayout>

<script>
	import { initPhoneCollapse } from '../scripts/phone-collapse';
	import { initTalkFilters } from '../scripts/talk-filters';
	initPhoneCollapse();
	initTalkFilters();
</script>
