---
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project, type ProjectPage } from '../../data/projects';

export function getStaticPaths() {
	return projects
		.filter((p): p is Project & { page: ProjectPage } => Boolean(p.page))
		.map((project) => ({ params: { slug: project.page.slug }, props: { project } }));
}

interface Props {
	project: Project & { page: ProjectPage };
}

const { project } = Astro.props;
const { page } = project;

// Page copy is plain text with `backticks` for inline code - escape first so
// nothing in projects.ts can inject markup.
const inline = (text: string) =>
	text
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/`([^`]+)`/g, '<code>$1</code>');
---

<BaseLayout
	title={`${project.title} | Joe Karlsson`}
	description={`${project.title}: ${page.tagline}`}
	image={project.image}
	schemaType="SoftwareSourceCode"
>
	<div class="mx-auto max-w-4xl px-4 py-8">
		<nav class="mb-4 font-mono text-sm text-gray-400" aria-label="Breadcrumb">
			<a href="/work/" class="text-gray-400 no-underline hover:text-coral">projects</a>
			<span class="mx-1">/</span>
			<span>{page.slug}</span>
		</nav>

		<p class="mb-2 font-mono text-sm text-coral" aria-hidden="true">
			~$ cat projects/{page.slug}.md
		</p>
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">{project.title}</h1>
		<p class="mb-4 text-lg text-gray-300">{page.tagline}</p>

		<div class="mb-6 flex flex-wrap gap-1">
			{
				project.tech.map((t) => (
					<span class="rounded-full bg-surface-3 px-2 py-0.5 font-mono text-xs text-gray-400">
						{t}
					</span>
				))
			}
		</div>

		{/* controls for the same WCAG 2.2.2 reason as rehype-gif-video */}
		{
			project.video ? (
				<video
					src={project.video}
					poster={project.image}
					autoplay
					loop
					muted
					playsinline
					controls
					preload="metadata"
					role="img"
					aria-label={project.imageAlt}
					class="mb-6 aspect-video w-full rounded-lg bg-black object-cover"
				/>
			) : (
				<img
					src={project.image}
					alt={project.imageAlt}
					class="mb-6 w-full rounded-lg object-cover"
					loading="eager"
				/>
			)
		}

		<div class="mb-10 flex flex-wrap gap-3">
			{
				project.sourceUrl && (
					<a
						href={project.sourceUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="plausible-event-name=Project+Source+Click inline-block rounded-md bg-coral px-4 py-2 font-medium text-surface-0 no-underline hover:bg-teal"
					>
						View on GitHub &rarr;
					</a>
				)
			}
			{
				project.blogUrl && (
					<a
						href={project.blogUrl}
						class="inline-block rounded-md border border-surface-3 px-4 py-2 font-medium text-gray-300 no-underline hover:border-coral/50 hover:text-coral"
					>
						Read why I built it
					</a>
				)
			}
			{
				project.demoUrl && (
					<a
						href={project.demoUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block rounded-md border border-surface-3 px-4 py-2 font-medium text-gray-300 no-underline hover:border-coral/50 hover:text-coral"
					>
						Demo &rarr;
					</a>
				)
			}
		</div>

		<div class="prose prose-invert mb-10 max-w-none">
			{page.intro.map((p) => <p set:html={inline(p)} />)}
		</div>

		{
			page.steps && (
				<section class="mb-10" aria-labelledby="how-it-works">
					<h2 id="how-it-works" class="mb-4 text-lg font-bold text-white">
						<span class="font-mono text-sm text-coral" aria-hidden="true">
							~$
						</span>{' '}
						how it works
					</h2>
					<ol class="grid gap-4 sm:grid-cols-3">
						{page.steps.map((step, i) => (
							<li class="rounded-lg border border-surface-3 bg-surface-1 p-4">
								<p class="mb-1 font-mono text-xs text-coral">0{i + 1}</p>
								<h3 class="mb-2 font-semibold text-white">{step.title}</h3>
								<p class="prose prose-invert prose-sm text-gray-400" set:html={inline(step.text)} />
							</li>
						))}
					</ol>
				</section>
			)
		}

		{
			(page.install || page.example) && (
				<section class="prose prose-invert mb-10 max-w-none" aria-labelledby="try-it">
					<h2 id="try-it" class="not-prose mb-4 text-lg font-bold text-white">
						<span class="font-mono text-sm text-coral" aria-hidden="true">
							~$
						</span>{' '}
						try it
					</h2>
					{page.install && <Code code={page.install} lang="bash" theme="github-dark" />}
					{page.example && (
						<>
							<p>A bumper is just a few lines of YAML:</p>
							<Code code={page.example.code} lang={page.example.lang} theme="github-dark" />
						</>
					)}
				</section>
			)
		}

		{
			page.gallery && (
				<section class="mb-10" aria-labelledby="examples">
					<h2 id="examples" class="mb-2 text-lg font-bold text-white">
						<span class="font-mono text-sm text-coral" aria-hidden="true">
							~$
						</span>{' '}
						ls output/
					</h2>
					<p class="mb-4 text-sm text-gray-400">
						A few from Joeflix. Hover to play, or use the controls.
					</p>
					<div class="grid gap-4 sm:grid-cols-2">
						{page.gallery.map((clip) => (
							<video
								src={clip.video}
								poster={clip.poster}
								loop
								muted
								playsinline
								controls
								preload="none"
								role="img"
								aria-label={clip.alt}
								data-hover-play
								class="aspect-video w-full rounded-lg bg-black object-cover"
							/>
						))}
					</div>
				</section>
			)
		}

		<a href="/work/" class="font-mono text-sm text-gray-400 no-underline hover:text-coral">
			&larr; cd ../projects
		</a>
	</div>
</BaseLayout>

<script>
	import '../../scripts/hover-play';
</script>
