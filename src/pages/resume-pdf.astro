---
import { Font } from 'astro:assets';
import { roles, education, skills } from '../data/resume';

function formatYearRange(start: number, end: number | null): string {
	return end ? `${start} - ${end}` : `${start} - Present`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Joe Karlsson - Resume</title>
		<meta name="robots" content="noindex" />
		<Font cssVariable="--font-anton" />
		<Font cssVariable="--font-hanken-grotesk" />
		<Font cssVariable="--font-jetbrains-mono" />
		<Font cssVariable="--font-fraunces" />
		<style>
			/* The site's brand on paper: Anton headings, Hanken Grotesk text, a Fraunces
			intro, JetBrains Mono dates, and the one hot pink. Pink is only for rules and
			markers: as text on white it is too light to read at this size */
			:root {
				--page: #fff;
				--text: #111;
				--body: #333;
				--muted: #6b6b6b;
				--pink: #ff4fd8;
				--accent-text: #111;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: var(--font-hanken-grotesk);
				font-size: 9.5pt;
				line-height: 1.5;
				color: var(--text);
				background: var(--page);
			}

			/* ─── Header ─────────────────────────────────────── */
			.header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				padding-bottom: 10pt;
				margin-bottom: 12pt;
				border-bottom: 3pt solid var(--pink);
			}

			h1 {
				font-family: var(--font-anton);
				font-size: 28pt;
				font-weight: 400;
				text-transform: uppercase;
				letter-spacing: 0.5pt;
				color: var(--text);
				line-height: 1;
			}

			.subtitle {
				font-size: 11pt;
				color: var(--accent-text);
				font-weight: 600;
				margin-top: 4pt;
			}

			.contact {
				text-align: right;
				font-size: 8pt;
				color: var(--muted);
				line-height: 1.8;
			}

			.intro {
				font-family: var(--font-fraunces);
				font-size: 9.5pt;
				color: var(--body);
				line-height: 1.5;
				margin-bottom: 14pt;
			}

			/* ─── Section headers ────────────────────────────── */
			h2 {
				font-family: var(--font-anton);
				font-size: 13pt;
				font-weight: 400;
				text-transform: uppercase;
				letter-spacing: 0.5pt;
				line-height: 1.1;
				color: var(--text);
				border-bottom: 1.5pt solid var(--pink);
				padding-bottom: 3pt;
				margin-top: 12pt;
				margin-bottom: 6pt;
			}

			/* ─── Experience ─────────────────────────────────── */
			.role {
				margin-bottom: 9pt;
			}

			.role-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
			}

			.role-title {
				font-size: 10.5pt;
				font-weight: 700;
				color: var(--text);
			}

			.role-dates,
			.edu-years {
				font-family: var(--font-jetbrains-mono);
				font-size: 7.5pt;
				color: var(--muted);
				white-space: nowrap;
			}

			.role-meta {
				font-size: 8.5pt;
				color: var(--accent-text);
				font-weight: 600;
				margin-top: 0.5pt;
				margin-bottom: 2pt;
			}

			.role-location {
				color: var(--muted);
				font-weight: 400;
			}

			.role-tech {
				font-family: var(--font-jetbrains-mono);
				font-size: 6.5pt;
				color: var(--muted);
				margin-bottom: 4pt;
			}

			.role ul {
				padding-left: 10pt;
			}

			.role li {
				font-size: 8.5pt;
				color: var(--body);
				margin-bottom: 1.5pt;
				line-height: 1.4;
			}

			.role li::marker {
				color: var(--pink);
			}

			/* ─── Skills ─────────────────────────────────────── */
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 6pt 16pt;
			}

			/* The last group takes the row's empty columns, so the list stays on two pages */
			.skills-grid > :last-child {
				grid-column: span 2;
			}

			.skill-label {
				font-size: 7.5pt;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.5pt;
				color: var(--text);
				margin-bottom: 1.5pt;
			}

			.skill-items {
				font-size: 8pt;
				color: var(--body);
				line-height: 1.5;
			}

			/* ─── Education ──────────────────────────────────── */
			.edu-row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
			}

			.edu-degree {
				font-size: 10.5pt;
				font-weight: 700;
			}

			.edu-school {
				font-size: 8.5pt;
				color: var(--accent-text);
				font-weight: 600;
				margin-top: 1pt;
			}

			.edu-detail {
				font-size: 8pt;
				color: var(--muted);
				margin-top: 1pt;
			}

			/* ─── Print / page setup ─────────────────────────── */
			@page {
				size: letter;
			}
		</style>
	</head>
	<body>
		<div class="header">
			<div>
				<h1>Joe Karlsson</h1>
				<p class="subtitle">Principal Developer Marketing Engineer</p>
			</div>
			<div class="contact">
				<div>joekarlsson.com</div>
				<div>joekarlsson1@gmail.com</div>
				<div>linkedin.com/in/joekarlsson</div>
				<div>github.com/JoeKarlsson</div>
				<div>bsky: @joekarlsson.com</div>
			</div>
		</div>

		<p class="intro">
			I run developer marketing for Connect AI, CData's MCP platform that connects AI agents to live
			enterprise data. Before that I spent about 15 years writing software, teaching it, and
			explaining it: front-end tech lead at Best Buy, bootcamp instructor in Honolulu, and developer
			relations at MongoDB, SingleStore, Tinybird, and CloudQuery. So far that's 100+ talks,
			including a TEDx talk.
		</p>

		<h2>Experience</h2>
		{roles.map((role) => (
			<div class="role">
				<div class="role-header">
					<span class="role-title">{role.title}</span>
					<span class="role-dates">{formatYearRange(role.startYear, role.endYear)}</span>
				</div>
				<div class="role-meta">
					{role.company} <span class="role-location">&middot; {role.location}</span>
				</div>
				<div class="role-tech">{role.tech.join(' · ')}</div>
				<ul>
					{role.bullets.map((b) => (
						<li>{typeof b === 'string' ? b : b.text}</li>
					))}
				</ul>
			</div>
		))}

		<h2>Skills</h2>
		<div class="skills-grid">
			{skills.map((group) => (
				<div>
					<div class="skill-label">{group.category}</div>
					<div class="skill-items">{group.items.join(', ')}</div>
				</div>
			))}
		</div>

		<h2>Education</h2>
		<div class="edu-row">
			<span class="edu-degree">{education.degree}</span>
			<span class="edu-years">{education.years}</span>
		</div>
		<div class="edu-school">{education.school}</div>
		<div class="edu-detail">
			GPA: {education.gpa} &middot; Minors: {education.minors?.join(', ')}
		</div>
	</body>
</html>
