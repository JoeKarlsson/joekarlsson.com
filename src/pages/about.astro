---
import {
	GROUP_HEADING,
	ITEM_TITLE,
	MORE_LINK,
	PAGE_CONTAINER,
	PRIMARY_BUTTON,
	SECONDARY_BUTTON,
	SECTION_HEADING,
	SIDEBAR_GRID,
	TEXT_LINK,
} from '../utils/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHero from '../components/PosterHero.astro';
import KeepExploring from '../components/KeepExploring.astro';
import NowFeed from '../components/NowFeed.astro';
import HoverBox from '../components/HoverBox.astro';
import IndexRow from '../components/IndexRow.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Scribble from '../components/Scribble.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SOCIAL_LINKS } from '../consts';
import nowFeed from '../data/now-feed.json';
import { CHALK, MARKS } from '../data/scribbles';

const aboutHeadings = [
	{ slug: 'what-i-do', text: 'What I do' },
	{ slug: 'career', text: 'Career' },
	{ slug: 'how-i-got-here', text: 'How I got here' },
	{ slug: 'as-seen-on', text: 'As seen on' },
	{ slug: 'videos', text: 'Videos' },
	{ slug: 'now', text: 'Right now' },
	{ slug: 'art', text: 'Art' },
	{ slug: 'follow-me', text: 'Follow me' },
];

// What I do, building first: that's where the technical credibility comes from
const whatIDo = [
	{
		title: 'Build',
		href: '/work/',
		image: '/images/blog/why-i-use-doom-to-visualize-mcp-data/game-and-panel.webp',
		alt: 'Connect AI × DOOM running beside its live data panel',
		text: `Software and hardware side projects, from an MCP server inside DOOM to the ${nowFeed.homelab.runningContainers}-container homelab this site runs on.`,
	},
	{
		title: 'Write',
		href: '/blog/',
		image:
			'/images/blog/how-to-get-started-building-a-homelab-server-in-2024/homelab-vaporwave.webp',
		alt: 'Vaporwave style homelab server illustration',
		text: 'Hands-on posts about homelabs, Home Assistant and AI tools, plus the Works on My Machine newsletter.',
	},
	{
		title: 'Make videos',
		href: SOCIAL_LINKS.youtube,
		image: '/images/blog/the-art-of-computer-science/The-Art-of-Computer-Science.webp',
		alt: 'Title card for The Art of Computer Science',
		text: 'Tutorials, demos and a TEDx talk. I used to give a lot of conference talks, too.',
	},
	{
		title: 'Developer marketing',
		href: '/blog/running-devrel-2026/',
		image: '/images/blog/running-devrel-2026/hero.webp',
		alt: 'Hands typing on a laptop',
		text: 'Strategy for how developers find and trust a product. Right now that is the MCP platform at CData.',
	},
];

// My main accounts, in the order the contact page ranks them, then the rest there
const followMe = [
	{ label: 'LinkedIn', meta: 'Work', href: SOCIAL_LINKS.linkedin, icon: 'linkedin' },
	{ label: 'Bluesky', meta: '@joekarlsson.com', href: SOCIAL_LINKS.bluesky, icon: 'bluesky' },
	{ label: 'GitHub', meta: 'Code', href: SOCIAL_LINKS.github, icon: 'github' },
	{ label: 'YouTube', meta: 'Videos', href: SOCIAL_LINKS.youtube, icon: 'youtube' },
	{ label: 'Threads', meta: '@joekarlsson', href: SOCIAL_LINKS.threads, icon: 'threads' },
	{ label: 'More', meta: 'Everywhere else, and email', href: '/contact/', icon: 'more' },
] as const;

// The mark that spills off each card's corner, cycling so neighbors differ
const CARD_MARKS = [MARKS.check, MARKS.tally, MARKS.burst, MARKS.asterisk];

const previousCompanies = [
	{ name: 'CloudQuery', logo: '/images/logos/cloudquery.webp', url: 'https://www.cloudquery.io/' },
	{ name: 'Tinybird', logo: '/images/logos/tinybird.webp', url: 'https://www.tinybird.co/' },
	{
		name: 'SingleStore',
		logo: '/images/logos/singlestore.webp',
		url: 'https://www.singlestore.com/',
	},
	{ name: 'MongoDB', logo: '/images/logos/mongodb.webp', url: 'https://www.mongodb.com/' },
	{ name: 'Best Buy', logo: '/images/logos/bestbuy.webp', url: 'https://www.bestbuy.com/' },
	{ name: 'DevLeague', logo: '/images/logos/devleague.webp', url: 'https://devleague.com/' },
];

const career = [
	{
		role: 'Principal Developer Marketing Manager - CData',
		logo: '/images/logos/cdata.webp',
		years: '2026 - present',
		text: 'Lead developer marketing for the managed MCP platform that connects AI agents to live enterprise data. Own the developer growth engine: docs, content, SEO and AEO, and platform positioning.',
	},
	{
		role: 'Head of Developer Relations - CloudQuery (now env0)',
		logo: '/images/logos/cloudquery.webp',
		years: '2024 - 2026',
		text: 'Built and ran the full DevRel function from scratch: content, community, docs, events, and video. 4x organic traffic in 3 months; docs traffic up 302%; MQLs at 239% of target. Replicated the playbook post-acquisition at env0: +106% organic traffic in 3 weeks.',
	},
	{
		role: 'Developer Advocate - Tinybird',
		logo: '/images/logos/tinybird.webp',
		years: '2023 - 2025',
		text: 'Helped developers building real-time analytics applications. Created documentation, demos, blog posts, webinars, and workshops.',
	},
	{
		role: 'Senior Developer Advocate - SingleStore',
		logo: '/images/logos/singlestore.webp',
		years: '2021 - 2023',
		text: 'Led community conversations around scaling SQL workloads. Built demos and content for the distributed SQL database.',
	},
	{
		role: 'Senior Developer Advocate - MongoDB',
		logo: '/images/logos/mongodb.webp',
		years: '2019 - 2021',
		text: 'Built developer community, created tutorials, demos, and educational content. Subject matter expert for developer experience.',
	},
	{
		role: 'Front-end Technical Lead - Best Buy',
		logo: '/images/logos/bestbuy.webp',
		years: '2017 - 2019',
		text: 'Engineered high-performance solutions for one of the top 10 eCommerce sites in North America. Scaled production apps handling thousands of requests per second.',
	},
	{
		role: 'Full-Stack JavaScript Instructor - DevLeague',
		logo: '/images/logos/devleague.webp',
		years: '2015 - 2017',
		text: 'Taught full-stack JavaScript at one of the top 10 coding bootcamps worldwide. Created curriculum and prepared students for software engineering careers in Honolulu.',
	},
];

const featuredPodcasts = [
	{
		name: 'Hanselminutes',
		host: 'with Scott Hanselman',
		episode: 'Document Databases and Mongo',
		image: '/images/podcasts/hanselminutes.webp',
		alt: 'Hanselminutes podcast artwork',
		url: 'https://hanselminutes.com/752/document-databases-and-mongo-with-engineer-joe-karlsson',
	},
	{
		name: 'Screaming in the Cloud',
		host: 'with Corey Quinn (Last Week in AWS)',
		episode: 'When Data is Your Brand and Your Job',
		image: '/images/podcasts/screaming-cloud.webp',
		alt: 'Screaming in the Cloud podcast artwork',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		host: 'Two episodes - MongoDB & IoT',
		episode: 'JSJ 432 & JSJ 436',
		image: '/images/podcasts/javascript-jabber.webp',
		alt: 'JavaScript Jabber podcast artwork',
	},
	{
		name: 'CodeNewbie',
		host: 'Making databases fun and approachable',
		episode: 'Season 19, Episode 6',
		image: '/images/podcasts/codenewbie.webp',
		alt: 'CodeNewbie podcast artwork',
		url: 'https://dev.to/codenewbie/s19-e6-how-to-make-learning-databases-fun-and-approachable-joe-karlsson',
	},
];

const moreAppearances = [
	{
		name: '8 Bits',
		detail: 'with Chloe Condon & Brandon Minnick',
		url: 'https://8bits.tv/8-bits-with-joe-karlsson/',
	},
	{
		name: 'Community Pulse',
		detail: 'DevRel Content Channels (w/ Cassidy Williams)',
		url: 'https://www.communitypulse.io/57-devrel-content-channels/',
	},
	{
		name: 'Data on Kubernetes',
		detail: 'Building Data Intensive Applications',
		url: 'https://podcasts.apple.com/us/podcast/dok-talks-120-a-gentle-introduction-to-building/id1524821862?i=1000553416566',
	},
	{
		name: 'Coding Over Cocktails',
		detail: 'Diving deep into databases',
		url: 'https://www.lonti.com/podcast/episode-9',
	},
	{
		name: 'REACT Podcast',
		detail: 'Serverless Apps With React (Ep. 126)',
		url: 'https://open.spotify.com/episode/3gg6uix4qtAIswZV3k3FXq',
	},
];

const moreTalks = [
	{ id: 'UuNVpLIOHW8', title: 'Mapping SQL to MongoDB' },
	{ id: 'bIFrJJkUftA', title: 'Getting Started with SingleStore' },
	{ id: '6bHYDUzY9j0', title: '8-Bits with Joe Karlsson' },
];

const cropArtUrl = 'https://www.cropart.com/joek.dir/index.htm';

const cropArtPieces = [
	{
		title: 'Beware of Riot Dog',
		image: '/images/crop-art/riot-dog.webp',
		alt: 'Crop art mosaic reading Cave Canem Tumultum depicting the famous Greek riot dog Loukanikos running with a red bandana, made from white and dark seeds',
	},
	{
		title: 'Seeds of Remembrance',
		image: '/images/crop-art/seeds-of-remembrance.webp',
		alt: 'Crop art of a cat lounging against an orange sunset sky with a golden sun, made from lentils and various seeds',
	},
	{
		title: '60th Anniversary of The Sound of Music',
		image: '/images/crop-art/sound-of-music.webp',
		alt: 'Crop art depicting a scene from The Sound of Music with a figure holding a wide skirt, made from dark seeds on a black background',
	},
];
---

<BaseLayout
	title="About | Joe Karlsson"
	description="Developer Marketing Engineer leading developer growth at CData for the managed MCP platform that connects AI agents to live enterprise data. Built DevRel from scratch at CloudQuery (now env0); 15+ years at MongoDB, SingleStore, Tinybird, and Best Buy. TEDx Speaker, homelab enthusiast."
	schemaType="AboutPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- A montage that opens on Joe at his desk, then cuts to the river wave, the homelab and two homepage shots, on the left, the page's sections in the pink ticker, and who I
		am in the dark panel above ABOUT (the same top as every main page). The montage is
		4:3 at the camera's full height with Joe's eyes on the top third, so the square
		desktop column only trims the sides, never his head. Pink
		dots are drawn live (src/scripts/halftone.ts); in-view-play stops it with
		pause-motion and reduced motion. -->
		<PosterHero title="About" wordRatio={2.4} tickerItems={aboutHeadings.map(({ text }) => text)}>
			<div
				slot="media"
				class="relative z-10 aspect-[4/3] md:aspect-auto md:before:block md:before:aspect-square md:before:content-['']"
			>
				<video
					src="/images/about/joe-desk.mp4"
					poster="/images/about/joe-desk-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					role="img"
					aria-label="Montage of Joe Karlsson: talking at his desk in pink light, waving a peace sign by a river, eating ice cream, giving a thumbs up by his server rack and holding up a Kindle"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class="relative w-fit font-display text-[clamp(36px,3.6vw,56px)] leading-none text-paper uppercase">
				Joe Karlsson
				<Scribble
					{...MARKS.underline}
					color="#ff4fd8"
					strokeWidth={10}
					duration="8s"
					delay="0.3s"
					class="-bottom-[0.3em] left-0 h-[0.25em] w-full"
				/>
			</p>
			<p class="mt-4 text-lg text-paper">Developer Marketing Engineer (He/They)</p>
			<div class="mt-5 flex flex-wrap gap-3">
				<a
					href="/resume/"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=resume ${PRIMARY_BUTTON}`}
				>
					View Resume
				</a>
				<a
					href="/joe-karlsson-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=pdf-download ${SECONDARY_BUTTON}`}
				>
					Download PDF
				</a>
			</div>
		</PosterHero>

		<div class={SIDEBAR_GRID}>
			<TableOfContents headings={aboutHeadings} />
			<div>
				<div class="prose mb-12 max-w-none!">
					<p>
						I lead developer marketing at CData, for the MCP platform that connects AI agents to
						live enterprise data. I got here the long way: about 15 years of writing code, teaching
						it, and explaining databases on stage before marketing was ever in my title.
					</p>
					<p>
						Most of what I know about getting developers to care, I learned by building something
						weird and showing my work.
					</p>
				</div>

				<div class="mb-12">
					<p class="mb-3 text-sm text-muted">Previously at</p>
					<ul class="flex flex-nowrap items-center justify-between gap-x-4">
						{previousCompanies.map((company) => (
							<li>
								<a
									href={company.url}
									target="_blank"
									rel="noopener noreferrer"
									class="relative flex items-center gap-2 text-paper no-underline hover:text-pink"
								>
									<img
										src={company.logo}
										alt=""
										aria-hidden="true"
										data-halftone="flat"
										class="size-12 rounded-sm lg:size-8"
										width="48"
										height="48"
										loading="eager"
									/>
									<span class="sr-only lg:not-sr-only">{company.name}</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<h2 id="what-i-do" class={`${SECTION_HEADING} scroll-mt-24`}>
					What I do
					<Scribble
						{...MARKS.rays}
						color={'#ff4fd8'}
						duration="8s"
						delay="0.4s"
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<div class="mb-12 grid gap-8 sm:grid-cols-2">
					{whatIDo.map((area, i) => (
						<a
							href={area.href}
							class="ring-host group relative block no-underline"
							{...(area.href.startsWith('http')
								? { target: '_blank', rel: 'noopener noreferrer' }
								: {})}
						>
							<span class="relative block">
								<img
									src={area.image}
									alt={area.alt}
									data-halftone="flat"
									class="mb-3 block aspect-video w-full rounded-lg object-cover"
									width="300"
									height="169"
									loading="lazy"
								/>
								<HoverBox />
							</span>
							<Scribble
								{...CARD_MARKS[i % CARD_MARKS.length]}
								color={i % 2 ? '#ff4fd8' : CHALK}
								duration="9s"
								delay={`${i * 0.7}s`}
								class="-top-[7%] -right-[5%] z-10 size-[24%]"
							/>
							<h3 class:list={[GROUP_HEADING, 'mb-2 group-hover:text-pink']}>{area.title}</h3>
							<p class="text-paper">{area.text}</p>
						</a>
					))}
				</div>

				<h2 id="career" class={`${SECTION_HEADING} scroll-mt-24`}>
					Career
					<Scribble
						{...MARKS.underline}
						color={CHALK}
						duration="7s"
						delay="0.0s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-6">
					{career.map((job) => (
						<details class="job border-t border-surface-4 py-3">
							<summary class="cursor-pointer text-paper hover:text-pink">
								<span class="relative mr-2 inline-block size-6 align-[-0.3em]">
									<img
										src={job.logo}
										alt=""
										aria-hidden="true"
										data-halftone="flat"
										class="block size-full rounded-sm"
										width="24"
										height="24"
										loading="lazy"
									/>
								</span>
								<span class="text-lg font-semibold">{job.role}</span>{' '}
								<span class="text-sm text-muted">{job.years}</span>
							</summary>
							<p class="mt-2 mb-1 leading-relaxed text-paper">{job.text}</p>
						</details>
					))}
				</div>
				<p class="mb-12">
					<a
						href="/resume/"
						class={`plausible-event-name=About+CTA+Click plausible-event-destination=resume-banner-top ${MORE_LINK}`}
					>
						View my full resume &rarr;
					</a>{' '}
					<span class="text-muted">Impact metrics, tech stack, and PDF download.</span>
				</p>

				<h2 id="how-i-got-here" class={`${SECTION_HEADING} scroll-mt-24`}>
					How I got here
					<Scribble
						{...MARKS.underline}
						color={CHALK}
						duration="8s"
						delay="0.4s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="prose mb-12 max-w-none!">
					<p>
						I got a computer science degree and went straight into Microsoft SharePoint consulting
						during the Ballmer years. I was bad at coding, and SharePoint did not make it more fun.
						It was a dark time.
					</p>
					<p>
						I fell back in love with programming in Hawaii. I met a group of developers at the local
						coding bootcamp who had so much joy building the things they wanted to build, and I
						realized I was good at programming as long as I was making things I wanted to make. I've
						been following that ever since.
					</p>
					<p>
						These days I make weird art, I solve problems in my own life and other people's, and I
						even like the drudgery of maintaining software day in and day out. The rest of this page
						is what came out of that.
					</p>
				</div>

				<h2 id="as-seen-on" class={`${SECTION_HEADING} scroll-mt-24`}>
					As seen on
					<Scribble
						{...MARKS.double}
						color={'#ff4fd8'}
						duration="10s"
						delay="0.0s"
						class="-bottom-[0.42em] left-0 h-[0.4em] w-full"
					/>
				</h2>
				<ul class="mb-8 grid gap-6 sm:grid-cols-2">
					{featuredPodcasts.map((podcast) => (
						<li class="relative flex items-center gap-4">
							<img
								src={podcast.image}
								alt={podcast.alt}
								data-halftone="flat"
								class="h-20 w-20 shrink-0 rounded-md object-cover"
								width="80"
								height="80"
								loading="lazy"
							/>
							<div>
								<h3 class={ITEM_TITLE}>
									{podcast.url ? (
										<a
											href={podcast.url}
											target="_blank"
											rel="noopener noreferrer"
											class={TEXT_LINK}
										>
											{podcast.name}
										</a>
									) : (
										podcast.name
									)}
								</h3>
								<p class="text-sm text-muted">{podcast.host}</p>
								<p class="text-sm text-muted">{podcast.episode}</p>
							</div>
						</li>
					))}
				</ul>
				<h3 class:list={[GROUP_HEADING, 'mb-3']}>More appearances</h3>
				<ul class="mb-12 space-y-2">
					{moreAppearances.map((appearance) => (
						<li>
							<a
								href={appearance.url}
								target="_blank"
								rel="noopener noreferrer"
								class={`font-semibold ${TEXT_LINK}`}
							>
								{appearance.name}
							</a>{' '}
							<span class="text-sm text-muted">{appearance.detail}</span>
						</li>
					))}
				</ul>

				<h2 id="videos" class={`${SECTION_HEADING} scroll-mt-24`}>
					Videos
					<Scribble
						{...MARKS.underline}
						color={'#ff4fd8'}
						duration="7s"
						delay="0.6s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-12 space-y-8">
					<div>
						<h3 class="mb-3 text-lg font-semibold text-paper">
							The Art of Computer Science (TEDx)
						</h3>
						<div class="relative">
							<YouTubeFacade
								id="GiNa2jen-lg"
								title="The Art of Computer Science - TEDx Talk by Joe Karlsson"
								poster="/images/talks/tedx-art-of-computer-science.webp"
							/>
							<Scribble
								{...MARKS.box}
								color={CHALK}
								duration="10s"
								delay="0.8s"
								class="-inset-[3%] z-20 h-[106%] w-[106%]"
							/>
						</div>
					</div>
					<div class="grid gap-6 sm:grid-cols-2">
						<div>
							<h3 class="mb-3 text-lg font-semibold text-paper">
								MongoDB Schema Design Best Practices
							</h3>
							<YouTubeFacade id="QAqK-R9HUhc" title="MongoDB Schema Design Best Practices" />
						</div>
						<div>
							<h3 class="mb-3 text-lg font-semibold text-paper">
								Bringing JavaScript to the IoT Edge
							</h3>
							<YouTubeFacade id="711Sb55fzdg" title="Bringing JavaScript to the IoT Edge" />
						</div>
					</div>
					<ul class="grid gap-6 sm:grid-cols-3">
						{moreTalks.map((talk) => (
							<li>
								<a
									href={`https://www.youtube.com/watch?v=${talk.id}`}
									target="_blank"
									rel="noopener noreferrer"
									class="ring-host group relative block no-underline"
								>
									<span class="relative block">
										<img
											src={`https://img.youtube.com/vi/${talk.id}/mqdefault.jpg`}
											alt=""
											aria-hidden="true"
											crossorigin="anonymous"
											data-halftone="flat"
											class="mb-2 block aspect-video w-full rounded-md object-cover"
											loading="lazy"
										/>
										<HoverBox />
									</span>
									<span class="font-semibold text-paper group-hover:text-pink">{talk.title}</span>
								</a>
							</li>
						))}
					</ul>
					<p>
						<a
							href={SOCIAL_LINKS.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class={MORE_LINK}
						>
							See all talks on YouTube &rarr;
						</a>
					</p>
				</div>

				<h2 id="now" class={`${SECTION_HEADING} scroll-mt-24`}>
					Right now
					<Scribble
						{...MARKS.asterisk}
						color={'#ff4fd8'}
						duration="9s"
						delay="0.0s"
						class="-top-[0.15em] -right-[0.8em] size-[0.6em]"
					/>
				</h2>
				<div class="mb-12">
					<NowFeed />
				</div>

				<h2 id="art" class={`${SECTION_HEADING} scroll-mt-24`}>
					Art
					<Scribble
						{...MARKS.underline}
						color={CHALK}
						duration="10s"
						delay="0.6s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-12">
					<p class="mb-6 text-paper">
						I make art. Lately that's crop art, pictures made by gluing seeds and grains to
						cardboard. I had two pieces in the Seeds of Justice exhibit in 2025, then entered the
						Minnesota State Fair Crop Art competition for the first time.
					</p>
					<ul class="grid gap-6 sm:grid-cols-3">
						{cropArtPieces.map((piece) => (
							<li>
								<a
									href={cropArtUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="ring-host group relative block no-underline"
								>
									<span class="relative block">
										<img
											src={piece.image}
											alt={piece.alt}
											data-halftone="flat"
											class="mb-2 block aspect-4/5 w-full rounded-lg object-cover"
											width="300"
											height="375"
											loading="lazy"
										/>
										<HoverBox />
									</span>
									<span class="block font-semibold text-paper group-hover:text-pink">
										{piece.title}
									</span>
									<span class="text-sm text-muted">2025</span>
								</a>
							</li>
						))}
					</ul>
					<p class="mt-4">
						<a href={cropArtUrl} target="_blank" rel="noopener noreferrer" class={MORE_LINK}>
							See all crop art &rarr;
						</a>
					</p>
				</div>

				<h2 id="follow-me" class={`${SECTION_HEADING} scroll-mt-24`}>
					Follow me
					<Scribble
						{...MARKS.asterisk}
						color={CHALK}
						duration="8s"
						delay="0.4s"
						class="-top-[0.15em] -right-[0.8em] size-[0.6em]"
					/>
				</h2>
				<div class="mb-12 grid gap-x-10 md:grid-cols-2">
					{followMe.map(({ label, meta, href, icon }, i) => (
						<IndexRow
							href={href}
							label={label}
							meta={meta}
							index={i}
							external={href.startsWith('http')}
							compact
						>
							{icon && (
								<SocialIcon
									slot="icon"
									name={icon}
									class="mr-3 inline-block size-[0.7em] align-[-0.02em]"
								/>
							)}
						</IndexRow>
					))}
				</div>

				<KeepExploring
					heading="Read this next"
					from="/about/"
					posts={['ship-the-ugly-pot', 'devrel-as-dev-zero', 'homelab-two-years-later']}
				/>
			</div>
		</div>
	</div>
</BaseLayout>

