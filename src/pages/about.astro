		image: '/images/podcasts/screaming-cloud.webp',
		alt: 'Screaming in the Cloud podcast artwork',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		host: 'Two episodes - MongoDB & IoT',
		episode: 'JSJ 432 & JSJ 436',
