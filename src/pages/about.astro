---
import BaseLayout from '../layouts/BaseLayout.astro';
import RightNow from '../components/RightNow.astro';
import NowFeed from '../components/NowFeed.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SOCIAL_LINKS } from '../consts';
import nowFeed from '../data/now-feed.json';

const aboutHeadings = [
	{ slug: 'career', text: 'Career' },
	{ slug: 'specializations', text: 'What I work on' },
	{ slug: 'recognition', text: 'Recognition' },
	{ slug: 'as-seen-on', text: 'As seen on' },
	{ slug: 'videos', text: 'Videos' },
	{ slug: 'interests', text: 'Outside of work' },
	{ slug: 'crop-art', text: 'Crop art' },
	{ slug: 'now', text: 'Right now' },
];

const previousCompanies = [
	{ name: 'CloudQuery', logo: '/images/logos/cloudquery.webp' },
	{ name: 'Tinybird', logo: '/images/logos/tinybird.webp' },
	{ name: 'SingleStore', logo: '/images/logos/singlestore.webp' },
	{ name: 'MongoDB', logo: '/images/logos/mongodb.webp' },
	{ name: 'Best Buy', logo: '/images/logos/bestbuy.webp' },
	{ name: 'DevLeague', logo: '/images/logos/devleague.webp' },
];

const career = [
	{
		role: 'Principal Developer Marketing Manager - CData',
		years: '2026 - present',
		text: 'Lead developer marketing for the managed MCP platform that connects AI agents to live enterprise data. Own the developer growth engine: docs, content, SEO and AEO, and platform positioning.',
	},
	{
		role: 'Head of Developer Relations - CloudQuery (now env0)',
		years: '2024 - 2026',
		text: 'Built and ran the full DevRel function from scratch: content, community, docs, events, and video. 4x organic traffic in 3 months; docs traffic up 302%; MQLs at 239% of target. Replicated the playbook post-acquisition at env0: +106% organic traffic in 3 weeks.',
	},
	{
		role: 'Developer Advocate - Tinybird',
		years: '2023 - 2025',
		text: 'Helped developers building real-time analytics applications. Created documentation, demos, blog posts, webinars, and workshops.',
	},
	{
		role: 'Senior Developer Advocate - SingleStore',
		years: '2021 - 2023',
		text: 'Led community conversations around scaling SQL workloads. Built demos and content for the distributed SQL database.',
	},
	{
		role: 'Senior Developer Advocate - MongoDB',
		years: '2019 - 2021',
		text: 'Built developer community, created tutorials, demos, and educational content. Subject matter expert for developer experience.',
	},
	{
		role: 'Front-end Technical Lead - Best Buy',
		years: '2017 - 2019',
		text: 'Engineered high-performance solutions for one of the top 10 eCommerce sites in North America. Scaled production apps handling thousands of requests per second.',
	},
	{
		role: 'Full-Stack JavaScript Instructor - DevLeague',
		years: '2015 - 2017',
		text: 'Taught full-stack JavaScript at one of the top 10 coding bootcamps worldwide. Created curriculum and prepared students for software engineering careers in Honolulu.',
	},
];

const featuredPodcasts = [
	{
		name: 'Hanselminutes',
		host: 'with Scott Hanselman',
		episode: 'Document Databases and Mongo',
		image: '/images/podcasts/hanselminutes.webp',
		alt: 'Hanselminutes podcast artwork',
		url: 'https://hanselminutes.com/752/document-databases-and-mongo-with-engineer-joe-karlsson',
	},
	{
		name: 'Screaming in the Cloud',
		host: 'with Corey Quinn (Last Week in AWS)',
		episode: 'When Data is Your Brand and Your Job',
		image: '/images/podcasts/screaming-cloud.webp',
		alt: 'Screaming in the Cloud podcast artwork',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		host: 'Two episodes - MongoDB & IoT',
		episode: 'JSJ 432 & JSJ 436',
		image: '/images/podcasts/javascript-jabber.webp',
		alt: 'JavaScript Jabber podcast artwork',
	},
	{
		name: 'CodeNewbie',
		host: 'Making databases fun and approachable',
		episode: 'Season 19, Episode 6',
		image: '/images/podcasts/codenewbie.webp',
		alt: 'CodeNewbie podcast artwork',
		url: 'https://dev.to/codenewbie/s19-e6-how-to-make-learning-databases-fun-and-approachable-joe-karlsson',
	},
];

const moreAppearances = [
	{
		name: '8 Bits',
		detail: 'with Chloe Condon & Brandon Minnick',
		url: 'https://8bits.tv/8-bits-with-joe-karlsson/',
	},
	{
		name: 'Community Pulse',
		detail: 'DevRel Content Channels (w/ Cassidy Williams)',
		url: 'https://www.communitypulse.io/57-devrel-content-channels/',
	},
	{
		name: 'Data on Kubernetes',
		detail: 'Building Data Intensive Applications',
		url: 'https://podcasts.apple.com/us/podcast/dok-talks-120-a-gentle-introduction-to-building/id1524821862?i=1000553416566',
	},
	{
		name: 'Coding Over Cocktails',
		detail: 'Diving deep into databases',
		url: 'https://www.lonti.com/podcast/episode-9',
	},
	{
		name: 'REACT Podcast',
		detail: 'Serverless Apps With React (Ep. 126)',
		url: 'https://open.spotify.com/episode/3gg6uix4qtAIswZV3k3FXq',
	},
];

const moreTalks = [
	{ id: 'UuNVpLIOHW8', title: 'Mapping SQL to MongoDB' },
	{ id: 'bIFrJJkUftA', title: 'Getting Started with SingleStore' },
	{ id: '6bHYDUzY9j0', title: '8-Bits with Joe Karlsson' },
];

const cropArtUrl = 'https://www.cropart.com/joek.dir/index.htm';

const cropArtPieces = [
	{
		title: 'Beware of Riot Dog',
		image: '/images/crop-art/riot-dog.webp',
		alt: 'Crop art mosaic reading Cave Canem Tumultum depicting the famous Greek riot dog Loukanikos running with a red bandana, made from white and dark seeds',
	},
	{
		title: 'Seeds of Remembrance',
		image: '/images/crop-art/seeds-of-remembrance.webp',
		alt: 'Crop art of a cat lounging against an orange sunset sky with a golden sun, made from lentils and various seeds',
	},
	{
		title: '60th Anniversary of The Sound of Music',
		image: '/images/crop-art/sound-of-music.webp',
		alt: 'Crop art depicting a scene from The Sound of Music with a figure holding a wide skirt, made from dark seeds on a black background',
	},
];
---

<BaseLayout
	title="About | Joe Karlsson"
	description="Developer Marketing Engineer leading developer growth at CData for the managed MCP platform that connects AI agents to live enterprise data. Built DevRel from scratch at CloudQuery (now env0); 15+ years at MongoDB, SingleStore, Tinybird, and Best Buy. TEDx Speaker, homelab enthusiast."
	schemaType="AboutPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<div class="mb-10 flex flex-col sm:flex-row sm:items-center sm:gap-8">
			<img
				src="/images/joe-profile.webp"
				alt="Joe Karlsson speaking at a conference"
				class="mb-4 sm:mb-0 w-32 h-32 sm:w-40 sm:h-40 rounded-lg object-cover"
				width="160"
				height="160"
				loading="eager"
			/>
			<div>
				<h1 class="mb-2 text-3xl font-bold text-white md:text-4xl">Joe Karlsson</h1>
				<p class="text-xl text-gray-300">
					Developer Marketing Engineer <span class="text-gray-400 text-base">(He/They)</span>
				</p>
				<div class="mt-3 flex gap-3">
					<a
						href="/resume/"
						class="plausible-event-name=About+CTA+Click plausible-event-destination=resume inline-block rounded-md bg-coral px-3 py-1.5 text-sm font-medium text-surface-0 no-underline hover:bg-white"
					>
						View Resume
					</a>
					<a
						href="/joe-karlsson-resume.pdf"
						target="_blank"
						rel="noopener noreferrer"
						class="plausible-event-name=About+CTA+Click plausible-event-destination=pdf-download inline-block rounded-md border border-coral px-3 py-1.5 text-sm font-medium text-coral no-underline hover:bg-surface-2"
					>
						Download PDF
					</a>
				</div>
			</div>
		</div>

		<div class="prose mb-10">
			<p class="text-lg">
				I lead developer marketing at CData, owning developer growth for the managed MCP platform
				that connects AI agents to live enterprise data. That means the whole growth engine:
				technical docs, content, SEO and AEO, and how we position the platform to the engineers
				actually building on it. Before this I built the Developer Relations function from scratch
				at CloudQuery (acquired by env0) - sole owner of content, community, docs, events, and
				video. The results: 4x organic traffic in under 3 months, docs traffic up 302%, and MQLs
				hitting 239% of target. I've been a professional software engineer for over 15 years, most
				of it at data companies - MongoDB, SingleStore, Tinybird, CloudQuery, and now CData.
			</p>

			<p>
				Before DevRel, I was a Technical Lead at Best Buy, where I helped architect and scale one of
				the top 10 eCommerce sites in North America - production apps handling thousands of requests
				per second. I've also given{' '}
				<a
					href="https://www.ted.com/talks/joe_karlsson_the_art_of_computer_science"
					target="_blank"
					rel="noopener noreferrer"
				>
					a TEDx talk
				</a>{' '}
				and spoken at 100+ conferences, been on 14+ podcasts, and studied CS at Gustavus Adolphus
				College.
			</p>
		</div>

		<div class="mb-12">
			<p class="mb-3 text-sm text-gray-400">Previously at</p>
			<ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
				{previousCompanies.map((company) => (
					<li class="flex items-center gap-2">
						<img
							src={company.logo}
							alt=""
							aria-hidden="true"
							class="h-8 w-8 rounded-sm"
							width="32"
							height="32"
							loading="eager"
						/>
						<span class="text-sm text-gray-300">{company.name}</span>
					</li>
				))}
			</ul>
		</div>

		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			<TableOfContents headings={aboutHeadings} />
			<div>
				<h2 id="career" class="mb-4 text-3xl font-extrabold text-white">
					Career
				</h2>
				<div class="mb-6 space-y-3">
					{career.map((job) => (
						<details>
							<summary class="cursor-pointer py-1 text-white hover:text-coral">
								<span class="font-medium">{job.role}</span>{' '}
								<span class="text-sm text-gray-400">{job.years}</span>
							</summary>
							<p class="mt-2 mb-2 text-gray-300 leading-relaxed">{job.text}</p>
						</details>
					))}
				</div>
				<p class="mb-12">
					<a
						href="/resume/"
						class="plausible-event-name=About+CTA+Click plausible-event-destination=resume-banner-top font-medium text-coral hover:text-white"
					>
						View my full resume &rarr;
					</a>{' '}
					<span class="text-gray-400">Impact metrics, tech stack, and PDF download.</span>
				</p>

				<h2 id="specializations" class="mb-4 text-3xl font-extrabold text-white">
					What I work on
				</h2>
				<div class="mb-12 grid gap-6 sm:grid-cols-3">
					<div>
						<h3 class="mb-1 font-semibold text-white">Data Systems</h3>
						<p class="text-gray-400">
							I've worked at five data companies (MongoDB, SingleStore, Tinybird, CloudQuery, CData)
							and scaled Best Buy's eCommerce platform.
						</p>
					</div>
					<div>
						<h3 class="mb-1 font-semibold text-white">Teaching Complex Topics</h3>
						<p class="text-gray-400">
							I taught at a coding bootcamp, gave a TEDx talk, and have spoken at 100+ conferences.
						</p>
					</div>
					<div>
						<h3 class="mb-1 font-semibold text-white">Building Weird Stuff</h3>
						<p class="text-gray-400">
							IoT cat litter boxes, crop art from millet kernels, hackathons for terrible ideas.
						</p>
					</div>
				</div>

				<h2 id="recognition" class="mb-4 text-3xl font-extrabold text-white">
					Recognition
				</h2>
				<ul class="mb-12 grid gap-x-8 gap-y-5 sm:grid-cols-2">
					<li>
						<h3 class="font-semibold text-white">TEDx Speaker & Conference Keynote</h3>
						<p class="text-sm text-gray-400">
							"The Art of Computer Science" - delivered as a TEDx talk and keynote at multiple
							conferences
						</p>
					</li>
					<li>
						<h3 class="font-semibold text-white">#1 on "10 Must-Follow Developers on TikTok"</h3>
						<p class="text-sm text-gray-400">25K+ followers, 844K+ likes</p>
					</li>
					<li>
						<h3 class="font-semibold text-white">Published Author</h3>
						<p class="text-sm text-gray-400">
							The New Stack, MongoDB Developer Hub, Tinybird blog, Medium, DEV Community
						</p>
					</li>
					<li>
						<h3 class="font-semibold text-white">
							<a
								href="https://stupidshitnooneinhawaiineedshackathon.github.io/"
								target="_blank"
								rel="noopener noreferrer"
								class="text-white hover:text-coral"
							>
								Hackathon Organizer
							</a>
						</h3>
						<p class="text-sm text-gray-400">
							Co-organized "Stupid Shit No One In Hawaii Needs" hackathon (2016). Sponsored by
							GitHub & Front End Masters.
						</p>
					</li>
					<li>
						<h3 class="font-semibold text-white">Arctic Code Vault Contributor</h3>
						<p class="text-sm text-gray-400">
							Code preserved in GitHub's Arctic Code Vault for future generations
						</p>
					</li>
					<li>
						<h3 class="font-semibold text-white">Coding Bootcamp Instructor</h3>
						<p class="text-sm text-gray-400">
							Taught full-stack JavaScript at DevLeague, one of the top 10 coding bootcamps
							worldwide (Honolulu, 2015-2017)
						</p>
					</li>
				</ul>

				<h2 id="as-seen-on" class="mb-4 text-3xl font-extrabold text-white">
					As seen on
				</h2>
				<ul class="mb-8 grid gap-6 sm:grid-cols-2">
					{featuredPodcasts.map((podcast) => (
						<li class="flex items-center gap-4">
							<img
								src={podcast.image}
								alt={podcast.alt}
								class="h-20 w-20 shrink-0 rounded-md object-cover"
								width="80"
								height="80"
								loading="lazy"
							/>
							<div>
								<h3 class="font-semibold text-white leading-tight">
									{podcast.url ? (
										<a
											href={podcast.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-white hover:text-coral"
										>
											{podcast.name}
										</a>
									) : (
										podcast.name
									)}
								</h3>
								<p class="text-sm text-gray-400">{podcast.host}</p>
								<p class="text-sm text-gray-400">{podcast.episode}</p>
							</div>
						</li>
					))}
				</ul>
				<h3 class="mb-3 font-semibold text-white">More appearances</h3>
				<ul class="mb-12 space-y-2">
					{moreAppearances.map((appearance) => (
						<li>
							<a
								href={appearance.url}
								target="_blank"
								rel="noopener noreferrer"
								class="font-medium text-white hover:text-coral"
							>
								{appearance.name}
							</a>{' '}
							<span class="text-sm text-gray-400">{appearance.detail}</span>
						</li>
					))}
				</ul>

				<h2 id="videos" class="mb-4 text-3xl font-extrabold text-white">
					Videos
				</h2>
				<div class="mb-12 space-y-8">
					<div>
						<h3 class="mb-2 font-semibold text-white">The Art of Computer Science (TEDx)</h3>
						<div class="aspect-video overflow-hidden rounded-lg">
							<iframe
								width="100%"
								height="100%"
								src="https://www.youtube-nocookie.com/embed/GiNa2jen-lg"
								title="The Art of Computer Science - TEDx Talk by Joe Karlsson"
								style="border:0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								loading="lazy"
							></iframe>
						</div>
					</div>
					<div class="grid gap-6 sm:grid-cols-2">
						<div>
							<h3 class="mb-2 font-semibold text-white">MongoDB Schema Design Best Practices</h3>
							<div class="aspect-video overflow-hidden rounded-lg">
								<iframe
									width="100%"
									height="100%"
									src="https://www.youtube-nocookie.com/embed/QAqK-R9HUhc"
									title="MongoDB Schema Design Best Practices"
									style="border:0"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
									loading="lazy"
								></iframe>
							</div>
						</div>
						<div>
							<h3 class="mb-2 font-semibold text-white">Bringing JavaScript to the IoT Edge</h3>
							<div class="aspect-video overflow-hidden rounded-lg">
								<iframe
									width="100%"
									height="100%"
									src="https://www.youtube-nocookie.com/embed/711Sb55fzdg"
									title="Bringing JavaScript to the IoT Edge"
									style="border:0"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen
									loading="lazy"
								></iframe>
							</div>
						</div>
					</div>
					<ul class="grid gap-6 sm:grid-cols-3">
						{moreTalks.map((talk) => (
							<li>
								<a
									href={`https://www.youtube.com/watch?v=${talk.id}`}
									target="_blank"
									rel="noopener noreferrer"
									class="group block no-underline"
								>
									<img
										src={`https://img.youtube.com/vi/${talk.id}/mqdefault.jpg`}
										alt=""
										aria-hidden="true"
										class="mb-2 w-full h-28 rounded-md object-cover"
										loading="lazy"
									/>
									<span class="text-sm font-medium text-white group-hover:text-coral">
										{talk.title}
									</span>
								</a>
							</li>
						))}
					</ul>
					<p>
						<a
							href={SOCIAL_LINKS.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class="text-coral hover:text-white"
						>
							See all talks on YouTube &rarr;
						</a>
					</p>
				</div>

				<h2 id="interests" class="mb-4 text-3xl font-extrabold text-white">
					Outside of work
				</h2>
				<div class="mb-12 grid gap-8 sm:grid-cols-2">
					<a
						href="/blog/how-to-get-started-building-a-homelab-server-in-2024/"
						class="group block no-underline"
					>
						<img
							src="/images/blog/how-to-get-started-building-a-homelab-server-in-2024/homelab-vaporwave.webp"
							alt="Vaporwave style homelab server illustration"
							class="mb-3 w-full h-36 rounded-md object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<h3 class="mb-1 font-semibold text-white group-hover:text-coral">Homelabber</h3>
						<p class="text-gray-400">
							Running a Proxmox cluster with {nowFeed.homelab.runningContainers} containers,
							self-hosted services, and Home Assistant automating the whole house.
						</p>
					</a>
					<a href="/talk-archive/" class="group block no-underline">
						<img
							src="/images/blog/the-art-of-computer-science/The-Art-of-Computer-Science.webp"
							alt="Joe Karlsson on the TEDx stage"
							class="mb-3 w-full h-36 rounded-md object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<h3 class="mb-1 font-semibold text-white group-hover:text-coral">Speaker</h3>
						<p class="text-gray-400">
							100+ conferences worldwide. TEDx speaker and keynote. I talk about databases, IoT, and
							the weird stuff I build at home.
						</p>
					</a>
					<a
						href="/blog/an-introduction-to-iot-internet-of-toilets/"
						class="group block no-underline"
					>
						<img
							src="/images/blog/an-introduction-to-iot-internet-of-toilets/og-iot-toilet.webp"
							alt="IoT litter box project with Raspberry Pi and sensors"
							class="mb-3 w-full h-36 rounded-md object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<h3 class="mb-1 font-semibold text-white group-hover:text-coral">
							Cat Person / IoT Tinkerer
						</h3>
						<p class="text-gray-400">
							Built an IoT litter box with a Raspberry Pi to monitor my cat's health. Gave a
							conference talk about it.
						</p>
					</a>
					<a
						href={cropArtUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group block no-underline"
					>
						<img
							src="/images/crop-art/riot-dog.webp"
							alt="Crop art of Riot Dog made from seeds and grains"
							class="mb-3 w-full h-36 rounded-md object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<h3 class="mb-1 font-semibold text-white group-hover:text-coral">Crop Artist</h3>
						<p class="text-gray-400">
							I make art by gluing seeds to cardboard. Exhibited at the Minnesota State Fair and the
							Seeds of Justice show.
						</p>
					</a>
				</div>

				<h2 id="crop-art" class="mb-4 text-3xl font-extrabold text-white">
					Crop art
				</h2>
				<div class="mb-12">
					<p class="mb-6 text-gray-400">
						I got into crop art in 2025 - making pictures by gluing seeds and grains to cardboard. I
						had two pieces in the Seeds of Justice exhibit, then entered the Minnesota State Fair
						Crop Art competition for the first time. Here are some of my pieces:
					</p>
					<ul class="grid gap-6 sm:grid-cols-3">
						{cropArtPieces.map((piece) => (
							<li>
								<a
									href={cropArtUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="group block no-underline"
								>
									<img
										src={piece.image}
										alt={piece.alt}
										class="mb-2 w-full aspect-4/5 rounded-md object-cover"
										width="300"
										height="375"
										loading="lazy"
									/>
									<span class="block text-sm font-medium text-white group-hover:text-coral">
										{piece.title}
									</span>
									<span class="text-sm text-gray-400">2025</span>
								</a>
