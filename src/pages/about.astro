---
import { SECTION_HEADING, PRIMARY_BUTTON, SECONDARY_BUTTON, MORE_LINK } from '../utils/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHero from '../components/PosterHero.astro';
import KeepExploring from '../components/KeepExploring.astro';
import NowFeed from '../components/NowFeed.astro';
import Scribble from '../components/Scribble.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SOCIAL_LINKS } from '../consts';
import nowFeed from '../data/now-feed.json';
import { CHALK, MARKS } from '../data/scribbles';

const CARD_TITLE =
	'font-display text-[clamp(24px,2vw,30px)] leading-none font-normal text-paper uppercase';

const aboutHeadings = [
	{ slug: 'career', text: 'Career' },
	{ slug: 'specializations', text: 'What I work on' },
	{ slug: 'recognition', text: 'Recognition' },
	{ slug: 'as-seen-on', text: 'As seen on' },
	{ slug: 'videos', text: 'Videos' },
	{ slug: 'interests', text: 'Outside of work' },
	{ slug: 'now', text: 'Right now' },
	{ slug: 'crop-art', text: 'Crop art' },
];

const previousCompanies = [
	{ name: 'CloudQuery', logo: '/images/logos/cloudquery.webp' },
	{ name: 'Tinybird', logo: '/images/logos/tinybird.webp' },
	{ name: 'SingleStore', logo: '/images/logos/singlestore.webp' },
	{ name: 'MongoDB', logo: '/images/logos/mongodb.webp' },
	{ name: 'Best Buy', logo: '/images/logos/bestbuy.webp' },
	{ name: 'DevLeague', logo: '/images/logos/devleague.webp' },
];

const career = [
	{
		role: 'Principal Developer Marketing Manager - CData',
		years: '2026 - present',
		text: 'Lead developer marketing for the managed MCP platform that connects AI agents to live enterprise data. Own the developer growth engine: docs, content, SEO and AEO, and platform positioning.',
	},
	{
		role: 'Head of Developer Relations - CloudQuery (now env0)',
		years: '2024 - 2026',
		text: 'Built and ran the full DevRel function from scratch: content, community, docs, events, and video. 4x organic traffic in 3 months; docs traffic up 302%; MQLs at 239% of target. Replicated the playbook post-acquisition at env0: +106% organic traffic in 3 weeks.',
	},
	{
		role: 'Developer Advocate - Tinybird',
		years: '2023 - 2025',
		text: 'Helped developers building real-time analytics applications. Created documentation, demos, blog posts, webinars, and workshops.',
	},
	{
		role: 'Senior Developer Advocate - SingleStore',
		years: '2021 - 2023',
		text: 'Led community conversations around scaling SQL workloads. Built demos and content for the distributed SQL database.',
	},
	{
		role: 'Senior Developer Advocate - MongoDB',
		years: '2019 - 2021',
		text: 'Built developer community, created tutorials, demos, and educational content. Subject matter expert for developer experience.',
	},
	{
		role: 'Front-end Technical Lead - Best Buy',
		years: '2017 - 2019',
		text: 'Engineered high-performance solutions for one of the top 10 eCommerce sites in North America. Scaled production apps handling thousands of requests per second.',
	},
	{
		role: 'Full-Stack JavaScript Instructor - DevLeague',
		years: '2015 - 2017',
		text: 'Taught full-stack JavaScript at one of the top 10 coding bootcamps worldwide. Created curriculum and prepared students for software engineering careers in Honolulu.',
	},
];

const featuredPodcasts = [
	{
		name: 'Hanselminutes',
		host: 'with Scott Hanselman',
		episode: 'Document Databases and Mongo',
		image: '/images/podcasts/hanselminutes.webp',
		alt: 'Hanselminutes podcast artwork',
		url: 'https://hanselminutes.com/752/document-databases-and-mongo-with-engineer-joe-karlsson',
	},
	{
		name: 'Screaming in the Cloud',
		host: 'with Corey Quinn (Last Week in AWS)',
		episode: 'When Data is Your Brand and Your Job',
		image: '/images/podcasts/screaming-cloud.webp',
		alt: 'Screaming in the Cloud podcast artwork',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		host: 'Two episodes - MongoDB & IoT',
		episode: 'JSJ 432 & JSJ 436',
		image: '/images/podcasts/javascript-jabber.webp',
		alt: 'JavaScript Jabber podcast artwork',
	},
	{
		name: 'CodeNewbie',
		host: 'Making databases fun and approachable',
		episode: 'Season 19, Episode 6',
		image: '/images/podcasts/codenewbie.webp',
		alt: 'CodeNewbie podcast artwork',
		url: 'https://dev.to/codenewbie/s19-e6-how-to-make-learning-databases-fun-and-approachable-joe-karlsson',
	},
];

const moreAppearances = [
	{
		name: '8 Bits',
		detail: 'with Chloe Condon & Brandon Minnick',
		url: 'https://8bits.tv/8-bits-with-joe-karlsson/',
	},
	{
		name: 'Community Pulse',
		detail: 'DevRel Content Channels (w/ Cassidy Williams)',
		url: 'https://www.communitypulse.io/57-devrel-content-channels/',
	},
	{
		name: 'Data on Kubernetes',
		detail: 'Building Data Intensive Applications',
		url: 'https://podcasts.apple.com/us/podcast/dok-talks-120-a-gentle-introduction-to-building/id1524821862?i=1000553416566',
	},
	{
		name: 'Coding Over Cocktails',
		detail: 'Diving deep into databases',
		url: 'https://www.lonti.com/podcast/episode-9',
	},
	{
		name: 'REACT Podcast',
		detail: 'Serverless Apps With React (Ep. 126)',
		url: 'https://open.spotify.com/episode/3gg6uix4qtAIswZV3k3FXq',
	},
];

const moreTalks = [
	{ id: 'UuNVpLIOHW8', title: 'Mapping SQL to MongoDB' },
	{ id: 'bIFrJJkUftA', title: 'Getting Started with SingleStore' },
	{ id: '6bHYDUzY9j0', title: '8-Bits with Joe Karlsson' },
];

const cropArtUrl = 'https://www.cropart.com/joek.dir/index.htm';

const cropArtPieces = [
	{
		title: 'Beware of Riot Dog',
		image: '/images/crop-art/riot-dog.webp',
		alt: 'Crop art mosaic reading Cave Canem Tumultum depicting the famous Greek riot dog Loukanikos running with a red bandana, made from white and dark seeds',
	},
	{
		title: 'Seeds of Remembrance',
		image: '/images/crop-art/seeds-of-remembrance.webp',
		alt: 'Crop art of a cat lounging against an orange sunset sky with a golden sun, made from lentils and various seeds',
	},
	{
		title: '60th Anniversary of The Sound of Music',
		image: '/images/crop-art/sound-of-music.webp',
		alt: 'Crop art depicting a scene from The Sound of Music with a figure holding a wide skirt, made from dark seeds on a black background',
	},
];
---

<BaseLayout
	title="About | Joe Karlsson"
	description="Developer Marketing Engineer leading developer growth at CData for the managed MCP platform that connects AI agents to live enterprise data. Built DevRel from scratch at CloudQuery (now env0); 15+ years at MongoDB, SingleStore, Tinybird, and Best Buy. TEDx Speaker, homelab enthusiast."
	schemaType="AboutPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-7">
		<!-- The waving clip on the left, the page's sections in the pink ticker, and who I
		am in the dark panel above ABOUT (the same top as every main page). The clip is
		pre-cropped with Joe's face centered on the top third, so it's drawn centered. Pink
		dots are drawn live (src/scripts/halftone.ts); in-view-play stops it with
		pause-motion and reduced motion. -->
		<PosterHero title="About" wordRatio={2.4} tickerItems={aboutHeadings.map(({ text }) => text)}>
			<div
				slot="media"
				class="relative z-10 aspect-[4/3] md:aspect-auto md:before:block md:before:aspect-square md:before:content-['']"
			>
				<video
					src="/images/about/joe-hello.mp4"
					data-halftone-poster="/images/about/joe-hello-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					role="img"
					aria-label="Joe Karlsson by a river, waving hello with a peace sign"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-[50%_8%] md:object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class="relative w-fit font-display text-[clamp(36px,3.6vw,56px)] leading-none text-paper uppercase">
				Joe Karlsson
				<Scribble
					{...MARKS.underline}
					color="#ff4fd8"
					strokeWidth={10}
					duration="8s"
					delay="0.3s"
					class="-bottom-[0.3em] left-0 h-[0.25em] w-full"
				/>
			</p>
			<p class="mt-4 text-lg text-paper">Developer Marketing Engineer (He/They)</p>
			<div class="mt-5 flex flex-wrap gap-3">
				<a
					href="/resume/"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=resume ${PRIMARY_BUTTON}`}
				>
					View Resume
				</a>
				<a
					href="/joe-karlsson-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=pdf-download ${SECONDARY_BUTTON}`}
				>
					Download PDF
				</a>
			</div>
		</PosterHero>

		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			<TableOfContents headings={aboutHeadings} />
			<div>
				<div class="prose mb-12 max-w-none!">
					<p>
						I lead developer marketing at CData, for the MCP platform that connects AI agents to
						live enterprise data. Before that I built DevRel from scratch at CloudQuery and
						quadrupled organic traffic in three months, after 15 years as an engineer at data
						companies like MongoDB and SingleStore.
					</p>
				</div>

				<div class="mb-12">
					<p class="mb-3 text-sm text-muted">Previously at</p>
					<ul class="flex flex-nowrap items-center justify-between gap-x-4">
						{previousCompanies.map((company) => (
							<li class="relative flex items-center gap-2">
								<img
									src={company.logo}
									alt=""
									aria-hidden="true"
									data-halftone="flat"
									class="size-12 rounded-sm lg:size-8"
									width="48"
									height="48"
									loading="eager"
								/>
								<span class="sr-only text-paper lg:not-sr-only">{company.name}</span>
							</li>
						))}
					</ul>
				</div>

				<h2 id="career" class={`${SECTION_HEADING} scroll-mt-24`}>
					Career
					<Scribble
						{...MARKS.underline}
						color={CHALK}
						duration="7s"
						delay="0.0s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-6">
					{career.map((job) => (
						<details class="border-t border-surface-4 py-3">
							<summary class="cursor-pointer text-paper hover:text-pink">
								<span class="text-lg font-semibold">{job.role}</span>{' '}
								<span class="text-sm text-muted">{job.years}</span>
							</summary>
							<p class="mt-2 mb-1 leading-relaxed text-muted">{job.text}</p>
						</details>
					))}
				</div>
				<p class="mb-12">
					<a
						href="/resume/"
						class="plausible-event-name=About+CTA+Click plausible-event-destination=resume-banner-top font-semibold text-pink no-underline hover:text-paper"
					>
						View my full resume &rarr;
					</a>{' '}
					<span class="text-muted">Impact metrics, tech stack, and PDF download.</span>
				</p>

				<h2 id="specializations" class={`${SECTION_HEADING} scroll-mt-24`}>
					What I work on
					<Scribble
						{...MARKS.rays}
						color={'#ff4fd8'}
						duration="8s"
						delay="0.6s"
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<div class="mb-12 grid gap-6 sm:grid-cols-3">
					<div>
						<h3 class:list={[CARD_TITLE, 'mb-2']}>Data Systems</h3>
						<p class="text-muted">
							I've worked at five data companies (MongoDB, SingleStore, Tinybird, CloudQuery, CData)
							and scaled Best Buy's eCommerce platform.
						</p>
					</div>
					<div>
						<h3 class:list={[CARD_TITLE, 'mb-2']}>Teaching Complex Topics</h3>
						<p class="text-muted">
							I taught at a coding bootcamp, gave a TEDx talk, and have spoken at 100+ conferences.
						</p>
					</div>
					<div>
						<h3 class:list={[CARD_TITLE, 'mb-2']}>Building Weird Stuff</h3>
						<p class="text-muted">
							IoT cat litter boxes, crop art from millet kernels, hackathons for terrible ideas.
						</p>
					</div>
				</div>

				<h2 id="recognition" class={`${SECTION_HEADING} scroll-mt-24`}>
					Recognition
					<Scribble
						{...MARKS.asterisk}
						color={CHALK}
						duration="9s"
						delay="1.2s"
						class="-top-[0.15em] -right-[0.8em] size-[0.6em]"
					/>
				</h2>
				<ul class="mb-12 grid gap-x-8 gap-y-5 sm:grid-cols-2">
					<li>
						<h3 class="text-lg font-semibold text-paper">
							<a
								href="https://www.ted.com/talks/joe_karlsson_the_art_of_computer_science"
								target="_blank"
								rel="noopener noreferrer"
								class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
							>
								TEDx Speaker & Conference Keynote
							</a>
						</h3>
						<p class="text-sm text-muted">
							"The Art of Computer Science" - delivered as a TEDx talk and keynote at multiple
							conferences
						</p>
					</li>
					<li>
						<h3 class="text-lg font-semibold text-paper">
							<a
								href="https://unclebigbay.com/10-must-follow-developers-on-tik-tok"
								target="_blank"
								rel="noopener noreferrer"
								class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
							>
								#1 on "10 Must-Follow Developers on TikTok"
							</a>
						</h3>
						<p class="text-sm text-muted">25K+ followers, 844K+ likes</p>
					</li>
					<li>
						<h3 class="text-lg font-semibold text-paper">Published Author</h3>
						<p class="text-sm text-muted">
							The New Stack, MongoDB Developer Hub, Tinybird blog, Medium, DEV Community
						</p>
					</li>
					<li>
						<h3 class="text-lg font-semibold text-paper">
							<a
								href="https://stupidshitnooneinhawaiineedshackathon.github.io/"
								target="_blank"
								rel="noopener noreferrer"
								class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
							>
								Hackathon Organizer
							</a>
						</h3>
						<p class="text-sm text-muted">
							Co-organized "Stupid Shit No One In Hawaii Needs" hackathon (2016). Sponsored by
							GitHub & Front End Masters.
						</p>
					</li>
					<li>
						<h3 class="text-lg font-semibold text-paper">Arctic Code Vault Contributor</h3>
						<p class="text-sm text-muted">
							Code preserved in GitHub's Arctic Code Vault for future generations
						</p>
					</li>
					<li>
						<h3 class="text-lg font-semibold text-paper">Coding Bootcamp Instructor</h3>
						<p class="text-sm text-muted">
							Taught full-stack JavaScript at DevLeague, one of the top 10 coding bootcamps
							worldwide (Honolulu, 2015-2017)
						</p>
					</li>
				</ul>

				<h2 id="as-seen-on" class={`${SECTION_HEADING} scroll-mt-24`}>
					As seen on
					<Scribble
						{...MARKS.double}
						color={'#ff4fd8'}
						duration="10s"
						delay="0.0s"
						class="-bottom-[0.42em] left-0 h-[0.4em] w-full"
					/>
				</h2>
				<ul class="mb-8 grid gap-6 sm:grid-cols-2">
					{featuredPodcasts.map((podcast) => (
						<li class="relative flex items-center gap-4">
							<img
								src={podcast.image}
								alt={podcast.alt}
								data-halftone="flat"
								class="h-20 w-20 shrink-0 rounded-md object-cover"
								width="80"
								height="80"
								loading="lazy"
							/>
							<div>
								<h3 class="text-lg leading-tight font-semibold text-paper">
									{podcast.url ? (
										<a
											href={podcast.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
										>
											{podcast.name}
										</a>
									) : (
										podcast.name
									)}
								</h3>
								<p class="text-sm text-muted">{podcast.host}</p>
								<p class="text-sm text-muted">{podcast.episode}</p>
							</div>
						</li>
					))}
				</ul>
				<h3 class:list={[CARD_TITLE, 'mb-3']}>More appearances</h3>
				<ul class="mb-12 space-y-2">
					{moreAppearances.map((appearance) => (
						<li>
							<a
								href={appearance.url}
								target="_blank"
								rel="noopener noreferrer"
								class="font-semibold text-paper underline decoration-pink underline-offset-4 hover:text-pink"
							>
								{appearance.name}
							</a>{' '}
							<span class="text-sm text-muted">{appearance.detail}</span>
						</li>
					))}
				</ul>

				<h2 id="videos" class={`${SECTION_HEADING} scroll-mt-24`}>
					Videos
					<Scribble
						{...MARKS.underline}
						color={'#ff4fd8'}
						duration="7s"
						delay="0.6s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-12 space-y-8">
					<div>
						<h3 class="mb-3 text-lg font-semibold text-paper">
							The Art of Computer Science (TEDx)
						</h3>
						<div class="relative">
							<YouTubeFacade
								id="GiNa2jen-lg"
								title="The Art of Computer Science - TEDx Talk by Joe Karlsson"
							/>
							<Scribble
								{...MARKS.box}
								color={CHALK}
								duration="10s"
								delay="0.8s"
								class="-inset-[3%] z-20 h-[106%] w-[106%]"
							/>
						</div>
					</div>
					<div class="grid gap-6 sm:grid-cols-2">
						<div>
							<h3 class="mb-3 text-lg font-semibold text-paper">
								MongoDB Schema Design Best Practices
							</h3>
							<YouTubeFacade id="QAqK-R9HUhc" title="MongoDB Schema Design Best Practices" />
						</div>
						<div>
							<h3 class="mb-3 text-lg font-semibold text-paper">
								Bringing JavaScript to the IoT Edge
							</h3>
							<YouTubeFacade id="711Sb55fzdg" title="Bringing JavaScript to the IoT Edge" />
						</div>
					</div>
					<ul class="grid gap-6 sm:grid-cols-3">
						{moreTalks.map((talk) => (
							<li>
								<a
									href={`https://www.youtube.com/watch?v=${talk.id}`}
									target="_blank"
									rel="noopener noreferrer"
									class="group relative block no-underline"
								>
									<img
										src={`https://img.youtube.com/vi/${talk.id}/mqdefault.jpg`}
										alt=""
										aria-hidden="true"
										crossorigin="anonymous"
										data-halftone="flat"
										class="mb-2 block aspect-video w-full rounded-md object-cover"
										loading="lazy"
									/>
									<span class="font-semibold text-paper group-hover:text-pink">{talk.title}</span>
								</a>
							</li>
						))}
					</ul>
					<p>
						<a
							href={SOCIAL_LINKS.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class={MORE_LINK}
						>
							See all talks on YouTube &rarr;
						</a>
					</p>
				</div>

				<h2 id="interests" class={`${SECTION_HEADING} scroll-mt-24`}>
					Outside of work
					<Scribble
						{...MARKS.rays}
						color={CHALK}
						duration="8s"
						delay="1.2s"
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<div class="mb-12 grid gap-8 sm:grid-cols-2">
					<a
						href="/blog/how-to-get-started-building-a-homelab-server-in-2024/"
						class="group relative block no-underline"
					>
						<img
							src="/images/blog/how-to-get-started-building-a-homelab-server-in-2024/homelab-vaporwave.webp"
							alt="Vaporwave style homelab server illustration"
							data-halftone="flat"
							class="mb-3 block aspect-video w-full rounded-lg object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<Scribble
							{...MARKS.check}
							color={CHALK}
							duration="9s"
							delay="0.0s"
							class="-top-[7%] -right-[5%] z-10 size-[24%]"
						/>
						<h3 class:list={[CARD_TITLE, 'mb-2 group-hover:text-pink']}>Homelabber</h3>
						<p class="text-muted">
							Running a Proxmox cluster with {nowFeed.homelab.runningContainers} containers,
							self-hosted services, and Home Assistant automating the whole house.
						</p>
					</a>
					<a href="/talk-archive/" class="group relative block no-underline">
						<img
							src="/images/blog/the-art-of-computer-science/The-Art-of-Computer-Science.webp"
							alt="Joe Karlsson on the TEDx stage"
							data-halftone="flat"
							class="mb-3 block aspect-video w-full rounded-lg object-cover"
							width="300"
							height="112"
							loading="lazy"
						/>
						<Scribble
							{...MARKS.tally}
							color="#ff4fd8"
							duration="9s"
