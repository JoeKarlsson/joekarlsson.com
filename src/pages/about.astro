</BaseLayout>

<style>
	/* A career row opens all the way on hover; clicking keeps it open */
	details.job summary::-webkit-details-marker {
		display: none;
	}
	details.job::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.3s ease,
			content-visibility 0.3s allow-discrete;
	}
	details.job:hover::details-content {
		content-visibility: visible;
		block-size: auto;
	}
	details.job[open]::details-content {
		block-size: auto;
	}
	@supports (interpolate-size: allow-keywords) {
		details.job {
			interpolate-size: allow-keywords;
		}
	}
	/* What I do thumbnails crossfade through four frames, three seconds each */
	.frame {
		opacity: 0;
		animation: frame-cycle 12s infinite;
		animation-delay: calc((var(--frame) - 4) * 3s);
	}
	@keyframes frame-cycle {
		0% {
			opacity: 0;
		}
		4%,
		25% {
			opacity: 1;
		}
		29%,
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		details.job::details-content {
			transition: none;
		}
		.frame {
			animation: none;
		}
		.frame:first-child {
			opacity: 1;
		}
	}
</style>
