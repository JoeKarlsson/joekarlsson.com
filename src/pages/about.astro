	details.job:hover::details-content {
		content-visibility: visible;
		block-size: auto;
	}
	details.job[open]::details-content {
		block-size: auto;
	}
	@supports (interpolate-size: allow-keywords) {
		details.job {
			interpolate-size: allow-keywords;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		details.job::details-content {
			transition: none;
		}
	}
