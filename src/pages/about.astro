		<script>
			document.querySelectorAll('.tiktok-facade').forEach((btn) => {
				btn.addEventListener('click', () => {
					const videoId = btn.getAttribute('data-video-id');
					if (!videoId) return;
					if (typeof window.plausible === 'function') {
						window.plausible('TikTok Embed Load', { props: { video_id: videoId } });
					}
					const container = btn.parentElement;
					if (!container) return;
					const blockquote = document.createElement('blockquote');
					blockquote.className = 'tiktok-embed';
					blockquote.setAttribute('cite', `https://www.tiktok.com/@joekarlsson/video/${videoId}`);
					blockquote.setAttribute('data-video-id', videoId);
					blockquote.style.maxWidth = '100%';
					blockquote.style.minWidth = '200px';
					blockquote.innerHTML = `<section><a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@joekarlsson">@joekarlsson</a></section>`;
					const wrapper = document.createElement('div');
					wrapper.className = 'overflow-hidden rounded-lg border border-surface-3';
					wrapper.appendChild(blockquote);
					container.replaceChild(wrapper, btn);
					if (!document.querySelector('script[src*="tiktok.com/embed"]')) {
						const script = document.createElement('script');
						script.src = 'https://www.tiktok.com/embed.js';
						script.async = true;
						document.body.appendChild(script);
					} else if (window.tiktokEmbed) {
						window.tiktokEmbed.lib.render();
					}
				});
			});
		</script>
