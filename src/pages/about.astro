---
import {
	HERO_LEAD,
	ITEM_TITLE,
	META,
	MORE_LINK,
	PAGE_CONTAINER,
	PRIMARY_BUTTON,
	SECONDARY_BUTTON,
	SECTION_HEADING,
	SIDEBAR_GRID,
} from '../utils/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHero from '../components/PosterHero.astro';
import KeepExploring from '../components/KeepExploring.astro';
import NowFeed from '../components/NowFeed.astro';
import HoverBox from '../components/HoverBox.astro';
import IndexRow from '../components/IndexRow.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Scribble from '../components/Scribble.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SOCIAL_LINKS } from '../consts';
import { roles } from '../data/resume';
import { formatTalkDate, newestLinkedTalk } from '../data/talks';
import { CHALK, MARKS, RINGS } from '../data/scribbles';
import { projects } from '../data/projects';
import { getFeedPosts, isOwnPost } from '../utils/posts';
import { halftoneMode } from '../utils/halftone';

// The pink band pushes the latest talk, as proof of the work
const latestTalk = newestLinkedTalk();
const aboutHeadings = [
	{ slug: 'what-i-do', text: 'What I do' },
	{ slug: 'career', text: 'Career' },
	{ slug: 'how-i-got-here', text: 'How I got here' },
	{ slug: 'as-seen-on', text: 'As seen on' },
	{ slug: 'videos', text: 'Videos' },
	{ slug: 'now', text: 'Right now' },
	{ slug: 'art', text: 'Art' },
	{ slug: 'follow-me', text: 'Follow me' },
];

// What I do. Make stuff and Writing and videos cycle through my newest projects and posts, so the
// pictures and the "Newest" line change every time I ship something
const FRAMES = 4;
const newestProjects = [...projects].sort((a, b) => b.date.localeCompare(a.date)).slice(0, FRAMES);
const newestPosts = (await getFeedPosts())
	.filter((post) => isOwnPost(post) && post.data.heroImage)
	.slice(0, FRAMES);

// A long post title, cut at a word near 50 characters so the Writing and videos line stays short
function shortTitle(title: string): string {
	if (title.length <= 50) return `${title}.`;
	return `${title.slice(0, 50).replace(/\s+\S*$/, '')}…`;
}

const whatIDo = [
	{
		title: 'Developer marketing',
		href: '/blog/running-devrel/',
		frames: [{ src: '/images/blog/running-devrel/hero.webp', alt: 'Hands typing on a laptop' }],
		text: 'Docs, SEO, demos and talks that get developers to try a product.',
	},
	{
		title: 'Make stuff',
		href: '/work/',
		frames: newestProjects.map((project) => ({ src: project.image, alt: project.imageAlt })),
		text: `Side projects, hardware hacks and art. Newest: ${newestProjects[0].title}.`,
	},
	{
		title: 'Writing and videos',
		href: '/blog/',
		frames: newestPosts.map((post) => ({
			src: post.data.heroImage as string,
			alt: post.data.heroAlt ?? post.data.title,
		})),
		text: `Blog posts, videos and the Works on My Machine newsletter. Newest: ${shortTitle(newestPosts[0].data.title)}`,
	},
];

// My main accounts, in the order the contact page ranks them, then the rest there
const followMe = [
	{ label: 'LinkedIn', meta: 'Work', href: SOCIAL_LINKS.linkedin, icon: 'linkedin' },
	{ label: 'Bluesky', meta: '@joekarlsson.com', href: SOCIAL_LINKS.bluesky, icon: 'bluesky' },
	{ label: 'GitHub', meta: 'Code', href: SOCIAL_LINKS.github, icon: 'github' },
	{ label: 'YouTube', meta: 'Videos', href: SOCIAL_LINKS.youtube, icon: 'youtube' },
	{ label: 'Threads', meta: '@joekarlsson', href: SOCIAL_LINKS.threads, icon: 'threads' },
	{ label: 'More', meta: 'Everywhere else', href: '/contact/', icon: 'more' },
] as const;

// The mark that spills off each card's corner, cycling so neighbors differ

const previousCompanies = [
	{ name: 'CloudQuery', logo: '/images/logos/cloudquery.webp', url: 'https://www.cloudquery.io/' },
	{ name: 'Tinybird', logo: '/images/logos/tinybird.webp', url: 'https://www.tinybird.co/' },
	{
		name: 'SingleStore',
		logo: '/images/logos/singlestore.webp',
		url: 'https://www.singlestore.com/',
	},
	{ name: 'MongoDB', logo: '/images/logos/mongodb.webp', url: 'https://www.mongodb.com/' },
	{ name: 'Best Buy', logo: '/images/logos/bestbuy.webp', url: 'https://www.bestbuy.com/' },
	{ name: 'DevLeague', logo: '/images/logos/devleague.webp', url: 'https://devleague.com/' },
];

// Company, title, years and summary come from the resume, so /about, /resume and
// llms.txt can't disagree
const career = roles.map((role) => ({
	company: role.company,
	role: role.title,
	logo: role.logo,
	years: `${role.startYear} - ${role.endYear ?? 'present'}`,
	text: role.summary,
}));

const featuredPodcasts = [
	{
		name: 'Hanselminutes',
		host: 'with Scott Hanselman',
		episode: 'Document Databases and Mongo',
		image: '/images/podcasts/hanselminutes.webp',
		alt: 'Hanselminutes podcast artwork',
		url: 'https://hanselminutes.com/752/document-databases-and-mongo-with-engineer-joe-karlsson',
	},
	{
		name: 'Screaming in the Cloud',
		host: 'with Corey Quinn (Last Week in AWS)',
		episode: 'When Data is Your Brand and Your Job',
		image: '/images/podcasts/screaming-cloud.webp',
		alt: 'Screaming in the Cloud podcast artwork',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		host: 'Three episodes - IoT and MongoDB',
		episode: 'JSJ 432, 436 & 448',
		image: '/images/podcasts/javascript-jabber.webp',
		alt: 'JavaScript Jabber podcast artwork',
		// devchat.tv is gone; Top End Devs hosts the show now and lists all three
		url: 'https://topenddevs.com/authors/joe-karlsson',
	},
	{
		name: 'CodeNewbie',
		host: 'Making databases fun and approachable',
		episode: 'Season 19, Episode 6',
		image: '/images/podcasts/codenewbie.webp',
		alt: 'CodeNewbie podcast artwork',
		url: 'https://dev.to/codenewbie/s19-e6-how-to-make-learning-databases-fun-and-approachable-joe-karlsson',
	},
];

const moreAppearances = [
	{
		name: '8 Bits',
		detail: 'with Chloe Condon & Brandon Minnick',
		url: 'https://8bits.tv/8-bits-with-joe-karlsson/',
	},
	{
		name: 'Community Pulse',
		detail: 'DevRel Content Channels (w/ Cassidy Williams)',
		url: 'https://www.communitypulse.io/57-devrel-content-channels/',
	},
	{
		name: 'Data on Kubernetes',
		detail: 'Building Data Intensive Applications',
		url: 'https://podcasts.apple.com/us/podcast/dok-talks-120-a-gentle-introduction-to-building/id1524821862?i=1000553416566',
	},
	{
		name: 'Coding Over Cocktails',
		detail: 'Diving deep into databases',
		url: 'https://www.lonti.com/podcast/episode-9',
	},
	{
		name: 'REACT Podcast',
		detail: 'Serverless Apps With React (Ep. 126)',
		url: 'https://open.spotify.com/episode/3gg6uix4qtAIswZV3k3FXq',
	},
];

// Beside TEDx; three, then the YouTube tile, so the reel stays as tall as the player
const moreVideos = [
	{ id: 'QAqK-R9HUhc', title: 'MongoDB Schema Design Best Practices' },
	{ id: '711Sb55fzdg', title: 'Bringing JavaScript to the IoT Edge' },
	{ id: 'bIFrJJkUftA', title: 'Getting Started with SingleStore' },
];

const cropArtUrl = 'https://www.cropart.com/joek.dir/index.htm';

const cropArtPieces = [
	{
		title: 'Beware of Riot Dog',
		image: '/images/crop-art/riot-dog.webp',
		alt: 'Crop art mosaic reading Cave Canem Tumultum depicting the famous Greek riot dog Loukanikos running with a red bandana, made from white and dark seeds',
	},
	{
		title: 'Seeds of Remembrance',
		image: '/images/crop-art/seeds-of-remembrance.webp',
		alt: 'Crop art of a cat lounging against an orange sunset sky with a golden sun, made from lentils and various seeds',
	},
	{
		title: '60th Anniversary of The Sound of Music',
		image: '/images/crop-art/sound-of-music.webp',
		alt: 'Crop art depicting a scene from The Sound of Music with a figure holding a wide skirt, made from dark seeds on a black background',
	},
];
---

<BaseLayout
	title="About | Joe Karlsson"
	type="profile"
	description="I run developer marketing for an MCP platform, after 15 years writing, teaching and talking about software. Outside work: crop art, my homelab and movies."
	schemaType="AboutPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- A montage that opens on Joe at his desk, then cuts to the river wave, the homelab and two homepage shots, on the left, my latest talk in the pink band, and who I
		am in the dark panel above ABOUT (the same top as every main page). The montage is
		4:3 at the camera's full height with Joe's eyes on the top third, so the square
		desktop column only trims the sides, never his head. Pink
		dots are drawn live (src/scripts/halftone.ts); in-view-play stops it with
		pause-motion and reduced motion. -->
		<PosterHero
			decorativeMedia
			title="About"
			wordRatio={2.4}
			featured={{
				label: 'New talk',
				title: latestTalk.talk.title,
				href: latestTalk.href,
				meta: [latestTalk.talk.event, formatTalkDate(latestTalk.talk)].filter(Boolean).join(' · '),
			}}
		>
			<div
				slot="media"
				class="relative z-10 aspect-[4/3] md:aspect-auto md:before:block md:before:aspect-square md:before:content-['']"
			>
				<video
					src="/images/about/joe-desk-2026-11-10.mp4"
					poster="/images/about/joe-desk-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Montage of Joe Karlsson: talking at his desk in pink light, waving a peace sign by a river, swinging a jacket on over his head, eating ice cream, giving a thumbs up by his server rack and holding up a Kindle"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class="relative w-fit font-display text-[clamp(2.25rem,3.6vw,3.5rem)] leading-none text-paper uppercase">
				Joe Karlsson
				<Scribble
					{...MARKS.underline}
					color="#ff4fd8"
					strokeWidth={10}
					duration="8s"
					delay="0.3s"
					class="-bottom-[0.3em] left-0 h-[0.25em] w-full"
				/>
			</p>
			<p class="mt-4 text-lg text-paper">Developer Marketing Engineer (He/They)</p>
			<div class="mt-5 flex flex-wrap gap-3">
				<a
					href="/resume/"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=resume ${PRIMARY_BUTTON}`}
				>
					View Resume
				</a>
				<a
					href="/joe-karlsson-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class={`plausible-event-name=About+CTA+Click plausible-event-destination=pdf-download ${SECONDARY_BUTTON}`}
				>
					Download PDF
				</a>
			</div>
		</PosterHero>

		<div class={SIDEBAR_GRID}>
			<TableOfContents headings={aboutHeadings} />
			<div class="min-w-0">
				<div class="mb-12 md:mb-16">
					<p class="mb-5 max-w-4xl font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98] text-paper uppercase">
						I build <span class="text-pink">weird things</span> and{' '}
						<span class="text-pink">show my work</span>
					</p>
					<p class={`max-w-3xl ${HERO_LEAD}`}>
						I run developer marketing for an MCP platform. Before that I spent about 15 years
						writing software, teaching it in Honolulu, and explaining it in talks and videos.
						Outside of work I make crop art, tinker with my homelab, and watch a lot of movies.
					</p>
				</div>

				{/* A box with a tilted pink label, like the stickers in the header. Off on phones,
				where Career a screen later lists the same companies with the same logos */}
				<div class="previously-at relative mb-12 md:mb-16 rounded-xl bg-surface-1 px-5 pt-9 pb-5 max-md:hidden sm:px-7">
					<p class="absolute -top-5 left-5 -rotate-2 rounded-md bg-pink px-3 pt-1.5 pb-0.5 font-display text-2xl leading-none text-ink uppercase">
						Previously at
					</p>
					<ul class="flex flex-nowrap items-center justify-between gap-x-4">
						{previousCompanies.map((company, i) => (
							<li>
								<a
									href={company.url}
									target="_blank"
									rel="noopener noreferrer"
									class="ring-host group flex items-center gap-2.5 font-semibold text-paper no-underline"
								>
									<span class="relative block shrink-0">
										<img
											src={company.logo}
											alt=""
											aria-hidden="true"
											data-halftone="flat"
											data-halftone-no-invert
											class="block size-12 rounded-sm object-contain lg:size-9"
											width="48"
											height="48"
											loading="eager"
										/>
										<HoverBox index={i} />
									</span>
									<span class="sr-only group-hover:text-pink lg:not-sr-only">{company.name}</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				{/* What I do is off on phones (heading and list): the page reads straight from the
				intro into Career */}
				<h2 id="what-i-do" class={`${SECTION_HEADING} scroll-mt-24 max-md:hidden`}>
					What I do
					<Scribble
						{...MARKS.rays}
						color={'#ff4fd8'}
						duration="8s"
						delay="0.4s"
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<div class="what-i-do mb-12 md:mb-16 grid max-md:hidden md:grid-cols-[minmax(0,1fr)_220px_280px] md:gap-x-8">
					{whatIDo.map((area, i) => (
						<a
							href={area.href}
							class="ring-host group grid items-end gap-x-8 gap-y-3 border-t border-surface-4 py-4 text-paper no-underline md:col-span-3 md:grid-cols-subgrid"
						>
							<span class="font-display text-[clamp(2.125rem,4vw,3.5rem)] leading-[0.98] uppercase group-hover:text-pink">
								{area.title}
							</span>
							<span class="relative block aspect-video w-full max-w-md md:max-w-none">
								{area.frames.map((frame, f) => (
									<span
										class:list={['absolute inset-0', area.frames.length > 1 && 'frame']}
										style={`--frame: ${f}`}
									>
										<img
											src={frame.src}
											alt={f === 0 ? frame.alt : ''}
											aria-hidden={f === 0 ? undefined : 'true'}
											data-halftone={halftoneMode(frame.src)}
											class="block size-full rounded-lg object-cover"
											width="220"
											height="124"
											loading="lazy"
										/>
									</span>
								))}
								<HoverBox index={i} />
							</span>
							<span class="text-sm text-muted">{area.text}</span>
						</a>
					))}
				</div>

				<h2 id="career" class={`${SECTION_HEADING} scroll-mt-24`}>
					Career
					<Scribble
						{...MARKS.underline}
						color={CHALK}
						duration="7s"
						delay="0.0s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-6">
					{career.map((job, i) => (
						<div class="job ring-host border-t border-surface-4">
							<button
								type="button"
								class="flex w-full cursor-pointer flex-wrap items-baseline justify-between gap-x-6 pt-1.5 pb-0.5 text-left text-paper"
							>
								<span class="relative inline-flex items-center font-display text-[clamp(2.125rem,4vw,3.5rem)] leading-[0.98] uppercase">
									<span class="relative mr-4 inline-block size-[0.8em]">
										<img
											src={job.logo}
											alt=""
											aria-hidden="true"
											data-halftone="flat"
											data-halftone-no-invert
											class="block size-full rounded-sm object-contain"
											width="48"
											height="48"
											loading="lazy"
										/>
									</span>
									{job.company}
									<Scribble
										path={RINGS[i % RINGS.length]}
										color={i % 2 ? CHALK : '#ff4fd8'}
										viewBox="0 0 520 150"
										strokeWidth={7}
										ring
										class="-top-[22%] -left-[35px] h-[150%] w-[calc(100%+70px)]"
									/>
								</span>
								<span class="text-right text-sm text-muted">
									{job.role}
									<span class="ml-3 text-paper">{job.years}</span>
								</span>
							</button>
							<div class="job-body">
								<div>
									<p class="max-w-3xl pt-1 pb-5 pl-[calc(clamp(34px,4vw,56px)*0.8+1rem)] leading-relaxed text-paper">
										{job.text}
									</p>
								</div>
							</div>
						</div>
					))}
				</div>

				<p class="mb-12 md:mb-16">
					<a
						href="/resume/"
						class={`plausible-event-name=About+CTA+Click plausible-event-destination=resume-banner-top ${MORE_LINK}`}
					>
						View my full resume &rarr;
					</a>
				</p>

				<h2 id="how-i-got-here" class={`${SECTION_HEADING} mb-[0.6em]! scroll-mt-24`}>
					How I got here
					<Scribble
						{...MARKS.zigzag}
						color={CHALK}
						duration="8s"
						delay="0.4s"
						class="-bottom-[0.45em] left-0 h-[0.4em] w-full"
					/>
				</h2>
				<div class="mb-12 md:mb-16 max-w-3xl space-y-5 leading-relaxed text-paper">
					<p>
						I got a computer science degree and went straight into Microsoft SharePoint consulting
						during the Ballmer years. I was bad at coding, and SharePoint did not make it more fun.
						It was a dark time.
					</p>
					<p>
						I fell back in love with programming in Hawaii. I met a group of developers at the local
						coding bootcamp who had so much joy building whatever they wanted, and I realized I was
						good at programming as long as I was making things I wanted to make.
					</p>
					<p>
						Now I make crop art, I build fixes for small problems at home, like the old Kindle that
						became the house dashboard, and I even like the drudgery of maintaining software day in
						and day out.
					</p>
				</div>

				<h2 id="as-seen-on" class={`${SECTION_HEADING} scroll-mt-24`}>
					As seen on
					<Scribble
						{...MARKS.double}
						color={'#ff4fd8'}
						duration="10s"
						delay="0.0s"
						class="-bottom-[0.42em] left-0 h-[0.4em] w-full"
					/>
				</h2>
				{/* Bleeds to the page's own side padding (px-4 on phones, px-7 from sm), so the first
				card lines up with the text above and is never cut off at the screen edge */}
				<ul class="as-seen-on -mx-4 mb-12 md:mb-16 flex snap-x scroll-px-4 gap-5 overflow-x-auto px-4 pt-6 pb-6 sm:-mx-7 sm:scroll-px-7 sm:px-7">
					{featuredPodcasts.map((podcast, i) => (
						<li class="w-56 shrink-0 snap-start">
							<a
								href={podcast.url}
								target="_blank"
								rel="noopener noreferrer"
								class="ring-host group block text-paper no-underline"
							>
								<span class="relative mb-3 block aspect-square">
									<img
										src={podcast.image}
										alt={podcast.alt}
										data-halftone="flat"
										data-halftone-no-invert
										class="block size-full rounded-lg object-cover"
										width="224"
										height="224"
										sizes="224px"
										loading="lazy"
									/>
									<HoverBox index={i} />
								</span>
								<span class:list={[ITEM_TITLE, 'block group-hover:text-pink']}>{podcast.name}</span>
								<span class:list={[META, 'block']}>{podcast.episode}</span>
							</a>
						</li>
					))}
					{moreAppearances.map((appearance, i) => (
						<li class="w-56 shrink-0 snap-start">
							<a
								href={appearance.url}
								target="_blank"
								rel="noopener noreferrer"
								class="ring-host group block text-paper no-underline"
							>
								<span class="relative mb-3 flex aspect-square items-end rounded-lg bg-pink p-4">
									<HoverBox index={i + 2} />
									<span class="font-display text-[2.5rem] leading-[0.95] text-ink uppercase">
										{appearance.name}
									</span>
								</span>
								<span class:list={[META, 'block']}>{appearance.detail}</span>
							</a>
						</li>
					))}
					<li class="w-56 shrink-0 snap-start">
						<a href="/talks/" class="ring-host group block text-paper no-underline">
							<span class="relative mb-3 flex aspect-square items-end rounded-lg bg-pink p-4">
								<HoverBox index={moreAppearances.length + 2} />
								<span class="font-display text-[2.5rem] leading-[0.95] text-ink uppercase">
									Every talk and podcast &rarr;
								</span>
							</span>
							<span class:list={[META, 'block']}>All of them, back to 2016</span>
						</a>
					</li>
				</ul>

				<h2 id="videos" class={`${SECTION_HEADING} scroll-mt-24`}>
					Videos
					<Scribble
						{...MARKS.underline}
						color={'#ff4fd8'}
						duration="7s"
						delay="0.6s"
						class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
					/>
				</h2>
				<div class="mb-12 md:mb-16">
					<div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
						<div>
							<div class="relative">
								<YouTubeFacade
									id="GiNa2jen-lg"
