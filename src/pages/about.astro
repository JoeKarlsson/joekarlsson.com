<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.job > button')) {
		const job = button.parentElement!;
		// Set here, not in the markup: without scripts the rows stay open and the button does nothing
		button.setAttribute('aria-expanded', 'false');
		button.addEventListener('click', () => {
			const isOpen = job.classList.toggle('is-open');
			button.setAttribute('aria-expanded', String(isOpen));
			// Closed by a click under the pointer: hover mustn't hold it open until the pointer leaves
			job.classList.toggle('is-shut', !isOpen && job.matches(':hover'));
		});
		job.addEventListener('mouseleave', () => job.classList.remove('is-shut'));
	}

	// "Right now" starts folded on phones only; the summary that opens it is md:hidden,
	// so from md up it has to stay open
	const nowFold = document.querySelector<HTMLDetailsElement>('details.now-fold');
	const isPhone = window.matchMedia('(width < 48rem)');
	if (nowFold && isPhone.matches) nowFold.open = false;
	isPhone.addEventListener('change', () => {
		if (nowFold && !isPhone.matches) nowFold.open = true;
	});
</script>

<style>
	/* A career row eases open on hover and closes 20% faster; clicking keeps it open, and a
	   click closes it even under the pointer. Animating the grid
	   row from 0fr to 1fr works in every current browser, unlike height: auto. Hover opens a
	   row only under a mouse (a tap's sticky :hover would hold a closed row open) and only
	   after a 150ms rest, so a pointer sweeping down the list doesn't open every row. */
	/* visibility too, so a closed row's text is gone for screen readers and find in page,
	   matching aria-expanded; it flips back only once the close has played */
	/* Folded only when scripts run: without them the button can't open a row on a phone,
	   so every row stays open */
	@media (scripting: enabled) {
		.job-body {
			grid-template-rows: 0fr;
			opacity: 0;
			visibility: hidden;
		}
	}
	.job-body {
		display: grid;
		transition:
			grid-template-rows 0.24s ease-in-out,
			opacity 0.2s var(--ease-exit),
			visibility 0.24s;
	}
	.job-body > * {
		overflow: hidden;
	}
	.job.is-open .job-body {
		grid-template-rows: 1fr;
		opacity: 1;
		visibility: visible;
		transition-duration: 0.3s, 0.25s, 0s;
		transition-timing-function: var(--ease-enter), ease-out;
	}
	@media (hover: hover) {
		.job:hover:not(.is-open, .is-shut) .job-body {
			grid-template-rows: 1fr;
			opacity: 1;
			visibility: visible;
			transition-duration: 0.3s, 0.25s, 0s;
			transition-delay: 0.15s;
			transition-timing-function: var(--ease-enter), ease-out;
		}
	}
	/* What I do thumbnails cut through four frames, three seconds each: a hard cut,
	   like the site's other stepped motion, not a smooth crossfade */
	.frame {
		opacity: 0;
		animation: frame-cycle 12s steps(1, end) infinite;
		animation-delay: calc((var(--frame) - 4) * 3s);
	}
	@keyframes frame-cycle {
		0% {
			opacity: 0;
		}
		4%,
		25% {
			opacity: 1;
		}
		29%,
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		/* 0s, not none: none also drops the hover rest, so a passing pointer would flash rows
		   open. !important, since the open and hover rules are more specific */
		.job-body {
			transition-duration: 0s !important;
		}
		.frame {
			animation: none;
		}
		.frame:first-child {
			opacity: 1;
		}
	}
</style>
