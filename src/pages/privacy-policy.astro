---
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHALK, MARKS } from '../data/scribbles';
---

<BaseLayout
	title="Privacy Policy | Joe Karlsson"
	description="Privacy policy for joekarlsson.com covering analytics, cookies, and how your data is handled on this site."
	schemaType="WebPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-16 sm:px-7">
		<h1 class="relative mb-12 w-fit font-display text-[clamp(56px,10vw,150px)] leading-[0.88] font-normal text-paper uppercase">
			Privacy
			<Scribble
				{...MARKS.underline}
				color="#ff4fd8"
				strokeWidth={10}
				duration="8s"
				delay="0.4s"
				class="-bottom-[0.12em] left-0 h-[0.18em] w-full"
			/>
			<Scribble
				{...MARKS.asterisk}
				color={CHALK}
				duration="8s"
				delay="1.2s"
				class="-top-[0.05em] -right-[0.7em] size-[0.5em]"
			/>
		</h1>
		<div class="prose">
			<p>This website is a static site that collects minimal data.</p>

			<h2>Analytics</h2>
			<p>
				This site uses{' '}
				<a href="https://plausible.io" target="_blank" rel="noopener noreferrer">
					Plausible Analytics
				</a>
				, a privacy-friendly, self-hosted analytics tool. Plausible does not use cookies and does
				not collect any personal data. All data is aggregated and no individual visitors can be
				identified.
			</p>

			<h2>Cookies</h2>
			<p>This website does not use cookies.</p>

			<h2>Third-Party Services</h2>
			<p>This site is self-hosted on my own hardware. Google Fonts are loaded for typography.</p>

			<h2>Contact</h2>
			<p>
				If you have questions about this privacy policy, please <a href="/contact/">contact me</a>.
			</p>
		</div>
	</div>
</BaseLayout>
