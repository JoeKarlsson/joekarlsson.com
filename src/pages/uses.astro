---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const usesHeadings = [
	{ slug: 'hardware', text: 'Hardware' },
	{ slug: 'recording', text: 'Recording' },
	{ slug: 'dev-tools', text: 'Dev Tools' },
	{ slug: 'homelab', text: 'Homelab' },
	{ slug: 'smart-home', text: 'Smart Home' },
];
---

<BaseLayout
	title="Uses | Joe Karlsson"
	description="Hardware, software, and gear I use daily for development, content creation, and my homelab."
	image="/images/uses/desk-2026.webp"
	schemaType="WebPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<p class="mb-2 font-mono text-sm text-coral" aria-hidden="true">~$ cat uses.md</p>
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Uses</h1>
		<p class="mb-4 text-gray-400">
			Hardware, software, and gear I use daily for development, content creation, and running my
			homelab.
		</p>
		<div class="mb-8 rounded-lg border border-surface-3 bg-surface-1 px-5 py-4">
			<p class="text-sm text-gray-400">
				This is a living document - I update it as my setup evolves. Things get swapped out, new
				tools earn a permanent spot, and old favorites get retired. If something here looks
				outdated, it probably means I haven't gotten around to updating this page yet.
			</p>
			<p class="mt-2 text-xs text-gray-400">Last updated: September 2026</p>
		</div>

		<!-- View Toggle -->
		<div class="mb-8 flex gap-0 font-mono text-sm" role="tablist" aria-label="View mode">
			<button
				id="tab-normal"
				role="tab"
				aria-selected="true"
				aria-controls="normal-view"
				class="rounded-l-md border border-surface-3 bg-coral px-4 py-2 text-black transition-colors"
				onclick="switchView('normal')"
			>
				view: normal
			</button>
			<button
				id="tab-apt"
				role="tab"
				aria-selected="false"
				aria-controls="apt-view"
				class="rounded-r-md border border-l-0 border-surface-3 bg-surface-1 px-4 py-2 text-gray-400 transition-colors"
				onclick="switchView('apt')"
			>
				view: apt list --installed
			</button>
		</div>

		<div id="normal-view">
			<img
				src="/images/uses/desk-2026.webp"
				alt="Joe Karlsson's standing desk with two monitors, a laptop on a stand, a mic on a boom arm, a key light above the monitors, and warm LED backlighting"
				class="mb-10 w-full rounded-lg border border-surface-3"
				width="1200"
				height="675"
				loading="eager"
			/>

			<!-- Grid: TOC sidebar + sections -->
			<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
				<TableOfContents headings={usesHeadings} />
				<div>
					<!-- ═══════════════════════════════════════════ -->
					<!-- 1. Desk & Hardware                         -->
					<!-- ═══════════════════════════════════════════ -->
					<section class="mb-12" id="hardware">
						<h2 class="mb-4 text-lg font-bold text-white">
							<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls hardware/
						</h2>

						<p class="text-xs font-mono text-teal mb-3">computer & monitors</p>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.apple.com/macbook-pro/"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">14" MacBook Pro M5 Max</a
										></strong
									> - my work laptop. 18-core CPU, 32-core GPU, 36 GB of memory, 2 TB SSD. Plenty of headroom
									for Docker, multiple IDEs, and running local AI models.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.apple.com/macbook-pro/"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">14" MacBook Pro M5 Pro</a
										></strong
									> - my personal laptop, with 24 GB of memory. Having two machines means I can move between
									my desk and the recording studio without unplugging anything.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white">Monitors</strong> - <a
										href="https://www.amazon.com/Lenovo-ThinkVision-P27h-10-LED-Monitor/dp/B071DK1TW8"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">ThinkVision P27h-10</a
									> 27" QHD (right) + <a
										href="https://www.amazon.com/Dell-U2723QE-UltraSharp-USB-C-Monitor/dp/B09TQZP9CL"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">Dell U3417W</a
									> 34" 4K (left). If I were buying today, I'd go ultrawide.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.ergotron.com/en-us/products/product-details/45-245"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Ergotron LX Dual Monitor Arm</a
										></strong
									> - lets me reposition monitors based on what I'm working on and frees up desk space
									for hardware projects.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/Dell-452-BCYT-D6000-Universal-Black/dp/B071YTQBXM"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Dell Universal Dock D6000</a
										></strong
									> - bought used on eBay for under $100. Single USB-C cable for power, monitors, and
									all USB accessories.
								</p>
							</div>
						</div>

						<p class="text-xs font-mono text-teal mb-3 mt-6">input & peripherals</p>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.razer.com/pc/gaming-mice/deathadder-line"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Razer DeathAdder Chroma</a
										></strong
									> - gaming mouse.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.apple.com/shop/product/MK2C3LL/A/magic-trackpad"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Apple Magic Trackpad 2</a
										></strong
									> - for swipe and pinch controls.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.razer.com/gaming-mouse-mats/razer-goliathus-extended-chroma"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Razer Goliathus Extended Chroma</a
										></strong
									> - mousepad with RGB backlighting.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.elgato.com/en/gaming/stream-deck"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Elgato Stream Deck</a
										></strong
									> - I use this more for productivity shortcuts than streaming. Muting/unmuting in Zoom,
									launching common workflows, and triggering Home Assistant scenes from my desk.
								</p>
							</div>
						</div>

						<p class="text-xs font-mono text-teal mb-3 mt-6">keyboards</p>
						<img
							src="/images/blog/how-i-work/5422ABA8-496F-41FD-83A0-E04FD7807046-1024x823.webp"
							alt="Joe's mechanical keyboards"
							class="mb-4 w-full rounded-lg border border-surface-3"
							width="1024"
							height="823"
							loading="lazy"
						/>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/gp/product/B072LZ2YRM"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Vortexgear Race 3</a
										></strong
									> - with Cherry MX Clear switches.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://vortexgear.store/products/the-new-pok3r-rgb"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Custom Vortex POK3R</a
										></strong
									> - wood case, Cherry MX Blue switches, custom keycap set from WASD Keyboards. I like
									clicky switches - Blues are the loudest and clickiest. I'd recommend Clears as a good
									starter switch.
								</p>
							</div>
						</div>

						<p class="text-xs font-mono text-teal mb-3 mt-6">desk & audio</p>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white">Standing Desk</strong> - custom-built IKEA desktop on industrial
									black steel legs, with a Luna Standing Desk Stool.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/Sony-MDR7506-Professional-Diaphragm-Headphone/dp/B000AJIF4E"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Sony MDR7506</a
										></strong
									> - professional headphones with upgraded velvet pads. Affordable, comfortable, and
									sound great.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.bestbuy.com/site/philips-hue-play-white-color-ambiance-smart-led-bar-light-2-pack-multicolor/6298635.p"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Philips Hue Play</a
										></strong
									> - White & Color Ambiance LED Bar Lights (2-Pack) for desk backlighting.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B07YY7BH2W"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Aranet4</a
										></strong
									> - CO2 monitor on my desk. When the number climbs, I start getting foggy, so it's my
									cue to open a window or take a break.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0BJDY6D1W"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">WiiM Pro</a
										></strong
									> - plays music in my office. It's cheaper than Sonos or Bose multi-room systems, and
									in my opinion better integrated. I love it.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.home-assistant.io/voice-pe/"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Home Assistant Voice Preview Edition</a
										></strong
									> - I swapped out all of my Amazon Alexas for these. Voice processing runs locally,
									not in Amazon's cloud. I wrote about <a
										href="/blog/i-replaced-my-smart-home-with-a-dumber-home-but-at-least-its-private/"
										class="text-coral hover:text-teal">what it's like replacing Alexa</a
									> if you want to learn more.
								</p>
							</div>
						</div>

						<p class="text-xs font-mono text-teal mb-3 mt-6">camera, mic & lighting</p>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.obsbot.com/obsbot-tiny-2"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">OBSBOT Tiny 2</a
										></strong
									> - 4K AI-powered webcam with gesture control and auto-tracking. Replaced my Sony A6600
									- much simpler setup for Zoom calls and recordings.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.elgato.com/us/en/p/wave-3-black"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Elgato Wave:3</a
										></strong
									> - USB condenser mic, managed through <a
										href="https://www.elgato.com/us/en/s/wave-link"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">Wave Link</a
									> for mixing. Replaced the Blue Yeti - much better sound and integrates with the Elgato
									ecosystem.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/gp/product/B07L755X9G"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Elgato Key Lights</a
										> (x2)</strong
									> - key and fill light for calls at my desk.
								</p>
							</div>
						</div>

						<img
							src="/images/uses/desk-2026-closeup.webp"
							alt="Close-up front view of Joe's desk: two monitors on a riser with warm LED backlighting, a Stream Deck, an Aranet4 CO2 monitor, a mechanical keyboard with a wood wrist rest, and an RGB mousepad"
							class="mt-6 w-full rounded-lg border border-surface-3"
							width="1200"
							height="675"
							loading="lazy"
						/>
					</section>

					<!-- ═══════════════════════════════════════════ -->
					<!-- 2. Recording & Content                     -->
					<!-- ═══════════════════════════════════════════ -->
					<section class="mb-12" id="recording">
						<h2 class="mb-4 text-lg font-bold text-white">
							<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls recording/
						</h2>

						<p class="text-xs font-mono text-teal mb-3">recording studio</p>
						<p class="mb-3 text-sm text-gray-400">
							I built a mini recording studio in a corner of my office. It's a second, fully
							separate setup from my main desk, so I can walk over, plug in one cable, and start
							recording without tearing anything down.
						</p>
						<div class="mb-4 grid gap-4 md:grid-cols-2">
							<img
								src="/images/uses/recording-studio.webp"
								alt="Overhead view of Joe's recording studio: an acacia standing desk with a green cutting mat, a softbox light, a mic and camera on boom arms, a chair, a shelf with a 3D printer, and a palm plant"
								class="w-full rounded-lg border border-surface-3"
								width="1920"
								height="1080"
								loading="lazy"
							/>
							<img
								src="/images/uses/recording-studio-camera-view.webp"
								alt="What the camera sees in the recording studio: Joe in a green t-shirt in front of a palm plant and a shelf lit with purple ambient light"
								class="w-full rounded-lg border border-surface-3"
								width="552"
								height="310"
								loading="lazy"
							/>
						</div>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0CRZBWVRN"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Sony ZV-E10</a
										></strong
									> - mirrorless camera with the 16-50mm kit lens, and the main camera in the studio.
									It feeds the Mac through an <a
										href="https://www.amazon.com/dp/B07K3FN5MR"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">Elgato Cam Link 4K</a
									> and runs on wall power through a <a
										href="https://www.amazon.com/dp/B08BCRSV4H"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">Kimaru dummy battery</a
									>, so it never dies halfway through a take.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0CH3P9K1X"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Elgato Prompter</a
										></strong
									> - teleprompter with a built-in screen. The camera sits behind the glass, so I can
									read a script and still look into the lens.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B097376LKF"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Elgato Wave Low Profile Mic Arm</a
										> (x2)</strong
									> - one holds the mic in an <a
										href="https://www.amazon.com/dp/B088P2WK3B"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">Elgato Wave Shock Mount</a
									>, the other holds the camera and prompter. Both clamp to the desk, so the whole
									rig moves as one unit when I shuffle the room around for a better shot.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0CJM6G7JR"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">NEEWER NS4S Softboxes</a
										> + <a
											href="https://www.amazon.com/dp/B0FMKF8PXJ"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">SMALLRIG Light Stands</a
										></strong
									> - softboxes over my LED panels for soft key and fill light. The stands fold down small
									and are easy to move when I reposition the camera. An <a
										href="https://www.amazon.com/dp/B0FBGYRDLW"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">orange mushroom floor lamp</a
									> sits in the background because it looks good on camera.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0HCNVWH1D"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">FLEXISPOT E6 MAX</a
										> + <a
											href="https://www.amazon.com/dp/B0FPXPQJBT"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">HON Ignition 2.0</a
										></strong
									> - 48x24 acacia dual-motor standing desk and an ergonomic mesh chair. A <a
										href="https://www.amazon.com/dp/B08Y5R5K5J"
										target="_blank"
										rel="noopener noreferrer"
										class="text-coral hover:text-teal">WORKLION cutting mat</a
									> covers the desk and doubles as a work surface for crafts and hardware projects.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.amazon.com/dp/B0DSVVJXK5"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Anker Prime TB5 Dock</a
										></strong
									> - 14-in-1 Thunderbolt 5 dock. One cable and the laptop is plugged into everything
									in the studio.
								</p>
							</div>
						</div>

						<p class="text-xs font-mono text-teal mb-3 mt-6">recording software</p>
						<div class="divide-y divide-surface-3/50">
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.techsmith.com/camtasia.html"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Camtasia</a
										></strong
									> - my go-to for editing tutorial videos. Not as powerful as Premiere, but way faster
									for the record-edit-export workflow I need for tech content.
								</p>
							</div>
							<div class="py-3">
								<p class="text-sm text-gray-400">
									<strong class="text-white"
										><a
											href="https://www.screen.studio/"
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-teal">Screen Studio</a
										></strong
