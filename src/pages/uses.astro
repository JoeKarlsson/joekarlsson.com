---
import BaseLayout from '../layouts/BaseLayout.astro';
import nowFeed from '../data/now-feed.json';
import Scribble from '../components/Scribble.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { CHALK, HERO_COIL, MARKS } from '../data/scribbles';

const SECTION_HEADING =
	'relative mb-6 w-fit font-display text-[clamp(40px,4.6vw,64px)] leading-none font-normal text-pink uppercase';
const SUBHEADING =
	'mb-4 font-display text-[clamp(24px,2vw,30px)] leading-none font-normal text-paper uppercase';

const usesHeadings = [
	{ slug: 'hardware', text: 'Hardware' },
	{ slug: 'recording', text: 'Recording' },
	{ slug: 'dev-tools', text: 'Dev tools' },
	{ slug: 'homelab', text: 'Homelab' },
	{ slug: 'smart-home', text: 'Smart home' },
];
---

<BaseLayout
	title="Uses | Joe Karlsson"
	description="Hardware, software, and gear I use daily for development, content creation, and my homelab."
	image="/images/uses/desk-2026.webp"
	imageAlt="Joe Karlsson's standing desk with two monitors, a laptop on a stand, a mic on a boom arm, a key light above the monitors, and warm LED backlighting"
	schemaType="WebPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-7">
		<!-- Built like the homepage, About and blog heroes: the desk in pink dots beside a
		pink ticker of the sections and a dark panel whose USES fills it -->
		<header class="relative mb-14 grid gap-4 md:grid-cols-2">
			<div class="relative z-10 aspect-video md:aspect-auto">
				<img
					src="/images/uses/desk-2026.webp"
					alt="Joe Karlsson's standing desk with two monitors, a laptop on a stand, a mic on a boom arm, a key light above the monitors, and warm LED backlighting"
					data-halftone="flat"
					class="block size-full rounded-xl object-cover"
					width="1200"
					height="675"
					loading="eager"
				/>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[9%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<div class="relative grid min-w-0 grid-rows-[auto_1fr] gap-4">
				<Scribble
					{...MARKS.tally}
					color={CHALK}
					duration="9s"
					delay="0.6s"
					class="-top-[6%] -right-[3%] z-10 hidden h-[12%] w-[18%] md:block"
				/>
				<div class="ticker rounded-xl bg-pink pt-3.5 pb-2 text-ink" aria-hidden="true">
					<div class="ticker-track font-display text-[clamp(52px,6.2vw,96px)] leading-none uppercase">
						{[...usesHeadings, ...usesHeadings].map(({ text }) => (
							<>
								<span>{text}</span>
								<span class="-translate-y-[0.15em] text-[0.38em]">●</span>
							</>
						))}
					</div>
				</div>
				<div class="relative flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7">
					<div>
						<p class="text-[clamp(18px,1.5vw,22px)] text-paper">
							Hardware, software, and gear I use daily for development, content creation, and
							running my homelab.
						</p>
						<p class="mt-2 text-sm text-muted">
							I update this page as my setup changes, most recently in September 2026.
						</p>
					</div>
					<div class="@container">
						<h1 class="relative font-display text-[calc(100cqw/var(--word-ratio))] leading-[0.84] font-normal whitespace-nowrap text-paper uppercase [--word-ratio:1.86]">
							Uses
							<Scribble
								path={HERO_COIL}
								color="#ff4fd8"
								duration="9s"
								delay="0.3s"
								class="-bottom-[10%] -left-[4%] h-[60%] w-[104%]"
							/>
						</h1>
					</div>
				</div>
			</div>
		</header>

		<!-- Grid: TOC sidebar + sections -->
		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			<TableOfContents headings={usesHeadings} />
			<div>
				<!-- ═══════════════════════════════════════════ -->
				<!-- 1. Desk & Hardware                         -->
				<!-- ═══════════════════════════════════════════ -->
				<section class="mb-16 scroll-mt-24" id="hardware">
					<h2 class={SECTION_HEADING}>
						Hardware
						<Scribble
							{...MARKS.underline}
							color={CHALK}
							duration="7s"
							delay="0.0s"
							class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
						/>
					</h2>

					<h3 class={SUBHEADING}>Computer & monitors</h3>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.apple.com/macbook-pro/"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										14" MacBook Pro M5 Max
									</a>
								</strong>{' '}
								- my work laptop. 18-core CPU, 32-core GPU, 36 GB of memory, 2 TB SSD. Plenty of
								headroom for Docker, multiple IDEs, and running local AI models.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.apple.com/macbook-pro/"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										14" MacBook Pro M5 Pro
									</a>
								</strong>{' '}
								- my personal laptop, with 24 GB of memory. Having two machines means I can move
								between my desk and the recording studio without unplugging anything.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">Monitors</strong> -{' '}
								<a
									href="https://www.amazon.com/Lenovo-ThinkVision-P27h-10-LED-Monitor/dp/B071DK1TW8"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									ThinkVision P27h-10
								</a>{' '}
								27" QHD (right) +{' '}
								<a
									href="https://www.amazon.com/Dell-U2723QE-UltraSharp-USB-C-Monitor/dp/B09TQZP9CL"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									Dell U3417W
								</a>{' '}
								34" 4K (left). If I were buying today, I'd go ultrawide.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.ergotron.com/en-us/products/product-details/45-245"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Ergotron LX Dual Monitor Arm
									</a>
								</strong>{' '}
								- lets me reposition monitors based on what I'm working on and frees up desk space
								for hardware projects.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/Dell-452-BCYT-D6000-Universal-Black/dp/B071YTQBXM"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Dell Universal Dock D6000
									</a>
								</strong>{' '}
								- bought used on eBay for under $100. Single USB-C cable for power, monitors, and
								all USB accessories.
							</p>
						</div>
					</div>

					<h3 class:list={[SUBHEADING, 'mt-10']}>Input & peripherals</h3>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.razer.com/pc/gaming-mice/deathadder-line"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Razer DeathAdder Chroma
									</a>
								</strong>{' '}
								- gaming mouse.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.apple.com/shop/product/MK2C3LL/A/magic-trackpad"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Apple Magic Trackpad 2
									</a>
								</strong>{' '}
								- for swipe and pinch controls.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.razer.com/gaming-mouse-mats/razer-goliathus-extended-chroma"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Razer Goliathus Extended Chroma
									</a>
								</strong>{' '}
								- mousepad with RGB backlighting.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.elgato.com/en/gaming/stream-deck"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Elgato Stream Deck
									</a>
								</strong>{' '}
								- I use this more for productivity shortcuts than streaming. Muting/unmuting in
								Zoom, launching common workflows, and triggering Home Assistant scenes from my desk.
							</p>
						</div>
					</div>

					<h3 class:list={[SUBHEADING, 'mt-10']}>Keyboards</h3>
					<img
						src="/images/blog/how-i-work/5422ABA8-496F-41FD-83A0-E04FD7807046-1024x823.webp"
						data-halftone="flat"
						alt="Joe's mechanical keyboards"
						class="block mb-4 w-full rounded-xl"
						width="1024"
						height="823"
						loading="lazy"
					/>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/gp/product/B072LZ2YRM"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Vortexgear Race 3
									</a>
								</strong>{' '}
								- with Cherry MX Clear switches.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://vortexgear.store/products/the-new-pok3r-rgb"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Custom Vortex POK3R
									</a>
								</strong>{' '}
								- wood case, Cherry MX Blue switches, custom keycap set from WASD Keyboards. I like
								clicky switches - Blues are the loudest and clickiest. I'd recommend Clears as a
								good starter switch.
							</p>
						</div>
					</div>

					<h3 class:list={[SUBHEADING, 'mt-10']}>Desk & audio</h3>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">Standing Desk</strong> - custom-built IKEA desktop on
								industrial black steel legs, with a Luna Standing Desk Stool.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/Sony-MDR7506-Professional-Diaphragm-Headphone/dp/B000AJIF4E"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Sony MDR7506
									</a>
								</strong>{' '}
								- professional headphones with upgraded velvet pads. Affordable, comfortable, and
								sound great.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.bestbuy.com/site/philips-hue-play-white-color-ambiance-smart-led-bar-light-2-pack-multicolor/6298635.p"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Philips Hue Play
									</a>
								</strong>{' '}
								- White & Color Ambiance LED Bar Lights (2-Pack) for desk backlighting.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B07YY7BH2W"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Aranet4
									</a>
								</strong>{' '}
								- CO2 monitor on my desk. When the number climbs, I start getting foggy, so it's my
								cue to open a window or take a break.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B0BJDY6D1W"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										WiiM Pro
									</a>
								</strong>{' '}
								- plays music in my office. It's cheaper than Sonos or Bose multi-room systems, and
								in my opinion better integrated. I love it.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.home-assistant.io/voice-pe/"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Home Assistant Voice Preview Edition
									</a>
								</strong>{' '}
								- I swapped out all of my Amazon Alexas for these. Voice processing runs locally,
								not in Amazon's cloud. I wrote about{' '}
								<a
									href="/blog/i-replaced-my-smart-home-with-a-dumber-home-but-at-least-its-private/"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									what it's like replacing Alexa
								</a>{' '}
								if you want to learn more.
							</p>
						</div>
					</div>

					<h3 class:list={[SUBHEADING, 'mt-10']}>Camera, mic & lighting</h3>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.obsbot.com/obsbot-tiny-2"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										OBSBOT Tiny 2
									</a>
								</strong>{' '}
								- 4K AI-powered webcam with gesture control and auto-tracking. Replaced my Sony
								A6600 - much simpler setup for Zoom calls and recordings.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.elgato.com/us/en/p/wave-3-black"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Elgato Wave:3
									</a>
								</strong>{' '}
								- USB condenser mic, managed through{' '}
								<a
									href="https://www.elgato.com/us/en/s/wave-link"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									Wave Link
								</a>{' '}
								for mixing. Replaced the Blue Yeti - much better sound and integrates with the
								Elgato ecosystem.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/gp/product/B07L755X9G"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Elgato Key Lights
									</a>{' '}
									(x2)
								</strong>{' '}
								- key and fill light for calls at my desk.
							</p>
						</div>
					</div>

					<img
						src="/images/uses/desk-2026-closeup.webp"
						data-halftone="flat"
						alt="Close-up front view of Joe's desk: two monitors on a riser with warm LED backlighting, a Stream Deck, an Aranet4 CO2 monitor, a mechanical keyboard with a wood wrist rest, and an RGB mousepad"
						class="block mt-6 w-full rounded-xl"
						width="1200"
						height="675"
						loading="lazy"
					/>
				</section>

				<!-- ═══════════════════════════════════════════ -->
				<!-- 2. Recording & Content                     -->
				<!-- ═══════════════════════════════════════════ -->
				<section class="mb-16 scroll-mt-24" id="recording">
					<h2 class={SECTION_HEADING}>
						Recording
						<Scribble
							{...MARKS.rays}
							color="#ff4fd8"
							duration="8s"
							delay="0.6s"
							class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
						/>
					</h2>

					<h3 class={SUBHEADING}>Recording studio</h3>
					<p class="mb-4 text-muted">
						I built a mini recording studio in a corner of my office. It's a second, fully separate
						setup from my main desk, so I can walk over, plug in one cable, and start recording
						without tearing anything down.
					</p>
					<div class="mb-4 grid gap-4 md:grid-cols-2">
						<img
							src="/images/uses/recording-studio.webp"
							data-halftone="flat"
							alt="Overhead view of Joe's recording studio: an acacia standing desk with a green cutting mat, a softbox light, a mic and camera on boom arms, a chair, a shelf with a 3D printer, and a palm plant"
							class="block w-full rounded-xl"
							width="1920"
							height="1080"
							loading="lazy"
						/>
						<img
							src="/images/uses/recording-studio-camera-view.webp"
							data-halftone="flat"
							alt="What the camera sees in the recording studio: Joe in a green t-shirt in front of a palm plant and a shelf lit with purple ambient light"
							class="block w-full rounded-xl"
							width="552"
							height="310"
							loading="lazy"
						/>
					</div>
					<div class="space-y-4">
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B0CRZBWVRN"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Sony ZV-E10
									</a>
								</strong>{' '}
								- mirrorless camera with the 16-50mm kit lens, and the main camera in the studio. It
								feeds the Mac through an{' '}
								<a
									href="https://www.amazon.com/dp/B07K3FN5MR"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									Elgato Cam Link 4K
								</a>{' '}
								and runs on wall power through a{' '}
								<a
									href="https://www.amazon.com/dp/B08BCRSV4H"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									Kimaru dummy battery
								</a>
								, so it never dies halfway through a take.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B0CH3P9K1X"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Elgato Prompter
									</a>
								</strong>{' '}
								- teleprompter with a built-in screen. The camera sits behind the glass, so I can
								read a script and still look into the lens.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B097376LKF"
										target="_blank"
										rel="noopener noreferrer"
										class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
									>
										Elgato Wave Low Profile Mic Arm
									</a>{' '}
									(x2)
								</strong>{' '}
								- one holds the mic in an{' '}
								<a
									href="https://www.amazon.com/dp/B088P2WK3B"
									target="_blank"
									rel="noopener noreferrer"
									class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
								>
									Elgato Wave Shock Mount
								</a>
								, the other holds the camera and prompter. Both clamp to the desk, so the whole rig
								moves as one unit when I shuffle the room around for a better shot.
							</p>
						</div>
						<div>
							<p class="text-muted">
								<strong class="text-paper">
									<a
										href="https://www.amazon.com/dp/B0CJM6G7JR"
										target="_blank"
										rel="noopener noreferrer"
