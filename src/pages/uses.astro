---
// /uses: each section is built around one real photo of the gear, marked up in crayon.
// Numbered pins on the photo match the numbers in the list beside it; hovering either
// circles both, and clicking a pin brings its entry up beside the photo (wider screens
// only: phones skip the pins and fold the list, phone-collapse.ts). Content lives
// in src/data/uses.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import KeepExploring from '../components/KeepExploring.astro';
import PosterHero from '../components/PosterHero.astro';
import Scribble from '../components/Scribble.astro';
import { GROUP_HEADING, HERO_LEAD, SECTION_HEADING, TEXT_LINK } from '../utils/ui';
import nowFeed from '../data/now-feed.json';
import { ARROW, CHALK, MARKS, RINGS } from '../data/scribbles';
import { USES_SECTIONS } from '../data/uses';
import {
	AMAZON_DISCLOSURE,
	isAmazonUrl,
	tagAmazonLinksInHtml,
	withAmazonTag,
} from '../utils/affiliate';

const PINK = '#ff4fd8';

/** The data file's links get the site's link style and Amazon tag, and the live container count fills in. */
const html = (s: string) =>
	tagAmazonLinksInHtml(s)
		.replaceAll('data-text-link', `class="${TEXT_LINK}"`)
		.replaceAll('{runningContainers}', String(nowFeed.homelab.runningContainers));

const slugify = (s: string) =>
	s
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');

// A few small marks per section, placed by hand: on the photo's corners (`shot`), beside
// the heading (`head`) and above the list (`list`). They bleed past their boxes on purpose.
type Mark = {
	path: string;
	viewBox?: string;
	color: string;
	strokeWidth: number;
	class: string;
	duration: string;
	delay: string;
};
const mark = (
	name: keyof typeof MARKS,
	color: string,
	strokeWidth: number,
	className: string,
	duration: string,
	delay = '0s',
): Mark => ({ ...MARKS[name], color, strokeWidth, class: className, duration, delay });

const SECTION_MARKS: { shot: Mark[]; head: Mark[]; list: Mark[] }[] = [
	{
		shot: [
			mark('burst', CHALK, 6, '-top-[9%] -left-[4%] h-[24%] w-[15%]', '8s', '1.2s'),
			mark('hatch', CHALK, 5, '-right-[5%] -bottom-[10%] h-[16%] w-[18%]', '10s', '2s'),
		],
		head: [],
		list: [
			{
				path: ARROW,
				viewBox: '0 0 260 140',
				color: PINK,
				strokeWidth: 6,
				class: '-top-[60px] -left-[120px] h-[80px] w-[150px] -scale-x-100',
				duration: '9s',
				delay: '1s',
			},
		],
	},
	{
		shot: [mark('hatch', PINK, 5, '-bottom-[10%] -left-[5%] h-[16%] w-[18%]', '9s', '1.4s')],
		head: [mark('asterisk', PINK, 7, '-top-[30px] -right-[56px] size-[46px]', '8s')],
		list: [mark('pointer', CHALK, 6, '-top-[56px] -left-[40px] h-[48px] w-[120px]', '9s', '1s')],
	},
	{
		shot: [mark('asterisk', PINK, 7, '-top-[10%] right-[4%] h-[16%] w-[9%]', '7s', '1.6s')],
		head: [mark('burstDense', PINK, 5, '-top-[30px] -right-[80px] size-[64px]', '9s')],
		list: [mark('tally', CHALK, 6, '-top-[70px] right-0 h-[56px] w-[110px]', '10s', '0.6s')],
	},
	{
		shot: [mark('rays', CHALK, 7, '-top-[14%] -right-[4%] h-[16%] w-[14%]', '8s', '1s')],
		head: [],
		list: [mark('pointer', PINK, 6, '-top-[56px] -left-[40px] h-[48px] w-[120px]', '9s', '1.4s')],
	},
	{
		shot: [mark('burst', PINK, 6, 'top-[52%] -right-[14%] h-[14%] w-[24%]', '8s', '1.4s')],
		head: [mark('rays', PINK, 7, '-top-[44px] -right-[72px] h-[56px] w-[70px]', '8s')],
		list: [mark('hatch', PINK, 5, '-top-[74px] right-0 h-[60px] w-[120px]', '10s', '0.8s')],
	},
	{
		shot: [mark('check', CHALK, 8, '-bottom-[14%] -left-[6%] h-[18%] w-[16%]', '7s', '2s')],
		head: [mark('asterisk', CHALK, 7, '-top-[30px] -right-[60px] size-[46px]', '7s')],
		list: [mark('tally', PINK, 6, '-top-[70px] right-0 h-[56px] w-[110px]', '10s', '0.6s')],
	},
];
const GROUP_UNDERLINES = ['underline', 'double', 'lines'] as const;

// Number the pinned items in list order, per section
const sections = USES_SECTIONS.map((section) => {
	let n = 0;
	return {
		...section,
		groups: section.groups.map((group) => ({
			...group,
			items: group.items.map((item) => ({
				...item,
				id: `${section.slug}-${slugify(item.name)}`,
				number: item.pin ? ++n : undefined,
			})),
		})),
	};
});
---

<BaseLayout
	title="Uses | Joe Karlsson"
	description="Hardware, software, and gear I use daily for development, content creation, and my homelab."
	image="/images/uses/desk-2026.webp"
	imageAlt="Joe Karlsson's standing desk with two monitors, a laptop on a stand, a mic on a boom arm, a key light above the monitors, and warm LED backlighting"
	schemaType="WebPage"
>
	<!-- Wider than PAGE_CONTAINER (max-w-6xl) on purpose: the photos need the room -->
	<div class="relative mx-auto max-w-[90rem] px-4 pt-6 pb-10 sm:px-7 md:pt-10">
		<PosterHero
			decorativeMedia
			title="Uses"
			wordRatio={1.86}
			tickerItems={USES_SECTIONS.map(({ name }) => name)}
		>
			<div slot="media" class="relative z-10 aspect-[5/4] md:aspect-auto">
				<video
					src="/images/uses/joe-uses.mp4"
					poster="/images/uses/joe-uses-poster.webp"
					data-halftone="flat"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Joe Karlsson talking at his desk in pink light, pointing back at his monitors and waving"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[9%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class={HERO_LEAD}>
				Hardware, software, and gear I use daily for development, content creation, and running my
				homelab.
			</p>
			<p class="mt-3 text-sm text-muted">{AMAZON_DISCLOSURE}</p>
		</PosterHero>

		{sections.map((section, si) => {
			const marks = SECTION_MARKS[si];
			const pinned = section.groups.flatMap((g) => g.items).filter((item) => item.pin);
			return (
				<section
					id={section.slug}
					class="relative scroll-mt-24 pt-12 first-of-type:pt-0 md:pt-16 md:first-of-type:pt-0"
				>
					<h2 class={SECTION_HEADING}>
						{section.name}
						<Scribble
							{...MARKS[si % 2 ? 'underline' : 'double']}
							color={si % 2 ? CHALK : PINK}
							duration={`${9 + si}s`}
							class="-bottom-[0.34em] left-0 h-[0.3em] w-full"
						/>
						{marks.head.map((m) => (
							<Scribble {...m} />
						))}
					</h2>
					{section.introHtml && (
						<p class="mb-6 max-w-[46em] text-paper" set:html={html(section.introHtml)} />
					)}
					<div
						class:list={[
							'grid items-start gap-12 md:grid',
							section.photo.tall
								? 'md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]'
								: 'md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]',
						]}
					>
						<div class="uses-shot relative md:sticky md:top-[100px]">
							<img
								src={section.photo.src}
								alt={section.photo.alt}
								data-halftone="flat"
								class="block w-full rounded-xl"
								width={section.photo.width}
								height={section.photo.height}
								sizes="(min-width: 768px) 50vw, 100vw"
								loading={si === 0 ? 'eager' : 'lazy'}
							/>
							{pinned.map((item, pi) => (
								<a
									href={`#${item.id}`}
									class="uses-pin ring-host"
									data-pin={item.id}
									style={`left:${item.pin![0]}%;top:${item.pin![1]}%`}
									aria-label={`${item.number}: ${item.name}`}
								>
									{item.number}
									<Scribble
										path={RINGS[pi % RINGS.length]}
										viewBox="0 0 520 150"
										color={PINK}
										strokeWidth={4}
										ring
										class="-top-[13px] -left-[41px] h-[70px] w-[140px]"
									/>
								</a>
							))}
							{marks.shot.map((m) => (
								<Scribble {...m} />
							))}
						</div>
						<div class="relative">
							{marks.list.map((m) => (
								<Scribble {...m} />
							))}
							{section.groups.map((group, gi) => (
								<div class="uses-group" data-phone-collapse={gi === 0 ? 'open' : ''}>
									<h3
										data-collapse-heading
										class:list={[GROUP_HEADING, 'relative mb-4 w-fit max-md:w-full']}
									>
										{group.name}
										<Scribble
											{...MARKS[GROUP_UNDERLINES[(gi + si) % 3]]}
											color={(gi + si) % 2 ? CHALK : PINK}
											strokeWidth={5}
											duration={`${9 + gi}s`}
											delay={`${gi * 0.4}s`}
											class="-bottom-[0.38em] left-0 h-[0.3em] w-full"
										/>
									</h3>
									<ul data-collapse-body class="space-y-4">
										{group.items.map((item, ii) => (
											<li
												id={item.id}
												data-pin={item.number ? item.id : undefined}
												class="uses-item grid scroll-mt-[100px] grid-cols-[34px_1fr] gap-2"
											>
												<span
													class="font-display text-[22px] leading-tight text-pink"
													aria-hidden="true"
												>
													{item.number}
												</span>
												<div class="text-paper">
													<p class="relative w-fit font-semibold">
														{item.url ? (
															<a
																href={withAmazonTag(item.url)}
																target="_blank"
																rel={
																	isAmazonUrl(item.url)
																		? 'sponsored noopener noreferrer'
																		: 'noopener noreferrer'
																}
																class={TEXT_LINK}
															>
																{item.name}
															</a>
														) : item.nameHtml ? (
															<span set:html={html(item.nameHtml)} />
														) : (
															item.name
														)}
														{/* The odd name gets a crayon circle that stays */}
														{(ii + gi + si) % 7 === 3 && (
															<Scribble
																path={RINGS[(ii + gi + si) % RINGS.length]}
																viewBox="0 0 520 150"
																stretch
																color={CHALK}
																strokeWidth={4}
																duration="10s"
																delay={`${ii * 0.3}s`}
																class="-top-[30%] -left-[10%] h-[160%] w-[120%]"
															/>
														)}
														{/* Clicking its pin circles the name in pink, with the pin's own ring */}
														{item.number && (
															<Scribble
																path={RINGS[(item.number - 1) % RINGS.length]}
																viewBox="0 0 520 150"
																color={PINK}
																strokeWidth={4}
																ring
																class="-top-[30%] -left-[10%] h-[160%] w-[120%]"
															/>
														)}
													</p>
													<p set:html={html(item.descHtml)} />
												</div>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				</section>
			);
		})}

		<p class="mt-12 text-paper md:mt-16">
			Inspired by{' '}
			<a href="https://uses.tech" target="_blank" rel="noopener noreferrer" class={TEXT_LINK}>
				uses.tech
			</a>{' '}
			- a list of developer /uses pages.
		</p>
		<KeepExploring
			heading="Read this next"
			from="/uses/"
			posts={[
				'my-development-setup-2026',
				'homelab-two-years-later',
				'opentofu-proxmox-immutable-homelab',
			]}
		/>
	</div>
</BaseLayout>

<style>
	.uses-group + .uses-group {
		margin-top: 40px;
	}
	/* Phones fold each group to its heading (phone-collapse.ts); folded ones sit closer.
	   The pins go: at phone width they bunch up too close to tap apart, and the
	   numbered list says the same thing */
	@media (width < 48rem) {
		.uses-group + .uses-group {
			margin-top: 24px;
		}
		.uses-shot .uses-pin {
			display: none;
		}
	}
	/* A pin: a big chalk number with a black outline so it reads on any part of the photo.
	   The number is about 15px wide; the link itself is a 44px square round it, so the
	   whole square takes the tap and counts as the target. */
	.uses-pin {
		position: absolute;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		transform: translate(-50%, -50%);
		font-family: var(--font-anton);
		font-size: 30px;
		line-height: 1;
		color: #ece6da; /* CHALK */
		-webkit-text-stroke: 6px #000;
		paint-order: stroke fill;
		text-decoration: none;
	}
	.uses-pin.is-lit,
	.uses-item.is-lit p:first-child,
	.uses-item.is-lit p:first-child a {
		color: #ff4fd8;
	}
	/* A lit pin keeps its ring drawn, like a hovered one */
	:global(.ring-host.is-lit .hover-ring) {
		visibility: visible;
		stroke-dashoffset: 0;
	}
	/* The entry a clicked pin points at gets the same ring round its name; a chalk
	   circle already on that name steps aside so there's one ring, not two */
	.uses-item.is-held :global(.hover-ring) {
		visibility: visible;
		stroke-dashoffset: 0;
	}
	.uses-item.is-held :global(svg.redraw) {
		visibility: hidden;
	}
</style>

<script>
	import { initPhoneCollapse, openFoldAround, previewFoldAround } from '../scripts/phone-collapse';

	initPhoneCollapse();

	// Pins and list entries light each other up on hover. Clicking a pin brings its entry
	// up level with the photo's top, but never so far that the sticky photo runs out of
	// section and scrolls away; the pair stays lit until another pin is clicked.
	const STICKY_TOP = 100;
	const pairOf = (id: string) => document.querySelectorAll<HTMLElement>(`[data-pin="${id}"]`);

	document.querySelectorAll<HTMLElement>('[data-pin]').forEach((el) => {
		const id = el.dataset.pin!;
		el.addEventListener('mouseenter', () => pairOf(id).forEach((x) => x.classList.add('is-lit')));
		el.addEventListener('mouseleave', () =>
			pairOf(id).forEach((x) => x.classList.contains('is-held') || x.classList.remove('is-lit')),
		);
	});

	document.querySelectorAll<HTMLAnchorElement>('a.uses-pin').forEach((pin) => {
		const entry = document.getElementById(pin.dataset.pin!);
		const shot = pin.closest<HTMLElement>('.uses-shot');
		if (!entry || !shot) throw new Error(`/uses pin ${pin.dataset.pin} has no entry or photo`);
		// A folded group (page loaded narrow, then widened) shows while its pin is hovered
		pin.addEventListener('mouseenter', () => previewFoldAround(entry, true));
		pin.addEventListener('mouseleave', () => previewFoldAround(entry, false));
		pin.addEventListener('click', (event) => {
			event.preventDefault();
			// Open the entry's group first if it's folded, so the scroll lands on it
			openFoldAround(entry);
			const wanted = scrollY + entry.getBoundingClientRect().top - STICKY_TOP;
			const photoStillFits =
				scrollY +
				shot.parentElement!.getBoundingClientRect().bottom -
				shot.offsetHeight -
				STICKY_TOP;
			scrollTo({ top: Math.min(wanted, photoStillFits), behavior: 'smooth' });
			document.querySelectorAll('.is-held').forEach((x) => x.classList.remove('is-held', 'is-lit'));
			pairOf(pin.dataset.pin!).forEach((x) => x.classList.add('is-held', 'is-lit'));
		});
	});
</script>
