---
// The web resume. The PDF is a separate page (resume-pdf.astro, printed by
// npm run generate:resume), so this one can be pink on black.
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHero from '../components/PosterHero.astro';
import {
	ITEM_TITLE,
	MORE_LINK,
	PAGE_CONTAINER,
	PRIMARY_BUTTON,
	SECTION_HEADING,
	TEXT_LINK,
} from '../utils/ui';
import KeepExploring from '../components/KeepExploring.astro';
import { SOCIAL_LINKS } from '../consts';
import { CHALK, MARKS } from '../data/scribbles';
import { roles, education, skills, highlights, openSource, writingSamples } from '../data/resume';
import { projects } from '../data/projects';

function formatYearRange(start: number, end: number | null): string {
	return end ? `${start} - ${end}` : `${start} - Present`;
}

// The pink band pins one piece of real work, the one closest to the job
const RESUME_PIECE = 'Connect AI × DOOM';
const resumePiece = projects.find((p) => p.title === RESUME_PIECE);
if (!resumePiece?.page)
	throw new Error(`RESUME_PIECE "${RESUME_PIECE}" needs a /work/ page in projects.ts`);
// Rows with a narrow left column (dates, labels) beside the content
const ROW = 'grid gap-x-8 gap-y-2 border-t border-surface-4 pt-5 md:grid-cols-[11rem_1fr]';
---

<BaseLayout
	title="Resume | Joe Karlsson"
	description="Joe Karlsson's resume: Principal Developer Marketing Engineer at CData. Before that, CloudQuery, Tinybird, SingleStore, MongoDB and Best Buy."
	schemaType="ProfilePage"
>
	<div class={PAGE_CONTAINER}>
		<!-- My headshot in pink dots beside one piece of my work in the pink band, and
		who I am, where to find me and the PDF in the dark panel -->
		<PosterHero
			decorativeMedia
			title="Resume"
			wordRatio={3}
			featured={{
				label: 'Featured',
				title: resumePiece.title,
				href: `/work/${resumePiece.page.slug}/`,
				meta: resumePiece.shareTitle?.split(': ')[1],
			}}
		>
			<div slot="media" class="relative z-10 aspect-square md:aspect-auto">
				<img
					src="/images/joe-headshot.webp"
					alt="Joe Karlsson in profile in a white tank top, looking right, against a warm wall in golden-hour light"
					data-halftone="flat"
					class="block size-full rounded-xl bg-ink object-cover"
					width="640"
					height="640"
					loading="eager"
					fetchpriority="high"
				/>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<div>
				<p class="relative w-fit font-display text-[clamp(2.25rem,3.6vw,3.5rem)] leading-none text-paper uppercase">
					Joe Karlsson
					<Scribble
						{...MARKS.underline}
						color="#ff4fd8"
						strokeWidth={10}
						duration="8s"
						delay="0.3s"
						class="-bottom-[0.3em] left-0 h-[0.25em] w-full"
					/>
				</p>
				<p class="mt-4 text-lg text-paper">Principal Developer Marketing Engineer</p>
				<!-- Each link is a 24px target on desktop (WCAG 2.2) and a 44px tap target on phones; the padding spaces the rows -->
				<p class="mt-4 flex flex-wrap gap-x-6 text-sm max-md:[&>a]:py-3">
					<a
						href={SOCIAL_LINKS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class={`${TEXT_LINK} py-0.5`}
					>
						linkedin/in/joekarlsson
					</a>
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class={`${TEXT_LINK} py-0.5`}
					>
						github/JoeKarlsson
					</a>
					<a href="https://www.joekarlsson.com" class={`${TEXT_LINK} py-0.5`}>
						joekarlsson.com
					</a>
				</p>
			</div>
			<div class="mt-6 flex flex-wrap items-center gap-4">
				<a
					href="/joe-karlsson-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class={`plausible-event-name=Resume+Download ${PRIMARY_BUTTON}`}
				>
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
					</svg>
					Download PDF
				</a>
				<a href="/about/" class={MORE_LINK}>
					Full bio &rarr;
				</a>
			</div>
		</PosterHero>

		<p class="mb-12 max-w-[65ch] md:mb-16 font-serif text-[clamp(1.1875rem,1.6vw,1.4375rem)] leading-relaxed text-paper">
			I've spent 15 years making complex data systems click for developers - through talks, docs,
			demos, and content. I build and run DevRel functions at data companies, with a track record in
			organic growth, developer activation, and pipeline influence. So far that's 100+ conference
			talks and 5 data companies.
		</p>

		<h2 class={SECTION_HEADING}>
			Experience
			<Scribble
				{...MARKS.underline}
				color={CHALK}
				duration="8s"
				delay="0.2s"
				class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
			/>
		</h2>
		<div class="mb-12 md:mb-16 space-y-8">
			{roles.map((role) => (
				<div class={ROW}>
					<p class="text-sm text-muted">
						{formatYearRange(role.startYear, role.endYear)}
						<span class="block">{role.location}</span>
					</p>
					<div>
						<div class="mb-3 flex items-center gap-3">
							{role.logo && (
								<span class="relative block shrink-0">
									<img
										src={role.logo}
										alt=""
										aria-hidden="true"
										data-halftone="flat"
										class="block h-9 w-9 rounded-sm object-contain"
										width="36"
										height="36"
										loading="lazy"
									/>
								</span>
							)}
							<div>
								<h3 class={ITEM_TITLE}>{role.title}</h3>
								<p class="text-sm text-paper">{role.company}</p>
							</div>
						</div>
						<ul class="mb-3 max-w-[65ch] list-disc space-y-1.5 pl-5 text-paper marker:text-pink">
							{role.bullets.map((b) => (
								<li>
									{typeof b === 'string' ? (
										b
									) : (
										<>
											{b.text}{' '}
											<a
												href={b.link.url}
												target="_blank"
												rel="noopener noreferrer"
												class={TEXT_LINK}
											>
												({b.link.label} &rarr;)
											</a>
										</>
									)}
								</li>
							))}
						</ul>
						<p class="text-sm text-muted">{role.tech.join(' · ')}</p>
					</div>
				</div>
			))}
		</div>

		<h2 class={SECTION_HEADING}>
			Skills
			<Scribble
				{...MARKS.rays}
				color="#ff4fd8"
				duration="7s"
				delay="0.6s"
				class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
			/>
		</h2>
		<dl class="mb-12 md:mb-16 space-y-4">
			{skills.map((group) => (
				<div class={ROW}>
					<dt class="font-semibold text-paper">{group.category}</dt>
					<dd class="text-paper">{group.items.join(', ')}</dd>
				</div>
			))}
		</dl>

		<h2 class={SECTION_HEADING}>
			Highlights
			<Scribble
				{...MARKS.asterisk}
				color={CHALK}
				duration="8s"
				delay="1.2s"
				class="-top-[0.15em] -right-[0.8em] size-[0.6em]"
			/>
		</h2>
		<ul class="mb-12 md:mb-16 list-disc space-y-2 pl-5 text-paper marker:text-pink">
			{highlights.map((h) => (
				<li>{h}</li>
			))}
		</ul>

		<h2 class={SECTION_HEADING}>
			Writing
			<Scribble
				{...MARKS.double}
				color="#ff4fd8"
				duration="9s"
				delay="0.4s"
				class="-bottom-[0.42em] left-0 h-[0.4em] w-full"
			/>
		</h2>
		<div class="mb-12 md:mb-16 space-y-8">
			{writingSamples.map((group) => (
				<div class={ROW}>
					<h3 class="font-semibold text-paper">{group.category}</h3>
					<ul class="space-y-3">
						{group.items.map((item) => (
							<li>
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class={`plausible-event-name=Resume+Writing+Sample+Click leading-snug ${TEXT_LINK} max-md:inline-block max-md:py-3 max-md:-my-3`}
								>
									{item.title}
								</a>
								<p class="text-sm text-muted">
									{item.publisher}
									{item.note && ` - ${item.note}`}
								</p>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<h2 class={SECTION_HEADING}>
			Projects
			<Scribble
				{...MARKS.underline}
				color={CHALK}
				duration="8s"
				delay="0.9s"
				class="-bottom-[0.32em] left-0 h-[0.3em] w-full"
			/>
		</h2>
		<ul class="mb-12 md:mb-16 grid gap-x-8 gap-y-6 md:grid-cols-2">
			{openSource.map((project) => (
				<li class="border-t border-surface-4 pt-5">
					<a
						href={project.url}
						target={project.url.startsWith('http') ? '_blank' : undefined}
						rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
						class={`plausible-event-name=Resume+Project+Click font-semibold ${TEXT_LINK}`}
					>
						{project.name}
					</a>
					<p class="mt-1 leading-relaxed text-paper">{project.description}</p>
					<p class="mt-1 text-sm text-muted">{project.tech.join(' · ')}</p>
				</li>
			))}
		</ul>

		<h2 class={SECTION_HEADING}>
			Education
			<Scribble
				{...MARKS.rays}
				color={CHALK}
				duration="7s"
				delay="0.3s"
				class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
			/>
		</h2>
		<div class:list={[ROW, 'mb-12 md:mb-16']}>
			<p class="text-sm text-muted">
				{education.years}
				{education.gpa && <span class="block">GPA: {education.gpa}</span>}
			</p>
			<div>
				<h3 class={ITEM_TITLE}>{education.degree}</h3>
				<p class="text-sm text-paper">{education.school}</p>
				{education.minors && (
					<p class="text-sm text-muted">Minors: {education.minors.join(', ')}</p>
				)}
			</div>
		</div>

		<KeepExploring
			heading="See the work"
			from="/resume/"
			door={{
				href: '/talks/',
				label: 'My talks',
				blurb: 'Conference talks, workshops and podcasts since 2019.',
			}}
		/>
	</div>
</BaseLayout>
