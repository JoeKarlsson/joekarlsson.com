---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS } from '../consts';
import { roles, education, skills, highlights, openSource, writingSamples } from '../data/resume';

function formatYearRange(start: number, end: number | null): string {
	return end ? `${start} - ${end}` : `${start} - Present`;
}
---

<BaseLayout
	title="Resume | Joe Karlsson"
	description="Joe Karlsson's resume. Principal Developer Marketing Manager at CData and software engineer with 15+ years at data companies including CloudQuery, Tinybird, SingleStore, MongoDB, and Best Buy."
	schemaType="ProfilePage"
>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
			<div>
				<h1 class="mb-1 text-3xl font-bold text-white md:text-4xl">Joe Karlsson</h1>
				<p class="text-lg text-gray-300">Principal Developer Marketing Manager</p>
				<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-400">
					<a
						href={SOCIAL_LINKS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-coral no-underline"
					>
						linkedin/in/joekarlsson
					</a>
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-coral no-underline"
					>
						github/JoeKarlsson
					</a>
					<a href="https://www.joekarlsson.com" class="hover:text-coral no-underline">
						joekarlsson.com
					</a>
				</div>
			</div>
			<div class="flex flex-col gap-2 sm:items-end">
				<a
					href="/joe-karlsson-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="plausible-event-name=Resume+Download inline-flex items-center gap-2 rounded-md bg-coral px-4 py-2 font-medium text-surface-0 no-underline hover:bg-white text-sm"
				>
					<svg
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						aria-hidden="true"
					>
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
					</svg>
					Download PDF
				</a>
				<a href="/about/" class="text-sm text-gray-400 hover:text-coral no-underline sm:text-right">
					Full bio &rarr;
				</a>
			</div>
		</div>

		<p class="mb-12 text-gray-300 leading-relaxed max-w-2xl">
			I've spent 15 years making complex data systems click for developers - through talks, docs,
			demos, content, and building things that probably shouldn't exist. I build and run DevRel
			functions at data companies, embedded across Sales, Product, and Engineering, with a track
			record in organic growth, developer activation, and pipeline influence. So far that's 100+
			conference talks and 5 data companies.
		</p>

		<h2 class="mb-6 text-2xl font-semibold text-white">Experience</h2>
		<div class="mb-12 space-y-10">
			{roles.map((role) => (
				<div>
					<div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
						<div class="flex items-center gap-3">
							{role.logo && (
								<img
									src={role.logo}
									alt=""
									aria-hidden="true"
									class="h-8 w-8 rounded-sm object-contain"
									width="32"
									height="32"
									loading="lazy"
								/>
							)}
							<div>
								<h3 class="font-semibold text-white leading-tight">{role.title}</h3>
								<p class="text-sm text-gray-300">{role.company}</p>
							</div>
						</div>
						<p class="text-sm text-gray-400 sm:text-right shrink-0">
							{formatYearRange(role.startYear, role.endYear)}
							<span class="block">{role.location}</span>
						</p>
					</div>
					<ul class="mb-3 list-disc space-y-1.5 pl-5 text-gray-300 marker:text-gray-500">
						{role.bullets.map((b) => (
							<li>
								{typeof b === 'string' ? (
									b
								) : (
									<>
										{b.text}{' '}
										<a
											href={b.link.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-coral hover:text-white"
										>
											({b.link.label} &rarr;)
										</a>
									</>
								)}
							</li>
						))}
					</ul>
					<p class="text-sm text-gray-400">{role.tech.join(' · ')}</p>
				</div>
			))}
		</div>

		<h2 class="mb-4 text-2xl font-semibold text-white">Skills</h2>
		<dl class="mb-12 space-y-4">
			{skills.map((group) => (
				<div>
					<dt class="font-medium text-white">{group.category}</dt>
					<dd class="text-gray-400">{group.items.join(', ')}</dd>
				</div>
			))}
		</dl>

		<h2 class="mb-4 text-2xl font-semibold text-white">Highlights</h2>
		<ul class="mb-12 list-disc space-y-2 pl-5 text-gray-300 marker:text-gray-500">
			{highlights.map((h) => (
				<li>{h}</li>
			))}
		</ul>

		<h2 class="mb-4 text-2xl font-semibold text-white">Writing</h2>
		<div class="mb-12 space-y-8">
			{writingSamples.map((group) => (
				<div>
					<h3 class="mb-3 font-medium text-white">{group.category}</h3>
					<ul class="space-y-3">
						{group.items.map((item) => (
							<li>
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="plausible-event-name=Resume+Writing+Sample+Click text-gray-300 no-underline hover:text-coral leading-snug"
								>
									{item.title}
								</a>
								<p class="text-sm text-gray-400">
									{item.publisher}
									{item.note && ` - ${item.note}`}
								</p>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<h2 class="mb-4 text-2xl font-semibold text-white">Projects</h2>
		<ul class="mb-12 space-y-6">
			{openSource.map((project) => (
				<li>
					<a
						href={project.url}
						target={project.url.startsWith('http') ? '_blank' : undefined}
						rel={project.url.startsWith('http') ? 'noopener noreferrer' : undefined}
						class="plausible-event-name=Resume+Project+Click font-medium text-white no-underline hover:text-coral"
					>
						{project.name}
					</a>
					<p class="text-gray-300 leading-relaxed">{project.description}</p>
					<p class="text-sm text-gray-400">{project.tech.join(' · ')}</p>
				</li>
			))}
		</ul>

		<h2 class="mb-4 text-2xl font-semibold text-white">Education</h2>
		<div class="mb-12 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
			<div>
				<h3 class="font-semibold text-white">{education.degree}</h3>
				<p class="text-sm text-gray-300">{education.school}</p>
				{education.minors && (
					<p class="text-sm text-gray-400">Minors: {education.minors.join(', ')}</p>
				)}
			</div>
			<p class="text-sm text-gray-400 sm:text-right">
				{education.years}
				{education.gpa && <span class="block">GPA: {education.gpa}</span>}
			</p>
		</div>

		<h2 class="mb-4 text-2xl font-semibold text-white">Keep exploring</h2>
		<ul class="mb-10 space-y-2">
			<li>
				<a href="/about/" class="text-coral hover:text-white">
					About me
				</a>
			</li>
			<li>
				<a href="/work/" class="text-coral hover:text-white">
					Projects
				</a>
			</li>
			<li>
				<a href="/blog/" class="text-coral hover:text-white">
					Blog
				</a>
			</li>
		</ul>
	</div>
</BaseLayout>
