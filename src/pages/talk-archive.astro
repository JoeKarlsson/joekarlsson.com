---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scribble from '../components/Scribble.astro';
import { CHALK, MARKS } from '../data/scribbles';

const LINK = 'text-paper underline decoration-pink underline-offset-4 hover:text-pink';
---

<BaseLayout
	title="Talk Archive | Joe Karlsson"
	description="Joe Karlsson's conference talks, workshops, podcasts, and speaking engagements from 2019 to 2026."
	schemaType="CollectionPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-7">
		<!-- Two panels like the other page heroes: TALKS filling the pink one, and what's
		here in the dark one -->
		<header class="relative mb-16 grid gap-4 md:grid-cols-2">
			<div class="relative flex flex-col justify-end rounded-xl bg-pink px-7 pt-6 pb-5 text-ink">
				<div class="@container">
					<h1 class="font-display text-[calc(100cqw/var(--word-ratio))] leading-[0.84] font-normal whitespace-nowrap text-ink uppercase [--word-ratio:2.2]">
						Talks
					</h1>
				</div>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[16%] -left-[5%] z-10 size-[26%]"
				/>
			</div>
			<div class="relative flex flex-col justify-end gap-6 rounded-xl bg-surface-1 p-7">
				<Scribble
					{...MARKS.tally}
					color={CHALK}
					duration="9s"
					delay="0.6s"
					class="-top-[12%] -right-[3%] z-10 hidden h-[24%] w-[18%] md:block"
				/>
				<p class="text-[clamp(18px,1.5vw,22px)] text-paper">
					My conference talks, workshops, podcasts, and other speaking engagements from 2019 to
					2026. Earlier talks (2017-2018) and more recordings are on my{' '}
					<a
						href="https://www.youtube.com/joekarlsson"
						target="_blank"
						rel="noopener noreferrer"
						class={LINK}
					>
						YouTube channel
					</a>
					.
				</p>
			</div>
		</header>

		<!-- 2026 -->
		<section
			class="mb-14 grid scroll-mt-24 gap-x-10 gap-y-2 border-t border-surface-4 pt-5 md:grid-cols-[clamp(140px,16vw,240px)_1fr]"
			id="2026"
		>
			<h2 class="font-display text-[clamp(64px,9vw,140px)] leading-[0.85] font-normal text-pink md:sticky md:top-24 md:self-start">
				2026
			</h2>
			<ul class="space-y-7">
				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://devopscon.io/platform-engineering-summit/internal-developers-platform-best-practice/"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							I Built an Internal Developer Platform and Developers Still Ping Me
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">
						DevOpsCon Amsterdam · Amsterdam, Netherlands · April 20th-24th, 2026
					</p>
					<p class="mt-1 text-muted">
						Addressing the challenges that persist even after implementing an internal developer
						platform, focusing on ongoing support needs and platform adoption.
					</p>
				</li>

				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.cloudquery.io/events/five-questions-cloud-team"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							Operationalizing AWS Governance at Scale: Five Questions Your Team Can't Answer in
							Under Five Minutes
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">
						CloudQuery & AWS Webinar · April 8th, 2026 (virtual)
					</p>
					<p class="mt-1 text-muted">
						Exploring five critical infrastructure questions that typically require hours to
						resolve, treating cloud governance as a data problem, and strategies for cross-cloud
						visibility and compliance. Co-presented with Keegan Mirazee from AWS.
					</p>
				</li>
			</ul>
		</section>

		<!-- 2025 -->
		<section
			class="mb-14 grid scroll-mt-24 gap-x-10 gap-y-2 border-t border-surface-4 pt-5 md:grid-cols-[clamp(140px,16vw,240px)_1fr]"
			id="2025"
		>
			<h2 class="font-display text-[clamp(64px,9vw,140px)] leading-[0.85] font-normal text-pink md:sticky md:top-24 md:self-start">
				2025
			</h2>
			<ul class="space-y-7">
				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.youtube.com/watch?v=nFA2C5JgjPw"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							Live Coding: Building a Multi-Cloud Asset Inventory with AWS & GCP using CloudQuery
							and Postgres
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">CloudQuery YouTube · 2025</p>
					<p class="mt-1 text-muted">
						Live coding session demonstrating how to build a multi-cloud asset inventory using
						CloudQuery to pull data from AWS and GCP, storing it in Postgres.
					</p>
				</li>

				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.youtube.com/watch?v=rHmCiIXkcow"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							How to Manage Data Pipeline Complexity and Maintain High Data Quality
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">CloudQuery YouTube · 2025</p>
					<p class="mt-1 text-muted">
						Strategies for handling data pipeline complexity and ensuring high data quality - best
						practices, tools, and techniques for data engineers and analysts.
					</p>
				</li>

				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.youtube.com/watch?v=kwcH--194dA"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							The Future of Security Engineering is Data Engineering
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">CloudQuery YouTube · 2025</p>
					<p class="mt-1 text-muted">
						Exploring why security engineers need to learn SQL and how the future of security
						engineering lies in data engineering.
					</p>
				</li>

				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.youtube.com/watch?v=hVW7kflCyIQ"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
							What is Apache Arrow?
						</a>
					</h3>
					<p class="mt-1 text-sm text-muted">CloudQuery YouTube · 2025</p>
					<p class="mt-1 text-muted">
						Deep dive into Apache Arrow with Yevgeny Pats (CloudQuery CEO) - exploring efficient
						data processing, cross-language support, and why CloudQuery chose Arrow for their ETL
						platform.
					</p>
				</li>
			</ul>
		</section>

		<!-- 2024 -->
		<section
			class="mb-14 grid scroll-mt-24 gap-x-10 gap-y-2 border-t border-surface-4 pt-5 md:grid-cols-[clamp(140px,16vw,240px)_1fr]"
			id="2024"
		>
			<h2 class="font-display text-[clamp(64px,9vw,140px)] leading-[0.85] font-normal text-pink md:sticky md:top-24 md:self-start">
				2024
			</h2>
			<ul class="space-y-7">
				<li>
					<h3 class="text-[clamp(19px,1.6vw,23px)] leading-snug font-semibold text-paper">
						<a
							href="https://www.cloudquery.io/events/cloud-asset-inventory"
							target="_blank"
							rel="noopener noreferrer"
							class={LINK}
						>
