---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const talkHeadings = [
	{ slug: '2026', text: '2026' },
	{ slug: '2025', text: '2025' },
	{ slug: '2024', text: '2024' },
	{ slug: '2023', text: '2023' },
	{ slug: '2022', text: '2022' },
	{ slug: '2021', text: '2021' },
	{ slug: '2020', text: '2020' },
	{ slug: '2019', text: '2019' },
];
---

<BaseLayout
	title="Talk Archive | Joe Karlsson"
	description="Joe Karlsson's conference talks, workshops, podcasts, and speaking engagements from 2019 to 2026."
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Talk Archive</h1>
		<p class="mb-8 text-gray-400">
			My conference talks, workshops, podcasts, and other speaking engagements from 2019 to 2026.
			Earlier talks (2017-2018) and more recordings are on my{' '}
			<a
				href="https://www.youtube.com/joekarlsson"
				target="_blank"
				rel="noopener noreferrer"
				class="text-coral underline hover:text-white"
			>
				YouTube channel
			</a>
			.
		</p>

		<!-- Grid: TOC sidebar + sections -->
		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			<TableOfContents headings={talkHeadings} />
			<div>
				<!-- 2026 -->
