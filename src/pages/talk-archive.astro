---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const talkHeadings = [
	{ slug: '2026', text: '2026' },
	{ slug: '2025', text: '2025' },
	{ slug: '2024', text: '2024' },
	{ slug: '2023', text: '2023' },
	{ slug: '2022', text: '2022' },
	{ slug: '2021', text: '2021' },
	{ slug: '2020', text: '2020' },
	{ slug: '2019', text: '2019' },
];
---

<BaseLayout
	title="Talk Archive | Joe Karlsson"
	description="Complete archive of Joe Karlsson's conference talks, workshops, and speaking engagements."
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<p class="mb-2 font-mono text-sm text-coral" aria-hidden="true">~$ ls talks/ --all</p>
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Talk Archive</h1>
		<p class="mb-8 text-gray-400">
			A complete list of my conference talks, workshops, podcasts, and speaking engagements. For
			recorded talks, check out my <a
				href="https://www.youtube.com/joekarlsson"
				target="_blank"
				rel="noopener noreferrer"
				class="text-coral hover:text-teal">YouTube channel</a
			>.
		</p>

		<!-- Grid: TOC sidebar + sections -->
		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			<TableOfContents headings={talkHeadings} />
			<div>
				<!-- 2026 -->
				<section class="mb-10" id="2026">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2026/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								I Built an Internal Developer Platform and Developers Still Ping Me
							</h3>
							<p class="text-sm text-coral">DevOpsCon Amsterdam</p>
							<p class="text-xs text-gray-400">April 20th-24th, 2026 -- Amsterdam, Netherlands</p>
							<p class="mt-1 text-sm text-gray-400">
								Addressing the challenges that persist even after implementing an internal developer
								platform, focusing on ongoing support needs and platform adoption.
							</p>
							<a
								href="https://devopscon.io/platform-engineering-summit/internal-developers-platform-best-practice/"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								Operationalizing AWS Governance at Scale: Five Questions Your Team Can't Answer in
								Under Five Minutes
							</h3>
							<p class="text-sm text-coral">CloudQuery & AWS Webinar</p>
							<p class="text-xs text-gray-400">April 8th, 2026 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Exploring five critical infrastructure questions that typically require hours to
								resolve, treating cloud governance as a data problem, and strategies for cross-cloud
								visibility and compliance. Co-presented with Keegan Mirazee from AWS.
							</p>
							<a
								href="https://www.cloudquery.io/events/five-questions-cloud-team"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>
					</div>
				</section>

				<!-- 2025 -->
				<section class="mb-10" id="2025">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2025/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								Live Coding: Building a Multi-Cloud Asset Inventory with AWS & GCP using CloudQuery
								and Postgres
							</h3>
							<p class="text-sm text-coral">CloudQuery YouTube</p>
							<p class="text-xs text-gray-400">2025</p>
							<p class="mt-1 text-sm text-gray-400">
								Live coding session demonstrating how to build a multi-cloud asset inventory using
								CloudQuery to pull data from AWS and GCP, storing it in Postgres.
							</p>
							<a
								href="https://www.youtube.com/watch?v=nFA2C5JgjPw"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								How to Manage Data Pipeline Complexity and Maintain High Data Quality
							</h3>
							<p class="text-sm text-coral">CloudQuery YouTube</p>
							<p class="text-xs text-gray-400">2025</p>
							<p class="mt-1 text-sm text-gray-400">
								Strategies for handling data pipeline complexity and ensuring high data quality -
								best practices, tools, and techniques for data engineers and analysts.
							</p>
							<a
								href="https://www.youtube.com/watch?v=rHmCiIXkcow"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								The Future of Security Engineering is Data Engineering
							</h3>
							<p class="text-sm text-coral">CloudQuery YouTube</p>
							<p class="text-xs text-gray-400">2025</p>
							<p class="mt-1 text-sm text-gray-400">
								Exploring why security engineers need to learn SQL and how the future of security
								engineering lies in data engineering.
							</p>
							<a
								href="https://www.youtube.com/watch?v=kwcH--194dA"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">What is Apache Arrow?</h3>
							<p class="text-sm text-coral">CloudQuery YouTube</p>
							<p class="text-xs text-gray-400">2025</p>
							<p class="mt-1 text-sm text-gray-400">
								Deep dive into Apache Arrow with Yevgeny Pats (CloudQuery CEO) - exploring efficient
								data processing, cross-language support, and why CloudQuery chose Arrow for their
								ETL platform.
							</p>
							<a
								href="https://www.youtube.com/watch?v=hVW7kflCyIQ"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>
					</div>
				</section>

				<!-- 2024 -->
				<section class="mb-10" id="2024">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2024/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Cloud Asset Inventory & Management Webinar</h3>
							<p class="text-sm text-coral">CloudQuery</p>
							<p class="text-xs text-gray-400">December 19th, 2024 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Creating a cloud asset inventory using CloudQuery to track resources across AWS and
								Azure, monitor changes, and query infrastructure with SQL. Co-presented with Yevgeny
								Pats (CloudQuery CEO).
							</p>
							<a
								href="https://www.cloudquery.io/events/cloud-asset-inventory"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Cloud Governance & Security Webinar</h3>
							<p class="text-sm text-coral">CloudQuery</p>
							<p class="text-xs text-gray-400">December 19th, 2024 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Managing governance, security, and regulatory compliance across multi-cloud
								environments with security monitoring and automated remediation workflows.
							</p>
							<a
								href="https://www.cloudquery.io/events/cloud-governance-security"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Improve AWS Visibility & Governance Webinar</h3>
							<p class="text-sm text-coral">CloudQuery</p>
							<p class="text-xs text-gray-400">December 19th, 2024 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Getting complete visibility into AWS infrastructure across all regions and accounts,
								with resource tracking, optimization, and SQL-based querying.
							</p>
							<a
								href="https://www.cloudquery.io/events/improve-aws-visibility"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Build Real-Time Data Products over Kafka</h3>
							<p class="text-sm text-coral">Tinybird Live Coding</p>
							<p class="text-xs text-gray-400">January 9th, 2024 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Live coding session on building real-time data products using Kafka. Co-hosted with
								Jim Moffitt.
							</p>
						</div>
					</div>
				</section>

				<!-- 2023 -->
				<section class="mb-10" id="2023">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2023/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">From Kafka to APIs in Minutes</h3>
							<p class="text-sm text-coral">Tinybird Live Coding</p>
							<p class="text-xs text-gray-400">November 14th, 2023 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Live coding session demonstrating rapid API development from Kafka streams.
								Co-hosted with Marc Gonzalez (Director of Data at Factorial).
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								Build Your Own Infrastructure Monitoring Application
							</h3>
							<p class="text-sm text-coral">Tinybird Live Coding</p>
							<p class="text-xs text-gray-400">May 17th, 2023 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Building a miniature version of Datadog's infrastructure monitoring tool - using
								Kafka to stream events and Tinybird's native Kafka connector for ingestion.
							</p>
							<a
								href="https://www.tinybird.co/live-coding-sessions/build-your-own-infrastructure-monitoring-application"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Launch Week #2 Release Round-up</h3>
							<p class="text-sm text-coral">Tinybird Live Coding</p>
							<p class="text-xs text-gray-400">April 21st, 2023 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Recap of Tinybird's Launch Week #2 releases and new features. Co-hosted with
								Alasdair Brown.
							</p>
						</div>
					</div>
				</section>

				<!-- 2022 -->
				<section class="mb-10" id="2022">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2022/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								DoK Talks #120: A Gentle Introduction to Building Data Intensive Applications
							</h3>
							<p class="text-sm text-coral">CNCF Data on Kubernetes</p>
							<p class="text-xs text-gray-400">March 2022 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Gotchas and best practices for building, deploying, and scaling data-intensive apps
								- building a key-value store from scratch using only SQL. Co-presented with Bart
								Farrell.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">TechTalk: Databases and DevOps</h3>
							<p class="text-sm text-coral">SingleStore</p>
							<p class="text-xs text-gray-400">February 2022 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Live demo showing how to set up continuous database deployments using GitHub
								Actions. Co-presented with Rizel Scarlett (GitHub).
							</p>
						</div>
					</div>
				</section>

				<!-- 2021 -->
				<section class="mb-10" id="2021">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2021/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								Save The World And Money with MongoDB Data Lakes
							</h3>
							<p class="text-sm text-coral">Conf42 Cloud Native 2021</p>
							<p class="text-xs text-gray-400">April 29th, 2021 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Using MongoDB's Data Lake service to auto-archive cold data to AWS S3 while
								maintaining query capabilities - reducing data center power consumption and costs.
							</p>
							<a
								href="https://www.conf42.com/Cloud_Native_2021_Joe_Karlsson_save_the_world_data_lakes"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Watch &rarr;</a
							>
						</div>
					</div>
				</section>

				<!-- 2020 -->
				<section class="mb-10" id="2020">
					<h2 class="mb-4 text-lg font-bold text-white">
						<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ls talks/2020/
					</h2>
					<div class="space-y-3">
						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								An Introduction to IoT / How I Built an IoT Kitty Litter Box Using JavaScript
							</h3>
							<p class="text-sm text-coral">IoT Innovation Latam</p>
							<p class="text-xs text-gray-400">September 7th-8th, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Building an IoT litter box with a Raspberry Pi and JavaScript -- from sensor setup
								to reading inputs with Node.js.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								An Introduction to IoT / How I Built an IoT Kitty Litter Box Using JavaScript
							</h3>
							<p class="text-sm text-coral">CodeLand:Distributed</p>
							<p class="text-xs text-gray-400">July 23rd, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Combining cats, computers, and crappy ideas into an IoT litter box using a Raspberry
								Pi and Node.js.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								JavaScript Jabber: MongoDB Basics with Joe Karlsson
							</h3>
							<p class="text-sm text-coral">JavaScript Jabber (JSJ 436)</p>
							<p class="text-xs text-gray-400">June 16th, 2020</p>
							<p class="mt-1 text-sm text-gray-400">
								What is MongoDB, how it works, how it differs from relational databases, and how it
								fits into modern web apps.
							</p>
							<a
								href="https://javascriptjabber.com/jsj-436-mongodb-basics-with-joe-karlsson"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Listen &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								Bechdel.io: How We Used MongoDB To Help Make Film More Inclusive
							</h3>
							<p class="text-sm text-coral">MongoDB World 2020 (mongodb.live)</p>
							<p class="text-xs text-gray-400">June 9th-10th, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								How a brother-sister team built bechdel.io, a film script parsing tool that
								automatically runs the Bechdel Test using MongoDB.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">Building Your First GraphQL Client in JS</h3>
							<p class="text-sm text-coral">MongoDB World 2020 (mongodb.live)</p>
							<p class="text-xs text-gray-400">June 9th-10th, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Learn about GraphQL with MongoDB -- schema architecture, query performance, error
								handling, and caching.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">An Introduction To IoT (Internet of Toilets)</h3>
							<p class="text-sm text-coral">Live Coders Conf</p>
							<p class="text-xs text-gray-400">June 6th, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								IoT kitty litter box talk at the Live Coders Conference.
							</p>
							<a
								href="https://atndesign.github.io/Live-coders-conference/"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Event page &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								From SQL to NoSQL: A Gentle Introduction For JS Developers
							</h3>
							<p class="text-sm text-coral">Node.js Global Summit</p>
							<p class="text-xs text-gray-400">May 30th, 2020</p>
							<p class="mt-1 text-sm text-gray-400">
								Changing your mindset from tabular data modeling to NoSQL -- comparing SQL and
								MongoDB concepts for JavaScript developers.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">MongoDB Schema Design Best Practices</h3>
							<p class="text-sm text-coral">Data Architecture Day</p>
							<p class="text-xs text-gray-400">May 18th, 2020</p>
							<p class="mt-1 text-sm text-gray-400">
								Data modeling basics using real-world examples -- common methodologies for designing
								MongoDB schemas.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								From SQL to NoSQL: A Gentle Introduction For JS Developers
							</h3>
							<p class="text-sm text-coral">JS VidCon 2020</p>
							<p class="text-xs text-gray-400">May 7th, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Comparing SQL and MongoDB for JavaScript developers, with a walkthrough of data
								modeling basics.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								JavaScript Jabber: Internet of Things (IoT) with Joe Karlsson
							</h3>
							<p class="text-sm text-coral">JavaScript Jabber (JSJ 432)</p>
							<p class="text-xs text-gray-400">May 5th, 2020</p>
							<p class="mt-1 text-sm text-gray-400">
								Walking through approaches, uses, and libraries for building IoT with JavaScript.
							</p>
							<a
								href="https://javascriptjabber.com/jsj-432-internet-of-things-iot-with-joe-karlsson"
								target="_blank"
								rel="noopener noreferrer"
								class="mt-1 inline-block text-xs text-teal hover:text-coral">Listen &rarr;</a
							>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">
								A Gentle Introduction to Building Serverless Apps
							</h3>
							<p class="text-sm text-coral">Byteconf React 2020</p>
							<p class="text-xs text-gray-400">May 1st, 2020 (virtual)</p>
							<p class="mt-1 text-sm text-gray-400">
								Beginner-friendly intro to serverless computing with MongoDB Stitch, including
								authentication and access rules.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">An Introduction To IoT (Internet of Toilets)</h3>
							<p class="text-sm text-coral">(mini) Minnebar</p>
							<p class="text-xs text-gray-400">April 25th, 2020 -- Minneapolis, MN</p>
							<p class="mt-1 text-sm text-gray-400">
								IoT litter box talk -- setting up Node.js on a Raspberry Pi, connecting sensors, and
								reading inputs.
							</p>
						</div>

						<div class="rounded-lg border border-surface-3 bg-surface-1 p-4">
							<h3 class="font-semibold text-white">MongoDB Schema Design Best Practices</h3>
							<p class="text-sm text-coral">MidwestPHP</p>
							<p class="text-xs text-gray-400">April 2nd-4th, 2020 -- Minneapolis, MN</p>
							<p class="mt-1 text-sm text-gray-400">
								Data modeling with document databases -- real-world examples of schema design for
								read-heavy and write-heavy applications.
							</p>
						</div>

