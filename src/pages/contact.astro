---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS } from '../consts';
---

<BaseLayout
	title="Contact | Joe Karlsson"
	description="Connect with Joe Karlsson - find me on Bluesky, LinkedIn, GitHub, YouTube, and more. Book me for speaking engagements or just say hi."
	schemaType="ContactPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<!-- Chat bubble typing animation -->
		<div id="chat-section" class="mb-8" aria-live="polite">
			<div id="typing-indicator" class="flex items-center gap-1 font-mono text-sm text-gray-400">
				<span>Joe is typing</span>
				<span class="typing-dots flex gap-0.5">
					<span class="typing-dot inline-block h-1.5 w-1.5 rounded-full bg-gray-400"></span>
					<span class="typing-dot inline-block h-1.5 w-1.5 rounded-full bg-gray-400"></span>
					<span class="typing-dot inline-block h-1.5 w-1.5 rounded-full bg-gray-400"></span>
				</span>
			</div>
			<div id="chat-bubble" class="hidden">
				<p class="mb-1 font-mono text-xs text-coral" aria-hidden="true">joe@karlsson ~$</p>
				<div
					class="rounded-lg border border-surface-3 bg-surface-2 px-4 py-3 font-mono text-sm text-gray-300"
				>
					<span id="chat-message"></span><span
						id="chat-cursor"
						class="inline-block w-1.5 h-4 bg-coral align-middle ml-0.5 opacity-0"></span>
				</div>
			</div>
		</div>

		<style>
			@keyframes bounce-dot {
				0%,
				80%,
				100% {
					transform: translateY(0);
				}
				40% {
					transform: translateY(-4px);
				}
			}
			.typing-dot:nth-child(1) {
				animation: bounce-dot 1.2s infinite 0s;
			}
			.typing-dot:nth-child(2) {
				animation: bounce-dot 1.2s infinite 0.2s;
			}
			.typing-dot:nth-child(3) {
				animation: bounce-dot 1.2s infinite 0.4s;
			}

			@keyframes blink-cursor {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0;
				}
			}
			#chat-cursor.blinking {
				animation: blink-cursor 0.8s step-end infinite;
			}

			@media (prefers-reduced-motion: reduce) {
				.typing-dot {
					animation: none !important;
				}
				#chat-cursor {
					animation: none !important;
					opacity: 0 !important;
				}
			}
		</style>

		<p class="mb-2 font-mono text-sm text-coral" aria-hidden="true">~$ cat contact.md</p>
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Ready to be friends?</h1>
		<p class="mb-8 text-gray-400">
			Whether you want to talk shop, book me for a speaking gig, or just say hi - pick a platform
			below and reach out.
		</p>

		<!-- Best ways to reach me -->
		<h2 class="mb-4 text-lg font-bold text-white">
			<span class="text-coral font-mono text-sm" aria-hidden="true">~$</span> ./reach-me
		</h2>
		<div class="mb-8 grid gap-3 sm:grid-cols-2">
			<a
				href={SOCIAL_LINKS.bluesky}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-3 rounded-lg border border-surface-3 bg-surface-1 p-4 no-underline transition-colors hover:border-coral/30 hover:bg-surface-2"
			>
				<svg
					viewBox="0 0 24 24"
					width="24"
					height="24"
					fill="currentColor"
					class="text-sky"
					aria-hidden="true"
				>
					<path
						d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.6 3.476 6.154 3.229-4.058.746-7.329 2.453-2.869 6.151 5.203 3.947 7.027-1.082 8.091-3.637.163-.39.24-.576.24-.41 0-.166.076.02.24.41 1.064 2.555 2.888 7.584 8.091 3.637 4.46-3.698 1.189-5.405-2.869-6.151 2.554.247 5.37-.602 6.154-3.229C24.002 9.418 24.38 4.458 24.38 3.768c0-.69-.139-1.861-.902-2.203-.659-.3-1.664-.621-4.3 1.24C16.426 4.747 13.087 8.686 12 10.8z"
					></path>
				</svg>
				<div>
					<p class="font-medium text-white">Bluesky</p>
					<p class="text-xs text-gray-400">@joekarlsson.com</p>
				</div>
			</a>
			<a
				href={SOCIAL_LINKS.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-3 rounded-lg border border-surface-3 bg-surface-1 p-4 no-underline transition-colors hover:border-coral/30 hover:bg-surface-2"
			>
				<svg
					viewBox="0 0 24 24"
					width="24"
					height="24"
					fill="currentColor"
					class="text-sky"
					aria-hidden="true"
