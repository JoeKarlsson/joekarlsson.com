---
import IndexRow from '../components/IndexRow.astro';
import { getSentIssues } from '../utils/posts';
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BEST, SECTIONS } from '../data/contact-links';
import { CHALK, MARKS } from '../data/scribbles';
import PosterHero from '../components/PosterHero.astro';
import {
	HERO_LEAD,
	PAGE_CONTAINER,
	PRIMARY_BUTTON,
	SECONDARY_BUTTON,
	SECTION_HEADING,
	formatDate,
} from '../utils/ui';

// The pink band pushes the newsletter's newest issue: a way to keep in touch without writing
const [newestIssue] = (await getSentIssues())
	.filter((issue) => !issue.data.substackUrl)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
if (!newestIssue) throw new Error('No newsletter issue for the featured band');
// Each link reports its platform to Plausible as a "Contact Social Click" event
const track = (platform: string) =>
	`plausible-event-name=Contact+Social+Click plausible-event-platform=${platform.replace(/[^A-Za-z0-9.]+/g, '+')}`;
---

<BaseLayout
	title="Contact | Joe Karlsson"
	description="How to reach me: LinkedIn for work and speaking gigs, Bluesky for everything else, plus every other place I post."
	schemaType="ContactPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- A halftone montage that opens on Joe already at his homelab rack (no walk-in),
		then cuts to the river wave, the desk and two homepage shots, beside every
		the newsletter's latest issue in the pink band and the best two ways to reach me. Pink dots are drawn live
		(src/scripts/halftone.ts); in-view-play stops it with pause-motion and reduced motion. -->
		<PosterHero
			decorativeMedia
			title="Contact"
			wordRatio={3.2}
			featured={{
				label: 'Latest',
				title: newestIssue.data.title,
				href: `/newsletter/${newestIssue.data.slug}/`,
				meta: `Newsletter, ${formatDate(newestIssue.data.date)}`,
			}}
		>
			<div slot="media" class="relative z-10 aspect-[4/3] md:aspect-auto md:min-h-[420px]">
				<video
					src="/images/about/joe-homelab.mp4"
					poster="/images/about/joe-homelab-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Montage of Joe Karlsson: giving a thumbs up next to his homelab server rack, waving a peace sign by a river, waving at the camera, talking at his desk and eating ice cream"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-[50%_8%] md:object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<!-- Phones keep the one-line pitch, so visitors know what to message me about, but skip
			the two buttons so the platform list, which LinkedIn opens, starts right after it -->
			<div>
				<p class={HERO_LEAD}>
					Message me on LinkedIn about work or a speaking gig, or on Bluesky to talk homelabs,
					databases, or weird IoT projects.
				</p>
				<div class="mt-5 flex flex-wrap gap-3 max-md:hidden">
					{BEST.map(({ label, meta, href }, i) => (
						<a
							href={href}
							target="_blank"
							rel="noopener noreferrer"
							title={meta}
							class:list={[track(label), i === 0 ? PRIMARY_BUTTON : SECONDARY_BUTTON]}
						>
							{label}
						</a>
					))}
				</div>
			</div>
		</PosterHero>

		{SECTIONS.map(({ heading, links }, s) => (
			<section class="relative mb-12 md:mb-16">
				<h2 class={SECTION_HEADING}>
					{heading}
					<Scribble
						{...(s ? MARKS.rays : MARKS.underline)}
						color={s ? '#ff4fd8' : CHALK}
						duration="8s"
						delay={`${s * 0.6}s`}
						class={
							s
								? '-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]'
								: '-bottom-[0.32em] left-0 h-[0.3em] w-full'
						}
					/>
				</h2>
				{links.map(({ label, meta, href }, i) => (
					<IndexRow
						href={href}
						label={label}
						meta={meta}
						index={i + s}
						external
						class={track(label)}
					/>
				))}
			</section>
		))}
	</div>
</BaseLayout>
