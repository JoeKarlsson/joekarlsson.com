---
import IndexRow from '../components/IndexRow.astro';
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS } from '../consts';
import { CHALK, MARKS } from '../data/scribbles';
import PosterHero from '../components/PosterHero.astro';
import {
	HERO_LEAD,
	PAGE_CONTAINER,
	PRIMARY_BUTTON,
	SECONDARY_BUTTON,
	SECTION_HEADING,
} from '../utils/ui';

// Each link reports its platform to Plausible as a "Contact Social Click" event
const track = (platform: string) =>
	`plausible-event-name=Contact+Social+Click plausible-event-platform=${platform.replace(/[^A-Za-z0-9.]+/g, '+')}`;

const BEST = [
	{ label: 'LinkedIn', meta: 'Professional inquiries & speaking', href: SOCIAL_LINKS.linkedin },
	{ label: 'Bluesky', meta: '@joekarlsson.com', href: SOCIAL_LINKS.bluesky },
];

// All personal accounts, ranked: where I post first, then the side places
// (Letterboxd gets a lot of use, but it's not why people come here), with the
// ones I've mostly left at the very bottom
const SECTIONS = [
	{
		heading: 'Where I post',
		links: [
			{ label: 'Threads', meta: '@joekarlsson', href: SOCIAL_LINKS.threads },
			{ label: 'Bluesky', meta: '@joekarlsson.com', href: SOCIAL_LINKS.bluesky },
			{ label: 'YouTube', meta: 'Talks & tutorials', href: SOCIAL_LINKS.youtube },
			{ label: 'Instagram', meta: 'Photos & stories', href: SOCIAL_LINKS.instagram },
			{ label: 'GitHub', meta: 'Open source & projects', href: SOCIAL_LINKS.github },
			{ label: 'Twitter/X', meta: '@JoeKarlsson1', href: SOCIAL_LINKS.twitter },
		],
	},
	{
		heading: 'Everywhere else',
		links: [
			{ label: 'Letterboxd', meta: 'Movie reviews & lists', href: SOCIAL_LINKS.letterboxd },
			{ label: 'TikTok', meta: '@joekarlsson', href: SOCIAL_LINKS.tiktok },
			{ label: 'Reddit', meta: 'Lurking & commenting', href: SOCIAL_LINKS.reddit },
			{ label: 'Last.fm', meta: "What I'm listening to", href: SOCIAL_LINKS.lastfm },
			{ label: 'Twitch', meta: 'Old live-coding streams', href: SOCIAL_LINKS.twitch },
		],
	},
];
---

<BaseLayout
	title="Contact | Joe Karlsson"
	description="Connect with Joe Karlsson - find me on LinkedIn, Bluesky, Threads, Instagram, YouTube, and more. Book me for speaking engagements or just say hi."
	schemaType="ContactPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- A halftone montage that opens on Joe already at his homelab rack (no walk-in),
		then cuts to the river wave, the desk and two homepage shots, beside every
		platform in the ticker and the best two ways to reach me. Pink dots are drawn live
		(src/scripts/halftone.ts); in-view-play stops it with pause-motion and reduced motion. -->
		<PosterHero
			decorativeMedia
			title="Contact"
			wordRatio={3.2}
			tickerItems={[...BEST, ...SECTIONS.flatMap(({ links }) => links)].map(({ label }) => label)}
		>
			<div slot="media" class="relative z-10 aspect-[4/3] md:aspect-auto md:min-h-[420px]">
				<video
					src="/images/about/joe-homelab.mp4"
					poster="/images/about/joe-homelab-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					role="img"
					aria-label="Montage of Joe Karlsson: giving a thumbs up next to his homelab server rack, waving a peace sign by a river, waving at the camera, talking at his desk and eating ice cream"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-[50%_8%] md:object-center"
				></video>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[7%] -left-[5%] z-10 size-[20%]"
				/>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-bottom-[7%] -left-[4%] z-10 h-[14%] w-[70%]"
				/>
			</div>
			<p class={HERO_LEAD}>
				Want to talk homelabs, databases, or weird IoT projects, or book me for a speaking gig? Pick
				a platform below.
			</p>
			<p class="mt-5 mb-3 text-sm text-muted">Best ways to reach me</p>
			<div class="flex flex-wrap gap-3">
				{BEST.map(({ label, meta, href }, i) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						title={meta}
						class:list={[track(label), i === 0 ? PRIMARY_BUTTON : SECONDARY_BUTTON]}
					>
						{label}
					</a>
				))}
			</div>
		</PosterHero>

		{SECTIONS.map(({ heading, links }, s) => (
			<section class="relative mb-12 md:mb-16">
				<h2 class={SECTION_HEADING}>
					{heading}
					<Scribble
						{...(s ? MARKS.rays : MARKS.underline)}
						color={s ? '#ff4fd8' : CHALK}
						duration="8s"
						delay={`${s * 0.6}s`}
						class={
							s
								? '-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]'
								: '-bottom-[0.32em] left-0 h-[0.3em] w-full'
						}
					/>
				</h2>
				{links.map(({ label, meta, href }, i) => (
					<IndexRow
						href={href}
						label={label}
						meta={meta}
						index={i + s}
						external
						class={track(label)}
					/>
				))}
			</section>
		))}
	</div>
</BaseLayout>
