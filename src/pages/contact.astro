	<script>
		// Track contact page social link clicks
		document.querySelectorAll('a[target="_blank"]').forEach((link) => {
			const platformEl = link.querySelector('p.font-medium');
			if (!platformEl) return;
			const platform = platformEl.textContent?.trim() || 'Unknown';
			link.addEventListener('click', () => {
				if (typeof window.plausible === 'function') {
					window.plausible('Contact Social Click', { props: { platform } });
				}
			});
		});
	</script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const typingIndicator = document.getElementById('typing-indicator');
			const chatBubble = document.getElementById('chat-bubble');
			const chatMessage = document.getElementById('chat-message');
			const chatCursor = document.getElementById('chat-cursor');
			const message =
				"Want to chat about homelabs, databases, or weird IoT projects? I'm always down. Pick a platform and say hi.";

			if (!typingIndicator || !chatBubble || !chatMessage || !chatCursor) return;

			if (prefersReducedMotion) {
				typingIndicator.classList.add('hidden');
				chatBubble.classList.remove('hidden');
				chatMessage.textContent = message;
				return;
			}

			// Show typing indicator for 2 seconds, then type out the message
			setTimeout(() => {
				typingIndicator.classList.add('hidden');
				chatBubble.classList.remove('hidden');
				chatCursor.classList.add('blinking');

				let i = 0;
				const typeInterval = setInterval(() => {
					if (i < message.length) {
						chatMessage.textContent += message[i];
						i++;
					} else {
						clearInterval(typeInterval);
						// Keep cursor blinking for a moment, then hide it
						setTimeout(() => {
							chatCursor.classList.remove('blinking');
							chatCursor.style.opacity = '0';
						}, 2000);
					}
				}, 35);
			}, 2000);
		});
	</script>
</BaseLayout>
