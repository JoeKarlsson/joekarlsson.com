---
import IndexRow from '../components/IndexRow.astro';
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS } from '../consts';
import { CHALK, MARKS } from '../data/scribbles';

// Each link reports its platform to Plausible as a "Contact Social Click" event
const track = (platform: string) =>
	`plausible-event-name=Contact+Social+Click plausible-event-platform=${platform.replace(/[^A-Za-z0-9.]+/g, '+')}`;

const BEST = [
	{ label: 'Bluesky', meta: '@joekarlsson.com', href: SOCIAL_LINKS.bluesky },
	{ label: 'LinkedIn', meta: 'Professional inquiries & speaking', href: SOCIAL_LINKS.linkedin },
];

const SECTIONS = [
	{
		heading: 'Work',
		links: [
			{ label: 'GitHub', meta: 'Open source & projects', href: SOCIAL_LINKS.github },
			{ label: 'YouTube', meta: 'Talks & tutorials', href: SOCIAL_LINKS.youtube },
			{ label: 'Twitch', meta: 'Live coding & hangouts', href: SOCIAL_LINKS.twitch },
			{ label: 'Threads', meta: '@joekarlsson', href: SOCIAL_LINKS.threads },
		],
	},
	{
		heading: 'Elsewhere',
		links: [
			{ label: 'Letterboxd', meta: 'Movie reviews & lists', href: SOCIAL_LINKS.letterboxd },
			{ label: 'Instagram', meta: 'Photos & stories', href: SOCIAL_LINKS.instagram },
			{ label: 'TikTok', meta: '@joekarlsson', href: SOCIAL_LINKS.tiktok },
			{ label: 'Last.fm', meta: "What I'm listening to", href: SOCIAL_LINKS.lastfm },
			{ label: 'Twitter/X', meta: 'Legacy account', href: SOCIAL_LINKS.twitter },
			{ label: 'Reddit', meta: 'Lurking & commenting', href: SOCIAL_LINKS.reddit },
		],
	},
];

const SECTION_HEADING =
	'relative mb-[18px] w-fit font-display text-[clamp(40px,4.6vw,64px)] leading-none font-normal text-pink uppercase';
---

<BaseLayout
	title="Contact | Joe Karlsson"
	description="Connect with Joe Karlsson - find me on Bluesky, LinkedIn, GitHub, YouTube, and more. Book me for speaking engagements or just say hi."
	schemaType="ContactPage"
>
	<div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-7">
		<!-- Like the other page heroes: CONTACT filling the pink panel and the best two ways
		to reach me in the dark one, stacked on the left, beside the halftone clip of Joe
		waving hello (the About page's clip). On phones the clip sits between the panels.
		Pink dots are drawn live (src/scripts/halftone.ts); in-view-play stops it with
		pause-motion and reduced motion. -->
		<header class="relative mb-16 grid gap-4 md:grid-cols-2 md:grid-rows-[auto_1fr]">
			<div class="relative flex flex-col justify-end rounded-xl bg-pink px-7 pt-6 pb-5 text-ink md:col-start-1">
				<div class="@container">
					<h1 class="font-display text-[calc(100cqw/var(--word-ratio))] leading-[0.84] font-normal whitespace-nowrap text-ink uppercase [--word-ratio:3.2]">
						Contact
					</h1>
				</div>
				<Scribble
					{...MARKS.burst}
					color={CHALK}
					strokeWidth={6}
					duration="8s"
					delay="1.6s"
					class="-top-[16%] -left-[5%] z-10 size-[26%]"
				/>
			</div>
			<div class="relative z-10 aspect-[4/3] md:col-start-2 md:row-span-2 md:row-start-1 md:aspect-auto md:min-h-[420px]">
				<video
					src="/images/about/joe-hello.mp4"
					data-halftone-poster="/images/about/joe-hello-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					role="img"
					aria-label="Joe Karlsson by a river, waving hello with a peace sign"
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-[50%_8%] md:object-center"
				></video>
				<Scribble
					{...MARKS.lines}
					color={CHALK}
					duration="11s"
					delay="1s"
					class="-right-[6%] -bottom-[7%] h-[14%] w-[70%]"
				/>
			</div>
			<div class="relative flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7 md:col-start-1">
				<Scribble
					{...MARKS.tally}
					color={CHALK}
					duration="9s"
					delay="0.6s"
					class="-top-[12%] -right-[3%] z-10 hidden h-[24%] w-[18%] md:block"
				/>
				<p class="text-[clamp(18px,1.5vw,22px)] text-paper">
					Want to talk homelabs, databases, or weird IoT projects, or book me for a speaking gig?
					Pick a platform below.
				</p>
				<div>
					<p class="mb-3 text-sm text-muted">Best ways to reach me</p>
					<div class="flex flex-wrap gap-3">
						{BEST.map(({ label, meta, href }, i) => (
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								title={meta}
								class:list={[
									track(label),
									'inline-block rounded-md px-[18px] py-3 font-semibold no-underline',
									i === 0
										? 'bg-pink text-ink hover:bg-white'
										: 'border-2 border-pink px-4 py-2.5 text-pink hover:border-white hover:text-white',
								]}
							>
								{label}
							</a>
						))}
					</div>
				</div>
			</div>
		</header>

		{SECTIONS.map(({ heading, links }, s) => (
			<section class="relative mb-16">
				<h2 class={SECTION_HEADING}>
					{heading}
					<Scribble
						{...(s ? MARKS.rays : MARKS.underline)}
						color={s ? '#ff4fd8' : CHALK}
						duration="8s"
						delay={`${s * 0.6}s`}
						class={
							s
								? '-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]'
								: '-bottom-[0.32em] left-0 h-[0.3em] w-full'
						}
					/>
				</h2>
				{links.map(({ label, meta, href }, i) => (
					<IndexRow
						href={href}
						label={label}
						meta={meta}
						index={i + s}
						external
						class={track(label)}
					/>
				))}
			</section>
		))}
	</div>
</BaseLayout>
