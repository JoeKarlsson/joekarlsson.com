---
import {
	HERO_LEAD,
	MORE_LINK,
	PAGE_CONTAINER,
	SECTION_HEADING,
	TEXT_LINK,
	formatDate,
} from '../utils/ui';
// The 404: a scribble board to play with (strokes fade on their own, nothing is
// saved) and every way back into the site: the main sections, the newest posts
// and the blog topics, all from real data.
import DrawingBoard from '../components/DrawingBoard.astro';
import IndexRow from '../components/IndexRow.astro';
import PosterHero from '../components/PosterHero.astro';
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHALK, MARKS } from '../data/scribbles';
import { getCategoryCounts } from '../utils/categories';
import { getFeedPosts, isOwnPost } from '../utils/posts';
import { jsonForScript } from '../utils/json-for-script';
import popularPosts from '../data/popular-posts.json';
import { projects } from '../data/projects';

const posts = await getFeedPosts();
const latestPosts = posts.filter(isOwnPost).slice(0, 5);
// The pink band sends a lost visitor to the most-read post
const [mostReadHref] = Object.entries(popularPosts.visitorsByPath)
	.filter(([path]) => posts.some((post) => post.href === path))
	.sort(([, a], [, b]) => b - a)
	.map(([path]) => path);
const mostRead = posts.find((post) => post.href === mostReadHref);
if (!mostRead) throw new Error('popular-posts.json names no post for the featured band');
const topics = getCategoryCounts(posts.filter((p) => !p.isNewsletter));
// For the "Looking for...?" line (closest-post.ts)
const postLinks = posts.map((post) => ({ href: post.href, title: post.data.title }));

const PLACES = [
	{ href: '/blog/', label: 'Blog', meta: `${posts.length} posts` },
	{ href: '/work/', label: 'Works', meta: `${projects.length} pieces` },
	{ href: '/about/', label: 'About', meta: 'Career, talks and crop art' },
	{ href: '/newsletter/', label: 'Newsletter', meta: 'Works on My Machine' },
	{ href: '/uses/', label: 'Uses', meta: 'My gear and homelab' },
	{ href: '/contact/', label: 'Contact', meta: 'Say hi' },
];
---

<BaseLayout title="404 | Joe Karlsson" description="Page not found" noindex>
	<script>
		if (typeof window.plausible === 'function') {
			window.plausible('404', { props: { path: window.location.pathname } });
		}
	</script>
	<script type="application/json" id="post-links" set:html={jsonForScript(postLinks)} />
	<script>
		import { findClosestPost, type PostLink } from '../scripts/closest-post';
		const posts: PostLink[] = JSON.parse(
			document.getElementById('post-links')?.textContent ?? '[]',
		);
		const closest = findClosestPost(location.pathname, posts);
		const line = document.querySelector<HTMLElement>('[data-closest-post]');
		const link = document.querySelector<HTMLAnchorElement>('[data-closest-post-link]');
		if (closest && line && link) {
			link.href = closest.href;
			link.textContent = closest.title;
			line.hidden = false;
		}
	</script>
	<div class={PAGE_CONTAINER}>
		{/* The same poster header as every section page, with the scribble board where the
		others put a picture (phones skip the board) */}
		<PosterHero
			title="404"
			wordRatio={1.6}
			featured={{
				label: 'Popular',
				title: mostRead.data.title,
				href: mostRead.href,
				meta: mostRead.data.updatedDate
					? `Updated ${formatDate(mostRead.data.updatedDate)}`
					: formatDate(mostRead.data.date),
			}}
		>
			<DrawingBoard slot="media" title="Doodle while lost" class="z-10 md:min-h-[420px]" />
			<p class={HERO_LEAD}>Nothing lives at this address. It may have moved.</p>
			<p data-closest-post hidden class:list={[HERO_LEAD, 'mt-3']}>
				Looking for <a data-closest-post-link class={TEXT_LINK}></a>?
			</p>
		</PosterHero>

		<section class="mb-12 md:mb-16">
			<h2 class={`${SECTION_HEADING} mb-[0.6em]!`}>
				Try one of these
				<Scribble
					{...MARKS.zigzag}
					color={CHALK}
					duration="8s"
					delay="0.2s"
					class="-bottom-[0.45em] left-0 h-[0.4em] w-full"
				/>
			</h2>
			{PLACES.map(({ href, label, meta }, i) => (
				<IndexRow href={href} label={label} meta={meta} index={i} />
			))}
		</section>

		<div class="grid gap-x-12 gap-y-14 md:grid-cols-[3fr_2fr]">
			<section>
				<h2 class={SECTION_HEADING}>
					Newest posts
					<Scribble
						{...MARKS.rays}
						color="#ff4fd8"
						duration="7s"
						delay="0.6s"
						class="-top-[0.45em] -left-[0.4em] h-[0.45em] w-[0.6em]"
					/>
				</h2>
				<ul>
					{latestPosts.map((post) => (
						<li class="border-t border-surface-4 py-1">
							<span class="block text-sm text-muted">
								<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							</span>
							<a
								href={post.href}
								class:list={[TEXT_LINK, 'inline-block py-2 text-lg font-semibold']}
							>
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
			<section>
				<h2 class={SECTION_HEADING}>
					Topics
					<Scribble
						{...MARKS.asterisk}
						color={CHALK}
						duration="8s"
						delay="1s"
						class="-top-[0.15em] -right-[0.8em] size-[0.6em]"
					/>
				</h2>
				<ul class="border-t border-surface-4 pt-3">
					{topics.map(({ name, slug, count }) => (
						<li>
							<a
								href={`/blog/category/${slug}/`}
								class:list={[TEXT_LINK, 'inline-block py-2.5 text-lg']}
							>
								{name}
							</a>{' '}
							<span class="text-muted">{count}</span>
						</li>
					))}
				</ul>
				<p class="mt-6">
					<a href="/blog/" class={MORE_LINK}>
						Search every post on the blog &rarr;
					</a>
				</p>
			</section>
		</div>
	</div>
</BaseLayout>
