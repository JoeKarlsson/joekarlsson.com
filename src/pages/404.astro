---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Joe Karlsson" description="Page not found">
	<script>
		if (typeof window.plausible === 'function') {
			window.plausible('404', { props: { path: window.location.pathname } });
		}
	</script>
	<div class="mx-auto max-w-3xl px-4 py-16 text-center">
		<div class="glitch-wrapper mb-6">
			<h1 class="glitch text-8xl font-bold text-coral" data-text="404">404</h1>
		</div>

		<!-- Terminal -->
		<div
			class="terminal mx-auto max-w-2xl text-left rounded-lg overflow-hidden border border-surface-3 shadow-2xl mb-8"
		>
			<!-- Title bar -->
			<div
				class="terminal-titlebar flex items-center gap-2 px-4 py-2 bg-surface-1 border-b border-surface-3"
			>
				<span class="w-3 h-3 rounded-full bg-red-500/80"></span>
				<span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
				<span class="w-3 h-3 rounded-full bg-green-500/80"></span>
				<span class="ml-2 text-xs text-gray-400 font-mono">joe@joekarlsson.com - bash</span>
			</div>
			<!-- Terminal body -->
			<div
				id="terminal"
				class="terminal-body bg-surface-0 p-4 font-mono text-sm leading-relaxed h-96 overflow-y-auto cursor-text"
				tabindex="0"
				role="application"
				aria-label="Interactive terminal. Type help for available commands."
			>
				<div id="output"></div>
				<div id="input-line" class="flex items-center" style="display:none;">
					<span class="prompt text-coral mr-2">joe@404 ~$</span>
					<span id="input-text" class="text-gray-200"></span><span id="cursor" class="cursor"
						>&#9608;</span
					>
				</div>
				<input
					id="hidden-input"
					type="text"
					class="absolute opacity-0 w-0 h-0 pointer-events-none"
					autocomplete="off"
					autocorrect="off"
					autocapitalize="off"
					spellcheck="false"
				/>
			</div>
		</div>

		<a
			href="/"
			class="inline-block rounded-md bg-coral px-4 py-2 font-medium text-surface-0 no-underline hover:bg-teal"
		>
			Go Home
		</a>
	</div>
</BaseLayout>

<style>
	.glitch-wrapper {
		position: relative;
		display: inline-block;
	}

	.glitch {
		position: relative;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.glitch::before {
		color: var(--color-teal, #8bcbc8);
		animation: glitch-1 2s infinite linear alternate-reverse;
		clip-path: inset(0 0 65% 0);
	}

	.glitch::after {
		color: var(--color-lavender, #c4b5fd);
		animation: glitch-2 2s infinite linear alternate-reverse;
		clip-path: inset(65% 0 0 0);
	}

	@keyframes glitch-1 {
		0%,
		90%,
		100% {
			transform: translate(0);
		}
		92% {
			transform: translate(-3px, 1px);
		}
		94% {
			transform: translate(3px, -1px);
		}
		96% {
			transform: translate(-2px, 0);
		}
		98% {
			transform: translate(2px, 1px);
		}
	}

	@keyframes glitch-2 {
		0%,
		90%,
		100% {
			transform: translate(0);
		}
		91% {
			transform: translate(3px, 0);
		}
		93% {
			transform: translate(-3px, 1px);
		}
		95% {
			transform: translate(2px, -1px);
		}
		97% {
			transform: translate(-2px, 1px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch::before,
		.glitch::after {
			animation: none;
		}

		.cursor {
			animation: none !important;
			opacity: 1;
		}
	}

	.terminal-body {
		scrollbar-width: thin;
		scrollbar-color: #fdae84 transparent;
	}

	.cursor {
		animation: blink 1s step-end infinite;
		color: #fdae84;
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	.terminal-body :global(.text-coral) {
		color: #fdae84;
	}

	.terminal-body :global(.text-teal) {
		color: #8bcbc8;
	}

	.terminal-body :global(.text-lavender) {
		color: #c4b5fd;
	}

	.terminal-body :global(.text-dim) {
		color: #9ca3af;
	}

	.terminal-body :global(.text-white) {
		color: #e5e7eb;
	}

	.terminal-body :global(.text-green) {
		color: #86efac;
	}

	.terminal-body :global(.text-yellow) {
		color: #fde68a;
	}
</style>

<script>
	const output = document.getElementById('output')!;
	const inputLine = document.getElementById('input-line')!;
	const inputText = document.getElementById('input-text')!;
	const terminal = document.getElementById('terminal')!;
	const hiddenInput = document.getElementById('hidden-input') as HTMLInputElement;

	let currentInput = '';
	const commandHistory: string[] = [];
	let historyIndex = -1;
	let ready = false;

	const pages: Record<string, string> = {
		home: '/',
		blog: '/blog',
		about: '/about',
		work: '/work',
		contact: '/contact',
		uses: '/uses',
		'talk-archive': '/talk-archive',
	};

	function scrollToBottom() {
		terminal.scrollTop = terminal.scrollHeight;
	}

	function appendLine(html: string) {
		const div = document.createElement('div');
		div.innerHTML = html;
		output.appendChild(div);
		scrollToBottom();
	}

	function appendLines(lines: string[]) {
		lines.forEach((line) => appendLine(line));
	}

	async function typeLines(lines: string[], delay = 40) {
		for (const line of lines) {
			appendLine(line);
			await sleep(delay);
		}
	}

	function sleep(ms: number): Promise<void> {
		return new Promise((r) => setTimeout(r, ms));
	}

	// --- Commands ---

	function cmdHelp(): string[] {
		return [
			'<span class="text-yellow">Available commands:</span>',
			'',
			'  <span class="text-coral">help</span>         show this message',
			'  <span class="text-coral">ls</span>           list site pages',
			'  <span class="text-coral">cd</span> &lt;page&gt;    navigate to a page',
			'  <span class="text-coral">whoami</span>       who is this',
			'  <span class="text-coral">cat</span>          list available files',
			'  <span class="text-coral">cat about.md</span> about me',
			'  <span class="text-coral">cat work.md</span>  things I\'ve built',
			'  <span class="text-coral">cat readme</span>   read about this site',
			'  <span class="text-coral">neofetch</span>     system info',
			'  <span class="text-coral">uptime</span>       system uptime',
			'  <span class="text-coral">hack</span>         ???',
			'  <span class="text-coral">clear</span>        clear terminal',
			'',
		];
	}

	function cmdLs(args: string): string[] {
		const entries = Object.keys(pages).map((p) => `  <span class="text-teal">${p}/</span>`);
		if (args.includes('-a') || args.includes('-la') || args.includes('-al')) {
			return [
				'<span class="text-dim">drwxr-xr-x  joe  staff</span>',
				'  <span class="text-dim">.secrets/</span>     <span class="text-coral">[REDACTED]</span>',
				'  <span class="text-dim">.env</span>          <span class="text-coral">[NICE TRY]</span>',
				'  <span class="text-dim">.ssh/</span>         <span class="text-coral">[NOPE]</span>',
				...entries,
				'',
			];
		}
		return ['<span class="text-dim">drwxr-xr-x  joe  staff</span>', ...entries, ''];
	}

	function cmdCd(args: string): string[] {
		const target = args.trim().replace(/^\//, '').replace(/\/$/, '');
		if (!target) return ['<span class="text-dim">usage: cd &lt;page&gt;</span>', ''];
		if (target === '~' || target === '/') {
			window.location.href = '/';
			return ['Navigating to home...'];
		}
		const url = pages[target];
		if (url) {
			setTimeout(() => {
				window.location.href = url;
			}, 400);
			return [`Navigating to /${target}...`];
		}
		return [
			`<span class="text-coral">cd: no such page: ${target}</span>`,
			`<span class="text-dim">try 'ls' to see available pages</span>`,
			'',
		];
	}

	function cmdWhoami(): string[] {
		return [
			'<span class="text-teal">joe-karlsson</span> - software engineer & developer advocate',
			'',
		];
	}

	function cmdCatReadme(): string[] {
		return [
			'<span class="text-yellow">README.md</span>',
			'',
			'  Welcome to joekarlsson.com!',
			'',
			'  This site is where I write about software engineering,',
			'  developer advocacy, homelabs, IoT cat litter boxes,',
			"  and whatever else I'm nerding out about.",
			'',
			'  Built with Astro. Powered by coffee and stubbornness.',
			'',
			"  You found the 404 page, which means you're either",
			'  lost or curious. Either way, I respect it.',
			'',
			'  <span class="text-dim">Type \'ls\' to see where you can go.</span>',
			'',
		];
	}

	function cmdCatAbout(): string[] {
		return [
			'',
			'  <span class="text-yellow">## about.md</span>',
			'',
			'  Hey, I\'m <span class="text-coral">Joe Karlsson</span>.',
			'  Software engineer turned dev advocate.',
			'',
			'  I help developers build cool stuff - through demos,',
			'  blog posts, talks, videos, whatever works. Currently',
			'  doing that at <span class="text-white">CloudQuery</span>.',
			'',
			'  Outside of work I run a <span class="text-teal">40+ container homelab</span>,',
			'  watch way too many movies, and build things that',
			"  probably shouldn't be connected to the internet.",
			'',
			'  <span class="text-dim">See more → <span class="text-teal">cd about</span></span>',
			'',
		];
	}

	function cmdCatWork(): string[] {
		return [
			'',
			'  <span class="text-yellow">## work.md</span>',
			'',
			'  <span class="text-coral">IoT Smart Litter Box</span>',
			'  Built an internet-connected cat toilet. Gave a',
			'  <span class="text-white">TEDx talk</span> about it. Yes, really.',
			'',
			'  <span class="text-coral">40+ Container Homelab</span>',
			'  Proxmox cluster, dual GPUs, Home Assistant,',
			'  media automation, monitoring - the works.',
			'',
			'  <span class="text-coral">Developer Advocacy</span>',
			'  Spoken at hundreds of conferences. Built demos,',
			'  docs, and tools at CloudQuery, Tinybird,',
			'  SingleStore, and MongoDB.',
			'',
			'  <span class="text-dim">See everything → <span class="text-teal">cd work</span></span>',
			'',
		];
	}

	function cmdUptime(): string[] {
		return [
			'  up <span class="text-green">42 days, 3 hours, 17 minutes</span> (since last mass container migration)',
			'  load average: 0.42, 0.69, 1.21',
			'  <span class="text-dim">vibes: immaculate</span>',
			'',
		];
	}

	function cmdNeofetch(): string[] {
		return [
			'',
			'  <span class="text-coral"> ██╗ ██████╗ ███████╗</span>    <span class="text-teal">joe</span>@<span class="text-teal">joekarlsson.com</span>',
			'  <span class="text-coral"> ██║██╔═══██╗██╔════╝</span>    ─────────────────────',
			'  <span class="text-coral"> ██║██║   ██║█████╗  </span>    <span class="text-coral">OS</span>: Astro, self-hosted on Proxmox',
			'  <span class="text-coral">██  ██║   ██║██╔══╝  </span>    <span class="text-coral">Host</span>: Proxmox Cluster x2',
			'  <span class="text-coral">╚█████╔╝██████╔╝███████╗</span>    <span class="text-coral">Kernel</span>: caffeine-6.1.0',
			'  <span class="text-coral"> ╚════╝ ╚═════╝ ╚══════╝</span>    <span class="text-coral">Uptime</span>: 42 days',
			'                          <span class="text-coral">Shell</span>: bash + vibes',
			'                          <span class="text-coral">GPU</span>: RTX A4000 + Quadro RTX 4000',
			'                          <span class="text-coral">Containers</span>: 40+',
			'                          <span class="text-coral">Cats</span>: 2 (1 IoT-enabled)',
			'                          <span class="text-coral">Coffee</span>: ████████████░░ 86%',
			'',
			'                          <span style="color:#ff6b6b">██</span><span style="color:#fdae84">██</span><span style="color:#fde68a">██</span><span style="color:#86efac">██</span><span style="color:#8bcbc8">██</span><span style="color:#c4b5fd">██</span><span style="color:#f0abfc">██</span>',
			'',
		];
	}

	function cmdClear(): string[] {
		output.innerHTML = '';
		return [];
	}

	function executeCommand(raw: string) {
		const trimmed = raw.trim();
		if (!trimmed) return;

		// Echo the command
		appendLine(
			`<span class="text-coral">joe@404 ~$</span> <span class="text-white">${escapeHtml(trimmed)}</span>`,
		);

		if (trimmed) commandHistory.unshift(trimmed);
		historyIndex = -1;

		const [cmd, ...rest] = trimmed.split(/\s+/);
		const args = rest.join(' ');

		let result: string[];

		switch (cmd.toLowerCase()) {
			case 'help':
				result = cmdHelp();
				break;
			case 'ls':
				result = cmdLs(args);
				break;
			case 'cd':
			case 'goto':
				result = cmdCd(args);
				break;
			case 'whoami':
				result = cmdWhoami();
				break;
			case 'cat':
				if (args.toLowerCase() === 'about.md' || args.toLowerCase() === 'about') {
					result = cmdCatAbout();
				} else if (args.toLowerCase() === 'work.md' || args.toLowerCase() === 'work') {
					result = cmdCatWork();
				} else if (args.toLowerCase() === 'readme' || args.toLowerCase() === 'readme.md') {
					result = cmdCatReadme();
				} else if (!args) {
					result = [
						'<span class="text-yellow">Available files:</span>',
						'',
						'  <span class="text-teal">about.md</span>  about me',
						'  <span class="text-teal">work.md</span>   things I\'ve built',
						'  <span class="text-teal">readme</span>    about this site',
						'',
						'<span class="text-dim">usage: cat &lt;filename&gt;</span>',
						'',
					];
				} else {
					result = [
						`<span class="text-coral">cat: ${escapeHtml(args)}: No such file</span>`,
						'<span class="text-dim">type \'cat\' to see available files</span>',
						'',
					];
				}
				break;
			case 'uptime':
				result = cmdUptime();
				break;
			case 'neofetch':
				result = cmdNeofetch();
				break;
			case 'clear':
				result = cmdClear();
				break;
			case 'sudo':
				result = ['<span class="text-coral">nice try.</span>', ''];
				break;
			case 'exit':
				setTimeout(() => {
					window.location.href = '/';
				}, 400);
				result = ['Goodbye! Navigating home...'];
				break;
			case 'rm':
				result = ['<span class="text-coral">absolutely not.</span>', ''];
				break;
			case 'matrix':
			case 'hack':
				result = [
					'',
					'  <span class="text-green">Initiating hack sequence...</span>',
					'  <span class="text-green">████████████████████░░░░░░ 76%</span>',
					'  <span class="text-coral">ACCESS DENIED</span>',
					'',
					'  <span class="text-dim">Nice try. The mainframe remains secure.</span>',
					'  <span class="text-dim">(visit the homepage for the full experience)</span>',
					'',
				];
				break;
			case 'pwd':
				result = ['<span class="text-teal">/home/joe/404</span>', ''];
				break;
			case 'hi':
			case 'hello':
			case 'hey':
				result = [
					'',
					'  <span class="text-coral">Hey!</span> You found the 404 page.',
					'  <span class="text-dim">Type \'ls\' to find your way back.</span>',
					'',
				];
				break;
			case 'curl':
			case 'wget':
				result = [
					"<span class=\"text-dim\">You're already here. Try 'cat readme' instead.</span>",
					'',
				];
				break;
			case 'chmod':
				result = ['<span class="text-coral">chmod: nice try, script kiddie.</span>', ''];
				break;
			case 'chown':
				result = ['<span class="text-coral">chown: you don\'t own me.</span>', ''];
				break;
			case 'kill':
			case 'pkill':
			case 'killall':
				result = ['<span class="text-coral">kill: process "404" refuses to die.</span>', ''];
				break;
			case 'shutdown':
			case 'reboot':
			case 'poweroff':
				result = [
					'<span class="text-coral">Error: This website runs on pure stubbornness.</span>',
					'<span class="text-dim">It cannot be stopped.</span>',
					'',
				];
				break;
			case 'dd':
				result = [
					'<span class="text-coral">dd: permission denied</span>',
					'<span class="text-dim">Nice try. My disks are safe.</span>',
					'',
				];
				break;
			case 'mkfs':
			case 'fdisk':
				result = [
					'<span class="text-coral">Whoa there. This is a website, not your homelab.</span>',
					'',
				];
				break;
			case 'fork':
				result = [
					'<span class="text-coral">:(){ :|:& };: detected</span>',
					'<span class="text-dim">Fork bombs don\'t work here. I\'ve seen things.</span>',
					'',
				];
				break;
			case 'deltree':
			case 'format':
				result = [
					'<span class="text-coral">This isn\'t Windows 95.</span>',
					'<span class="text-dim">But I appreciate the nostalgia.</span>',
					'',
				];
				break;
			case 'drop':
				result = [
					'<span class="text-coral">DROP TABLE users; --</span>',
					'<span class="text-dim">Nice try, Bobby Tables. This is a static site.</span>',
					'',
				];
				break;
			case 'vim':
				result = [
					'<span class="text-dim">You\'re now trapped in vim.</span>',
					'<span class="text-dim">Just kidding. Type :q to... wait, that won\'t work here either.</span>',
					'',
				];
				break;
			case 'emacs':
				result = ['<span class="text-dim">Emacs? In this economy?</span>', ''];
				break;
			case 'nano':
				result = ['<span class="text-green">Finally, someone with taste.</span>', ''];
				break;
			case 'git':
				result = [
					'<span class="text-coral">git: this site is already committed.</span>',
					'<span class="text-dim">No takebacks.</span>',
					'',
				];
				break;
			case 'echo':
				result = [
					`<span class="text-teal">${escapeHtml(args) || '...'}</span>`,
					'<span class="text-dim">(...echo... ...echo...)</span>',
					'',
				];
				break;
			case 'sl':
				result = [
					'',
					'<span class="text-dim">      ====        ________                ___________</span>',
					'<span class="text-dim">  _D _|  |_______/        \\__I_I_____===__|_________|</span>',
					'<span class="text-dim">   |(_)---  |   H\\________/ |   |        =|___ ___|</span>',
					'<span class="text-dim">   /     |  |   H  |  |     |   |         ||_| |_||</span>',
					'<span class="text-dim">  |      |  |   H  |__--------------------| [___] |</span>',
					'<span class="text-dim">  | ________|___H__/__|_____/[][]~\\_______|       |</span>',
					'<span class="text-dim">  |/ |   |-----------I_____I [][] []  D   |=======|__</span>',
					'',
					"<span class=\"text-coral\">You meant 'ls', didn't you?</span>",
					'',
				];
				break;
			case 'please':
			case 'thanks':
			case 'thank':
				result = [
					'<span class="text-green">You\'re welcome! Such nice manners.</span>',
					'<span class="text-dim">Type \'help\' if you need anything.</span>',
					'',
				];
				break;
			case 'coffee':
				result = [
					'',
					'    <span class="text-coral">   )</span>',
					'    <span class="text-coral">  (</span>',
					'    <span class="text-coral">c[_]</span>',
					'',
					'<span class="text-dim">Coffee level: ████████░░ 80%</span>',
					'<span class="text-dim">Homelab uptime directly correlated.</span>',
					'',
				];
				break;
			case 'beer':
				result = [
					'',
					'    <span class="text-yellow">  .~~~~.</span>',
					'    <span class="text-yellow">  i====i_</span>',
					'    <span class="text-yellow">  |cccc|_)</span>',
					'    <span class="text-yellow">  |cccc|</span>',
					'    <span class="text-yellow">  `-==-\'</span>',
					'',
					'<span class="text-dim">It\'s mass container migration o\'clock somewhere.</span>',
					'',
				];
				break;
			case '42':
				result = [
					'<span class="text-green">The Answer to the Ultimate Question of Life,</span>',
					'<span class="text-green">the Universe, and Everything.</span>',
					'',
					'<span class="text-dim">...but what was the question?</span>',
					'',
				];
				break;
			case 'xkcd':
				result = [
					'<span class="text-dim">I see you\'re a person of culture.</span>',
					'<span class="text-teal">sudo make me a sandwich</span>',
					'',
				];
				break;
			case 'rickroll':
			case 'rick':
				result = [
					'<span class="text-coral">Never gonna give you up</span>',
					'<span class="text-coral">Never gonna let you down</span>',
					'<span class="text-coral">Never gonna run around and desert you</span>',
					'',
				];
				break;
			case 'ping':
				result = [
					'<span class="text-green">PONG!</span>',
					'<span class="text-dim">64 bytes from 404.joekarlsson.com: icmp_seq=1 ttl=64 time=0.404ms</span>',
					'',
				];
				break;
			case 'ssh':
				result = [
					'<span class="text-coral">ssh: Connection refused</span>',
					'<span class="text-dim">Nice try. My homelab is behind a VPN.</span>',
					'',
				];
				break;
			case 'docker':
			case 'npm':
			case 'yarn':
			case 'pnpm':
			case 'python':
			case 'node':
				result = [
					'<span class="text-dim">This is a 404 page, not a dev environment.</span>',
					'<span class="text-dim">Type \'ls\' to find your way home.</span>',
					'',
				];
				break;
			case 'touch':
			case 'mkdir':
			case 'mv':
			case 'cp':
				result = [
					'<span class="text-coral">Permission denied.</span>',
					'<span class="text-dim">This is a read-only filesystem.</span>',
					'',
				];
				break;
			case 'nmap':
			case 'telnet':
			case 'traceroute':
				result = [
					'<span class="text-coral">Scanning...</span>',
					'<span class="text-dim">PORT     STATE    SERVICE</span>',
					'<span class="text-dim">404/tcp  open     not-found</span>',
					'',
				];
				break;
			case 'fuck':
			case 'shit':
			case 'damn':
				result = [
					'<span class="text-dim">I understand. 404s are frustrating.</span>',
					"<span class=\"text-dim\">Type 'ls' to find what you're looking for.</span>",
					'',
				];
				break;
			case 'why':
				result = ['<span class="text-dim">Because the page doesn\'t exist. Sorry!</span>', ''];
				break;
			default:
				result = [
					`<span class="text-dim">${escapeHtml(cmd)}: command not found. try 'help'</span>`,
					'',
				];
		}

		appendLines(result);
	}

	function escapeHtml(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}

	function updateInputDisplay() {
		inputText.textContent = currentInput;
		scrollToBottom();
	}

	// --- Keyboard handler (uses hidden input for reliable keystroke capture) ---
	function focusInput() {
		hiddenInput.focus();
	}

	hiddenInput.addEventListener('keydown', (e: KeyboardEvent) => {
		if (!ready) return;

		if (e.key === 'Enter') {
			e.preventDefault();
			const cmd = currentInput;
			currentInput = '';
			hiddenInput.value = '';
			updateInputDisplay();
			inputLine.style.display = 'none';
			executeCommand(cmd);
			inputLine.style.display = 'flex';
			updateInputDisplay();
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			if (commandHistory.length > 0 && historyIndex < commandHistory.length - 1) {
				historyIndex++;
				currentInput = commandHistory[historyIndex];
				hiddenInput.value = currentInput;
				updateInputDisplay();
			}
		} else if (e.key === 'ArrowDown') {
			e.preventDefault();
			if (historyIndex > 0) {
				historyIndex--;
				currentInput = commandHistory[historyIndex];
			} else {
				historyIndex = -1;
				currentInput = '';
			}
			hiddenInput.value = currentInput;
			updateInputDisplay();
		} else if (e.key === 'Tab') {
			e.preventDefault();
			const partial = currentInput.replace(/^(cd|goto)\s+/, '');
			const prefix = currentInput.replace(partial, '');
			const matches = Object.keys(pages).filter((p) => p.startsWith(partial));
			if (matches.length === 1) {
				currentInput = prefix + matches[0];
				hiddenInput.value = currentInput;
				updateInputDisplay();
			}
		} else if (e.key === 'l' && e.ctrlKey) {
			e.preventDefault();
			cmdClear();
		}
	});

	// Sync hidden input value to our display on every keystroke
	hiddenInput.addEventListener('input', () => {
		if (!ready) return;
		currentInput = hiddenInput.value;
		updateInputDisplay();
	});

	// Focus hidden input on click anywhere in terminal
	terminal.addEventListener('click', () => {
		focusInput();
	});

	// --- Boot sequence ---
	async function boot() {
		const bootLines = [
			'<span class="text-dim">[    0.000000] joekarlsson.com kernel loading...</span>',
			'<span class="text-dim">[    0.042069] Initializing vibes subsystem</span>',
			'<span class="text-dim">[    0.133700] Mounting /dev/pages</span>',
			'<span class="text-dim">[    0.200000] Scanning route table...</span>',
		];

		await typeLines(bootLines, 120);
		await sleep(300);

		appendLine(
			'<span class="text-coral">[    0.404000] ERROR: requested path not found in route table</span>',
		);
		await sleep(200);
		appendLine(
			'<span class="text-coral">[    0.404001] PANIC: page does not exist (error 404)</span>',
		);
		await sleep(400);

		appendLines([
			'',
			'<span class="text-yellow">  The page you requested was not found.</span>',
			'<span class="text-yellow">  But you found something better: a terminal.</span>',
			'',
			"<span class=\"text-dim\">  Type 'help' for available commands, or 'ls' to see site pages.</span>",
			'',
		]);

		inputLine.style.display = 'flex';
		ready = true;
		focusInput();
	}

	boot();
</script>
