---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Joe Karlsson" description="Page not found">
	<script>
		if (typeof window.plausible === 'function') {
			window.plausible('404', { props: { path: window.location.pathname } });
		}
	</script>
	<div class="mx-auto max-w-3xl px-4 py-24 text-center">
		<h1 class="mb-6 font-display text-[clamp(64px,14vw,180px)] leading-none text-pink uppercase">
			404
		</h1>
		<p class="mb-8 text-lg text-paper">Nothing lives at this address. It may have moved.</p>
		<p class="flex justify-center gap-6 font-semibold">
			<a href="/" class="text-pink no-underline hover:text-white">
				Go home
			</a>
			<a href="/blog/" class="text-pink no-underline hover:text-white">
				Read the blog
			</a>
		</p>
	</div>
</BaseLayout>
