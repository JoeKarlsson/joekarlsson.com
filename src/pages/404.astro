---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/terminal.css';
---

<BaseLayout title="404 | Joe Karlsson" description="Page not found">
	<script>
		if (typeof window.plausible === 'function') {
			window.plausible('404', { props: { path: window.location.pathname } });
		}
	</script>
	<div class="mx-auto max-w-3xl px-4 py-16 text-center">
		<div class="glitch-wrapper mb-6">
			<h1 class="glitch text-8xl font-bold text-coral" data-text="404">404</h1>
		</div>

		<!-- Terminal -->
		<div
			class="terminal mx-auto max-w-2xl text-left rounded-lg overflow-hidden border border-surface-3 shadow-2xl mb-8"
		>
			<!-- Title bar -->
			<div
				class="terminal-titlebar flex items-center gap-2 px-4 py-2 bg-surface-1 border-b border-surface-3"
			>
				<span class="w-3 h-3 rounded-full bg-red-500/80"></span>
				<span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
				<span class="w-3 h-3 rounded-full bg-green-500/80"></span>
				<span class="ml-2 text-xs text-gray-400 font-mono">joe@joekarlsson.com - bash</span>
			</div>
			<!-- Terminal body -->
			<div
				id="terminal"
				class="terminal-body bg-surface-0 p-4 font-mono text-sm leading-relaxed h-96 overflow-y-auto cursor-text"
				tabindex="0"
				role="application"
				aria-label="Interactive terminal. Type help for available commands."
			>
				<div id="output"></div>
				<div id="input-line" class="flex items-center" style="display:none;">
					<span class="prompt text-coral mr-2">joe@404 ~$</span>
					<span class="relative">
						<span
							id="placeholder"
							class="text-gray-400 absolute left-0 pointer-events-none"
							style="white-space: nowrap;">type a command...</span
						>
						<span id="input-text" class="text-gray-200 cursor-blink"></span><span
							id="ghost-text"
							class="text-gray-600 pointer-events-none"
							aria-hidden="true"></span>
					</span>
				</div>
				<div
					id="hint-text"
					class="text-xs text-gray-400 mt-2 transition-opacity duration-500"
					style="display:none;"
				>
					Type <span class="text-coral">help</span> or use <span class="text-teal">↑↓</span> for history
					• <span class="text-teal">Tab</span> to autocomplete
				</div>
				<label for="hidden-input" class="sr-only">Terminal command input</label>
				<input
					id="hidden-input"
					type="text"
					class="absolute opacity-0 w-0 h-0 pointer-events-none"
					autocomplete="off"
					autocorrect="off"
					autocapitalize="off"
					spellcheck="false"
				/>
			</div>
		</div>

		<a
			href="/"
			class="inline-block rounded-md bg-coral px-4 py-2 font-medium text-surface-0 no-underline hover:bg-teal"
		>
			Go Home
		</a>
	</div>
</BaseLayout>

<style>
	#output {
		white-space: pre-wrap;
	}

	.glitch-wrapper {
		position: relative;
		display: inline-block;
	}

	.glitch {
		position: relative;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.glitch::before {
		color: var(--color-teal, #8bcbc8);
		animation: glitch-1 2s infinite linear alternate-reverse;
		clip-path: inset(0 0 65% 0);
	}

	.glitch::after {
		color: var(--color-lavender, #c4b5fd);
		animation: glitch-2 2s infinite linear alternate-reverse;
		clip-path: inset(65% 0 0 0);
	}

	@keyframes glitch-1 {
		0%,
		90%,
		100% {
			transform: translate(0);
		}
		92% {
			transform: translate(-3px, 1px);
		}
		94% {
			transform: translate(3px, -1px);
		}
		96% {
			transform: translate(-2px, 0);
		}
		98% {
			transform: translate(2px, 1px);
		}
	}

	@keyframes glitch-2 {
		0%,
		90%,
		100% {
			transform: translate(0);
		}
		91% {
			transform: translate(3px, 0);
		}
		93% {
			transform: translate(-3px, 1px);
		}
		95% {
			transform: translate(2px, -1px);
		}
		97% {
			transform: translate(-2px, 1px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch::before,
		.glitch::after {
			animation: none;
		}
	}
</style>

<script>
	import * as T from '../lib/terminal-core';

	const variant = '404' as const;
	const pages = T.defaultPages;

	const output = document.getElementById('output')!;
	const inputLine = document.getElementById('input-line')!;
	const inputText = document.getElementById('input-text')!;
	const terminal = document.getElementById('terminal')!;
	const hiddenInput = document.getElementById('hidden-input') as HTMLInputElement;
	const placeholder = document.getElementById('placeholder');
	const hintText = document.getElementById('hint-text');
	const ghostText = document.getElementById('ghost-text');

	let currentInput = '';
	const commandHistory: string[] = [];
	let historyIndex = -1;
	let ready = false;
	let hasInteracted = false;

	// Tab completion lists
	const allCommands = T.allCommands.filter((c) => !['fortune', 'cowsay', 'man'].includes(c));
	const catFiles = T.catFiles.filter(
		(f) => !['music', 'fails', 'blog/iot', 'blog/homelab', 'cat'].includes(f),
	);

	function scrollToBottom() {
		terminal.scrollTop = terminal.scrollHeight;
	}

	function appendLine(html: string) {
		const div = document.createElement('div');
		div.innerHTML = html;
		output.appendChild(div);
		scrollToBottom();
	}

	function appendLines(lines: string[]) {
		lines.forEach((line) => appendLine(line));
	}

	async function typeLines(lines: string[], delay = 40) {
		for (const line of lines) {
			appendLine(line);
			await T.sleep(delay);
		}
	}

	function cmdClear(): string[] {
		output.innerHTML = '';
		return [];
	}

	function executeCommand(raw: string) {
		const trimmed = raw.trim();
		if (!trimmed) return;

		hideHint();

		appendLine(
			`<span class="text-coral">joe@404 ~$</span> <span class="text-white">${T.escapeHtml(trimmed)}</span>`,
		);

		if (trimmed) commandHistory.unshift(trimmed);
		historyIndex = -1;

		const [cmd, ...rest] = trimmed.split(/\s+/);
		const args = rest.join(' ');

		let result: string[];

		switch (cmd.toLowerCase()) {
			case 'help':
				result = T.cmdHelp(variant);
				break;
			case 'ls':
				result = T.cmdLs(args, pages);
				break;
			case 'cd':
			case 'goto': {
				const r = T.cmdCd(args, pages);
				result = r.lines;
				if (r.navigateTo) {
					setTimeout(() => {
						window.location.href = r.navigateTo!;
					}, 400);
				}
				break;
			}
			case 'whoami':
				result = T.cmdWhoami();
				break;
			case 'cat':
				if (args.toLowerCase() === 'about.md' || args.toLowerCase() === 'about') {
					result = T.cmdCatAbout();
				} else if (args.toLowerCase() === 'work.md' || args.toLowerCase() === 'work') {
					result = T.cmdCatWork();
				} else if (args.toLowerCase() === 'readme' || args.toLowerCase() === 'readme.md') {
					result = T.cmdCatReadme(variant);
				} else if (!args) {
					result = T.cmdCatEmpty(variant);
				} else {
					result = [
						`<span class="text-coral">cat: ${T.escapeHtml(args)}: No such file</span>`,
						'<span class="text-dim">type \'cat\' to see available files</span>',
						'',
					];
				}
				break;
			case 'uptime':
				result = T.cmdUptime(variant);
				break;
			case 'neofetch':
				result = T.cmdNeofetch(variant);
				break;
			case 'clear':
				result = cmdClear();
				break;
			case 'sudo':
				result = T.cmdSudo();
				break;
			case 'exit': {
				const r = T.cmdExit(variant);
				result = r.lines;
				if (r.navigateTo) {
					setTimeout(() => {
						window.location.href = r.navigateTo!;
					}, 400);
				}
				break;
			}
			case 'rm':
				result = T.cmdRm();
				break;
			case 'matrix':
			case 'hack':
				result = T.cmdHack(variant).lines;
				break;
			case 'pwd':
				result = T.cmdPwd(variant);
				break;
			case 'hi':
			case 'hello':
			case 'hey':
				result = T.cmdHi(variant);
				break;
			case 'curl':
			case 'wget':
				result = T.cmdCurlWget();
				break;
			case 'chmod':
				result = T.cmdChmod();
				break;
			case 'chown':
				result = T.cmdChown();
				break;
			case 'kill':
			case 'pkill':
			case 'killall':
				result = T.cmdKill(variant);
				break;
			case 'shutdown':
			case 'reboot':
			case 'poweroff':
				result = T.cmdShutdown();
				break;
			case 'dd':
				result = T.cmdDd();
				break;
			case 'mkfs':
			case 'fdisk':
				result = T.cmdMkfs();
				break;
			case 'fork':
				result = T.cmdFork();
				break;
			case 'deltree':
			case 'format':
				result = T.cmdDeltree();
				break;
			case 'drop':
				result = T.cmdDrop();
				break;
			case 'vim':
				result = T.cmdVim();
				break;
			case 'emacs':
				result = T.cmdEmacs();
				break;
			case 'nano':
				result = T.cmdNano();
				break;
			case 'git':
				result = T.cmdGit(variant);
				break;
			case 'echo':
				result = T.cmdEcho(args);
				break;
			case 'sl':
				result = T.cmdSl();
				break;
			case 'please':
			case 'thanks':
			case 'thank':
				result = T.cmdPlease();
				break;
			case 'coffee':
				result = T.cmdCoffee();
				break;
			case 'beer':
				result = T.cmdBeer();
				break;
			case '42':
				result = T.cmd42();
				break;
			case 'xkcd':
				result = T.cmdXkcd();
				break;
			case 'rickroll':
			case 'rick':
				result = T.cmdRickroll(variant);
				break;
			case 'ping':
				result = T.cmdPing(variant);
				break;
			case 'ssh':
				result = T.cmdSsh();
				break;
			case 'docker':
			case 'npm':
			case 'yarn':
			case 'pnpm':
			case 'python':
			case 'node':
				result = T.cmdDocker(variant);
				break;
			case 'touch':
			case 'mkdir':
			case 'mv':
			case 'cp':
				result = T.cmdTouch();
				break;
			case 'nmap':
			case 'telnet':
			case 'traceroute':
				result = T.cmdNmap(variant);
				break;
			case 'fuck':
			case 'shit':
			case 'damn':
				result = T.cmdFrustration(variant);
				break;
			case 'why':
				result = T.cmdWhy(variant);
				break;
			default:
				result = T.cmdNotFound(cmd);
		}

		appendLines(result);
	}

	function getGhostCompletion(input: string): string {
		if (!input) return '';
		const lower = input.toLowerCase();
		if (lower.startsWith('cd ') || lower.startsWith('goto ')) {
			const partial = input.replace(/^(cd|goto)\s+/i, '');
			const matches = Object.keys(pages)
				.filter((p) => p.toLowerCase().startsWith(partial.toLowerCase()))
				.sort();
			if (matches.length >= 1) return matches[0].slice(partial.length);
			return '';
		}
		if (lower.startsWith('cat ')) {
			const partial = input.replace(/^cat\s+/i, '');
			const matches = catFiles
				.filter((f) => f.toLowerCase().startsWith(partial.toLowerCase()))
				.sort();
			if (matches.length >= 1) return matches[0].slice(partial.length);
			return '';
		}
		if (!lower.includes(' ')) {
			const matches = allCommands.filter((c) => c.startsWith(lower)).sort();
			if (matches.length >= 1 && matches[0] !== lower) return matches[0].slice(lower.length);
			return '';
		}
		return '';
	}

	function updateInputDisplay() {
		inputText.textContent = currentInput;
		if (placeholder) {
			placeholder.style.display = currentInput.length > 0 ? 'none' : 'inline';
		}
		if (ghostText) {
			ghostText.textContent = getGhostCompletion(currentInput);
		}
		scrollToBottom();
	}

	function hideHint() {
		if (hintText && !hasInteracted) {
			hasInteracted = true;
			hintText.style.opacity = '0';
			setTimeout(() => {
				hintText.style.display = 'none';
			}, 500);
		}
	}

	function focusInput() {
		hiddenInput.focus();
	}

	hiddenInput.addEventListener('keydown', (e: KeyboardEvent) => {
		if (!ready) return;

		if (e.key === 'Enter') {
			e.preventDefault();
			const cmd = currentInput;
			currentInput = '';
			hiddenInput.value = '';
			updateInputDisplay();
			inputLine.style.display = 'none';
			executeCommand(cmd);
			inputLine.style.display = 'flex';
			updateInputDisplay();
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			if (commandHistory.length > 0 && historyIndex < commandHistory.length - 1) {
				historyIndex++;
				currentInput = commandHistory[historyIndex];
				hiddenInput.value = currentInput;
				updateInputDisplay();
			}
		} else if (e.key === 'ArrowDown') {
			e.preventDefault();
			if (historyIndex > 0) {
				historyIndex--;
				currentInput = commandHistory[historyIndex];
			} else {
				historyIndex = -1;
				currentInput = '';
			}
			hiddenInput.value = currentInput;
			updateInputDisplay();
		} else if (e.key === 'Tab' || (e.key === 'ArrowRight' && ghostText?.textContent)) {
			e.preventDefault();
			const ghost = ghostText?.textContent;
			if (ghost) {
				currentInput += ghost;
				hiddenInput.value = currentInput;
				updateInputDisplay();
			}
		} else if (e.key === 'l' && e.ctrlKey) {
			e.preventDefault();
			cmdClear();
		}
	});

	hiddenInput.addEventListener('input', () => {
		if (!ready) return;
		currentInput = hiddenInput.value;
		updateInputDisplay();
	});

	terminal.addEventListener('click', () => {
		focusInput();
	});

	async function boot() {
		const bootLines = [
			'<span class="text-dim">[    0.000000] joekarlsson.com kernel loading...</span>',
			'<span class="text-dim">[    0.042069] Initializing vibes subsystem</span>',
			'<span class="text-dim">[    0.133700] Mounting /dev/pages</span>',
			'<span class="text-dim">[    0.200000] Scanning route table...</span>',
		];

		await typeLines(bootLines, 120);
		await T.sleep(300);

		appendLine(
			'<span class="text-coral">[    0.404000] ERROR: requested path not found in route table</span>',
		);
		await T.sleep(200);
		appendLine(
			'<span class="text-coral">[    0.404001] PANIC: page does not exist (error 404)</span>',
		);
		await T.sleep(400);

		appendLines([
			'',
			'<span class="text-yellow">  The page you requested was not found.</span>',
			'<span class="text-yellow">  But you found something better: a terminal.</span>',
			'',
		]);

		inputLine.style.display = 'flex';
		if (hintText) hintText.style.display = 'block';
		ready = true;
		focusInput();
	}

	boot();
</script>
