---
import DrawingBoard from '../components/DrawingBoard.astro';
import IndexRow from '../components/IndexRow.astro';
import Scribble from '../components/Scribble.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';
import { ARROW, CHALK, HERO_COIL, MARKS } from '../data/scribbles';
import nowFeed from '../data/now-feed.json';
import { getCategoryCounts } from '../utils/categories';
import { getFeedPosts } from '../utils/posts';

// Live count from the snapshot scripts/update-now-feed.mjs writes on every deploy
const { runningContainers } = nowFeed.homelab;

const allPosts = await getFeedPosts();
const recentPosts = allPosts.slice(0, 5);
// Work and Personal are catch-all buckets most posts sit in; the index lists subjects
const CATCH_ALL_CATEGORIES = ['Work', 'Personal'];
const topics = getCategoryCounts(allPosts.filter((p) => !p.isNewsletter))
	.filter((topic) => !CATCH_ALL_CATEGORIES.includes(topic.name))
	.slice(0, 8);

const HOME_PROJECTS = [
	'PixelPane',
	'Screencast Director',
	'FollowSpot',
	'Connect AI × DOOM',
	'IoT Kitty Litter Box',
];
const homeProjects = HOME_PROJECTS.map((title) => {
	const project = projects.find((p) => p.title === title);
	if (!project) throw new Error(`Homepage project "${title}" is not in src/data/projects.ts`);
	const href = project.page ? `/work/${project.page.slug}/` : project.blogUrl;
	if (!href) throw new Error(`Homepage project "${title}" has no project page or blog post`);
	return { title, href, meta: [project.date.slice(0, 4), ...project.tech.slice(0, 2)].join(' · ') };
});

const dateFormat = new Intl.DateTimeFormat('en-US', {
	timeZone: 'UTC',
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});

const TOP_TICKER = ['Joe Karlsson', 'Developer marketing', 'Homelab', 'Databases', 'Smart home'];
const BOTTOM_TICKER = [
	'Homelab',
	'Databases',
	'Smart home',
	'DevRel',
	'AI tools',
	'Talks',
	`${runningContainers} containers`,
];
const SLOT_WORDS = ['ugly pot', 'ugly demo', 'weird idea', 'homelab', 'ugly pot'];

const COLLAGE = [
	{ name: 'racktop', alt: 'Photocopied networking gear at the top of the rack' },
	{ name: 'rackfront', alt: 'Halftone server rack' },
	{ name: 'cat', alt: "Photocopied video of Joe's cat on the litter box wiring" },
	{ name: 'kindle', alt: 'Photocopied video of the Kindle home dashboard' },
	{ name: 'assembly', alt: 'Photocopied video of the litter box being built' },
	{ name: 'desk', alt: "Halftone of Joe's desk" },
];
---

<BaseLayout
	title="Joe Karlsson | Developer Marketing Engineer"
	description={SITE_DESCRIPTION}
	schemaType="WebSite"
>
	<div slot="hero" class="grid gap-4 p-4 md:grid-cols-2">
		<!-- Phones: a 16:9 banner zoomed in on Joe's face (each clip centers it in the top
		third). Side by side: at least square, growing with a taller text panel so the
		video never stops short. -->
		<div class="relative aspect-video overflow-hidden rounded-xl md:aspect-auto md:before:block md:before:aspect-square md:before:content-['']">
			<video
				class="absolute inset-0 size-full scale-[1.4] object-cover object-[50%_11%] md:scale-100 md:object-center"
				src="/images/home/montage.mp4"
				poster="/images/home/montage-poster.webp"
				data-autoplay-in-view
				muted
				loop
				playsinline
				preload="metadata"
				aria-label="Montage of short halftone clips of Joe"
			></video>
			<Scribble
				{...MARKS.tally}
				color="#000"
				duration="9s"
				delay="0.6s"
				class="top-[6%] right-[6%] h-[11%] w-[22%]"
			/>
			<Scribble
				{...MARKS.lines}
				color={CHALK}
				duration="11s"
				delay="1.8s"
				class="bottom-[9%] left-[5%] h-[15%] w-[68%]"
			/>
			<Scribble
				{...MARKS.hatch}
				color={CHALK}
				duration="8s"
				delay="3.2s"
				class="right-[5%] bottom-[5%] h-[10%] w-[20%]"
			/>
		</div>
		<div class="grid min-w-0 grid-rows-[auto_1fr] gap-4">
			<div class="ticker rounded-xl bg-pink pt-3.5 pb-2 text-ink" aria-hidden="true">
				<div class="ticker-track font-display text-[clamp(52px,6.2vw,96px)] leading-none uppercase">
					{[...TOP_TICKER, ...TOP_TICKER].map((item) => (
						<>
							<span>{item}</span>
							<span class="-translate-y-[0.15em] text-[0.38em]">●</span>
						</>
					))}
				</div>
			</div>
			<div class="flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7">
				<div>
					<p class="mb-3.5 text-[clamp(26px,2.6vw,40px)] leading-[1.15] font-semibold text-white">
						I run developer marketing, from the docs and demos to the talks and videos.
					</p>
					<p class="max-w-[32em] text-[clamp(17px,1.4vw,21px)] text-paper">
						15 years writing software at companies like MongoDB and Best Buy. Now I lead developer
						marketing at CData. Outside of work I run a {`${runningContainers}-container`} homelab,
						build smart home projects, and watch a lot of movies.
					</p>
				</div>
				<div class="@container">
					<h1 class="relative font-display text-[calc(100cqw/var(--name-ratio))] leading-[0.88] whitespace-nowrap text-paper uppercase [--name-ratio:3.8]">
						<span class="block">Joe</span>
						<span class="block">Karlsson</span>
						<Scribble
							path={HERO_COIL}
							color="#ff4fd8"
							duration="9s"
							delay="0.3s"
							class="-bottom-[14%] -left-[4%] h-[85%] w-[104%]"
						/>
					</h1>
				</div>
			</div>
		</div>
	</div>

	<section class="relative px-4 pt-20 sm:px-7">
		<h2 class="mb-[18px] font-display text-[clamp(40px,4.6vw,64px)] leading-none uppercase">
			<a href="/blog/" class="relative text-pink no-underline hover:text-pink hover:underline">
				Recent posts
				<Scribble
					{...MARKS.underline}
					color={CHALK}
					duration="8s"
					delay="0.5s"
					class="-bottom-[0.3em] left-0 h-[0.3em] w-full"
				/>
			</a>
		</h2>
		<ul>
			{recentPosts.map((post) => (
				<li class="group grid items-center gap-7 border-t border-surface-4 py-[18px] md:grid-cols-[clamp(140px,22vw,300px)_1fr]">
					<a href={post.href} tabindex="-1" aria-hidden="true">
						<img
							src={post.data.heroImage || DEFAULT_HERO_IMAGE}
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							class="block aspect-video w-full rounded-lg object-cover"
						/>
					</a>
					<div>
						<span class="mb-1.5 block text-sm text-muted">
							<time datetime={post.data.date.toISOString()}>
								{dateFormat.format(post.data.date)}
							</time>
							{post.data.categories[0] && ` · ${post.data.categories[0]}`}
						</span>
						<a
							href={post.href}
							class="text-[clamp(20px,2.2vw,30px)] leading-tight font-semibold text-paper no-underline group-hover:text-pink"
						>
							{post.data.title}
						</a>
					</div>
				</li>
			))}
		</ul>
		<Scribble
			path={ARROW}
			color="#ff4fd8"
			viewBox="0 0 260 140"
			strokeWidth={7}
			duration="5s"
			delay="1s"
			class="top-10 right-[8%] hidden h-[110px] w-[200px] md:block"
		/>
		<p class="mt-[18px]">
			<a href="/blog/" class="font-semibold text-pink no-underline hover:text-white">
				All {allPosts.length} posts →
			</a>
		</p>
	</section>

	<p class="relative mx-4 mt-[110px] mb-[30px] flex items-baseline justify-center gap-[0.28em] font-display text-[clamp(32px,10vw,170px)] leading-[0.88] whitespace-nowrap text-paper uppercase sm:mx-7">
		<span class="sr-only">Ship the ugly pot</span>
		<span aria-hidden="true">Ship the</span>
		<span class="slot-window" aria-hidden="true">
			<span class="slot-reel text-pink">
				{SLOT_WORDS.map((word) => (
					<span>{word}</span>
				))}
			</span>
		</span>
		<Scribble
			{...MARKS.check}
			color={CHALK}
			duration="7s"
			delay="2s"
			class="-top-[0.35em] right-[2%] hidden h-[0.55em] w-[0.8em] md:block"
		/>
	</p>

	<section class="relative overflow-x-clip px-4 pt-20 sm:px-7">
		<h2 class="mb-[18px] font-display text-[clamp(40px,4.6vw,64px)] leading-none uppercase">
			<a href="/work/" class="text-pink no-underline hover:text-pink hover:underline">
				Projects
			</a>
		</h2>
		<Scribble
			{...MARKS.hatch}
			color="#ff4fd8"
			duration="9s"
			delay="1s"
			class="top-[86px] right-[6%] h-[60px] w-[120px]"
		/>
		<div class="border-b border-surface-4">
			{homeProjects.map((project, i) => (
				<IndexRow href={project.href} label={project.title} meta={project.meta} index={i} />
			))}
		</div>
		<p class="mt-[18px]">
			<a href="/work/" class="font-semibold text-pink no-underline hover:text-white">
				All projects →
			</a>
		</p>
	</section>

	<DrawingBoard />

	<section class="relative overflow-x-clip px-4 pt-20 sm:px-7">
		<h2 class="mb-[18px] font-display text-[clamp(40px,4.6vw,64px)] leading-none uppercase">
			<a href="/blog/" class="text-pink no-underline hover:text-pink hover:underline">
				Writing by topic
			</a>
		</h2>
		<Scribble
			{...MARKS.lines}
			color={CHALK}
			duration="12s"
			delay="0.4s"
			class="top-[92px] right-[4%] hidden h-[56px] w-[250px] sm:block"
		/>
		<div class="border-b border-surface-4">
			{topics.map((topic, i) => (
				<IndexRow
					href={`/blog/category/${topic.slug}/`}
					label={topic.name}
					meta={`${topic.count} posts`}
					index={i + 1}
				/>
			))}
		</div>
		<p class="mt-[18px]">
			<a href="/blog/" class="font-semibold text-pink no-underline hover:text-white">
				Every post and topic →
			</a>
		</p>
	</section>

	<!-- Clips marks that hang past the clips at the screen edge -->
	<div class="overflow-x-clip">
		<div class="collage mx-4 mt-20 grid grid-cols-2 items-center gap-5 sm:mx-7 md:grid-cols-6">
			{COLLAGE.map(({ name, alt }, i) => (
				<figure class="relative">
					<video
						class="block w-full"
						src={`/images/home/${name}.mp4`}
						poster={`/images/home/${name}-poster.webp`}
						data-autoplay-in-view
						muted
						loop
						playsinline
						preload="none"
						aria-label={alt}
					/>
					{i === 3 && (
						<Scribble
							{...MARKS.box}
							color={CHALK}
							duration="10s"
							delay="1.5s"
							class="-inset-[10%] size-[120%]"
						/>
					)}
					{i === 0 && (
						<Scribble
							{...MARKS.cross}
							color="#ff4fd8"
							duration="8s"
							delay="3s"
							class="-top-[18%] -left-[8%] size-[70px]"
						/>
					)}
				</figure>
			))}
		</div>
	</div>

	<!-- Clips the tilted ticker's corners so the page doesn't scroll sideways -->
	<div class="overflow-x-clip pt-[90px] pb-24">
		<div
			class="ticker scale-[1.04] -rotate-2 border-y-[3px] border-pink bg-ink pt-3 pb-1.5 ticker-reverse"
			aria-hidden="true"
		>
			<div class="ticker-track font-display text-[clamp(44px,5vw,80px)] leading-none text-pink uppercase [--ticker-duration:45s]">
				{[...BOTTOM_TICKER, ...BOTTOM_TICKER].map((item) => (
					<>
						<span>{item}</span>
						<span class="-translate-y-[0.15em] text-[0.38em] text-paper">●</span>
					</>
				))}
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	@media (min-width: 768px) {
		.collage {
			grid-template-columns: 1fr 0.8fr 1fr 0.7fr 1.1fr 0.9fr;
		}
	}

	/* Taped-up, slightly crooked */
	.collage figure:nth-child(1) {
		transform: rotate(-2.5deg);
	}
	.collage figure:nth-child(2) {
		transform: rotate(1.8deg) translateY(30px);
	}
	.collage figure:nth-child(3) {
		transform: rotate(-1deg);
	}
	.collage figure:nth-child(4) {
		transform: rotate(2.4deg) translateY(-20px);
	}
	.collage figure:nth-child(5) {
		transform: rotate(-2deg) translateY(18px);
	}
	.collage figure:nth-child(6) {
		transform: rotate(1.5deg) translateY(-14px);
	}
</style>
