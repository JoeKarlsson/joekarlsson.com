---
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/ui';
import DrawingBoard from '../components/DrawingBoard.astro';
import MarginDoodles from '../components/MarginDoodles.astro';
import FeaturedBand from '../components/FeaturedBand.astro';
import HoverBox from '../components/HoverBox.astro';
import MetaParts from '../components/MetaParts.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import Scribble from '../components/Scribble.astro';
import SectionMasthead from '../components/SectionMasthead.astro';
import WrittenFor from '../components/WrittenFor.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';
import { ARROW, CHALK, COIL, HERO_COIL, MARKS } from '../data/scribbles';
import { shortPosterPath, shorts } from '../data/shorts';
import nowFeed from '../data/now-feed.json';
import popularPosts from '../data/popular-posts.json';
import { getCategoryCounts } from '../utils/categories';
import { getFeedPosts, getPinnedPost, isOwnPost } from '../utils/posts';
import { cardClip, halftoneMode } from '../utils/halftone';
import { oneLiner, reviewStats } from '../utils/review-stats';
import { terminalCard, terminalRuns } from '../utils/terminal-card';
import { stars } from '../../scripts/update-reviews.mjs';
import { joinLastWord } from '../plugins/rehype-no-widows.mjs';

const allPosts = await getFeedPosts();
const ownPosts = allPosts.filter(isOwnPost);
const [leadPost, ...sidePosts] = ownPosts.slice(0, 4);
// All six subject categories (BLOG_CATEGORIES), most posts first
const topics = getCategoryCounts(allPosts.filter((p) => !p.isNewsletter));

// Most read: the five own posts with the most visitors in the last 12 months (Plausible,
// popular-posts.json). Only the bars show, relative to the top post: no counts in public
const mostRead = Object.entries(popularPosts.visitorsByPath)
	.flatMap(([path, visitors]) => {
		const post = ownPosts.find((p) => p.href === path);
		return post ? [{ post, visitors }] : [];
	})
	.slice(0, 5);
const topVisitors = mostRead[0].visitors;

// A line I picked from a post, set big between Writing and Most read
const pullQuote = {
	text: 'Working like this, I can get into an artistic flow.',
	post: await getPinnedPost('hackers-and-painters-ai-agents'),
};

// The pink band in the hero pins the one piece I'm pushing
const featuredPost = await getPinnedPost('doom-mcp-server');
// The last repeats the first so the reel loops seamlessly (slot-roll in motion.css)
const SLOT_WORDS = ['ugly pot', 'bad idea', 'ugly demo', 'weird idea', 'homelab', 'ugly pot'];

function work(title: string) {
	const project = projects.find((p) => p.title === title);
	if (!project?.page || !project.video)
		throw new Error(`Homepage work "${title}" needs a project page and a clip`);
	return {
		href: `/work/${project.page.slug}/`,
		tagline: project.page.tagline,
		poster: project.poster ?? project.image,
		clip: cardClip(project.video),
	};
}
const dvd = work('DVD Screensaver');
// Full width, so the spread plays the full-size clip, not the card copy
const spreadWork = {
	name: 'Nothing But Corners',
	...dvd,
	clip: dvd.clip.replace('-card.mp4', '.mp4'),
};
const works = ['PixelPane', 'Connect AI × DOOM', 'Punc', 'Screencast Director'].map((title) => ({
	title,
	...work(title),
}));

const talks = await getCollection('talks');
const talk = (slug: string) => {
	const entry = talks.find((t) => t.data.slug === slug);
	if (!entry) throw new Error(`Homepage talk "${slug}" is not in src/content/talks`);
	return { title: entry.data.title, href: `/talks/${slug}/` };
};
const spreadTalk = {
	...talk('the-art-of-computer-science'),
	kicker: 'TEDxYouth',
	clip: '/images/talks/tedx-art-of-computer-science-montage.mp4',
	poster: '/images/talks/tedx-art-of-computer-science-still.webp',
};
const talkCards = [
	{
		...talk('mongodb-schema-design-best-practices'),
		kicker: 'Conf42 JavaScript',
		clip: '/images/talks/mongodb-schema-design-montage.mp4',
		poster: '/images/talks/mongodb-schema-design-still.webp',
		// Its poster is the one white slide; the rest are dark, so never flip it to a negative
		noInvert: true,
	},
	{
		...talk('an-introduction-to-iot-internet-of-toilets'),
		kicker: 'My most-given talk',
		clip: '/images/blog/an-introduction-to-iot-internet-of-toilets/stop_motion_intro-1024x683.mp4',
		poster: '/images/blog/an-introduction-to-iot-internet-of-toilets/thumb-ec97a203.webp',
		noInvert: false,
	},
];

const HOME_SHORTS = ['uQTWcr5Bvk4', 'jPQSayxSpNM'].map((id) => {
	const short = shorts.find((s) => s.id === id);
	if (!short) throw new Error(`Homepage Short ${id} is not in src/data/shorts.ts`);
	return short;
});

const reviews = (await getCollection('reviews'))
	.map((r) => r.data)
	.toSorted((a, b) => b.date.valueOf() - a.date.valueOf());
const [newestReview, ...moreReviews] = reviews.slice(0, 4);
// Two films I rate far above Letterboxd's crowd and one far below: more love than dunking
const { higher, lower } = reviewStats(reviews);
// Clifford is the biggest gap, but Joe would rather show another
const HOT_TAKE_SKIP = new Set(['clifford']);
const hotTakes = [...higher.slice(0, 2), lower.find((film) => !HOT_TAKE_SKIP.has(film.slug))!].map(
	(film) => reviews.find((r) => r.slug === film.slug)!,
);

const PODCASTS = [
	{
		name: 'Hanselminutes',
		image: '/images/podcasts/hanselminutes.webp',
		url: 'https://hanselminutes.com/752/document-databases-and-mongo-with-engineer-joe-karlsson',
	},
	{
		name: 'Screaming in the Cloud',
		image: '/images/talks/events/screaming-in-the-cloud.webp',
		url: 'https://www.lastweekinaws.com/podcast/screaming-in-the-cloud/when-data-is-your-brand-and-your-job-with-joe-karlsson/',
	},
	{
		name: 'JavaScript Jabber',
		image: '/images/podcasts/javascript-jabber.webp',
		url: 'https://topenddevs.com/authors/joe-karlsson',
	},
	{
		name: 'CodeNewbie',
		image: '/images/podcasts/codenewbie.webp',
		url: 'https://dev.to/codenewbie/s19-e6-how-to-make-learning-databases-fun-and-approachable-joe-karlsson',
	},
];

// What `curl -L joekarlsson.com/hi` prints, minus its sign-off line
const terminal = terminalRuns(
	terminalCard({
		...nowFeed.homelab,
		latestTitle: ownPosts[0].data.title,
		latestUrl: new URL(ownPosts[0].href, 'https://joekarlsson.com').href,
	}),
)
	// Its sign-off and pink links are too wide for the column; the labels and text stay
	.filter((line) => !line.some((run) => run.text.includes('get along')))
	.flatMap((line) => {
		const kept = line.filter((run) => !(run.pink && run.text.startsWith('https://')));
		// A line that held only a link is gone, not left as an empty gap
		return kept.length < line.length && !kept.some((run) => run.text.trim()) ? [] : [kept];
	});
while (terminal.length && !terminal.at(-1)!.length) terminal.pop();

// Phones stay tight; wide screens give each section room (Joe: cramped on desktop)
// The link under each Odds & ends group, styled like SectionMasthead's header link
const MORE_LINK =
	'mt-4 inline-block self-start border-b-2 border-pink py-2.5 font-semibold text-paper no-underline hover:text-pink';
const SECTION = 'relative mx-auto max-w-[90rem] px-4 pt-12 sm:px-7 md:pt-32';
---

<BaseLayout
	title="Joe Karlsson | Developer Marketing Engineer"
	description={SITE_DESCRIPTION}
	schemaType="WebSite"
	marginDoodles={false}
	footerNewsletter={false}
>
	<!-- A section with a name is a landmark, so screen-reader landmark jumps reach the
	hero, which sits above the nav and outside <main> -->
	<!-- The full width of the window, gutter and rounded panels kept (DECISIONS.md,
	2026-11-16). The clip stops a little short of the window's height, so a 2560px
	screen still shows the nav on its first screen -->
	<section slot="hero" aria-label="Introduction" class="grid w-full gap-4 p-4 md:grid-cols-2">
		<!-- Phones: a 16:9 banner of Joe's face (montage-phone is that crop). Side by side: at least square, growing with a taller text panel so the
		video never stops short. Only the video is clipped to the rounded box; the marks
		sit above everything and spill across the text panel, the gutters and the nav. -->
		<div class="relative z-10 aspect-video md:aspect-auto md:before:block md:before:aspect-square md:before:max-h-[calc(100svh-6rem)] md:before:content-['']">
			<div class="absolute inset-0 overflow-hidden rounded-xl">
				<video
					tabindex="-1"
					class="absolute inset-0 size-full object-cover object-[50%_25%] md:object-center"
					poster="/images/home/montage-poster.webp"
					data-halftone="flat"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Montage of short clips of Joe in pink"
				>
					<!-- Plain color clips, each frame auto-leveled, so the live pink
					(src/scripts/halftone.ts) stay sharp at any size and every shot matches the
					poster's levels. Phones get their own 16:9 cut, already cropped to Joe's face.
					VP9 is smaller; H.264 is the fallback. -->
					<source
						media="(max-width: 767px)"
						src="/images/home/montage-phone-2026-11-10.webm"
						type="video/webm"
					/>
					<source
						media="(max-width: 767px)"
						src="/images/home/montage-phone-2026-11-10.mp4"
						type="video/mp4"
					/>
					<source src="/images/home/montage-2026-11-10.webm" type="video/webm" />
					<source src="/images/home/montage-2026-11-10.mp4" type="video/mp4" />
				</video>
			</div>
			<Scribble
				path={COIL}
				color={CHALK}
				duration="10s"
				delay="1s"
				class="top-[52%] -left-[10%] h-[24%] w-[150%] max-md:top-[80%] max-md:left-[34%] max-md:h-[34%] max-md:w-[76%]"
			/>
			<!-- Phones: the 16:9 cut is all face, so the coil above drops to straddle the
			clip's bottom-right edge instead of crossing it, and the lines below make room -->
			<Scribble
				{...MARKS.burst}
				color={CHALK}
				strokeWidth={6}
				duration="8s"
				delay="2.4s"
				class="-top-[7%] -left-[7%] size-[22%]"
			/>
			<Scribble
				{...MARKS.tally}
				color={CHALK}
				duration="9s"
				delay="0.6s"
				class="top-[3%] -right-[8%] h-[12%] w-[26%]"
			/>
			<Scribble
				{...MARKS.lines}
				color={CHALK}
				duration="11s"
				delay="1.8s"
				class="-bottom-[9%] -left-[6%] h-[16%] w-[78%] max-md:hidden"
			/>
			<Scribble
				{...MARKS.hatch}
				color="#ff4fd8"
				duration="8s"
				delay="3.2s"
				class="-right-[9%] -bottom-[12%] h-[13%] w-[24%]"
			/>
		</div>
		<div class="grid min-w-0 grid-rows-[auto_1fr] gap-4">
			<div class="flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7">
				<!-- My name first, then what I do underneath it -->
				<div class="@container">
					<h1 class="relative font-display text-[calc(100cqw/var(--name-ratio))] leading-[0.88] whitespace-nowrap text-paper uppercase [--name-ratio:3.8]">
						<span class="block">Joe</span>
						<Scribble
							{...MARKS.rays}
							color="#ff4fd8"
							strokeWidth={10}
							duration="6s"
							delay="1.2s"
							class="top-[2%] left-[42%] h-[30%] w-[22%]"
						/>
						<span class="block">Karlsson</span>
						<Scribble
							path={HERO_COIL}
							color="#ff4fd8"
							duration="9s"
							delay="0.3s"
							class="-bottom-[14%] -left-[4%] h-[85%] w-[104%]"
						/>
					</h1>
				</div>
				<p class="font-serif text-[clamp(1.625rem,min(2.6vw,4.2vh),3.75rem)] leading-[1.15] font-medium text-balance text-paper italic">
					Technology is better when it's weird and it's yours. Everything I write about runs in
					my&nbsp;house.
				</p>
			</div>
			<!-- After the panel, so my name is read first; wider screens show it on top -->
			<FeaturedBand
				label="Featured"
				title={featuredPost.data.title}
				href={featuredPost.href}
				meta={formatDate(featuredPost.data.date)}
				class="md:order-first"
			/>
		</div>
	</section>

	<!-- The homepage's own doodle layer: its column is 90rem, not the layout's 72rem, so they
	draw only from 2020px (224px margins), and a crayon line wanders down the left margin -->
	<MarginDoodles column="90rem" from={2020} thread />

	<section class={SECTION} aria-labelledby="writing">
		<SectionMasthead id="writing" title="Writing" href="/blog/" linkLabel="All posts">
			<Scribble
				{...MARKS.rays}
				once
				color="#ff4fd8"
				strokeWidth={10}
				duration="6s"
				class="-top-[0.15em] left-[calc(100%+0.15em)] h-[0.45em] w-[0.6em] max-md:hidden"
			/>
		</SectionMasthead>
		<nav
			aria-label="Topics"
			class="-mt-3 mb-7 flex flex-wrap items-baseline gap-x-5 text-[0.9375rem]"
		>
			{topics.map((topic) => (
				<a
					href={`/blog/category/${topic.slug}/`}
					class="min-h-11 min-w-11 py-2.5 text-center font-semibold text-paper underline decoration-pink decoration-2 underline-offset-[6px] hover:text-pink md:min-w-6"
				>
					{topic.name}
				</a>
			))}
		</nav>
		<div class="grid gap-7 md:grid-cols-12 md:gap-12">
			<article class="relative md:col-span-8 -mx-4 sm:-mx-7 md:mr-0">
				<a href={leadPost.href} tabindex="-1" aria-hidden="true" class="block">
					<img
						data-morph={leadPost.href}
						src={leadPost.data.heroImage || DEFAULT_HERO_IMAGE}
						alt=""
						aria-hidden="true"
						data-halftone={halftoneMode(leadPost.data.heroImage || DEFAULT_HERO_IMAGE)}
						sizes="(min-width: 768px) 60vw, 100vw"
						decoding="async"
						class="block aspect-[16/10] w-full object-cover"
					/>
				</a>
				<!-- The headline overlaps the bottom of the picture on a black slab, magazine style -->
				<h3 class="relative -mt-[clamp(40px,8vw,118px)] w-fit max-w-[min(620px,92%)] bg-ink px-4 pt-3 font-display text-[clamp(2.75rem,7vw,6.5rem)] leading-[0.9] font-normal text-paper uppercase sm:px-7">
					<a href={leadPost.href} class="text-paper no-underline hover:text-pink">
						{/* A question headline stops at its question; the rest is the description below */}
						{leadPost.data.title.split('?')[0]}
						{leadPost.data.title.includes('?') && '?'}
					</a>
					<Scribble
						path={ARROW}
						viewBox="0 0 260 140"
						once
						color="#ff4fd8"
						strokeWidth={7}
						duration="5s"
						class="-right-[220px] bottom-[10%] hidden h-[100px] w-[190px] -rotate-6 lg:block"
					/>
				</h3>
				<div class="px-4 sm:px-7">
					<MetaParts class="mt-2 text-sm text-muted">
						<time datetime={leadPost.data.date.toISOString()}>
							{formatDate(leadPost.data.date)}
						</time>{' '}
						{leadPost.data.categories[0] && <span>{leadPost.data.categories[0]}</span>}
					</MetaParts>
					<p class="mt-3 max-w-[52ch] font-serif text-[1.1875rem] leading-normal text-paper">
						{leadPost.data.description.replace(/^[^?]*\?\s*/, '')}
					</p>
				</div>
			</article>
			<ul class="flex flex-col gap-7 md:col-span-4">
				{sidePosts.map((post, i) => (
					<li class="ring-host group relative">
						<p class="mb-1.5 text-sm font-semibold text-pink">
							{post.data.categories[0]}
							{post.data.writtenFor && <WrittenFor employer={post.data.writtenFor} />}
						</p>
						{i === 0 && (
							<a href={post.href} tabindex="-1" aria-hidden="true" class="relative mb-3 block">
								<img
									data-morph={post.href}
									src={post.data.heroImage || DEFAULT_HERO_IMAGE}
									alt=""
									aria-hidden="true"
									data-halftone={halftoneMode(post.data.heroImage || DEFAULT_HERO_IMAGE)}
									sizes="(min-width: 768px) 30vw, 100vw"
									loading="lazy"
									decoding="async"
									class="block aspect-video w-full rounded-lg object-cover"
								/>
								<HoverBox index={1} />
							</a>
						)}
						<a
							href={post.href}
							class="text-[1.375rem] leading-tight font-semibold text-balance text-paper no-underline group-hover:text-pink"
						>
							{post.data.title}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Pink bands run edge to edge; their content stays in the 1440px column -->
	<figure class="quote-band torn relative mt-12 md:mt-32 bg-pink px-[max(1rem,calc((100%-90rem)/2+1.75rem))] py-16 text-ink md:py-20">
		<span
			aria-hidden="true"
			class="block font-display text-[clamp(7rem,14vw,15rem)] leading-[0.6] text-ink md:absolute md:top-14 md:left-[max(1rem,calc((100%-90rem)/2+1.75rem))]"
		>
			“
		</span>
		<blockquote class="max-w-[19ch] font-serif text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.02] font-semibold text-ink italic md:ml-[clamp(7rem,11vw,10rem)]">
			{pullQuote.text}
		</blockquote>
		<figcaption class="mt-6 flex flex-wrap items-center gap-3 text-[0.9375rem] font-medium md:ml-[clamp(7rem,11vw,10rem)]">
			<a
				href={pullQuote.post.href}
				class="bg-ink px-2 py-1 font-display text-xl tracking-[0.04em] whitespace-nowrap text-pink uppercase no-underline hover:text-paper"
			>
				Read it
			</a>
			<cite class="not-italic">{pullQuote.post.data.title}</cite>
		</figcaption>
	</figure>

	<section class={SECTION} aria-labelledby="most-read">
		<SectionMasthead id="most-read" title="Most read" />
		<ol class="relative flex flex-col gap-5">
			{mostRead.map(({ post, visitors }) => (
				<li class="group">
					<a href={post.href} class="block text-paper no-underline">
						<span class="relative inline-block text-lg leading-snug font-semibold group-hover:text-pink md:text-xl">
							{post.data.title}
						</span>
						<span
							class="most-read-bar mt-2 block h-[22px] bg-pink group-hover:bg-paper"
							style={`width:${Math.max(6, (visitors / topVisitors) * 72)}%`}
						/>
					</a>
				</li>
			))}
			<Scribble
				{...MARKS.burst}
				once
				color="#ff4fd8"
				strokeWidth={6}
				duration="7s"
				class="right-[6%] bottom-[8%] hidden size-[110px] md:block"
			/>
		</ol>
	</section>

	<section
		aria-label="Newsletter"
		class="relative mt-12 md:mt-32 bg-pink px-[max(1rem,calc((100%-90rem)/2+1.75rem))] pt-11 pb-12 text-ink [&_:focus-visible]:outline-ink"
	>
		<NewsletterBand />
	</section>
	<!-- Phones: the word is about 36px tall, so min-h-11 makes the link a 44px tap target -->
	<a
		href="/blog/ship-the-ugly-pot/"
		class="ugly-pot group relative mx-4 mt-16 mb-6 md:mt-44 md:mb-32 flex max-md:min-h-11 items-baseline justify-center gap-[0.28em] font-display text-[clamp(32px,10vw,170px)] leading-[0.88] whitespace-nowrap text-paper uppercase no-underline hover:text-paper sm:mx-7"
	>
		<span class="sr-only">Ship the ugly pot</span>
		<span aria-hidden="true" class="relative group-hover:text-pink">
			Ship the
			<Scribble
				{...MARKS.rays}
				color={CHALK}
				strokeWidth={11}
				duration="6s"
				delay="0.6s"
				class="-top-[0.45em] -left-[0.35em] h-[0.45em] w-[0.6em]"
			/>
		</span>
		<span class="slot-window" aria-hidden="true">
			<span class="slot-reel text-pink">
				{SLOT_WORDS.map((word) => (
					<span>{word}</span>
				))}
			</span>
		</span>
		<Scribble
			{...MARKS.check}
			color={CHALK}
			duration="7s"
			delay="2s"
			class="-top-[0.35em] right-[2%] hidden h-[0.55em] w-[0.8em] md:block"
		/>
	</a>

	<section class={SECTION.replace('md:pt-32', 'md:pt-0')} aria-labelledby="works">
		<SectionMasthead id="works" title="Works" href="/work/" linkLabel="All works">
			<Scribble
				{...MARKS.burst}
				once
				color="#ff4fd8"
				strokeWidth={6}
				duration="6s"
				class="-top-[0.2em] left-[calc(100%+0.2em)] size-[0.55em] max-md:hidden"
			/>
		</SectionMasthead>
		<a
			href={spreadWork.href}
			class="ring-host spread group relative -mx-4 block text-ink no-underline sm:-mx-7"
		>
			<span class="relative block">
				<video
					tabindex="-1"
					class="block aspect-[16/8.3] w-full object-cover object-top"
					src={spreadWork.clip}
					data-poster={spreadWork.poster}
					data-halftone="flat"
					data-morph={spreadWork.href}
					data-autoplay-in-view
					data-phone-still
					muted
					loop
					playsinline
					preload="none"
					aria-hidden="true"
				></video>
				<HoverBox index={0} featured />
			</span>
			<span class="relative z-10 mx-4 -mt-6 block w-fit max-w-[calc(100%-2rem)] bg-pink px-5 pt-3 pb-4 sm:mx-7">
				<span class="block font-display text-[clamp(2.25rem,5.5vw,4.75rem)] leading-[0.9] uppercase">
					{spreadWork.name}
				</span>
				<span class="mt-2 block max-w-[40ch] font-serif text-lg">{spreadWork.tagline}</span>
			</span>
		</a>
		<ul
			class="paste-wall mt-9 grid grid-cols-2 gap-7 md:mt-14 md:gap-10 lg:grid-cols-4"
			style="--wall:1"
		>
			{works.map((w, i) => (
				<li>
					<a href={w.href} class="ring-host group block text-paper no-underline">
						<span class="relative block">
							<video
								tabindex="-1"
								class="block aspect-video w-full object-cover"
								src={w.clip}
								data-poster={w.poster}
								data-halftone="flat"
								data-morph={w.href}
								data-autoplay-in-view
								data-phone-still
								muted
								loop
								playsinline
								preload="none"
								aria-hidden="true"
							></video>
							<HoverBox index={i} />
						</span>
						<span class="mt-3.5 block font-display text-[clamp(1.5rem,2.4vw,2.125rem)] leading-[0.92] text-balance uppercase group-hover:text-pink">
							{w.title}
						</span>
						<span class="mt-1.5 block text-[0.9375rem] leading-snug text-[#c9c9c9]">
							{joinLastWord(w.tagline)}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class={SECTION} aria-labelledby="talks">
		<SectionMasthead id="talks" title="Talks" href="/talks/" linkLabel="All talks">
			<Scribble
				{...MARKS.hatch}
				once
				color={CHALK}
				duration="6s"
				class="top-[20%] left-[calc(100%+0.3em)] h-[0.5em] w-[1.3em] max-md:hidden"
			/>
		</SectionMasthead>
		<div class="grid gap-10 md:grid-cols-12 md:gap-12">
			<a
				href={spreadTalk.href}
				class="ring-host spread group relative -mx-4 block no-underline sm:-mx-7 md:col-span-8 md:mx-0"
			>
				<span class="relative block">
					<video
						tabindex="-1"
						class="block aspect-video w-full object-cover"
						src={spreadTalk.clip}
						data-poster={spreadTalk.poster}
						data-halftone="flat"
						data-morph={spreadTalk.href}
						data-autoplay-in-view
						data-phone-still
						muted
						loop
						playsinline
						preload="none"
						aria-hidden="true"
					></video>
					<HoverBox index={2} featured />
				</span>
				<span class="relative z-10 mx-4 -mt-10 block w-fit max-w-[calc(100%-2rem)] bg-ink px-5 pt-3 pb-4 sm:mx-7 md:-mt-12">
					<span class="block text-sm font-semibold text-pink">{spreadTalk.kicker}</span>
					<span class="block font-display text-[clamp(2.25rem,4.4vw,4rem)] leading-[0.9] text-paper uppercase group-hover:text-pink">
						The Art of <span class="text-pink">Computer&nbsp;Science</span>
					</span>
				</span>
			</a>
			<ul class="paste-wall grid gap-10 md:col-span-4" style="--wall:2">
				{talkCards.map((t, i) => (
					<li>
						<a href={t.href} class="ring-host group block no-underline">
							<span class="relative block">
								<video
									tabindex="-1"
									class="block aspect-video w-full rounded-lg object-cover"
									src={t.clip}
									data-poster={t.poster}
									data-halftone="flat"
									data-halftone-no-invert={t.noInvert || undefined}
									data-morph={t.href}
									data-autoplay-in-view
									data-phone-still
									muted
									loop
									playsinline
									preload="none"
									aria-hidden="true"
								></video>
								<HoverBox index={i + 1} />
							</span>
							<span class="mt-3 block text-sm font-semibold text-pink">{t.kicker}</span>
							<span class="block font-display text-[clamp(1.5rem,2vw,2rem)] leading-[0.95] text-balance text-paper uppercase group-hover:text-pink">
								{t.title}
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class={SECTION} aria-labelledby="odds">
		<SectionMasthead id="odds" title="Odds & ends">
			<Scribble
				{...MARKS.asterisk}
				once
				color={CHALK}
				strokeWidth={8}
				duration="6s"
				class="-top-[0.1em] left-[calc(100%+0.1em)] size-[0.45em] max-md:hidden"
			/>
		</SectionMasthead>
		<div class="grid gap-7 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-7">
				<ul class="grid grid-cols-2 gap-4 md:gap-5">
					{HOME_SHORTS.map((s) => (
						<li>
							<YouTubeFacade
								id={s.id}
								title={s.title}
								poster={shortPosterPath(s)}
								hoverLoop={`/images/talks/shorts/${s.id}-montage.mp4`}
								vertical
							/>
							<a
								href={`https://www.youtube.com/shorts/${s.id}`}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-3 block font-display text-[clamp(1.125rem,2.2vw,1.875rem)] leading-[0.95] text-balance text-paper uppercase no-underline hover:text-pink"
							>
								{s.title}
							</a>
						</li>
					))}
				</ul>
				<a href="/talks/#short-videos" class={MORE_LINK}>
					All Shorts <span aria-hidden="true">→</span>
				</a>
			</div>
			<div class="flex flex-col md:col-span-5">
				<a
					href={`/reviews/${newestReview.slug}/`}
					class="ring-host group block text-paper no-underline"
				>
					{newestReview.poster && (
						<span class="relative block">
							<img
								src={newestReview.poster}
								alt=""
								aria-hidden="true"
								data-morph={`/reviews/${newestReview.slug}/`}
								loading="lazy"
								class="block aspect-[16/9] w-full object-cover object-[50%_12%]"
							/>
							<HoverBox index={3} />
						</span>
					)}
					<span class="mt-4 block font-display text-[clamp(2.25rem,4vw,3.25rem)] leading-[0.9] uppercase group-hover:text-pink">
						{joinLastWord(newestReview.title)}
					</span>
					{newestReview.rating && (
						<span class="mt-1 block text-xl text-pink">
							<span aria-hidden="true">{stars(newestReview.rating)}</span>
							<span class="sr-only">Rated {newestReview.rating} out of 5</span>
						</span>
					)}
					<span class="mt-2 block text-lg leading-snug">
						{joinLastWord(oneLiner(newestReview))}
					</span>
				</a>
				<ul class="paste-wall mt-5 grid grid-cols-3 gap-3" style="--wall:3">
					{moreReviews.map((r, i) => (
						<li>
							<a
								href={`/reviews/${r.slug}/`}
								class="ring-host group block text-sm text-paper no-underline"
							>
								{r.poster && (
									<span class="relative block">
										<img
											src={r.poster}
											alt=""
											aria-hidden="true"
											data-morph={`/reviews/${r.slug}/`}
											loading="lazy"
											class="block aspect-[2/3] w-full object-cover"
										/>
										<HoverBox index={i} />
									</span>
								)}
								<span class="mt-1.5 block leading-snug text-balance group-hover:text-pink">
									{r.title}
								</span>
								{r.rating && (
									<span class="block text-pink">
										<span aria-hidden="true">{stars(r.rating)}</span>
										<span class="sr-only">Rated {r.rating} out of 5</span>
									</span>
								)}
							</a>
						</li>
					))}
				</ul>
				<a href="/reviews/" class={MORE_LINK}>
					All reviews <span aria-hidden="true">→</span>
				</a>
			</div>

			<div class="torn relative bg-paper px-5 py-7 text-ink md:col-span-12 md:px-7">
				<h3 class="mb-5 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.05] font-normal text-ink uppercase">
					Hot takes
				</h3>
				<ul class="paste-wall grid gap-6 md:grid-cols-3" style="--wall:4">
					{hotTakes.map((r) => (
						<li>
							<a
								href={`/reviews/${r.slug}/`}
								class="group grid grid-cols-[90px_1fr] gap-4 text-ink no-underline hover:text-[#c4009f]"
							>
								{r.poster && (
									<img
										src={r.poster}
										alt=""
										aria-hidden="true"
										loading="lazy"
										class="block aspect-[2/3] w-full object-cover transition-[translate] duration-(--duration-enter) ease-(--ease-enter) group-hover:-translate-y-1 motion-reduce:transition-none"
									/>
								)}
								<span>
									<span class="block font-display text-2xl leading-none uppercase">
										{joinLastWord(r.title)}
									</span>
									<span class="mt-1.5 flex flex-wrap items-baseline gap-x-3 text-[0.8125rem] font-bold">
										<span>
											Me{' '}
											<span class="text-2xl text-[#c4009f]" aria-hidden="true">
												{stars(r.rating!)}
											</span>
											<span class="sr-only">{r.rating} out of 5</span>
										</span>
										<span>
											Letterboxd{' '}
											<span class="font-display text-[1.75rem] font-normal">
												{r.letterboxdAverage!.toFixed(1)}
											</span>
										</span>
									</span>
									<span class="mt-1 block text-[0.9375rem] leading-snug">
										{joinLastWord(oneLiner(r))}
									</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class="md:col-span-4">
				<h3 class="mb-2 text-sm font-semibold text-pink">Podcasts</h3>
				<ul class="grid grid-cols-2 gap-2">
					{PODCASTS.map((p) => (
						<li>
							<a
								href={p.url}
								target="_blank"
								rel="noopener noreferrer"
								class="group block"
								aria-label={`${p.name} (opens in a new tab)`}
							>
								<img
									src={p.image}
									alt={p.name}
									data-halftone="flat"
									loading="lazy"
									class="block aspect-square w-full object-cover transition-[translate] duration-(--duration-enter) ease-(--ease-enter) group-hover:-translate-y-1 motion-reduce:transition-none"
								/>
							</a>
						</li>
					))}
				</ul>
				<a href="/talks/?filter=podcast" class={MORE_LINK}>
					All podcasts <span aria-hidden="true">→</span>
				</a>
			</div>
			<div class="flex min-w-0 flex-col md:col-span-5">
				<pre
					tabindex="0"
					aria-label="Sample output of curl -L joekarlsson.com/hi"
					class="flex-1 overflow-x-auto max-md:whitespace-pre-wrap border-2 border-paper bg-[#0b0b0b] px-4 py-3.5 font-mono text-[11px] leading-[1.7] text-[#e6e6e6] md:text-[13px]"
				><span class="text-muted">$</span> curl -L joekarlsson.com/hi
{terminal.map((line) => <>{line.map((run) => <span class:list={[run.pink && 'text-pink', run.muted && 'text-muted', run.bold && 'font-bold']}>{run.text}</span>)}{'\n'}</>)}</pre>
			</div>
			<figure class="flex flex-col md:col-span-3">
				<video
					tabindex="-1"
					class="block min-h-[220px] w-full flex-1 object-cover"
					src="/images/home/cat-wide.mp4"
					data-poster="/images/home/cat-wide-poster.webp"
					data-halftone="flat"
					data-autoplay-in-view
					data-phone-still
					muted
					loop
					playsinline
					preload="none"
					aria-label="Photocopied video of Joe’s cat on the litter box wiring"
				></video>
				<figcaption class="mt-2 text-[0.9375rem] text-paper">The cat</figcaption>
			</figure>
		</div>
	</section>

	<!-- The full width like the hero, sitting right on the footer: the negative margin takes
	back main's bottom padding (phones hide the board, so they keep it) -->
	<div class="mt-20 md:mt-32 md:-mb-20">
		<DrawingBoard />
	</div>
</BaseLayout>

