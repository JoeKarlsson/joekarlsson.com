---
import { MORE_LINK, SECTION_HEADING, formatDate } from '../utils/ui';
import DrawingBoard from '../components/DrawingBoard.astro';
import FeaturedBand from '../components/FeaturedBand.astro';
import HoverBox from '../components/HoverBox.astro';
import IndexRow from '../components/IndexRow.astro';
import Scribble from '../components/Scribble.astro';
import MetaParts from '../components/MetaParts.astro';
import WrittenFor from '../components/WrittenFor.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_HERO_IMAGE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';
import { ARROW, CHALK, COIL, HERO_COIL, MARKS } from '../data/scribbles';
import nowFeed from '../data/now-feed.json';
import { getCategoryCounts } from '../utils/categories';
import { getFeedPosts, getPinnedPost, isOwnPost } from '../utils/posts';
import { cardHalftone, halftoneMode } from '../utils/halftone';

// Live count from the snapshot scripts/update-now-feed.mjs writes on every deploy
const { runningContainers } = nowFeed.homelab;

const allPosts = await getFeedPosts();
const recentPosts = allPosts.filter(isOwnPost).slice(0, 5);
// All six subject categories (BLOG_CATEGORIES), most posts first
const topics = getCategoryCounts(allPosts.filter((p) => !p.isNewsletter));

const HOME_PROJECTS = [
	'PixelPane',
	'Screencast Director',
	'FollowSpot',
	'Connect AI × DOOM',
	'IoT Kitty Litter Box',
];
const homeProjects = HOME_PROJECTS.map((title) => {
	const project = projects.find((p) => p.title === title);
	if (!project) throw new Error(`Homepage project "${title}" is not in src/data/projects.ts`);
	const href = project.page ? `/work/${project.page.slug}/` : project.blogUrl;
	if (!href) throw new Error(`Homepage project "${title}" has no project page or blog post`);
	return { title, href, meta: [project.date.slice(0, 4), ...project.tech.slice(0, 2)].join(', ') };
});

// The pink band in the hero pins the one piece I'm pushing; Recent posts below already
// shows the newest
const featuredPost = await getPinnedPost('doom-mcp-server');
// The last repeats the first so the reel loops seamlessly (slot-roll in motion.css)
const SLOT_WORDS = ['ugly pot', 'bad idea', 'ugly demo', 'weird idea', 'homelab', 'ugly pot'];

// Around the house: one clip per thing, each with a caption that links to it.
// Every clip is plain color; the live pink dots (src/scripts/halftone.ts)
// give them the same look as the montage, cropped to 4:5 on the page.
const AROUND_THE_HOUSE = [
	{
		name: 'cat-wide',
		alt: "Photocopied video of Joe's cat on the litter box wiring",
		caption: 'My cat inspecting the litter box I wired to the internet',
		href: '/talks/an-introduction-to-iot-internet-of-toilets/',
	},
	{
		name: 'pixelpane',
		alt: 'Photocopied video of Joe holding up his PixelPane pixel art frame',
		caption: 'PixelPane, the pixel art frame behind my mirror',
		href: '/work/pixelpane/',
	},
	{
		name: 'rackfront',
		alt: "Photocopied video of Joe's hand pointing out the servers in his rack",
		caption: `The rack: ${runningContainers} containers running right now`,
		href: '/blog/how-to-get-started-building-a-homelab-server/',
	},
	{
		name: 'kindle',
		alt: 'Photocopied video of an old Kindle showing the house dashboard',
		caption: 'An old Kindle, now the house dashboard',
	},
];
---

<BaseLayout
	title="Joe Karlsson | Developer Marketing Engineer"
	description={SITE_DESCRIPTION}
	schemaType="WebSite"

	marginDoodles={false}
>
	<!-- A section with a name is a landmark, so screen-reader landmark jumps reach the
	hero, which sits above the nav and outside <main> -->
	<!-- max-w-[90rem]: the hero and sections fill a laptop as before, but stop growing
	past 1440px, so a 2560px screen keeps the nav on its first screen -->
	<section
		slot="hero"
		aria-label="Introduction"
		class="mx-auto grid w-full max-w-[90rem] gap-4 p-4 md:grid-cols-2"
	>
		<!-- Phones: a 16:9 banner of Joe's face (montage-phone is that crop). Side by side: at least square, growing with a taller text panel so the
		video never stops short. Only the video is clipped to the rounded box; the marks
		sit above everything and spill across the text panel, the gutters and the nav. -->
		<div class="relative z-10 aspect-video md:aspect-auto md:before:block md:before:aspect-square md:before:content-['']">
			<div class="absolute inset-0 overflow-hidden rounded-xl">
				<video
					class="absolute inset-0 size-full object-cover object-[50%_25%] md:object-center"
					poster="/images/home/montage-poster.webp"
					data-halftone="dots"
					data-autoplay-in-view
					muted
					loop
					playsinline
					preload="metadata"
					aria-label="Montage of short halftone clips of Joe"
				>
					<!-- Plain color clips, each frame auto-leveled, so the live pink dots
					(src/scripts/halftone.ts) stay sharp at any size and every shot matches the
					poster's levels. Phones get their own 16:9 cut, already cropped to Joe's face.
					VP9 is smaller; H.264 is the fallback. -->
					<source
						media="(max-width: 767px)"
						src="/images/home/montage-phone-2026-11-10.webm"
						type="video/webm"
					/>
					<source
						media="(max-width: 767px)"
						src="/images/home/montage-phone-2026-11-10.mp4"
						type="video/mp4"
					/>
					<source src="/images/home/montage-2026-11-10.webm" type="video/webm" />
					<source src="/images/home/montage-2026-11-10.mp4" type="video/mp4" />
				</video>
			</div>
			<Scribble
				path={COIL}
				color={CHALK}
				duration="10s"
				delay="1s"
				class="top-[52%] -left-[10%] h-[24%] w-[150%] max-md:top-[80%] max-md:left-[34%] max-md:h-[34%] max-md:w-[76%]"
			/>
			<!-- Phones: the 16:9 cut is all face, so the coil above drops to straddle the
			clip's bottom-right edge instead of crossing it, and the lines below make room -->
			<Scribble
				{...MARKS.burst}
				color={CHALK}
				strokeWidth={6}
				duration="8s"
				delay="2.4s"
				class="-top-[7%] -left-[7%] size-[22%]"
			/>
			<Scribble
				{...MARKS.tally}
				color={CHALK}
				duration="9s"
				delay="0.6s"
				class="top-[3%] -right-[8%] h-[12%] w-[26%]"
			/>
			<Scribble
				{...MARKS.lines}
				color={CHALK}
				duration="11s"
				delay="1.8s"
				class="-bottom-[9%] -left-[6%] h-[16%] w-[78%] max-md:hidden"
			/>
			<Scribble
				{...MARKS.hatch}
				color="#ff4fd8"
				duration="8s"
				delay="3.2s"
				class="-right-[9%] -bottom-[12%] h-[13%] w-[24%]"
			/>
		</div>
		<div class="grid min-w-0 grid-rows-[auto_1fr] gap-4">
			<div class="flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7">
				<!-- My name first, then what I do underneath it -->
				<div class="@container">
					<h1 class="relative font-display text-[calc(100cqw/var(--name-ratio))] leading-[0.88] whitespace-nowrap text-paper uppercase [--name-ratio:3.8]">
						<span class="block">Joe</span>
						<Scribble
							{...MARKS.rays}
							color="#ff4fd8"
							strokeWidth={10}
							duration="6s"
							delay="1.2s"
							class="top-[2%] left-[42%] h-[30%] w-[22%]"
						/>
						<span class="block">Karlsson</span>
						<Scribble
							path={HERO_COIL}
							color="#ff4fd8"
							duration="9s"
							delay="0.3s"
							class="-bottom-[14%] -left-[4%] h-[85%] w-[104%]"
						/>
					</h1>
				</div>
				<p class="text-[clamp(1.625rem,2.6vw,2.5rem)] leading-[1.15] font-semibold text-paper">
					I run developer marketing at CData, and before that DevRel at CloudQuery, Tinybird,
					SingleStore and MongoDB.
				</p>
			</div>
			<!-- After the panel, so my name is read first; wider screens show it on top -->
			<FeaturedBand
				label="Featured"
				title={featuredPost.data.title}
				href={featuredPost.href}
				meta={formatDate(featuredPost.data.date)}
				class="md:order-first"
			/>
		</div>
	</section>

	<!-- Phones: the hero's own bottom padding (p-4) plus pt-8 makes the usual 48 -->
	<section class="relative mx-auto max-w-[90rem] px-4 pt-8 sm:px-7 md:pt-20">
		<h2 class={SECTION_HEADING}>
			<a href="/blog/" class="relative text-pink no-underline hover:text-pink hover:underline">
				Recent posts
				<Scribble
					{...MARKS.underline}
					color={CHALK}
					duration="8s"
					delay="0.5s"
					class="-bottom-[0.3em] left-0 h-[0.3em] w-full"
				/>
			</a>
		</h2>
		<ul>
			{recentPosts.map((post, i) => (
				// Phones: the newest post keeps its big picture; the rest are compact rows with a
				// thumbnail beside the title, so the list is one screen instead of three
				<li
					class:list={[
						'ring-host group grid items-center gap-7 border-t border-surface-4 py-[18px] md:grid-cols-[clamp(140px,22vw,300px)_1fr]',
						i > 0 && 'recent-compact max-md:grid-cols-[112px_1fr] max-md:gap-4',
					]}
				>
					<a href={post.href} tabindex="-1" aria-hidden="true" class="relative block">
						{i === 0 && (
							<Scribble
								{...MARKS.box}
								color={CHALK}
								duration="10s"
								delay="0.8s"
								class="-inset-[8%] z-10 h-[116%] w-[116%]"
							/>
						)}
						{i === 0 && (
							<Scribble
								{...MARKS.newTag}
								once
								color="#ff4fd8"
								strokeWidth={16}
								duration="10s"
								delay="2.4s"
								class="-right-[18%] -bottom-[20%] z-10 h-[40%] w-[48%] -rotate-[8deg] max-md:-right-[1%] max-md:-bottom-[14%] max-md:h-[24%] max-md:w-[30%]"
							/>
						)}
						<img
							src={post.data.heroImage || DEFAULT_HERO_IMAGE}
							alt=""
							data-halftone={cardHalftone(post.data.heroImage || DEFAULT_HERO_IMAGE)}
							aria-hidden="true"
							sizes={
								i === 0 ? '(min-width: 768px) 300px, 100vw' : '(min-width: 768px) 300px, 112px'
							}
							loading="lazy"
							decoding="async"
							class="block aspect-video w-full rounded-lg object-cover"
						/>
						{/* The newest post's box is always drawn; the rest draw it on hover */}
						{i > 0 && <HoverBox index={i} />}
					</a>
					<div>
						<MetaParts class="mb-1.5 text-sm text-muted">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{' '}
							{post.data.categories[0] && <span>{post.data.categories[0]}</span>}{' '}
							{post.data.writtenFor && <WrittenFor employer={post.data.writtenFor} />}
						</MetaParts>
						<a
							href={post.href}
							class:list={[
								'text-[clamp(1.25rem,2.2vw,1.875rem)] leading-tight font-semibold text-paper no-underline group-hover:text-pink',
								i > 0 && 'max-md:text-lg',
							]}
						>
							{post.data.title}
						</a>
						{i === 0 && (
							<span class="relative ml-2 inline-block size-[0.9em] align-[-0.1em] text-[clamp(1.25rem,2.2vw,1.875rem)]">
								<Scribble
									{...MARKS.asterisk}
									color="#ff4fd8"
									strokeWidth={9}
									duration="7s"
									delay="2s"
									class="inset-0 size-full"
								/>
							</span>
						)}
					</div>
				</li>
			))}
		</ul>
		<Scribble
			path={ARROW}
			color="#ff4fd8"
			viewBox="0 0 260 140"
			strokeWidth={7}
			duration="5s"
			delay="1s"
			class="top-10 right-[8%] hidden h-[110px] w-[200px] md:block"
		/>
		<p class="mt-[18px]">
			<a href="/blog/" class={MORE_LINK}>
				All {allPosts.length} posts →
			</a>
		</p>
		<!-- Leaves Recent posts and runs down into the Ship the ugly pot band -->
		<Scribble
			path={COIL}
			color={CHALK}
			duration="12s"
			delay="2s"
			class="right-[-6%] -bottom-[150px] z-10 h-[170px] w-[62%]"
		/>
	</section>

	<!-- Phones: the word is about 36px tall, so min-h-11 makes the link a 44px tap target -->
	<a
		href="/blog/ship-the-ugly-pot/"
		class="group relative mx-4 mt-[110px] mb-[30px] flex max-md:min-h-11 items-baseline justify-center gap-[0.28em] font-display text-[clamp(32px,10vw,170px)] leading-[0.88] whitespace-nowrap text-paper uppercase no-underline hover:text-paper sm:mx-7"
	>
		<span class="sr-only">Ship the ugly pot</span>
		<span aria-hidden="true" class="relative group-hover:text-pink">
			Ship the
			<Scribble
				{...MARKS.rays}
				color={CHALK}
				strokeWidth={11}
				duration="6s"
				delay="0.6s"
				class="-top-[0.45em] -left-[0.35em] h-[0.45em] w-[0.6em]"
			/>
		</span>
		<span class="slot-window" aria-hidden="true">
			<span class="slot-reel text-pink">
				{SLOT_WORDS.map((word) => (
					<span>{word}</span>
				))}
			</span>
		</span>
		<Scribble
			{...MARKS.check}
			color={CHALK}
			duration="7s"
			delay="2s"
			class="-top-[0.35em] right-[2%] hidden h-[0.55em] w-[0.8em] md:block"
		/>
	</a>

	<section class="relative mx-auto max-w-[90rem] px-4 pt-12 md:pt-20 sm:px-7">
		<h2 class={SECTION_HEADING}>
			<a href="/work/" class="text-pink no-underline hover:text-pink hover:underline">
				Works
			</a>
		</h2>
		<Scribble
			{...MARKS.hatch}
			color="#ff4fd8"
			duration="9s"
			delay="1s"
			class="top-[86px] right-[6%] h-[60px] w-[120px]"
		/>
		<div class="border-b border-surface-4">
			{homeProjects.map((project, i) => (
				<IndexRow href={project.href} label={project.title} meta={project.meta} index={i} />
			))}
		</div>
		<p class="relative mt-[18px] inline-block">
			<a href="/work/" class={MORE_LINK}>
				All works →
			</a>
			<Scribble
				{...MARKS.pointer}
				color={CHALK}
				strokeWidth={14}
				duration="7s"
				delay="1.5s"
				class="top-[-10%] left-[calc(100%+12px)] h-[1.6em] w-[110px]"
			/>
		</p>
	</section>

	<!-- In the 1440px column like the sections around it, so it doesn't run edge to edge at 2560 -->
	<div class="mx-auto max-w-[90rem]">
		<DrawingBoard />
	</div>

	<section class="relative mx-auto max-w-[90rem] px-4 pt-12 md:pt-20 sm:px-7">
		<h2 class={SECTION_HEADING}>
			<a href="/blog/" class="text-pink no-underline hover:text-pink hover:underline">
				Writing by topic
			</a>
			<span class="relative ml-3 inline-block h-[0.9em] w-[1.2em] align-top">
				<Scribble
					{...MARKS.rays}
					color="#ff4fd8"
					strokeWidth={10}
					duration="6s"
					delay="1.4s"
					class="inset-0 size-full"
				/>
			</span>
		</h2>
		<Scribble
			{...MARKS.lines}
			color={CHALK}
			duration="12s"
			delay="0.4s"
			class="top-[92px] right-[4%] hidden h-[56px] w-[250px] sm:block"
		/>
		<div class="border-b border-surface-4">
			{topics.map((topic, i) => (
				<IndexRow
					href={`/blog/category/${topic.slug}/`}
					label={topic.name}
					meta={`${topic.count} posts`}
					index={i + 1}
				/>
			))}
		</div>
		<p class="mt-[18px]">
			<a href="/blog/" class={`relative ${MORE_LINK}`}>
				Every post and topic →
				<Scribble
					{...MARKS.double}
					color="#ff4fd8"
					strokeWidth={14}
					duration="8s"
					delay="1s"
					class="-bottom-[0.55em] left-0 h-[0.5em] w-full"
				/>
			</a>
		</p>
	</section>

	<section class="relative mx-auto max-w-[90rem] px-4 pt-12 md:pt-24 sm:px-7">
		<h2 class={SECTION_HEADING}>Around the house</h2>
		<!-- Straddles the topics list and the strip -->
		<Scribble
			{...MARKS.burstDense}
			color="#ff4fd8"
			strokeWidth={6}
			duration="9s"
			delay="1.2s"
			class="-top-[30px] right-[12%] z-10 size-[140px]"
		/>
		<!-- Phones: one clip at a time, swiped sideways, the next one peeking in from the
		edge. py keeps the tape and the tilted corners inside the scroller's clip. -->
		<div class="house-strip -mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 py-6 sm:-mx-7 sm:scroll-px-7 sm:px-7 md:mx-0 md:mt-12 md:grid md:grid-cols-4 md:gap-x-10 md:gap-y-14 md:overflow-visible md:p-0">
			{AROUND_THE_HOUSE.map(({ name, alt, caption, href }, i) => (
				<figure class="relative w-[72%] shrink-0 snap-start md:w-auto">
					<span class="tape" aria-hidden="true" />
					<video
						class="block aspect-[4/5] w-full object-cover"
						src={`/images/home/${name}.mp4`}
						data-poster={`/images/home/${name}-poster.webp`}
						data-halftone={halftoneMode(`/images/home/${name}.mp4`)}
						data-autoplay-in-view
						muted
						loop
						playsinline
						preload="none"
						aria-label={alt}
					/>
					<figcaption class="mt-3 flex gap-2.5 text-[0.9375rem] leading-snug text-paper">
						<span class="font-display text-[1.375rem] leading-none text-pink" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						{href ? (
							<a
								href={href}
								class="text-paper underline decoration-pink underline-offset-4 hover:text-pink"
							>
								{caption}
							</a>
						) : (
							<span>{caption}</span>
						)}
					</figcaption>
				</figure>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	/* Taped up, slightly crooked: each clip tilts its own way and the tape leans against it */
	.house-strip figure {
		--tilt: -1.5deg;
		transform: rotate(var(--tilt));
	}
	.house-strip figure:nth-child(2) {
		--tilt: 1.2deg;
	}
	.house-strip figure:nth-child(3) {
		--tilt: -0.8deg;
	}
	.house-strip figure:nth-child(4) {
		--tilt: 1.8deg;
	}
	.tape {
		position: absolute;
		top: -12px;
		left: 50%;
		z-index: 2;
		width: 84px;
		height: 24px;
		transform: translateX(-50%) rotate(calc(var(--tilt) * -2));
		background: #8f8a80;
	}
</style>
