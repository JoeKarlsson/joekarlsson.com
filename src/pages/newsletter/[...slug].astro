---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const issues = (await getCollection('newsletter')).sort(
		(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
	);
	return issues.map((issue, i) => ({
		params: { slug: issue.data.slug },
		props: { issue, prev: issues[i - 1], next: issues[i + 1] },
	}));
}
interface Props {
	issue: CollectionEntry<'newsletter'>;
	prev?: CollectionEntry<'newsletter'>;
	next?: CollectionEntry<'newsletter'>;
}

const { issue, prev, next } = Astro.props;
const { title, date, description, substackUrl } = issue.data;
const { Content } = await render(issue);
const linkClass =
	'underline decoration-gray-500 underline-offset-2 transition-colors hover:text-coral hover:decoration-coral';
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || `${title}, from the TL;DR in Tech newsletter archive.`}
	type="article"
	publishedDate={date}
	noindex={Boolean(substackUrl)}
>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<article class="min-w-0" data-post-title={title}>
			<nav class="mb-4 font-mono text-xs text-gray-400" aria-label="Breadcrumb">
				<a href="/" class={linkClass}>Home</a>
				<span class="mx-1">&gt;</span>
				<a href="/newsletter/" class={linkClass}>Newsletter</a>
				<span class="mx-1">&gt;</span>
				<span class="text-gray-400">{title}</span>
			</nav>
			{
				substackUrl && (
					<div
						class="mb-6 rounded-lg border border-yellow-500/30 bg-yellow-500/10 px-4 py-3 font-mono text-sm text-yellow-200"
						role="note"
					>
						<span class="mr-2 text-yellow-400" aria-hidden="true">
							&#9888;
						</span>
						From the TL;DR in Tech archive, originally sent on Substack. Some links may have died
						since.
					</div>
				)
			}
			<div class="mb-8">
				<p class="mb-2 font-mono text-sm text-gray-400"><FormattedDate date={date} /></p>
				<h1 class="mb-4 text-3xl font-bold text-white md:text-4xl">{title}</h1>
				{description && <p class="text-gray-400">{description}</p>}
			</div>
			<div class="prose">
				<Content />
			</div>
			<nav
				class="mt-12 flex justify-between gap-4 border-t border-surface-3 py-6 font-mono text-sm"
				aria-label="Newsletter issues"
			>
				{
					prev ? (
						<a href={`/newsletter/${prev.data.slug}/`} class={linkClass}>
							&larr; {prev.data.title}
						</a>
					) : (
						<span />
					)
				}
				{
					next && (
						<a href={`/newsletter/${next.data.slug}/`} class={`${linkClass} text-right`}>
							{next.data.title} &rarr;
						</a>
					)
				}
			</nav>
		</article>
	</div>
</BaseLayout>
