---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ShareLinks from '../../components/ShareLinks.astro';

export async function getStaticPaths() {
	const issues = (await getCollection('newsletter')).sort(
		(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
	);
	return issues.map((issue, i) => ({
		params: { slug: issue.data.slug },
		props: { issue, prev: issues[i - 1], next: issues[i + 1] },
	}));
}
interface Props {
	issue: CollectionEntry<'newsletter'>;
	prev?: CollectionEntry<'newsletter'>;
	next?: CollectionEntry<'newsletter'>;
}

const { issue, prev, next } = Astro.props;
const { title, shareTitle, date, description, substackUrl, heroImage, heroAlt, recapOf } =
	issue.data;
// A recap condenses a blog post, so search engines should index the post instead.
const canonicalUrl = recapOf ? new URL(`/blog/${recapOf}/`, Astro.site).href : undefined;
const { Content } = await render(issue);
const linkClass = 'text-paper underline decoration-pink underline-offset-4 hover:text-pink';
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || `${title}, from the TL;DR in Tech newsletter archive.`}
	type="article"
	publishedDate={date}
	image={heroImage}
	imageAlt={heroAlt}
	noindex={Boolean(substackUrl)}
	canonicalUrl={canonicalUrl}
>
	<div class="relative mx-auto max-w-3xl px-4 pt-10 pb-8">
		<article class="min-w-0" data-post-title={title}>
			<div class="mb-8">
				<p class="mb-3 text-[15px]">
					<a href="/newsletter/" class="text-muted no-underline hover:text-pink">
						&larr; Works on My Machine
					</a>
				</p>
				<h1 class="mb-4 font-display text-[clamp(2.4rem,1.6rem+3.2vw,4.25rem)] leading-[0.95] font-normal text-paper uppercase">
					{title}
				</h1>
				<p class="text-[15px] text-muted">
					<FormattedDate date={date} />
				</p>
				{description && <p class="mt-4 text-lg text-paper">{description}</p>}
			</div>
			{substackUrl && (
				<p class="mb-6 text-sm text-muted" role="note">
					From the TL;DR in Tech archive, originally sent on Substack. Some links may have died
					since.
				</p>
			)}
			{heroImage && (
				<img
					src={heroImage}
					alt={heroAlt || ''}
					data-halftone="flat"
					class="mb-8 block w-full rounded-xl"
					width="1200"
					height="630"
					loading="eager"
				/>
			)}
			<div class="prose">
				<Content />
			</div>
			<ShareLinks
				url={canonicalUrl || new URL(`/newsletter/${issue.data.slug}/`, Astro.site).href}
				title={shareTitle || title}
				noun="issue"
				class="mt-10"
			/>
			<nav
				class="mt-12 flex justify-between gap-4 border-t border-surface-4 pt-5 text-[15px]"
				aria-label="Newsletter issues"
			>
				{prev ? (
					<a href={`/newsletter/${prev.data.slug}/`} class={linkClass}>
						&larr; {prev.data.title}
					</a>
				) : (
					<span />
				)}
				{next && (
					<a href={`/newsletter/${next.data.slug}/`} class={`${linkClass} text-right`}>
						{next.data.title} &rarr;
					</a>
				)}
			</nav>
		</article>
	</div>
</BaseLayout>

<script>
	// Same events and props as blog posts (BlogPost.astro), so the Scroll Depth and
	// Reading Complete goals cover issues too; filter on /newsletter/ to split them.
	const article = document.querySelector<HTMLElement>('article[data-post-title]');
	if (article) {
		const post = article.dataset.postTitle || 'Unknown';
		const reached = new Set<number>();
		let ticking = false;

		const update = () => {
			ticking = false;
			const plausible = window.plausible;
			if (typeof plausible !== 'function') return;
			const articleTop = article.getBoundingClientRect().top + window.scrollY;
			const total = article.offsetHeight - window.innerHeight;
			const pct = total > 0 ? Math.round(((window.scrollY - articleTop) / total) * 100) : 0;
			[25, 50, 75, 100].forEach((milestone) => {
				if (pct < milestone || reached.has(milestone)) return;
				reached.add(milestone);
				plausible('Scroll Depth', { props: { depth: `${milestone}%`, post } });
				if (milestone === 100) plausible('Reading Complete', { props: { post } });
			});
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
	}
</script>
