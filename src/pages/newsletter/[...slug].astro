---
import { ARTICLE_TITLE, META, MORE_LINK, PAGE_CONTAINER, SIDEBAR_GRID } from '../../utils/ui';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import KeepExploring from '../../components/KeepExploring.astro';
import popularPosts from '../../data/popular-posts.json';
import { isOwnPost } from '../../utils/posts';
import { rankRelatedPosts } from '../../utils/related-posts';

export async function getStaticPaths() {
	const issues = (await getCollection('newsletter')).sort(
		(a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
	);
	return issues.map((issue, i) => ({
		params: { slug: issue.data.slug },
		props: { issue, prev: issues[i - 1], next: issues[i + 1] },
	}));
}
interface Props {
	issue: CollectionEntry<'newsletter'>;
	prev?: CollectionEntry<'newsletter'>;
	next?: CollectionEntry<'newsletter'>;
}

const { issue, prev, next } = Astro.props;
const { title, shareTitle, date, description, substackUrl, heroImage, heroAlt, recapOf } =
	issue.data;
// A recap condenses a blog post, so search engines should index the post instead.
const canonicalUrl = recapOf ? new URL(`/blog/${recapOf}/`, Astro.site).href : undefined;
const { Content, headings } = await render(issue);
// The same sidebar as a blog post (BlogPost.astro)
const tocHeadings = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));

// Someone landing on an issue gets the blog posts closest to it under the crayon
// arrow (src/utils/related-posts.ts), the same way a blog post does
const blogPosts = (await getCollection('blog')).filter(isOwnPost).map((post) => ({
	slug: post.data.slug,
	title: post.data.title,
	description: post.data.description,
	tags: post.data.tags,
	body: post.body,
}));
const relatedSlugs = rankRelatedPosts(
	{ slug: `newsletter/${issue.data.slug}`, title, description, body: issue.body },
	blogPosts,
	popularPosts.visitorsByPath,
);
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || `${title}, from the TL;DR in Tech newsletter archive.`}
	type="article"
	publishedDate={date}
	image={heroImage}
	imageAlt={heroAlt}
	noindex={Boolean(substackUrl)}
	canonicalUrl={canonicalUrl}
>
	<div class={PAGE_CONTAINER}>
		<div class={SIDEBAR_GRID}>
			{tocHeadings.length >= 2 ? (
				<TableOfContents headings={tocHeadings} />
			) : (
				<div class="hidden xl:block" />
			)}
			<article class="min-w-0" data-post-title={title}>
				<div class="mb-8">
					<BackLink href="/newsletter/" label="Newsletter" />
					<h1 class={ARTICLE_TITLE}>{title}</h1>
					<p class={META}>
						<FormattedDate date={date} />
					</p>
					{description && <p class="mt-4 text-lg text-paper">{description}</p>}
				</div>
				{substackUrl && (
					<p class="mb-6 text-sm text-muted" role="note">
						From the TL;DR in Tech archive, originally sent on Substack. Some links may have died
						since.
					</p>
				)}
				{heroImage && (
					<img
						src={heroImage}
						alt={heroAlt || ''}
						data-halftone="flat"
						class="mb-8 block w-full rounded-xl"
						width="1200"
						height="630"
						loading="eager"
					/>
				)}
				<div class="prose">
					<Content />
				</div>
				<ShareLinks
					url={canonicalUrl || new URL(`/newsletter/${issue.data.slug}/`, Astro.site).href}
					title={shareTitle || title}
					noun="issue"
					class="mt-10"
				/>
				<nav
					class="mt-12 flex justify-between gap-4 border-t border-surface-4 pt-5"
					aria-label="Newsletter issues"
				>
					{prev ? (
						<a href={`/newsletter/${prev.data.slug}/`} class={MORE_LINK}>
							&larr; {prev.data.title}
						</a>
					) : (
						<span />
					)}
					{next && (
						<a href={`/newsletter/${next.data.slug}/`} class={`${MORE_LINK} text-right`}>
							{next.data.title} &rarr;
						</a>
					)}
				</nav>
				<div class="max-w-(--reading-width)">
					{relatedSlugs.length > 0 && (
						<KeepExploring
							heading="Keep reading"
							from={`/newsletter/${issue.data.slug}/`}
							posts={relatedSlugs}
						/>
					)}
				</div>
			</article>
		</div>
	</div>
</BaseLayout>

<script>
	// Same events and props as blog posts (BlogPost.astro), so the Scroll Depth and
	// Reading Complete goals cover issues too; filter on /newsletter/ to split them.
	const article = document.querySelector<HTMLElement>('article[data-post-title]');
	if (article) {
		const post = article.dataset.postTitle || 'Unknown';
		const reached = new Set<number>();
		let ticking = false;

		const update = () => {
			ticking = false;
			const plausible = window.plausible;
			if (typeof plausible !== 'function') return;
			const articleTop = article.getBoundingClientRect().top + window.scrollY;
			const total = article.offsetHeight - window.innerHeight;
			const pct = total > 0 ? Math.round(((window.scrollY - articleTop) / total) * 100) : 0;
			[25, 50, 75, 100].forEach((milestone) => {
				if (pct < milestone || reached.has(milestone)) return;
				reached.add(milestone);
				plausible('Scroll Depth', { props: { depth: `${milestone}%`, post } });
				if (milestone === 100) plausible('Reading Complete', { props: { post } });
			});
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
	}
</script>
