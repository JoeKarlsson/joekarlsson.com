---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import BlogCard from '../../components/BlogCard.astro';

const issues = (await getCollection('newsletter')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Works on My Machine posts get cards with their header image, like the blog list; the
// imported TL;DR in Tech link roundups (substackUrl) stay a compact list by year.
const posts = issues.filter((i) => !i.data.substackUrl);
const backIssues = issues.filter((i) => i.data.substackUrl);

const byYear = new Map<number, typeof issues>();
for (const issue of backIssues) {
	const year = issue.data.date.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), issue]);
}
---

<BaseLayout
	title="Works on My Machine, my newsletter | Joe Karlsson"
	description="Works on My Machine is Joe Karlsson's newsletter: thoughts and reactions on tech writing, AI, homelab builds and open source. Plus every back issue of TL;DR in Tech."
	schemaType="CollectionPage"
>
	<div class="mx-auto max-w-3xl px-4 py-8">
		<p class="mb-2 font-mono text-sm text-coral" aria-hidden="true">
			~$ cat newsletter.md
		</p>
		<h1 class="mb-2 text-3xl font-bold text-coral md:text-4xl">Works on My Machine</h1>
		<p class="mb-6 text-gray-400">
			My thoughts and reactions on tech writing, AI, homelab builds and open source, plus whatever
			I'm working on. It goes out when I have something to say.
		</p>
		<div class="mb-12 rounded-lg border border-teal/20 bg-teal/5 p-6">
			<NewsletterSignup location="newsletter-page" />
			<p class="mt-3 text-center text-xs text-gray-400">
				Free, no spam, unsubscribe anytime. You'll get an email to confirm first. Prefer RSS?{' '}
				<a href="/newsletter/rss.xml" class="underline hover:text-coral">
					Follow Works on My Machine in your feed reader
				</a>
				.
			</p>
		</div>

		<h2 class="mb-6 text-2xl font-bold text-white">Every issue</h2>
		<div class="mb-10 grid gap-4 sm:grid-cols-2">
			{posts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					heroAlt={post.data.heroAlt}
					href={`/newsletter/${post.data.slug}/`}
				/>
			))}
		</div>

		<h2 class="mb-2 text-2xl font-bold text-white">TL;DR in Tech</h2>
		<p class="mb-8 text-gray-400">
			The weekly link roundup this newsletter used to be, from 2021 to 2024.
		</p>

		{[...byYear.entries()].map(([year, list]) => (
			<section class="mb-10" id={String(year)}>
				<h3 class="mb-4 text-lg font-bold text-white">
					<span class="text-coral font-mono text-sm" aria-hidden="true">
						~$
					</span>{' '}
					ls newsletter/{year}/
				</h3>
				<ul class="space-y-2">
					{list.map((issue) => (
						<li class="flex flex-col gap-x-4 sm:flex-row sm:items-center">
							<span class="w-32 shrink-0 font-mono text-xs text-gray-400">
								<FormattedDate date={issue.data.date} />
							</span>
							<a
								href={`/newsletter/${issue.data.slug}/`}
								class="text-white underline decoration-gray-500 underline-offset-2 transition-colors hover:text-coral hover:decoration-coral"
							>
								{issue.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>
