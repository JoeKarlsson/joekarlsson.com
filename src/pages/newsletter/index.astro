---
import KeepExploring from '../../components/KeepExploring.astro';
import { HERO_LEAD, PAGE_CONTAINER, SECTION_HEADING, TEXT_LINK } from '../../utils/ui';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import BlogCard from '../../components/BlogCard.astro';
import HoverBox from '../../components/HoverBox.astro';
import Scribble from '../../components/Scribble.astro';
import PosterHero from '../../components/PosterHero.astro';
import { CHALK, MARKS } from '../../data/scribbles';

const issues = (await getCollection('newsletter')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Works on My Machine posts get cards with their header image, like the blog list; the
// imported TL;DR in Tech link roundups (substackUrl) stay a compact list by year.
const posts = issues.filter((i) => !i.data.substackUrl);
// The newest issue leads the page; the list below holds the rest
const [latest, ...olderPosts] = posts;
const backIssues = issues.filter((i) => i.data.substackUrl);

// What I write about, from the pitch below, for the hero ticker
const TOPICS = ['Tech writing', 'AI', 'Homelab', 'Open source'];

const byYear = new Map<number, typeof issues>();
for (const issue of backIssues) {
	const year = issue.data.date.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), issue]);
}
---

<BaseLayout
	title="Works on My Machine, my newsletter | Joe Karlsson"
	description="Works on My Machine is Joe Karlsson's newsletter: thoughts and reactions on tech writing, AI, homelab builds and open source. Plus every back issue of TL;DR in Tech."
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<!-- The latest issue on the left (its image shown whole: issue images are title
		cards, so they're never cropped), what I write about in the pink ticker, and the
		newsletter's name, pitch and signup in the dark panel above NEWSLETTER (the same
		top as every main page) -->
		<PosterHero title="Newsletter" wordRatio={4.7} tickerItems={TOPICS}>
			{latest && (
				<a
					slot="media"
					href={`/newsletter/${latest.data.slug}/`}
					class="ring-host group relative z-10 flex flex-col no-underline"
				>
					<!-- Issue images are title cards, so they show whole, never cropped -->
					<span class="flex flex-1 flex-col overflow-hidden rounded-xl bg-ink">
						{latest.data.heroImage && (
							<span class="relative block">
								<img
									src={latest.data.heroImage}
									alt=""
									aria-hidden="true"
									data-halftone="flat"
									width="1200"
									height="630"
									class="block aspect-[40/21] w-full object-cover"
									loading="eager"
								/>
							</span>
						)}
						<span class="flex flex-1 flex-col justify-end px-6 pt-5 pb-6">
							<span class="mb-1.5 block text-sm text-muted">
								<span class="font-semibold text-pink">Latest issue</span>
								{' · '}
								<FormattedDate date={latest.data.date} />
							</span>
							<span class="block font-display text-[clamp(28px,2.8vw,44px)] leading-[0.95] text-paper uppercase group-hover:text-pink">
								{latest.data.title}
							</span>
							{latest.data.description && (
								<span class="mt-3 line-clamp-3 block text-muted">{latest.data.description}</span>
							)}
						</span>
					</span>
					<Scribble
						{...MARKS.burst}
						color={CHALK}
						strokeWidth={6}
						duration="8s"
						delay="1.6s"
						class="-top-[7%] -left-[7%] z-10 size-[22%]"
					/>
					<HoverBox featured />
				</a>
			)}
			<p class="font-display text-[clamp(36px,3.6vw,56px)] leading-none text-paper uppercase">
				Works on <span class="text-pink">My Machine</span>
			</p>
			<p class={`mt-4 ${HERO_LEAD}`}>
				My thoughts and reactions on tech writing, AI, homelab builds and open source, plus whatever
				I'm working on. It goes out when I have something to say.
			</p>
			<div class="mt-6">
				<NewsletterSignup location="newsletter-page" />
				<p class="mt-3 text-xs text-muted">
					Free, no spam, unsubscribe anytime. You'll get an email to confirm first. Prefer RSS?{' '}
					<a
						href="/newsletter/rss.xml"
						class={`plausible-event-name=RSS+Click plausible-event-feed=newsletter ${TEXT_LINK}`}
					>
						Follow Works on My Machine in your feed reader
					</a>
					.
				</p>
			</div>
		</PosterHero>

		<h2 class={SECTION_HEADING}>Every issue</h2>
		<ul class="mb-20">
			{olderPosts.map((post) => (
				<BlogCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					slug={post.data.slug}
					heroImage={post.data.heroImage}
					href={`/newsletter/${post.data.slug}/`}
				/>
			))}
		</ul>

		<h2 class={`${SECTION_HEADING} !mb-2`}>TL;DR in Tech</h2>
		<p class="mb-8 text-muted">
			The weekly link roundup this newsletter used to be, from 2021 to 2024.
		</p>

		<div class="grid gap-x-10 md:grid-cols-[auto_1fr]">
			{[...byYear.entries()].map(([year, list]) => (
				<section class="contents">
					<h3
						id={String(year)}
						class="scroll-mt-24 border-t border-surface-4 pt-3 font-display text-[clamp(36px,4vw,56px)] leading-none font-normal text-pink md:pb-8"
					>
						{year}
					</h3>
					<ul class="mb-8 gap-x-10 pt-4 md:border-t md:border-surface-4 xl:columns-2">
						{list.map((issue) => (
							<li class="mb-2 flex break-inside-avoid flex-col gap-x-4 sm:flex-row sm:items-baseline">
								<span class="w-32 shrink-0 text-sm text-muted">
									<FormattedDate date={issue.data.date} />
								</span>
								<a href={`/newsletter/${issue.data.slug}/`} class={TEXT_LINK}>
									{issue.data.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
		<KeepExploring
			heading="Who's writing this"
			from="/newsletter/"
			door={{
				href: '/about/',
				label: 'About me',
				blurb: 'Who I am, what I work on, and why I write this.',
			}}
		/>
	</div>
</BaseLayout>
