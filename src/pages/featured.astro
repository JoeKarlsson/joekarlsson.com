---
// Everything other people have written about my work, in full (DECISIONS.md 2026-11-21): the
// papers that cite it first, then the code, courses and reading lists built on it
// (2026-11-22), then press, interviews, newsletters, write-ups and threads. About's
// Written about section shows a few and links here. Podcasts and talks stay on /talks/.
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageList from '../components/CoverageList.astro';
import KeepExploring from '../components/KeepExploring.astro';
import PaperCitations from '../components/PaperCitations.astro';
import PosterHero from '../components/PosterHero.astro';
import SectionRule from '../components/SectionRule.astro';
import { BUILT_ON_GROUPS, COVERAGE_GROUPS, LEAD_STORY } from '../data/coverage';
import { HERO_LEAD, PAGE_CONTAINER, SECTION_HEADING, TEXT_LINK } from '../utils/ui';
---

<BaseLayout
	title="Featured on | Joe Karlsson"
	description="Research papers that cite Joe Karlsson’s work, the code and courses built on it, and the press, newsletters and threads that wrote about it."
	image={LEAD_STORY.image}
	imageAlt={LEAD_STORY.imageAlt}
	schemaType="CollectionPage"
>
	<div class={PAGE_CONTAINER}>
		<PosterHero
			title="Featured"
			wordRatio={3.6}
			featured={{
				label: 'Lead story',
				title: LEAD_STORY.title,
				href: LEAD_STORY.url,
				meta: `${LEAD_STORY.outlet}, ${LEAD_STORY.year}`,
			}}
		>
			<div slot="media" class="relative z-10 aspect-[4/3] md:aspect-auto">
				<img
					src={LEAD_STORY.image}
					alt={LEAD_STORY.imageAlt}
					data-halftone="flat"
					data-halftone-no-invert
					class="absolute inset-0 block size-full rounded-xl bg-ink object-cover object-center"
					width="960"
					height="720"
					sizes="(min-width: 768px) 560px, 100vw"
					fetchpriority="high"
				/>
			</div>
			<p class={HERO_LEAD}>
				Papers that cite my work, the code and courses built on it, and what other people wrote
				about it. The podcasts and talks are on my{' '}
				<a href="/talks/" class={TEXT_LINK}>
					talks page
				</a>
				.
			</p>
		</PosterHero>

		<h2 id="cited-in-research" class={SECTION_HEADING}>
			Cited in research
		</h2>
		<SectionRule />
		<PaperCitations />

		<h2 id="built-on-my-work" class={SECTION_HEADING}>
			Built on my work
		</h2>
		<SectionRule />
		{BUILT_ON_GROUPS.map(({ kind, heading }) => (
			<CoverageList kind={kind} heading={heading} level="h3" />
		))}

		{COVERAGE_GROUPS.map(({ kind, heading }) => (
			<CoverageList kind={kind} heading={heading} />
		))}

		<KeepExploring
			heading="Read what they read"
			from="/featured/"
			posts={[
				'homelab-two-years-later',
				'implementing-mikrotik-binary-api-protocol-in-python',
				'how-to-build-a-real-time-fraud-detection-system',
			]}
		/>
	</div>
</BaseLayout>
