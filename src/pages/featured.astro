---
// Everything other people have written about my work, in full (DECISIONS.md 2026-11-21): the
// papers that cite it first, then the code, courses and reading lists built on it
// (2026-11-22), then press, interviews, newsletters, write-ups and threads. About's
// Written about section shows a few and links here. Podcasts and talks stay on /talks/.
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageList from '../components/CoverageList.astro';
import KeepExploring from '../components/KeepExploring.astro';
import PosterHero from '../components/PosterHero.astro';
import SectionRule from '../components/SectionRule.astro';
import {
	BUILT_ON_GROUPS,
	COVERAGE_GROUPS,
	SHARE_CARD,
	coverageOf,
	papers,
	papersNewestFirst,
} from '../data/coverage';
import { featuredItemList } from '../utils/featured-schema';
import { HERO_LEAD, PAGE_CONTAINER, SECTION_HEADING, TEXT_LINK } from '../utils/ui';

// The hero shows the newest top-tier paper that cites me (DECISIONS.md 2026-11-22)
const heroPaper = papers.find((paper) => paper.venue === 'OSDI')!;
const [heroBefore, heroAfter] = heroPaper.reference.split(heroPaper.highlight);
---

<BaseLayout
	title="Featured on | Joe Karlsson"
	description="Research papers that cite Joe Karlsson’s work, the code and courses built on it, and the press, newsletters and threads that wrote about it."
	image={SHARE_CARD}
	imageAlt="FEATURED and Joe Karlsson’s name over a wall of the outlets, courses and threads that wrote about his work, with the research venues that cite him in pink"
	schemaType="CollectionPage"
	mainEntity={featuredItemList()}
>
	<div class={PAGE_CONTAINER}>
		<PosterHero
			title="Featured"
			wordRatio={3.6}
			featured={{
				label: 'Cited in',
				title: `${papers.length} papers, from SOSP and OSDI to CHI and a law review`,
				href: '#cited-in-research',
				meta: 'Cited in research, below',
			}}
		>
			<a
				slot="media"
				href={heroPaper.url}
				target="_blank"
				rel="noopener noreferrer"
				aria-labelledby="hero-paper-title"
				aria-describedby="hero-paper-ref"
				class="card-link group relative z-10 flex flex-col justify-center gap-5 rounded-xl bg-surface-1 p-6 text-paper no-underline md:gap-7 lg:p-10"
			>
				<span class="font-display text-[clamp(2.5rem,5vw,4rem)] leading-[0.9] text-pink uppercase">
					USENIX {heroPaper.venue}
					<span class="mt-2 block text-[0.45em] text-paper">{heroPaper.year}</span>
				</span>
				<span
					id="hero-paper-title"
					class="font-serif text-lg leading-snug italic group-hover:text-pink max-md:hidden lg:text-[1.375rem]"
				>
					{heroPaper.title}
				</span>
				<span
					id="hero-paper-ref"
					class="rounded-lg bg-ink p-4 font-serif text-[0.9375rem] leading-relaxed text-muted [overflow-wrap:anywhere] md:p-5 md:text-lg"
				>
					{heroBefore}
					<mark class="bg-pink px-1 text-ink [box-decoration-break:clone]">
						{heroPaper.highlight}
					</mark>
					<span class="max-md:hidden">{heroAfter}</span>
				</span>
			</a>
			<p class={HERO_LEAD}>
				Papers that cite my work, the code and courses built on it, and what other people wrote
				about it. The podcasts and talks are on my{' '}
				<a href="/talks/" class={TEXT_LINK}>
					talks page
				</a>
				.
			</p>
		</PosterHero>

		<h2 id="cited-in-research" class={SECTION_HEADING}>
			Cited in research
		</h2>
		<SectionRule />
		<CoverageList
			rows={papersNewestFirst.map((paper) => ({
				date: String(paper.year),
				outlet: paper.venue,
				title: paper.title,
				url: paper.url,
				cites: paper.cites,
			}))}
		/>

		<h2 id="built-on-my-work" class={SECTION_HEADING}>
			Built on my work
		</h2>
		<SectionRule />
		{BUILT_ON_GROUPS.map(({ kind, heading }) => (
			<CoverageList rows={coverageOf(kind)} heading={heading} level="h3" />
		))}

		{COVERAGE_GROUPS.map(({ kind, heading }) => (
			<CoverageList rows={coverageOf(kind)} heading={heading} />
		))}

		<KeepExploring
			heading="Read what they read"
			from="/featured/"
			posts={[
				'homelab-two-years-later',
				'implementing-mikrotik-binary-api-protocol-in-python',
				'how-to-build-a-real-time-fraud-detection-system',
			]}
		/>
	</div>
</BaseLayout>
