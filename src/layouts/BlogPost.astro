---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import AuthorBio from '../components/AuthorBio.astro';
interface Props {
	title: string;
	description?: string;
	date: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
	categories?: string[];
	slug: string;
	contentNotice?: string | boolean;
	tldr?: string;
	readingTime?: number;
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	headings?: { depth: number; slug: string; text: string }[];
}

const {
	title,
	description,
	date,
	updatedDate,
	heroImage,
	categories,
	slug,
	contentNotice,
	tldr,
	readingTime,
	wordCount,
	faq,
	howToSteps,
	headings,
} = Astro.props;

const tocHeadings = (headings || [])
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
const showToc = tocHeadings.length >= 2;

// Content age notice logic
const AGE_THRESHOLD_YEARS = 4;
const referenceDate = updatedDate || date;
const ageInYears = Math.floor(
	(new Date().getTime() - referenceDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const isOld = ageInYears >= AGE_THRESHOLD_YEARS;

// contentNotice: undefined = auto, false = suppress, string = custom message
let noticeMessage: string | null = null;
if (contentNotice === false) {
	noticeMessage = null;
} else if (typeof contentNotice === 'string') {
	noticeMessage = contentNotice;
} else if (isOld) {
	noticeMessage = `This post is ${ageInYears} years old. Some information may be outdated.`;
}

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Primary category for breadcrumbs and prev/next
const primaryCategory = categories?.[0];
const categorySlug = primaryCategory?.toLowerCase().replace(/\s+/g, '-');

// Prev/next within primary category
let prevPost: (typeof publishedPosts)[number] | undefined;
let nextPost: (typeof publishedPosts)[number] | undefined;

if (primaryCategory) {
	const categoryPosts = publishedPosts
		.filter((p) => p.data.categories?.includes(primaryCategory))
		.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
	const currentIndex = categoryPosts.findIndex((p) => p.data.slug === slug);
	if (currentIndex > 0) {
		prevPost = categoryPosts[currentIndex - 1];
	}
	if (currentIndex >= 0 && currentIndex < categoryPosts.length - 1) {
		nextPost = categoryPosts[currentIndex + 1];
	}
}

// Improved related posts: score by shared categories + title keyword overlap
const currentCategories = new Set(categories || []);
const currentTitleWords = new Set(
	title
		.toLowerCase()
		.replace(/[^a-z0-9\s]/g, '')
		.split(/\s+/)
		.filter((w) => w.length > 3),
);

const relatedPosts = publishedPosts
	.filter((p) => p.data.slug !== slug)
	.map((p) => {
		const postCategories = p.data.categories || [];
		const categoryScore = postCategories.filter((cat) => currentCategories.has(cat)).length;
		if (categoryScore === 0) return null;

		const postTitleWords = p.data.title
			.toLowerCase()
			.replace(/[^a-z0-9\s]/g, '')
			.split(/\s+/)
			.filter((w: string) => w.length > 3);
		const titleOverlap = postTitleWords.filter((w: string) => currentTitleWords.has(w)).length;

		return { post: p, categoryScore, titleOverlap };
	})
	.filter(Boolean)
	.sort((a, b) => {
		if (b!.categoryScore !== a!.categoryScore) return b!.categoryScore - a!.categoryScore;
		if (b!.titleOverlap !== a!.titleOverlap) return b!.titleOverlap - a!.titleOverlap;
		return b!.post.data.date.valueOf() - a!.post.data.date.valueOf();
	})
	.slice(0, 3)
	.map((r) => r!.post);
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || tldr || title}
	image={heroImage}
	type="article"
	publishedDate={date}
	modifiedDate={updatedDate}
	keywords={categories}
	wordCount={wordCount}
	faq={faq}
	howToSteps={howToSteps}
>
	<div
		id="reading-progress"
		class="fixed bottom-0 z-40 hidden w-full font-mono"
		aria-hidden="true"
		data-next-post={nextPost ? `/blog/${nextPost.data.slug}/` : ''}
	>
		<!-- Terminal-style progress (default) -->
		<div
			id="progress-terminal"
			class="flex items-center gap-2 bg-surface-0/95 px-3 py-1 text-[11px] text-gray-400 backdrop-blur-xs border-t border-surface-3"
		>
			<span id="progress-bar-text">[....................] 0%</span>
			<span class="text-gray-500">|</span>
			<span id="progress-status">reading...</span>
		</div>
		<!-- Reduced-motion fallback: simple thin line -->
		<div id="progress-simple" class="hidden h-[2px] bg-surface-0/90">
			<div id="progress-simple-fill" class="h-full bg-coral transition-none" style="width: 0%">
			</div>
		</div>
	</div>

	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10 xl:items-start">
			{/* TOC sidebar */}
			{
				showToc && (
					<aside class="hidden xl:block" aria-label="Table of contents">
						<nav class="sticky top-20 font-mono text-xs" id="toc-nav">
							<p class="mb-3 text-gray-500">
								<span class="text-coral" aria-hidden="true">
									~$
								</span>{' '}
								cat contents.md
							</p>
							<ul class="space-y-1.5 border-l border-surface-3 pl-3">
								{tocHeadings.map((h) => (
									<li>
										<a
											href={`#${h.slug}`}
											data-toc-slug={h.slug}
											class={[
												'toc-link block leading-snug transition-colors duration-150',
												h.depth === 3
													? 'pl-4 text-[10px] text-gray-500 hover:text-gray-300'
													: 'text-[11px] font-bold text-gray-200 hover:text-white',
											].join(' ')}
										>
											{h.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				)
			}
			{!showToc && <div class="hidden xl:block" />}

			<article class="min-w-0">
				{/* Breadcrumbs */}
				<nav class="mb-4 font-mono text-xs text-gray-400" aria-label="Breadcrumb">
					<a
						href="/"
						class="underline decoration-gray-500 underline-offset-2 transition-colors hover:text-coral hover:decoration-coral"
						>Home</a
					>
					<span class="mx-1">&gt;</span>
					<a
						href="/blog/"
						class="underline decoration-gray-500 underline-offset-2 transition-colors hover:text-coral hover:decoration-coral"
						>Blog</a
					>
					{
						primaryCategory && (
							<>
								<span class="mx-1">&gt;</span>
								<a
									href={`/blog/category/${categorySlug}/`}
									class="underline decoration-gray-500 underline-offset-2 transition-colors hover:text-coral hover:decoration-coral"
								>
									{primaryCategory}
								</a>
							</>
						)
					}
					<span class="mx-1">&gt;</span>
					<span class="text-gray-400">{title}</span>
				</nav>

				{
					heroImage && (
						<img
							src={heroImage}
							alt={title}
							class="mb-8 w-full max-h-[400px] rounded-lg object-cover"
							width="768"
							height="400"
							loading="eager"
						/>
					)
				}
				{
					noticeMessage && (
						<div
							class="mb-6 rounded-lg border border-yellow-500/30 bg-yellow-500/10 px-4 py-3 font-mono text-sm text-yellow-200"
							role="note"
						>
							<span class="mr-2 text-yellow-400" aria-hidden="true">
								&#9888;
							</span>
							{noticeMessage}
						</div>
					)
				}
				<div class="mb-8">
					<p class="mb-2 font-mono text-sm text-gray-400">
						<FormattedDate date={date} />
						{
							updatedDate && (
								<span class="ml-2 italic">
									(Updated <FormattedDate date={updatedDate} />)
								</span>
							)
						}
						{
							readingTime && (
								<>
									<span class="mx-2 text-gray-500">|</span>
									<span>{readingTime} min read</span>
								</>
							)
						}
					</p>
					<h1 class="mb-4 text-3xl font-bold text-white md:text-4xl">{title}</h1>
					{
						categories && categories.length > 0 && (
							<div class="flex flex-wrap gap-2">
								{categories.map((cat) => (
									<a
										href={`/blog/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`}
										class="rounded-full bg-surface-3 px-2 py-0.5 font-mono text-[10px] text-gray-400 no-underline transition-colors hover:bg-coral/20 hover:text-coral"
									>
										{cat}
									</a>
								))}
							</div>
						)
					}
				</div>
				{
					tldr && (
						<div class="mb-8 rounded-lg border border-coral/20 bg-coral/5 px-4 py-3">
							<p class="mb-1 font-mono text-xs font-bold uppercase tracking-wider text-coral">
								TL;DR
							</p>
							<p class="text-sm leading-relaxed text-gray-300">{tldr}</p>
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>

				<script>
					function copyToClipboard(text: string): Promise<void> {
						if (navigator.clipboard?.writeText) {
							return navigator.clipboard.writeText(text);
						}
						const textarea = document.createElement('textarea');
						textarea.value = text;
						textarea.style.position = 'fixed';
						textarea.style.opacity = '0';
						document.body.appendChild(textarea);
						textarea.select();
						document.execCommand('copy');
						document.body.removeChild(textarea);
						return Promise.resolve();
					}

					document.querySelectorAll('.prose pre').forEach((pre) => {
						const code = pre.querySelector('code');

						// Add language label
						const lang = pre.getAttribute('data-language');
						if (lang) {
							const label = document.createElement('span');
							label.className = 'code-lang-label';
							label.textContent = lang;
							pre.appendChild(label);
						}

						// Add copy button
						const button = document.createElement('button');
						button.className = 'copy-button';
						button.textContent = 'Copy';
						button.addEventListener('click', async () => {
							if (!code) return;
							try {
								await copyToClipboard(code.textContent || '');
								button.textContent = 'Copied!';
							} catch {
								button.textContent = 'Failed';
							}
							setTimeout(() => {
								button.textContent = 'Copy';
							}, 2000);
						});
						pre.appendChild(button);
					});
				</script>

				<script>
					(() => {
						const progressEl = document.getElementById('reading-progress');
						const barText = document.getElementById('progress-bar-text');
						const statusText = document.getElementById('progress-status');
						const terminalEl = document.getElementById('progress-terminal');
						const simpleEl = document.getElementById('progress-simple');
						const simpleFill = document.getElementById('progress-simple-fill');
						const article = document.querySelector('article');

						if (
							!progressEl ||
							!barText ||
							!statusText ||
							!article ||
							!terminalEl ||
							!simpleEl ||
							!simpleFill
						)
							return;

						const prefersReducedMotion = window.matchMedia(
							'(prefers-reduced-motion: reduce)',
						).matches;

						if (prefersReducedMotion) {
							terminalEl.classList.add('hidden');
							simpleEl.classList.remove('hidden');
						}

						function buildBar(pct: number): string {
							const filled = Math.round(pct / 5);
							const empty = 20 - filled;
							return '[' + '#'.repeat(filled) + '.'.repeat(empty) + '] ' + pct + '%';
						}

						function update() {
							const rect = article!.getBoundingClientRect();
							const articleTop = rect.top + window.scrollY;
							const articleHeight = rect.height;
							const viewportHeight = window.innerHeight;
							const scrollY = window.scrollY;

							const scrolled = scrollY - articleTop;
							const total = articleHeight - viewportHeight;
							let pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
							pct = Math.max(0, Math.min(100, pct));

							trackScrollDepth(pct);

							if (pct <= 0) {
								progressEl!.classList.add('hidden');
								return;
							}

							progressEl!.classList.remove('hidden');

							if (prefersReducedMotion) {
								simpleFill!.style.width = pct + '%';
							} else {
								barText!.textContent = buildBar(pct);
								if (pct >= 100) {
									const nextUrl = progressEl!.dataset.nextPost;
									if (nextUrl && nextUrl.startsWith('/blog/')) {
										statusText!.textContent = '';
										const doneText = document.createTextNode('done. ');
										const link = document.createElement('a');
										link.href = nextUrl;
										link.className = 'text-coral hover:text-teal underline';
										link.textContent = 'cat next-post.md';
										statusText!.appendChild(doneText);
										statusText!.appendChild(link);
									} else {
										statusText!.textContent = 'done.';
									}
									statusText!.classList.add('text-coral');
								} else {
									statusText!.textContent = 'reading...';
									statusText!.classList.remove('text-coral');
								}
							}
						}

						// Scroll depth tracking milestones
						const depthMilestones = new Set<number>();

						function trackScrollDepth(pct: number) {
							const plausible = window.plausible;
							if (typeof plausible !== 'function') return;
							[25, 50, 75, 100].forEach((milestone) => {
								if (pct >= milestone && !depthMilestones.has(milestone)) {
									depthMilestones.add(milestone);
									plausible('Scroll Depth', { props: { depth: `${milestone}%` } });
									if (milestone === 100) {
										plausible('Reading Complete');
									}
								}
							});
						}

						let ticking = false;
						window.addEventListener(
							'scroll',
							() => {
								if (!ticking) {
									requestAnimationFrame(() => {
										update();
										ticking = false;
									});
									ticking = true;
								}
							},
							{ passive: true },
						);

						update();
					})();
				</script>

				{/* Author bio */}
				<AuthorBio />

				{/* Newsletter CTA — inline after post content */}
				<div class="mt-6">
					<NewsletterCTA />
				</div>

				{/* Related Posts — moved above prev/next for better visibility */}
				{
					relatedPosts.length > 0 && (
						<section class="mt-12 border-t border-surface-3 pt-8">
							<h2 class="mb-6 text-lg font-bold text-white">
								<span class="text-coral font-mono text-sm" aria-hidden="true">
									~$
								</span>{' '}
								Related Posts
							</h2>
							<div class="grid gap-4 sm:grid-cols-3">
								{relatedPosts.map((post) => (
									<a
										href={`/blog/${post.data.slug}/`}
										class="plausible-event-name=Related+Post+Click group block rounded-lg border border-surface-3 bg-surface-1 p-4 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-coral/30 hover:bg-surface-2"
									>
										{post.data.heroImage && (
											<img
												src={post.data.heroImage}
												alt={post.data.title}
												class="mb-3 h-32 w-full rounded-md object-cover"
												width="300"
												height="128"
												loading="lazy"
											/>
										)}
										<p class="mb-1 font-mono text-xs text-gray-400">
											{post.data.date.toLocaleDateString('en-us', {
												year: 'numeric',
												month: 'short',
												day: 'numeric',
											})}
										</p>
										<h3 class="text-sm font-semibold text-white transition-colors group-hover:text-coral">
											{post.data.title}
										</h3>
										{post.data.description && (
											<p class="mt-1 text-xs text-gray-400 line-clamp-2">{post.data.description}</p>
										)}
									</a>
								))}
							</div>
						</section>
					)
				}

				{/* Prev/Next within category */}
				{
					(prevPost || nextPost) && (
						<nav
							class="mt-12 flex items-stretch gap-4 border-t border-surface-3 pt-8"
							aria-label="Category navigation"
						>
							{prevPost ? (
								<a
									href={`/blog/${prevPost.data.slug}/`}
									class="group flex flex-1 flex-col rounded-lg border border-surface-3 p-4 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-coral/30 hover:bg-surface-2"
								>
									<span class="mb-1 font-mono text-xs text-gray-400">
										&larr; Previous in {primaryCategory}
									</span>
									<span class="text-sm font-semibold text-white transition-colors group-hover:text-coral">
										{prevPost.data.title}
									</span>
								</a>
							) : (
								<div class="flex-1" />
							)}
							{nextPost ? (
								<a
									href={`/blog/${nextPost.data.slug}/`}
									class="group flex flex-1 flex-col items-end rounded-lg border border-surface-3 p-4 no-underline text-right transition-all duration-300 hover:-translate-y-0.5 hover:border-coral/30 hover:bg-surface-2"
								>
									<span class="mb-1 font-mono text-xs text-gray-400">
										Next in {primaryCategory} &rarr;
									</span>
									<span class="text-sm font-semibold text-white transition-colors group-hover:text-coral">
										{nextPost.data.title}
									</span>
								</a>
							) : (
								<div class="flex-1" />
							)}
						</nav>
					)
				}
			</article>
		</div>
	</div>

	<script>
		(() => {
			const links = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>;
			if (!links.length) return;

			const headingEls = Array.from(links).map((l) => {
				const slug = l.dataset.tocSlug;
				return slug ? document.getElementById(slug) : null;
			});

			function setActive(el: HTMLAnchorElement | null) {
				links.forEach((l) => {
					l.classList.remove('text-coral');
					l.classList.add('text-gray-500');
				});
				if (el) {
					el.classList.remove('text-gray-500');
					el.classList.add('text-coral');
				}
			}

			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((e) => e.isIntersecting)
						.map((e) => headingEls.indexOf(e.target as HTMLElement))
						.filter((i) => i !== -1)
						.sort((a, b) => a - b);

					if (visible.length > 0) {
						setActive(links[visible[0]]);
					}
				},
				{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
			);

			headingEls.forEach((el) => {
				if (el) observer.observe(el);
			});
		})();
	</script>
</BaseLayout>
