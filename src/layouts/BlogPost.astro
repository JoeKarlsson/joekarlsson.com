---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import BackLink from '../components/BackLink.astro';
import { categorySlug } from '../utils/categories';
import { isOwnPost } from '../utils/posts';
import AuthorBio from '../components/AuthorBio.astro';
import WrittenFor from '../components/WrittenFor.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';
import Scribble from '../components/Scribble.astro';
import KeepExploring from '../components/KeepExploring.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import Logo from '../components/Logo.astro';
import { CHALK, MARKS } from '../data/scribbles';
import { halftoneMode } from '../utils/halftone';
import { localImageSize } from '../utils/image-size.mjs';
import { rankRelatedPosts } from '../utils/related-posts';
import popularPosts from '../data/popular-posts.json';
import { ARTICLE_TITLE, META, PAGE_CONTAINER, SIDEBAR_GRID } from '../utils/ui';
interface Props {
	title: string;
	shareTitle?: string;
	seoTitle?: string;
	description?: string;
	date: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroAlt?: string;
	heroVideo?: string;
	categories?: string[];
	// The employer this post was written for; none for a personal post
	writtenFor?: string;
	slug: string;
	contentNotice?: string | boolean;
	tldr?: string;
	readingTime?: number;
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	headings?: { depth: number; slug: string; text: string }[];
	canonicalUrl?: string;
}

const {
	title,
	shareTitle,
	seoTitle,
	description,
	date,
	updatedDate,
	heroImage,
	heroAlt,
	heroVideo,
	categories,
	writtenFor,
	slug,
	contentNotice,
	tldr,
	readingTime,
	wordCount,
	faq,
	howToSteps,
	headings,
	canonicalUrl,
} = Astro.props;
// The hero's real size, so a phone reserves the right height before it loads:
// the old fixed 1120x440 made square heroes jump the title down (CLS 0.15)
const heroSize = heroImage ? await localImageSize(heroImage) : undefined;

const tocHeadings = (headings || [])
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
const showToc = tocHeadings.length >= 2;

// Content age notice logic
const AGE_THRESHOLD_YEARS = 4;
const referenceDate = updatedDate || date;
const ageInYears = Math.floor(
	(new Date().getTime() - referenceDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const isOld = ageInYears >= AGE_THRESHOLD_YEARS;

// contentNotice: undefined = auto, false = suppress, string = custom message
let noticeMessage: string | null = null;
if (contentNotice === false) {
	noticeMessage = null;
} else if (typeof contentNotice === 'string') {
	noticeMessage = contentNotice;
} else if (isOld) {
	noticeMessage = `This post is ${ageInYears} years old. Some information may be outdated.`;
}

// Notices are plain text plus optional [text](https://...) links, e.g. crosspost credits
const escapeHtml = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const noticeHtml = noticeMessage
	? escapeHtml(noticeMessage).replace(
			/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
			'<a href="$2">$1</a>',
		)
	: null;

const allPosts = await getCollection('blog');
// Keep reading suggests Joe's own posts, unless this post was written for an employer:
// that reader came for employer posts, so those stay in the pool
const publishedPosts = allPosts
	.filter((p) => writtenFor || isOwnPost(p))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "Keep reading": the three posts closest to this one in what they're about (full
// text, src/utils/related-posts.ts), best match first, where the crayon arrow points
const relatablePosts = publishedPosts.map((post) => ({
	slug: post.data.slug,
	title: post.data.title,
	description: post.data.description,
	tags: post.data.tags,
	body: post.body,
}));
const relatedSlugs = rankRelatedPosts(
	relatablePosts.find((post) => post.slug === slug)!,
	relatablePosts,
	popularPosts.visitorsByPath,
);

// One crayon mark spills off each post's hero; the slug picks which, so a post
// keeps the same one between builds
const HERO_MARKS = [
	{ mark: MARKS.burst, color: CHALK, class: '-top-[9%] -right-[4%] size-[22%] max-w-[170px]' },
	{ mark: MARKS.rays, color: '#ff4fd8', class: '-top-[12%] -left-[3%] h-[20%] w-[18%]' },
	{ mark: MARKS.tally, color: CHALK, class: '-right-[5%] -bottom-[7%] h-[14%] w-[26%]' },
	{ mark: MARKS.hatch, color: '#ff4fd8', class: '-bottom-[8%] -left-[4%] h-[14%] w-[24%]' },
	{
		mark: MARKS.burstDense,
		color: '#ff4fd8',
		class: '-right-[5%] -bottom-[10%] size-[20%] max-w-[150px]',
	},
];
const slugHash = [...slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const heroMark = HERO_MARKS[slugHash % HERO_MARKS.length];
---

<BaseLayout
	title={`${seoTitle || title} | Joe Karlsson`}
	description={description || tldr || title}
	image={heroImage}
	imageAlt={heroAlt}
	type="article"
	publishedDate={date}
	modifiedDate={updatedDate}
	keywords={categories}
	wordCount={wordCount}
	faq={faq}
	howToSteps={howToSteps}
	canonicalUrl={canonicalUrl}
>
	{/* Phones show progress in the nav bar instead (reading-context.ts) */}
	<div
		id="reading-progress"
		class="fixed top-0 left-0 z-50 h-1 w-0 bg-pink max-md:hidden"
		aria-hidden="true"
	></div>

	<div class={PAGE_CONTAINER}>
		<div class={SIDEBAR_GRID}>
			{/* TOC sidebar */}
			{showToc ? <TableOfContents headings={tocHeadings} /> : <div class="hidden xl:block" />}

			{/* @container: wide pictures and code in the post size themselves to this column */}
			<article
				class="@container min-w-0"
				data-post-title={title}
				data-post-category={categories?.[0]}
				data-reading-time={readingTime}
			>
				<BackLink href="/blog/" label="Blog" />
				{/* controls on the video for the same WCAG 2.2.2 reason as rehype-gif-video;
				in-view-play starts it, so a remembered pause or reduced motion keeps it still */}
				{heroVideo ? (
					<video
						src={heroVideo}
						data-halftone={halftoneMode(heroVideo)}
						poster={heroImage}
						data-autoplay-in-view
						loop
						muted
						playsinline
						controls
						preload="metadata"
						aria-label={heroAlt || title}
						class="mb-10 w-full max-h-[440px] rounded-xl object-cover"
						width={heroSize?.width ?? 768}
						height={heroSize?.height ?? 440}
					/>
				) : (
					heroImage && (
						<div class="relative mb-10">
							{/* Drawn in pink by src/scripts/halftone.ts */}
							<img
								src={heroImage}
								data-halftone={halftoneMode(heroImage)}
								alt={heroAlt || title}
								class="block w-full max-h-[440px] rounded-xl object-cover"
								width={heroSize?.width}
								height={heroSize?.height}
								sizes="(min-width: 1280px) 856px, 100vw"
								loading="eager"
								fetchpriority="high"
							/>
							<Scribble
								{...heroMark.mark}
								color={heroMark.color}
								strokeWidth={6}
								duration="9s"
								delay="0.8s"
								class={heroMark.class}
							/>
						</div>
					)
				)}
				{/* Title, text and everything under it share one column centered under the
				hero, so the text doesn't hug the hero's left edge and leave a dead strip right */}
				<div class="mx-auto max-w-(--reading-width)">
					<div class="mb-8">
						<h1 class={ARTICLE_TITLE}>{title}</h1>
						<p class={META}>
							<FormattedDate date={date} />
							{updatedDate && (
								<>
									{' '}
									(Updated <FormattedDate date={updatedDate} />)
								</>
							)}
							{readingTime && <> · {readingTime} min read</>}
							{categories &&
								categories.map((cat) => (
									<>
										{' · '}
										<a
											href={`/blog/category/${categorySlug(cat)}/`}
											class="text-pink underline decoration-1 underline-offset-[0.2em] hover:text-paper"
										>
											{cat}
										</a>
									</>
								))}
							{writtenFor && (
								<>
									{' · '}
									<WrittenFor employer={writtenFor} />
								</>
							)}
						</p>
					</div>
					{noticeMessage && (
						<p class="mb-6 text-sm text-muted" role="note">
							<Fragment set:html={noticeHtml} />
						</p>
					)}
					{tldr && (
						<p class="mb-10 border-l-4 border-pink pl-5 text-lg leading-relaxed text-paper">
							<strong class="font-display text-xl font-normal tracking-wide text-pink uppercase">
								TL;DR
							</strong>{' '}
							{tldr}
						</p>
					)}
					<div class:list={['prose wide-media', (heroImage || heroVideo) && 'has-hero']}>
						<slot />
					</div>
					<!-- End mark: the post is over -->
					<Logo text="JK" class="text-paper" style="display:block;margin-top:2rem;font-size:20px" />

					<script>
						function copyToClipboard(text: string): Promise<void> {
							return navigator.clipboard.writeText(text);
						}

						document.querySelectorAll('.prose pre').forEach((pre) => {
							const code = pre.querySelector('code');

							// Add language label
							const lang = pre.getAttribute('data-language');
							if (lang) {
								const label = document.createElement('span');
								label.className = 'code-lang-label';
								label.textContent = lang;
								pre.appendChild(label);
							}

							// Add copy button
							const button = document.createElement('button');
							button.className = 'copy-button';
							button.textContent = 'Copy';
							button.addEventListener('click', async () => {
								if (!code) return;
								try {
									await copyToClipboard(code.textContent || '');
									button.textContent = 'Copied!';
									if (typeof window.plausible === 'function') {
										window.plausible('Code Copy', { props: { language: lang || 'unknown' } });
									}
								} catch {
									button.textContent = 'Failed';
								}
								setTimeout(() => {
									button.textContent = 'Copy';
								}, 2000);
							});
							pre.appendChild(button);
						});
					</script>

					<script>
						(() => {
							const progressEl = document.getElementById('reading-progress');
							const article = document.querySelector('article');
							if (!progressEl || !article) return;

							// Scroll depth tracking milestones
							const depthMilestones = new Set<number>();
							const postTitle = article.dataset.postTitle || 'Unknown';

							function trackScrollDepth(pct: number) {
								const plausible = window.plausible;
								if (typeof plausible !== 'function') return;
								[25, 50, 75, 100].forEach((milestone) => {
									if (pct >= milestone && !depthMilestones.has(milestone)) {
										depthMilestones.add(milestone);
										plausible('Scroll Depth', {
											props: { depth: `${milestone}%`, post: postTitle },
										});
										if (milestone === 100) {
											plausible('Reading Complete', { props: { post: postTitle } });
										}
									}
								});
							}

							function update() {
								const rect = article!.getBoundingClientRect();
								const articleTop = rect.top + window.scrollY;
								const total = rect.height - window.innerHeight;
								const scrolled = window.scrollY - articleTop;
								let pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
								pct = Math.max(0, Math.min(100, pct));

								trackScrollDepth(pct);
								progressEl!.style.width = pct + '%';
							}

							let ticking = false;
							window.addEventListener(
								'scroll',
								() => {
									if (!ticking) {
										requestAnimationFrame(() => {
											update();
											ticking = false;
										});
										ticking = true;
									}
								},
								{ passive: true },
							);

							update();
						})();
					</script>

					<ShareLinks
						url={canonicalUrl || new URL(`/blog/${slug}/`, Astro.site).href}
						title={shareTitle || title}
						noun="post"
						class="mt-10"
					/>

					<AuthorBio />

					{relatedSlugs.length > 0 && (
						<KeepExploring
							heading="Keep reading"
							from={slug}
							posts={relatedSlugs}
							eventName="Related+Post+Click"
						/>
					)}
				</div>
			</article>
		</div>
	</div>
	<ImageLightbox />
</BaseLayout>

<script>
	// Phones fold a written-in "In this article" list (rehype-collapsible-toc.mjs)
	import { initPhoneCollapse } from '../scripts/phone-collapse';
	initPhoneCollapse();
</script>
