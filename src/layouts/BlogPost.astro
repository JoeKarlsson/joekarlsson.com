---
import { getCollection, getEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import { categorySlug } from '../utils/categories';
import { isOwnPost } from '../utils/posts';
import { AMAZON_DISCLOSURE } from '../utils/affiliate';
import ArticleFrame from '../components/ArticleFrame.astro';
import MetaParts from '../components/MetaParts.astro';
import { curlyApostrophes } from '../utils/curly-apostrophes.mjs';
import { inlineMarkdown } from '../utils/inline-markdown';
import WrittenFor from '../components/WrittenFor.astro';
import Scribble from '../components/Scribble.astro';
import KeepExploring from '../components/KeepExploring.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { MARKS } from '../data/scribbles';
import { halftoneMode } from '../utils/halftone';
import { localImageSize } from '../utils/image-size.mjs';
import { rankRelatedPosts } from '../utils/related-posts';
import popularPosts from '../data/popular-posts.json';
import { joinLastWord } from '../plugins/rehype-no-widows.mjs';
interface Props {
	title: string;
	shareTitle?: string;
	seoTitle?: string;
	description?: string;
	date: Date;
	updatedDate?: Date;
	/** Dated fixes to mistakes in the post, shown in a box at the top */
	corrections?: { date: Date; note: string }[];
	/** What the last refresh changed, shown in a banner under the title */
	updateNote?: string;
	heroImage?: string;
	// What the masthead shows when it isn't heroImage (a taped card's flat copy)
	mastheadImage?: string;
	heroAlt?: string;
	/** Who or what the hero shows, in place of the description as its caption */
	heroCaption?: string;
	heroVideo?: string;
	categories?: string[];
	// The employer this post was written for; none for a personal post
	writtenFor?: string;
	slug: string;
	contentNotice?: string | boolean;
	/** The post links to Amazon, so it shows the affiliate disclosure up top */
	hasAffiliateLinks?: boolean;
	tldr?: string;
	readingTime?: number;
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	headings?: { depth: number; slug: string; text: string }[];
	canonicalUrl?: string;
	/** Where the post lives: /blog/ by default, /talks/ for a talk write-up, /reviews/ for a film review */
	section?: 'blog' | 'talks' | 'reviews';
	/** Blog post slugs for "Keep reading", in place of the ones ranked by similar text */
	relatedPosts?: string[];
	/** A post outside the blog collection brings its own text, to find related blog posts */
	body?: string;
	/** VideoObject JSON-LD for the videos on the page (src/utils/video-schema.ts) */
	videoObjects?: Record<string, unknown>[];
	/** The research paper this post is the readable version of (src/content/papers) */
	paper?: string;
}

const {
	title,
	shareTitle,
	seoTitle,
	description,
	date,
	updatedDate,
	updateNote,
	corrections,
	heroImage,
	mastheadImage = heroImage,
	heroAlt,
	heroCaption,
	heroVideo,
	categories,
	writtenFor,
	slug,
	contentNotice,
	hasAffiliateLinks,
	tldr,
	readingTime,
	wordCount,
	faq,
	howToSteps,
	headings,
	canonicalUrl,
	section = 'blog',
	relatedPosts,
	body,
	videoObjects,
	paper,
} = Astro.props;
const SECTIONS = {
	blog: { name: 'Blog', path: '/blog/' },
	talks: { name: 'Talks', path: '/talks/' },
	reviews: { name: 'Reviews', path: '/reviews/' },
};
const home = SECTIONS[section];
// The hero's real size, so a phone reserves the right height before it loads:
// the old fixed 1120x440 made square heroes jump the title down (CLS 0.15)
const heroSize = mastheadImage ? await localImageSize(mastheadImage) : undefined;

const tocHeadings = (headings || [])
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
// Under xl there's no sidebar, so long posts get a folded contents list above the text
const inlineTocHeadings = tocHeadings.filter((h) => h.depth === 2);

// Content age notice logic
const AGE_THRESHOLD_YEARS = 4;
const referenceDate = updatedDate || date;
const ageInYears = Math.floor(
	(new Date().getTime() - referenceDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const isOld = ageInYears >= AGE_THRESHOLD_YEARS;

// contentNotice: undefined = auto, false = suppress, string = custom message
let noticeMessage: string | null = null;
if (contentNotice === false) {
	noticeMessage = null;
} else if (typeof contentNotice === 'string') {
	noticeMessage = contentNotice;
} else if (isOld) {
	noticeMessage = `This post is ${ageInYears} years old. Some information may be outdated.`;
}

// Notices are plain text plus optional [text](https://...) links, e.g. crosspost credits
const escapeHtml = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const noticeHtml = noticeMessage
	? escapeHtml(noticeMessage).replace(
			/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
			'<a href="$2">$1</a>',
		)
	: null;

const paperEntry = paper ? await getEntry('papers', paper) : undefined;
if (paper && !paperEntry) throw new Error(`post ${slug}: no paper ${paper} in src/content/papers`);

const allPosts = await getCollection('blog');
// Keep reading suggests Joe's own posts, unless this post was written for an employer:
// that reader came for employer posts, so those stay in the pool
const publishedPosts = allPosts
	.filter((p) => writtenFor || isOwnPost(p))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "Keep reading": the three posts closest to this one in what they're about (full
// text, src/utils/related-posts.ts), best match first, where the crayon arrow points
const relatablePosts = publishedPosts.map((post) => ({
	slug: post.data.slug,
	title: post.data.title,
	description: post.data.description,
	tags: post.data.tags,
	body: post.body,
}));
const relatedSlugs =
	relatedPosts ??
	rankRelatedPosts(
		relatablePosts.find((post) => post.slug === slug) ?? {
			slug: `${section}/${slug}`,
			title,
			description,
			body,
		},
		relatablePosts,
		popularPosts.visitorsByPath,
	);

// The description is the masthead's caption, unless the text opens with it (a review's
// description is its first lines), which would say the same thing twice in a row. The
// schema curled the description's quotes, so the body is curled the same way to compare
const captionText =
	heroCaption ??
	(description &&
	!curlyApostrophes((body ?? '').replace(/\s+/g, ' ')).includes(description.slice(0, 60))
		? description
		: undefined);
---

<BaseLayout
	title={`${seoTitle || title} | Joe Karlsson`}
	description={description || tldr || title}
	image={heroImage}
	imageAlt={heroAlt}
	type="article"
	publishedDate={date}
	modifiedDate={updatedDate}
	keywords={categories}
	wordCount={wordCount}
	faq={faq}
	howToSteps={howToSteps}
	canonicalUrl={canonicalUrl}
	section={home}
	videoObjects={videoObjects}
>
	<ArticleFrame
		title={title}
		section={home}
		caption={captionText}
		heroImage={mastheadImage}
		heroVideo={heroVideo}
		heroAlt={heroAlt}
		heroWidth={heroSize?.width}
		heroHeight={heroSize?.height}
		halftone={halftoneMode(heroVideo ?? mastheadImage ?? '')}
		toc={tocHeadings}
		inlineToc={inlineTocHeadings}
		share={{
			url: canonicalUrl || new URL(`${home.path}${slug}/`, Astro.site).href,
			title: shareTitle || title,
			noun: section === 'reviews' ? 'review' : 'post',
		}}
		ask={{
			location: 'post-end',
			blurb:
				section === 'reviews'
					? 'If you read this far for a movie review, you might like the rest of what I write: homelab builds, AI tools and open source, by email when I have something to\u00A0say.'
					: 'Get the next post by email. My newsletter covers homelab builds, AI tools and open source, and it goes out when I have something to\u00A0say.',
		}}
		articleData={{
			'data-post-title': title,
			'data-post-category': categories?.[0],
			'data-reading-time': readingTime,
		}}
	>
		<Fragment slot="kicker">
			<MetaParts>
				<span>
					<FormattedDate date={date} />
					{updatedDate && (
						<>
							{' '}
							(Updated <FormattedDate date={updatedDate} />)
						</>
					)}
				</span>{' '}
				{readingTime && <span>{readingTime} min read</span>}{' '}
				{categories &&
					categories.map((cat) => (
						<>
							<a href={`/blog/category/${categorySlug(cat)}/`} class="text-pink hover:text-paper">
								{cat}
							</a>{' '}
						</>
					))}
				{writtenFor && <WrittenFor employer={writtenFor} />}
				<slot name="meta" />
			</MetaParts>
		</Fragment>
		{paperEntry && (
			<p slot="under-title" class="paper-strip">
				<span class="paper-strip-label">Paper</span>
				<span>
					This post is the readable version of a research paper:{' '}
					{/* The title up to its question mark: the subtitle is for the paper page */}
					<a href={`/papers/${paperEntry.id}/`}>
						{paperEntry.data.displayTitle.split(/(?<=\?) /)[0]}
					</a>
				</span>
				<MetaParts class="paper-strip-links">
					<span>
						<a href={paperEntry.data.pdf}>PDF</a>
					</span>{' '}
					{paperEntry.data.doi && (
						<span>
							<a href={`https://doi.org/${paperEntry.data.doi}`}>doi:{paperEntry.data.doi}</a>
						</span>
					)}
				</MetaParts>
			</p>
		)}
		<Fragment slot="top">
			<slot name="margin" />
			{updateNote && updatedDate && (
				<p class="mb-6 border border-pink px-4 py-3 text-base text-paper" role="note">
					<strong class="text-pink">
						Updated <FormattedDate date={updatedDate} />:
					</strong>{' '}
					{updateNote}
				</p>
			)}
			{corrections && corrections.length > 0 && (
				<div class="mb-6 border border-pink px-4 py-3 text-base text-paper" role="note">
					<strong class="text-pink">Corrections</strong>
					<ul class="mt-1 list-disc pl-5">
						{corrections
							.toSorted((a, b) => b.date.valueOf() - a.date.valueOf())
							.map((correction) => (
								<li>
									<strong>
										<FormattedDate date={correction.date} />:
									</strong>{' '}
									<span set:html={inlineMarkdown(correction.note)} />
								</li>
							))}
					</ul>
				</div>
			)}
			{noticeMessage && (
				<p class="mb-6 text-sm text-muted" role="note">
					<Fragment set:html={noticeHtml} />
				</p>
			)}
			{hasAffiliateLinks && (
				<p class="mb-6 text-sm text-muted" role="note">
					{AMAZON_DISCLOSURE}
				</p>
			)}
			{tldr && (
				<p class="mb-10 border-l-4 border-pink pl-5 text-lg leading-relaxed text-paper">
					<strong class="font-display text-xl font-normal tracking-[0.04em] text-pink uppercase">
						TL;DR
					</strong>{' '}
					{joinLastWord(tldr)}
				</p>
			)}
		</Fragment>
		<div class:list={['prose wide-media', (heroImage || heroVideo) && 'has-hero']}>
			<slot />
		</div>
		<Fragment slot="end">
			{/* Drawn once around a code block's Copy when it copies (copy-burst, motion.css) */}
			<Scribble
				{...MARKS.burst}
				color="#ff4fd8"
				strokeWidth={7}
				once
				duration="1.1s"
				class="copy-burst z-20 size-[110px]"
			/>
			<script>
				import { isMotionPaused } from '../scripts/pause-motion';

				function copyToClipboard(text: string): Promise<void> {
					return navigator.clipboard.writeText(text);
				}

				const copyBurst = document.querySelector<SVGSVGElement>('.copy-burst');
				const motionAllowed = () =>
					!matchMedia('(prefers-reduced-motion: reduce)').matches && !isMotionPaused();
				// Centers the starburst on the button and draws it again from the first stroke
				function drawCopyBurst(button: HTMLElement) {
					if (!copyBurst || !motionAllowed()) return;
					// Move it by the gap between where it is and the button's center
					const burstBox = copyBurst.getBoundingClientRect();
					const buttonBox = button.getBoundingClientRect();
					const placed = getComputedStyle(copyBurst);
					const left = parseFloat(placed.left) + buttonBox.left + buttonBox.width / 2;
					const top = parseFloat(placed.top) + buttonBox.top + buttonBox.height / 2;
					copyBurst.style.left = `${left - burstBox.left - burstBox.width / 2}px`;
					copyBurst.style.top = `${top - burstBox.top - burstBox.height / 2}px`;
					copyBurst.classList.remove('go');
					void copyBurst.getBoundingClientRect(); // restart the fade on a second copy
					for (const stroke of copyBurst.getAnimations({ subtree: true })) {
						stroke.currentTime = 0;
						stroke.play();
					}
					copyBurst.classList.add('go');
				}

				// One polite live region says "Copied" for every code block's button
				const copyStatus = document.createElement('span');
				copyStatus.setAttribute('role', 'status');
				copyStatus.className = 'sr-only';
				document.body.append(copyStatus);

				document.querySelectorAll('.prose pre').forEach((pre) => {
					const code = pre.querySelector('code');

					// Add language label
					const lang = pre.getAttribute('data-language');
					if (lang) {
						const label = document.createElement('span');
						label.className = 'code-lang-label';
						label.textContent = lang;
						pre.appendChild(label);
					}

					// Add copy button: Copy and Copied! stacked in one cell, crossfading on
					// [data-copied] (motion.css)
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'copy-button';
					const idleName = lang ? `Copy ${lang} code` : 'Copy code';
					button.setAttribute('aria-label', idleName);
					const swap = document.createElement('span');
					swap.className = 'icon-swap';
					swap.setAttribute('aria-hidden', 'true');
					const idleLabel = document.createElement('span');
					idleLabel.toggleAttribute('data-icon-off', true);
					idleLabel.textContent = 'Copy';
					const doneLabel = document.createElement('span');
					doneLabel.toggleAttribute('data-icon-on', true);
					doneLabel.textContent = 'Copied!';
					swap.append(idleLabel, doneLabel);
					button.append(swap);
					let resetTimer: ReturnType<typeof setTimeout> | undefined;
					button.addEventListener('click', async () => {
						if (!code) return;
						clearTimeout(resetTimer);
						copyStatus.textContent = '';
						try {
							await copyToClipboard(code.textContent || '');
							button.toggleAttribute('data-copied', true);
							copyStatus.textContent = 'Copied';
							button.classList.remove('copied');
							void button.offsetWidth; // restart the pop on a second copy
							button.classList.add('copied');
							drawCopyBurst(button);
							if (typeof window.plausible === 'function') {
								window.plausible('Code Copy', { props: { language: lang || 'unknown' } });
							}
						} catch {
							idleLabel.textContent = 'Failed';
							copyStatus.textContent = 'Copy failed';
						}
						resetTimer = setTimeout(() => {
							button.removeAttribute('data-copied');
							idleLabel.textContent = 'Copy';
						}, 2000);
					});
					pre.appendChild(button);
				});
			</script>
		</Fragment>
		<slot name="related" slot="related" />
		<Fragment slot="after">
			{relatedSlugs.length > 0 && (
				<KeepExploring
					heading="Keep reading"
					from={slug}
					posts={relatedSlugs}
					eventName="Related+Post+Click"
				/>
			)}
		</Fragment>
	</ArticleFrame>
	<ImageLightbox />
</BaseLayout>

<script>
	// Phones fold a written-in "In this article" list (rehype-collapsible-toc.mjs)
	import { initPhoneCollapse } from '../scripts/phone-collapse';
	import { initLinkPeek } from '../scripts/link-peek';
	initPhoneCollapse();
	initLinkPeek();
</script>
