---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';
interface Props {
	title: string;
	shareTitle?: string;
	description?: string;
	date: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroAlt?: string;
	heroVideo?: string;
	categories?: string[];
	slug: string;
	contentNotice?: string | boolean;
	tldr?: string;
	readingTime?: number;
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	headings?: { depth: number; slug: string; text: string }[];
	canonicalUrl?: string;
}

const {
	title,
	shareTitle,
	description,
	date,
	updatedDate,
	heroImage,
	heroAlt,
	heroVideo,
	categories,
	slug,
	contentNotice,
	tldr,
	readingTime,
	wordCount,
	faq,
	howToSteps,
	headings,
	canonicalUrl,
} = Astro.props;

const tocHeadings = (headings || [])
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
const showToc = tocHeadings.length >= 2;

// Content age notice logic
const AGE_THRESHOLD_YEARS = 4;
const referenceDate = updatedDate || date;
const ageInYears = Math.floor(
	(new Date().getTime() - referenceDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const isOld = ageInYears >= AGE_THRESHOLD_YEARS;

// contentNotice: undefined = auto, false = suppress, string = custom message
let noticeMessage: string | null = null;
if (contentNotice === false) {
	noticeMessage = null;
} else if (typeof contentNotice === 'string') {
	noticeMessage = contentNotice;
} else if (isOld) {
	noticeMessage = `This post is ${ageInYears} years old. Some information may be outdated.`;
}

// Notices are plain text plus optional [text](https://...) links, e.g. crosspost credits
const escapeHtml = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const noticeHtml = noticeMessage
	? escapeHtml(noticeMessage).replace(
			/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
			'<a href="$2">$1</a>',
		)
	: null;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Primary category for prev/next
const primaryCategory = categories?.[0];

// Prev/next within primary category
let prevPost: (typeof publishedPosts)[number] | undefined;
let nextPost: (typeof publishedPosts)[number] | undefined;

if (primaryCategory) {
	const categoryPosts = publishedPosts
		.filter((p) => p.data.categories?.includes(primaryCategory))
		.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
	const currentIndex = categoryPosts.findIndex((p) => p.data.slug === slug);
	if (currentIndex > 0) {
		prevPost = categoryPosts[currentIndex - 1];
	}
	if (currentIndex >= 0 && currentIndex < categoryPosts.length - 1) {
		nextPost = categoryPosts[currentIndex + 1];
	}
}

// Improved related posts: score by shared categories + title keyword overlap
const currentCategories = new Set(categories || []);
const currentTitleWords = new Set(
	title
		.toLowerCase()
		.replace(/[^a-z0-9\s]/g, '')
		.split(/\s+/)
		.filter((w) => w.length > 3),
);

const relatedPosts = publishedPosts
	.filter((p) => p.data.slug !== slug)
	.map((p) => {
		const postCategories = p.data.categories || [];
		const categoryScore = postCategories.filter((cat) => currentCategories.has(cat)).length;
		if (categoryScore === 0) return null;

		const postTitleWords = p.data.title
			.toLowerCase()
			.replace(/[^a-z0-9\s]/g, '')
			.split(/\s+/)
			.filter((w: string) => w.length > 3);
		const titleOverlap = postTitleWords.filter((w: string) => currentTitleWords.has(w)).length;

		return { post: p, categoryScore, titleOverlap };
	})
	.filter(Boolean)
	.sort((a, b) => {
		if (b!.categoryScore !== a!.categoryScore) return b!.categoryScore - a!.categoryScore;
		if (b!.titleOverlap !== a!.titleOverlap) return b!.titleOverlap - a!.titleOverlap;
		return b!.post.data.date.valueOf() - a!.post.data.date.valueOf();
	})
	.slice(0, 3)
	.map((r) => r!.post);

const formatShortDate = (d: Date) =>
	d.toLocaleDateString('en-us', {
		timeZone: 'UTC',
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || tldr || title}
	image={heroImage}
	imageAlt={heroAlt}
	type="article"
	publishedDate={date}
	modifiedDate={updatedDate}
	keywords={categories}
	wordCount={wordCount}
	faq={faq}
	howToSteps={howToSteps}
	canonicalUrl={canonicalUrl}
>
	<div
		id="reading-progress"
		class="fixed top-0 left-0 z-50 h-0.5 w-0 bg-coral"
		aria-hidden="true"
	></div>

	<div class="mx-auto max-w-3xl px-4 py-8 xl:max-w-5xl">
		<div class="xl:grid xl:grid-cols-[200px_1fr] xl:gap-10">
			{/* TOC sidebar */}
			{showToc ? <TableOfContents headings={tocHeadings} /> : <div class="hidden xl:block" />}

			<article class="min-w-0" data-post-title={title}>
				{/* controls on the video for the same WCAG 2.2.2 reason as rehype-gif-video */}
				{heroVideo ? (
					<video
						src={heroVideo}
						poster={heroImage}
						autoplay
						loop
						muted
						playsinline
						controls
						preload="metadata"
						role="img"
						aria-label={heroAlt || title}
						class="mb-8 w-full max-h-[400px] rounded-lg object-cover"
						width="768"
						height="400"
					/>
				) : (
					heroImage && (
						<img
							src={heroImage}
							alt={title}
							class="mb-8 w-full max-h-[400px] rounded-lg object-cover"
							width="768"
							height="400"
							loading="eager"
						/>
					)
				)}
				<div class="mb-8">
					<h1 class="mb-3 text-3xl font-bold text-white md:text-4xl">{title}</h1>
					<p class="text-sm text-gray-400">
						<FormattedDate date={date} />
						{updatedDate && (
							<>
								{' '}
								(Updated <FormattedDate date={updatedDate} />)
							</>
						)}
						{readingTime && <> · {readingTime} min read</>}
						{categories &&
							categories.map((cat) => (
								<>
									{' · '}
									<a
										href={`/blog/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`}
										class="text-gray-400 no-underline hover:text-coral"
									>
										{cat}
									</a>
								</>
							))}
					</p>
				</div>
				{noticeMessage && (
					<p class="mb-6 text-sm text-gray-400" role="note">
						<Fragment set:html={noticeHtml} />
					</p>
				)}
				{tldr && (
					<p class="mb-8 border-l-2 border-surface-4 pl-4 leading-relaxed text-gray-300">
						<strong class="font-semibold text-white">TL;DR:</strong> {tldr}
					</p>
				)}
				<div class="prose">
					<slot />
				</div>

				<script>
					function copyToClipboard(text: string): Promise<void> {
						return navigator.clipboard.writeText(text);
					}

					document.querySelectorAll('.prose pre').forEach((pre) => {
						const code = pre.querySelector('code');

						// Add language label
						const lang = pre.getAttribute('data-language');
						if (lang) {
							const label = document.createElement('span');
							label.className = 'code-lang-label';
							label.textContent = lang;
							pre.appendChild(label);
						}

						// Add copy button
						const button = document.createElement('button');
						button.className = 'copy-button';
						button.textContent = 'Copy';
						button.addEventListener('click', async () => {
							if (!code) return;
							try {
								await copyToClipboard(code.textContent || '');
								button.textContent = 'Copied!';
								if (typeof window.plausible === 'function') {
									window.plausible('Code Copy', { props: { language: lang || 'unknown' } });
								}
							} catch {
								button.textContent = 'Failed';
							}
							setTimeout(() => {
								button.textContent = 'Copy';
							}, 2000);
						});
						pre.appendChild(button);
					});
				</script>

				<script>
					(() => {
						const progressEl = document.getElementById('reading-progress');
						const article = document.querySelector('article');
						if (!progressEl || !article) return;

						// Scroll depth tracking milestones
						const depthMilestones = new Set<number>();
						const postTitle = article.dataset.postTitle || 'Unknown';

						function trackScrollDepth(pct: number) {
							const plausible = window.plausible;
							if (typeof plausible !== 'function') return;
							[25, 50, 75, 100].forEach((milestone) => {
								if (pct >= milestone && !depthMilestones.has(milestone)) {
									depthMilestones.add(milestone);
									plausible('Scroll Depth', { props: { depth: `${milestone}%`, post: postTitle } });
									if (milestone === 100) {
										plausible('Reading Complete', { props: { post: postTitle } });
									}
								}
							});
						}

						function update() {
							const rect = article!.getBoundingClientRect();
							const articleTop = rect.top + window.scrollY;
							const total = rect.height - window.innerHeight;
							const scrolled = window.scrollY - articleTop;
							let pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
							pct = Math.max(0, Math.min(100, pct));

							trackScrollDepth(pct);
							progressEl!.style.width = pct + '%';
						}

						let ticking = false;
						window.addEventListener(
							'scroll',
							() => {
								if (!ticking) {
									requestAnimationFrame(() => {
										update();
										ticking = false;
									});
									ticking = true;
								}
							},
							{ passive: true },
						);

						update();
					})();
				</script>

				<ShareLinks
					url={canonicalUrl || new URL(`/blog/${slug}/`, Astro.site).href}
					title={shareTitle || title}
					noun="post"
					class="mt-10"
				/>

				<AuthorBio />

				{relatedPosts.length > 0 && (
					<section class="mt-12">
						<h2 class="mb-4 text-3xl font-extrabold text-white">Related posts</h2>
						<ul class="space-y-3">
							{relatedPosts.map((post) => (
								<li>
									<a
										href={`/blog/${post.data.slug}/`}
										class="plausible-event-name=Related+Post+Click font-semibold text-white no-underline hover:text-coral"
									>
										{post.data.title}
									</a>
									<span class="block text-sm text-gray-400">{formatShortDate(post.data.date)}</span>
								</li>
							))}
						</ul>
					</section>
				)}

				{(prevPost || nextPost) && (
					<nav class="mt-12" aria-label="Category navigation">
						<h2 class="mb-4 text-3xl font-extrabold text-white">More in {primaryCategory}</h2>
						<ul class="space-y-3">
							{prevPost && (
								<li>
									<span class="block text-sm text-gray-400">Previous</span>
									<a
										href={`/blog/${prevPost.data.slug}/`}
										class="plausible-event-name=Blog+Navigation plausible-event-direction=prev font-semibold text-white no-underline hover:text-coral"
									>
										{prevPost.data.title}
									</a>
									<span class="block text-sm text-gray-400">
										{formatShortDate(prevPost.data.date)}
									</span>
								</li>
							)}
							{nextPost && (
								<li>
									<span class="block text-sm text-gray-400">Next</span>
									<a
										href={`/blog/${nextPost.data.slug}/`}
										class="plausible-event-name=Blog+Navigation plausible-event-direction=next font-semibold text-white no-underline hover:text-coral"
									>
										{nextPost.data.title}
									</a>
									<span class="block text-sm text-gray-400">
										{formatShortDate(nextPost.data.date)}
									</span>
								</li>
							)}
						</ul>
					</nav>
				)}
			</article>
		</div>
	</div>
</BaseLayout>
