---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import BackLink from '../components/BackLink.astro';
import { categorySlug } from '../utils/categories';
import AuthorBio from '../components/AuthorBio.astro';
import WrittenFor from '../components/WrittenFor.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareLinks from '../components/ShareLinks.astro';
import Scribble from '../components/Scribble.astro';
import { CHALK, MARKS } from '../data/scribbles';
import { halftoneMode } from '../utils/halftone';
import {
	ARTICLE_TITLE,
	META,
	PAGE_CONTAINER,
	SECTION_HEADING,
	SIDEBAR_GRID,
	formatDate,
} from '../utils/ui';
interface Props {
	title: string;
	shareTitle?: string;
	description?: string;
	date: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroAlt?: string;
	heroVideo?: string;
	categories?: string[];
	// The employer this post was written for; none for a personal post
	writtenFor?: string;
	slug: string;
	contentNotice?: string | boolean;
	tldr?: string;
	readingTime?: number;
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	headings?: { depth: number; slug: string; text: string }[];
	canonicalUrl?: string;
}

const {
	title,
	shareTitle,
	description,
	date,
	updatedDate,
	heroImage,
	heroAlt,
	heroVideo,
	categories,
	writtenFor,
	slug,
	contentNotice,
	tldr,
	readingTime,
	wordCount,
	faq,
	howToSteps,
	headings,
	canonicalUrl,
} = Astro.props;

const tocHeadings = (headings || [])
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, '').trim() }));
const showToc = tocHeadings.length >= 2;

// Content age notice logic
const AGE_THRESHOLD_YEARS = 4;
const referenceDate = updatedDate || date;
const ageInYears = Math.floor(
	(new Date().getTime() - referenceDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const isOld = ageInYears >= AGE_THRESHOLD_YEARS;

// contentNotice: undefined = auto, false = suppress, string = custom message
let noticeMessage: string | null = null;
if (contentNotice === false) {
	noticeMessage = null;
} else if (typeof contentNotice === 'string') {
	noticeMessage = contentNotice;
} else if (isOld) {
	noticeMessage = `This post is ${ageInYears} years old. Some information may be outdated.`;
}

// Notices are plain text plus optional [text](https://...) links, e.g. crosspost credits
const escapeHtml = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const noticeHtml = noticeMessage
	? escapeHtml(noticeMessage).replace(
			/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
			'<a href="$2">$1</a>',
		)
	: null;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Primary category for prev/next
const primaryCategory = categories?.[0];

// Prev/next within primary category
let prevPost: (typeof publishedPosts)[number] | undefined;
let nextPost: (typeof publishedPosts)[number] | undefined;

if (primaryCategory) {
	const categoryPosts = publishedPosts
		.filter((p) => p.data.categories.some((category) => category === primaryCategory))
		.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
	const currentIndex = categoryPosts.findIndex((p) => p.data.slug === slug);
	if (currentIndex > 0) {
		prevPost = categoryPosts[currentIndex - 1];
	}
	if (currentIndex >= 0 && currentIndex < categoryPosts.length - 1) {
		nextPost = categoryPosts[currentIndex + 1];
	}
}

// Improved related posts: score by shared categories + title keyword overlap
const currentCategories = new Set(categories || []);
const currentTitleWords = new Set(
	title
		.toLowerCase()
		.replace(/[^a-z0-9\s]/g, '')
		.split(/\s+/)
		.filter((w) => w.length > 3),
);

const relatedPosts = publishedPosts
	.filter((p) => p.data.slug !== slug)
	.map((p) => {
		const postCategories = p.data.categories || [];
		const categoryScore = postCategories.filter((cat) => currentCategories.has(cat)).length;
		if (categoryScore === 0) return null;

		const postTitleWords = p.data.title
			.toLowerCase()
			.replace(/[^a-z0-9\s]/g, '')
			.split(/\s+/)
			.filter((w: string) => w.length > 3);
		const titleOverlap = postTitleWords.filter((w: string) => currentTitleWords.has(w)).length;

		return { post: p, categoryScore, titleOverlap };
	})
	.filter(Boolean)
	.sort((a, b) => {
		if (b!.categoryScore !== a!.categoryScore) return b!.categoryScore - a!.categoryScore;
		if (b!.titleOverlap !== a!.titleOverlap) return b!.titleOverlap - a!.titleOverlap;
		return b!.post.data.date.valueOf() - a!.post.data.date.valueOf();
	})
	.slice(0, 3)
	.map((r) => r!.post);

// One crayon mark spills off each post's hero; the slug picks which, so a post
// keeps the same one between builds
const HERO_MARKS = [
	{ mark: MARKS.burst, color: CHALK, class: '-top-[9%] -right-[4%] size-[22%] max-w-[170px]' },
	{ mark: MARKS.rays, color: '#ff4fd8', class: '-top-[12%] -left-[3%] h-[20%] w-[18%]' },
	{ mark: MARKS.tally, color: CHALK, class: '-right-[5%] -bottom-[7%] h-[14%] w-[26%]' },
	{ mark: MARKS.hatch, color: '#ff4fd8', class: '-bottom-[8%] -left-[4%] h-[14%] w-[24%]' },
	{
		mark: MARKS.burstDense,
		color: '#ff4fd8',
		class: '-right-[5%] -bottom-[10%] size-[20%] max-w-[150px]',
	},
];
const slugHash = [...slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const heroMark = HERO_MARKS[slugHash % HERO_MARKS.length];
---

<BaseLayout
	title={`${title} | Joe Karlsson`}
	description={description || tldr || title}
	image={heroImage}
	imageAlt={heroAlt}
	type="article"
	publishedDate={date}
	modifiedDate={updatedDate}
	keywords={categories}
	wordCount={wordCount}
	faq={faq}
	howToSteps={howToSteps}
	canonicalUrl={canonicalUrl}
>
	<div
		id="reading-progress"
		class="fixed top-0 left-0 z-50 h-1 w-0 bg-pink"
		aria-hidden="true"
	></div>

	<div class={PAGE_CONTAINER}>
		<div class={SIDEBAR_GRID}>
			{/* TOC sidebar */}
			{showToc ? <TableOfContents headings={tocHeadings} /> : <div class="hidden xl:block" />}

			<article class="min-w-0" data-post-title={title}>
				<BackLink href="/blog/" label="Blog" />
				{/* controls on the video for the same WCAG 2.2.2 reason as rehype-gif-video;
				in-view-play starts it, so a remembered pause or reduced motion keeps it still */}
				{heroVideo ? (
					<video
						src={heroVideo}
						data-halftone={halftoneMode(heroVideo)}
						poster={heroImage}
						data-autoplay-in-view
						loop
						muted
						playsinline
						controls
						preload="metadata"
						role="img"
						aria-label={heroAlt || title}
						class="mb-10 w-full max-h-[440px] rounded-xl object-cover"
						width="768"
						height="440"
					/>
				) : (
					heroImage && (
						<div class="relative mb-10">
							{/* Drawn in pink by src/scripts/halftone.ts */}
							<img
								src={heroImage}
								data-halftone={halftoneMode(heroImage)}
								alt={heroAlt || title}
								class="block w-full max-h-[440px] rounded-xl object-cover"
								width="1120"
								height="440"
								loading="eager"
							/>
							<Scribble
								{...heroMark.mark}
								color={heroMark.color}
								strokeWidth={6}
								duration="9s"
								delay="0.8s"
								class={heroMark.class}
							/>
						</div>
					)
				)}
				<div class="mb-8">
					<h1 class={ARTICLE_TITLE}>{title}</h1>
					<p class={META}>
						<FormattedDate date={date} />
						{updatedDate && (
							<>
								{' '}
								(Updated <FormattedDate date={updatedDate} />)
							</>
						)}
						{readingTime && <> · {readingTime} min read</>}
						{categories &&
							categories.map((cat) => (
								<>
									{' · '}
									<a
										href={`/blog/category/${categorySlug(cat)}/`}
										class="text-pink underline decoration-1 underline-offset-[0.2em] hover:text-paper"
									>
										{cat}
									</a>
								</>
							))}
						{writtenFor && (
							<>
								{' · '}
								<WrittenFor employer={writtenFor} />
							</>
						)}
					</p>
				</div>
				{noticeMessage && (
					<p class="mb-6 max-w-[40rem] text-sm text-muted" role="note">
						<Fragment set:html={noticeHtml} />
					</p>
				)}
				{tldr && (
					<p class="mb-10 max-w-[40rem] border-l-4 border-pink pl-5 text-lg leading-relaxed text-paper">
						<strong class="font-display text-xl font-normal tracking-wide text-pink uppercase">
							TL;DR
						</strong>{' '}
						{tldr}
					</p>
				)}
				<div class="prose">
					<slot />
				</div>

				<script>
					function copyToClipboard(text: string): Promise<void> {
						return navigator.clipboard.writeText(text);
					}

					document.querySelectorAll('.prose pre').forEach((pre) => {
						const code = pre.querySelector('code');

						// Add language label
						const lang = pre.getAttribute('data-language');
						if (lang) {
							const label = document.createElement('span');
							label.className = 'code-lang-label';
							label.textContent = lang;
							pre.appendChild(label);
						}

						// Add copy button
						const button = document.createElement('button');
						button.className = 'copy-button';
						button.textContent = 'Copy';
						button.addEventListener('click', async () => {
							if (!code) return;
							try {
								await copyToClipboard(code.textContent || '');
								button.textContent = 'Copied!';
								if (typeof window.plausible === 'function') {
									window.plausible('Code Copy', { props: { language: lang || 'unknown' } });
								}
							} catch {
								button.textContent = 'Failed';
							}
							setTimeout(() => {
								button.textContent = 'Copy';
							}, 2000);
						});
						pre.appendChild(button);
					});
				</script>

				<script>
					(() => {
						const progressEl = document.getElementById('reading-progress');
						const article = document.querySelector('article');
						if (!progressEl || !article) return;

						// Scroll depth tracking milestones
						const depthMilestones = new Set<number>();
						const postTitle = article.dataset.postTitle || 'Unknown';

						function trackScrollDepth(pct: number) {
							const plausible = window.plausible;
							if (typeof plausible !== 'function') return;
							[25, 50, 75, 100].forEach((milestone) => {
								if (pct >= milestone && !depthMilestones.has(milestone)) {
									depthMilestones.add(milestone);
									plausible('Scroll Depth', { props: { depth: `${milestone}%`, post: postTitle } });
									if (milestone === 100) {
										plausible('Reading Complete', { props: { post: postTitle } });
									}
								}
							});
						}

						function update() {
							const rect = article!.getBoundingClientRect();
							const articleTop = rect.top + window.scrollY;
							const total = rect.height - window.innerHeight;
							const scrolled = window.scrollY - articleTop;
							let pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
							pct = Math.max(0, Math.min(100, pct));

							trackScrollDepth(pct);
							progressEl!.style.width = pct + '%';
						}

						let ticking = false;
						window.addEventListener(
							'scroll',
							() => {
								if (!ticking) {
									requestAnimationFrame(() => {
										update();
										ticking = false;
									});
									ticking = true;
								}
							},
							{ passive: true },
						);

						update();
					})();
				</script>

				<ShareLinks
					url={canonicalUrl || new URL(`/blog/${slug}/`, Astro.site).href}
					title={shareTitle || title}
					noun="post"
					class="mt-10"
				/>

				<AuthorBio />

				{relatedPosts.length > 0 && (
					<section class="mt-12">
						<h2 class={SECTION_HEADING}>Related posts</h2>
						<ul class="space-y-3">
							{relatedPosts.map((post) => (
								<li>
									<a
										href={`/blog/${post.data.slug}/`}
										class="plausible-event-name=Related+Post+Click text-lg font-semibold text-paper no-underline hover:text-pink"
									>
										{post.data.title}
									</a>
									<span class="block text-sm text-muted">{formatDate(post.data.date)}</span>
								</li>
							))}
						</ul>
					</section>
				)}

				{(prevPost || nextPost) && (
					<nav class="mt-12" aria-label="Category navigation">
						<h2 class={SECTION_HEADING}>More in {primaryCategory}</h2>
						<ul class="space-y-3">
							{prevPost && (
								<li>
									<span class="block text-sm text-muted">Previous</span>
									<a
										href={`/blog/${prevPost.data.slug}/`}
										class="plausible-event-name=Blog+Navigation plausible-event-direction=prev text-lg font-semibold text-paper no-underline hover:text-pink"
									>
										{prevPost.data.title}
									</a>
									<span class="block text-sm text-muted">{formatDate(prevPost.data.date)}</span>
								</li>
							)}
							{nextPost && (
								<li>
									<span class="block text-sm text-muted">Next</span>
									<a
										href={`/blog/${nextPost.data.slug}/`}
										class="plausible-event-name=Blog+Navigation plausible-event-direction=next text-lg font-semibold text-paper no-underline hover:text-pink"
									>
										{nextPost.data.title}
									</a>
									<span class="block text-sm text-muted">{formatDate(nextPost.data.date)}</span>
								</li>
							)}
						</ul>
					</nav>
				)}
			</article>
		</div>
	</div>
</BaseLayout>
