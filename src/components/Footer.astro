---
import { FOOTER_LINKS, SOCIAL_LINKS } from '../consts';
import { CHALK, COIL, MARKS } from '../data/scribbles';
import NewsletterCTA from './NewsletterCTA.astro';
import Scribble from './Scribble.astro';
const year = new Date().getFullYear();
const ECHO_TITLE = 'Works on my machine';
---

<footer class="relative bg-pink px-4 pt-11 pb-10 text-ink sm:px-7 [&_:focus-visible]:outline-ink">
	<h2
		class="echo font-display text-[clamp(28px,9vw,150px)] whitespace-nowrap text-ink uppercase"
		style="--echo-fill:#000;--echo-stroke:#000"
	>
		<span class="sr-only">{ECHO_TITLE}</span>
		<!-- Phones keep just the first line, filled in solid (.echo-lead in motion.css) -->
		{[0, 1, 2, 3, 4].map((index) => (
			<span
				aria-hidden="true"
				style={`--echo-index:${index}`}
				class={index === 0 ? 'echo-lead' : 'max-md:hidden'}
			>
				{ECHO_TITLE}
			</span>
		))}
	</h2>
	<!-- Starts above the footer, over the ticker, and comes down into the pink -->
	<Scribble
		path={COIL}
		color={CHALK}
		duration="10s"
		class="-top-[110px] right-[1%] z-10 h-[260px] w-[56%]"
	/>
	<Scribble
		{...MARKS.burstDense}
		color="#000"
		strokeWidth={6}
		duration="8s"
		delay="2s"
		class="right-[6%] bottom-[150px] hidden size-[150px] md:block"
	/>
	<NewsletterCTA />
	<!-- From md up, one row: the links take about 33em, so the type shrinks with the
	viewport until they fit. Phones: bigger type wrapped onto a few rows, each link a
	full-height tap target -->
	<nav
		aria-label="Footer"
		class="mt-8 flex flex-wrap gap-x-5 font-display text-xl whitespace-nowrap uppercase md:mt-10 md:gap-x-[1em] md:text-[clamp(15px,calc((100vw-64px)/33),22px)]"
	>
		{FOOTER_LINKS.map(({ href, label }) => (
			<a
				href={href}
				class="py-2.5 text-ink no-underline hover:underline hover:decoration-[3px] md:py-0"
			>
				{label}
			</a>
		))}
	</nav>
	<div class="mt-7 flex flex-col justify-between gap-4 border-t-2 border-ink pt-[18px] font-semibold sm:flex-row sm:items-center">
		<p>&copy; {year} Joe Karlsson</p>
		<!-- Phones: each icon gets a 44px tap area (p-[11px] around 22px), pulled back to the edge by -mx -->
		<div class="-mx-[11px] flex items-center md:mx-0 md:gap-[18px] [&>a]:p-[11px] md:[&>a]:p-0">
			<a
				href={SOCIAL_LINKS.github}
				target="_blank"
				rel="noopener noreferrer"
				class="plausible-event-name=Footer+Social+Click plausible-event-platform=github text-ink hover:text-paper"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
			<a
				href={SOCIAL_LINKS.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="plausible-event-name=Footer+Social+Click plausible-event-platform=linkedin text-ink hover:text-paper"
				aria-label="LinkedIn"
			>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
				</svg>
			</a>
			<a
				href={SOCIAL_LINKS.bluesky}
				target="_blank"
				rel="noopener noreferrer"
				class="plausible-event-name=Footer+Social+Click plausible-event-platform=bluesky text-ink hover:text-paper"
				aria-label="Bluesky"
			>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.6 3.476 6.154 3.229-4.058.746-7.329 2.453-2.869 6.151 5.203 3.947 7.027-1.082 8.091-3.637.163-.39.24-.576.24-.41 0-.166.076.02.24.41 1.064 2.555 2.888 7.584 8.091 3.637 4.46-3.698 1.189-5.405-2.869-6.151 2.554.247 5.37-.602 6.154-3.229C24.002 9.418 24.38 4.458 24.38 3.768c0-.69-.139-1.861-.902-2.203-.659-.3-1.664-.621-4.3 1.24C16.426 4.747 13.087 8.686 12 10.8z"></path>
				</svg>
			</a>
			<a
				href={SOCIAL_LINKS.youtube}
				target="_blank"
				rel="noopener noreferrer"
				class="plausible-event-name=Footer+Social+Click plausible-event-platform=youtube text-ink hover:text-paper"
				aria-label="YouTube"
			>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
				</svg>
			</a>
			<a
				href={SOCIAL_LINKS.letterboxd}
				target="_blank"
				rel="noopener noreferrer"
				class="plausible-event-name=Footer+Social+Click plausible-event-platform=letterboxd text-ink hover:text-paper"
				aria-label="Letterboxd"
			>
				<svg viewBox="0 -2.4 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M8.224 14.352a4.773 4.773 0 0 1-3.2-4.46 4.773 4.773 0 0 1 3.2-4.46A4.769 4.769 0 0 0 6.4 4.8a4.8 4.8 0 1 0 0 9.6c.66 0 1.29-.134 1.862-.375l-.038.327zm7.552 0a4.773 4.773 0 0 0 3.2-4.46 4.773 4.773 0 0 0-3.2-4.46A4.769 4.769 0 0 1 17.6 4.8a4.8 4.8 0 1 1 0 9.6 4.769 4.769 0 0 1-1.862-.375l.038.327zM12 14.4a4.773 4.773 0 0 1-3.776-4.508A4.773 4.773 0 0 1 12 5.384a4.773 4.773 0 0 1 3.776 4.508A4.773 4.773 0 0 1 12 14.4z"></path>
				</svg>
			</a>
			<a
				href="/rss.xml"
				class="plausible-event-name=RSS+Click plausible-event-feed=blog text-ink hover:text-paper"
				aria-label="RSS Feed"
			>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>
