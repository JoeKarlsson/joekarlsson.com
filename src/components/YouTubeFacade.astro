---
// A YouTube video that costs one thumbnail until it's clicked: src/scripts/youtube-facade.ts
// (loaded by BaseLayout) swaps the button for the youtube-nocookie player, playing.
// Three real embeds put /about over the Lighthouse page-weight budget.
import { halftoneMode } from '../utils/halftone';

interface Props {
	id: string;
	title: string;
	// Our own still instead of YouTube's thumbnail
	poster?: string;
	// A short muted loop played over the poster until the player loads
	loop?: string;
	// A YouTube Short: an upright 9:16 frame, for the still and the player
	vertical?: boolean;
}

const { id, title, poster, loop, vertical } = Astro.props;
---

<button
	type="button"
	class:list={[
		'youtube-facade group relative block w-full cursor-pointer overflow-hidden rounded-xl bg-ink',
		vertical ? 'aspect-[9/16]' : 'aspect-video',
	]}
	data-youtube-id={id}
	data-youtube-title={title}
	data-youtube-vertical={vertical ? '' : undefined}
	aria-label={`Play ${title}`}
>
	{loop ? (
		<video
			src={loop}
			poster={poster}
			data-halftone="dots"
			data-autoplay-in-view
			muted
			loop
			playsinline
			preload="none"
			aria-hidden="true"
			class="block size-full object-cover"
		/>
	) : (
		<img
			src={poster ?? `https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
			alt=""
			aria-hidden="true"
			crossorigin={poster ? undefined : 'anonymous'}
			loading="lazy"
			decoding="async"
			data-halftone={poster ? halftoneMode(poster) : 'flat'}
			class="block size-full object-cover"
		/>
	)}
	<span
		aria-hidden="true"
		class="absolute top-1/2 left-1/2 z-10 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-pink text-ink group-hover:bg-paper"
	>
		<svg viewBox="0 0 24 24" class="ml-1 size-7" fill="currentColor">
			<path d="M8 5v14l11-7z"></path>
		</svg>
	</span>
	<!-- Labels drawn over the still (a logo, a title); they go when the player loads -->
	<slot />
</button>
