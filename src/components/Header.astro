---
import { NAV_LINKS } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

function isActive(href: string, also: string[] = []): boolean {
	return [href, ...also].some((path) => {
		const normalized = path.replace(/\/$/, '') || '/';
		if (normalized === '/') return currentPath === '/';
		return currentPath === normalized || currentPath.startsWith(normalized);
	});
}
---

<!--
	One row, always. Spacing is in em, so the whole bar scales with its type: from md
	up the type shrinks until the bar (about 33.5em wide) fits the window. On phones
	the section links fold into a MENU sticker that drops them below the bar.
-->
<header class="pointer-events-none sticky top-2 z-50 flex justify-center px-2 pt-2 md:top-3.5">
	<nav
		aria-label="Main navigation"
		class="group/nav pointer-events-auto relative flex max-w-full items-center gap-[0.19em] rounded-[0.67em] bg-paper p-[0.29em] font-display text-base leading-none whitespace-nowrap text-ink uppercase md:text-[min(21px,calc((100vw-24px)/33.5))]"
	>
		<!-- The name is the home link; on the homepage it goes pink like any current page -->
		<a
			href="/"
			aria-current={currentPath === '/' ? 'page' : undefined}
			class:list={[
				'sticker shrink-0 rounded-[0.43em] px-[0.48em] py-[0.38em] no-underline',
				currentPath === '/' ? 'bg-pink text-ink' : 'bg-ink text-paper hover:text-pink',
			]}
		>
			Joe Karlsson
		</a>
		<button
			type="button"
			data-nav-menu-toggle
			aria-expanded="false"
			aria-controls="nav-section-links"
			class="sticker shrink-0 cursor-pointer rounded-[0.43em] px-[0.48em] py-[0.38em] text-ink uppercase hover:bg-ink hover:text-pink aria-expanded:bg-ink aria-expanded:text-pink md:hidden"
		>
			Menu
		</button>
		<!-- md and up: the links sit in the bar. Phones: a dropdown under the bar, shown while the menu is open -->
		<div
			id="nav-section-links"
			class="contents max-md:absolute max-md:top-full max-md:right-0 max-md:mt-[0.29em] max-md:hidden max-md:flex-col max-md:items-stretch max-md:gap-[0.19em] max-md:rounded-[0.67em] max-md:bg-paper max-md:p-[0.29em] max-md:group-data-[menu-open]/nav:flex"
		>
			{NAV_LINKS.map(({ href, label, also }) => (
				<a
					href={href}
					aria-current={isActive(href, also) ? 'page' : undefined}
					class:list={[
						'sticker shrink-0 rounded-[0.43em] px-[0.48em] py-[0.38em] no-underline',
						isActive(href, also) ? 'bg-pink text-ink' : 'text-ink hover:bg-ink hover:text-pink',
					]}
				>
					{label}
				</a>
			))}
		</div>
		<!-- Pause bars while motion runs, a play triangle once paused (pause-motion.ts swaps the label) -->
		<button
			type="button"
			data-pause-motion
			aria-pressed="false"
			aria-label="Pause motion"
			title="Pause motion"
			class="sticker group shrink-0 cursor-pointer rounded-[0.43em] bg-ink p-[0.38em] text-paper hover:text-pink aria-pressed:bg-pink aria-pressed:text-ink"
		>
			<svg
				viewBox="0 0 16 16"
				class="size-[1em] group-aria-pressed:hidden"
				fill="currentColor"
				aria-hidden="true"
			>
				<rect x="3" y="2" width="3.5" height="12"></rect>
				<rect x="9.5" y="2" width="3.5" height="12"></rect>
			</svg>
			<svg
				viewBox="0 0 16 16"
				class="hidden size-[1em] group-aria-pressed:block"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 2 L14 8 L4 14 Z"></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	// Phones: MENU opens the section links; Escape or a tap outside the bar closes them
	const nav = document.querySelector<HTMLElement>('header nav[aria-label="Main navigation"]');
	const menuToggle = nav?.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]');
	if (nav && menuToggle) {
		const setMenuOpen = (open: boolean) => {
			nav.toggleAttribute('data-menu-open', open);
			menuToggle.setAttribute('aria-expanded', String(open));
		};
		menuToggle.addEventListener('click', () => setMenuOpen(!nav.hasAttribute('data-menu-open')));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && nav.hasAttribute('data-menu-open')) {
				setMenuOpen(false);
				menuToggle.focus();
			}
		});
		document.addEventListener('click', (event) => {
			if (!nav.contains(event.target as Node)) setMenuOpen(false);
		});
	}
</script>
