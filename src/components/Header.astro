---
import { NAV_LINKS } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
	const normalizedHref = href.replace(/\/$/, '') || '/';
	if (normalizedHref === '/') return currentPath === '/';
	return currentPath === normalizedHref || currentPath.startsWith(normalizedHref);
}
---

<!-- Floats over the page from md up; on phones it wraps to a few rows, so it scrolls away -->
<header class="pointer-events-none z-50 flex justify-center px-2 pt-2 md:sticky md:top-3.5">
	<nav
		aria-label="Main navigation"
		class="pointer-events-auto flex flex-wrap items-center justify-center gap-1 rounded-[14px] bg-paper p-1.5 font-display text-base leading-none text-ink uppercase md:text-[21px]"
	>
		<a href="/" class="rounded-[9px] bg-ink px-2.5 py-2 text-paper no-underline">
			joekarlsson.com
		</a>
		{NAV_LINKS.map(({ href, label }) => (
			<a
				href={href}
				aria-current={isActive(href) ? 'page' : undefined}
				class:list={[
					'rounded-[9px] px-2.5 py-2 no-underline',
					isActive(href) ? 'bg-pink text-ink' : 'text-ink hover:bg-ink hover:text-pink',
				]}
			>
				{label}
			</a>
		))}
		<button
			type="button"
			data-pause-motion
			aria-pressed="false"
			class="cursor-pointer rounded-[9px] bg-ink px-2.5 py-2 uppercase text-paper aria-pressed:bg-pink aria-pressed:text-ink"
		>
			Pause motion
		</button>
	</nav>
</header>
