---
import { NAV_LINKS } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
	const normalizedHref = href.replace(/\/$/, '') || '/';
	if (normalizedHref === '/') return currentPath === '/';
	return currentPath === normalizedHref || currentPath.startsWith(normalizedHref);
}
---

<!--
	One row, always. Spacing is in em, so the whole bar scales with its type: from md
	up the type shrinks until the bar (about 33.5em wide) fits the window; on phones
	it stays readable and the row scrolls sideways instead.
-->
<header class="pointer-events-none sticky top-2 z-50 flex justify-center px-2 pt-2 md:top-3.5">
	<nav
		aria-label="Main navigation"
		class="pointer-events-auto flex max-w-full items-center gap-[0.19em] overflow-x-auto rounded-[0.67em] bg-paper p-[0.29em] font-display text-base leading-none whitespace-nowrap text-ink uppercase [scrollbar-width:none] md:text-[min(21px,calc((100vw-24px)/33.5))]"
	>
		<!-- The name is the home link; on the homepage it goes pink like any current page -->
		<a
			href="/"
			aria-current={currentPath === '/' ? 'page' : undefined}
			class:list={[
				'sticker shrink-0 rounded-[0.43em] px-[0.48em] py-[0.38em] no-underline',
				currentPath === '/' ? 'bg-pink text-ink' : 'bg-ink text-paper hover:text-pink',
			]}
		>
			Joe Karlsson
		</a>
		{NAV_LINKS.map(({ href, label }) => (
			<a
				href={href}
				aria-current={isActive(href) ? 'page' : undefined}
				class:list={[
					'sticker shrink-0 rounded-[0.43em] px-[0.48em] py-[0.38em] no-underline',
					isActive(href) ? 'bg-pink text-ink' : 'text-ink hover:bg-ink hover:text-pink',
				]}
			>
				{label}
			</a>
		))}
		<!-- Pause bars while motion runs, a play triangle once paused (pause-motion.ts swaps the label) -->
		<button
			type="button"
			data-pause-motion
			aria-pressed="false"
			aria-label="Pause motion"
			title="Pause motion"
			class="sticker group shrink-0 cursor-pointer rounded-[0.43em] bg-ink p-[0.38em] text-paper hover:text-pink aria-pressed:bg-pink aria-pressed:text-ink"
		>
			<svg
				viewBox="0 0 16 16"
				class="size-[1em] group-aria-pressed:hidden"
				fill="currentColor"
				aria-hidden="true"
			>
				<rect x="3" y="2" width="3.5" height="12"></rect>
				<rect x="9.5" y="2" width="3.5" height="12"></rect>
			</svg>
			<svg
				viewBox="0 0 16 16"
				class="hidden size-[1em] group-aria-pressed:block"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M4 2 L14 8 L4 14 Z"></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	// On phones the bar scrolls sideways; start it with the current page's link centered
	const nav = document.querySelector<HTMLElement>('header nav[aria-label="Main navigation"]');
	const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
	if (nav && current && nav.scrollWidth > nav.clientWidth) {
		nav.scrollLeft = current.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2;
	}
</script>
