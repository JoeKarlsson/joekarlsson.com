---
// A line of metadata (date, reading time, category, place) with each piece set apart by
// space instead of a " · " between them. Pass plain parts, or slot your own <span>s when a
// piece is a link or a <time>, with {' '} between them. Empty parts drop out.
interface Props {
	parts?: (string | false | null | undefined)[];
	class?: string;
}

const { parts = [], class: className } = Astro.props;
---

<span class:list={['flex flex-wrap gap-x-4', className]}>
	{/* The spaces keep the pieces apart in reader view and copied text; flex drops them */}
	{parts.filter(Boolean).map((part) => (
		<>
			<span>{part}</span>{' '}
		</>
	))}
	<slot />
</span>
