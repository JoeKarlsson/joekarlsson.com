---
// The frame every article-style page shares: blog posts, reviews and talks (BlogPost.astro),
// newsletter issues and project pages. It owns the masthead, the text column with "On this
// page", and the ending, so a change to any of them reaches every page type at once
// (CLAUDE.md, "One frame for every article page"; e2e/consistency.spec.ts holds them to it).
// A template passes only what's its own: the kicker, the body, and its own "more" section.
import AuthorBio from './AuthorBio.astro';
import BackLink from './BackLink.astro';
import InlineToc from './InlineToc.astro';
import Logo from './Logo.astro';
import Masthead from './Masthead.astro';
import NewsletterAsk from './NewsletterAsk.astro';
import ShareLinks from './ShareLinks.astro';
import TableOfContents from './TableOfContents.astro';
import { PAGE_CONTAINER } from '../utils/ui';

type Heading = { slug: string; text: string; depth?: number };

interface Props {
	title: string;
	/** The section: names the back link and leads the caption (Blog, Reviews, Works...) */
	section: { name: string; path: string };
	caption?: string;
	heroImage?: string;
	heroVideo?: string;
	heroAlt?: string;
	heroWidth?: number;
	heroHeight?: number;
	halftone?: 'flat';
	/** "On this page" in the margin, shown for two or more */
	toc: Heading[];
	/** The folded list for narrow screens, shown for three or more */
	inlineToc: Heading[];
	share: { url: string; title: string; noun: string };
	ask: { blurb: string; location: string };
	/** data-* attributes for the article (analytics read them) */
	articleData?: Record<string, string | number | undefined>;
}

const {
	title,
	section,
	caption,
	heroImage,
	heroVideo,
	heroAlt,
	heroWidth,
	heroHeight,
	halftone,
	toc,
	inlineToc,
	share,
	ask,
	articleData = {},
} = Astro.props;
---

{/* How far through the article, on every article type. Phones show it in the nav bar instead (reading-context.ts) */}
<div
	id="reading-progress"
	class="fixed top-0 left-0 z-50 h-1 w-full origin-left bg-pink [scale:0_1] max-md:hidden"
	aria-hidden="true"
></div>

<div class={PAGE_CONTAINER}>
	<div>
		{/* @container: wide pictures, code and embeds size themselves to this column */}
		<article class="article-frame @container min-w-0" {...articleData}>
			<div class="post-axis">
				<BackLink href={section.path} label={section.name} />
				<Masthead
					title={title}
					label={section.name}
					caption={caption}
					heroImage={heroImage}
					heroVideo={heroVideo}
					heroAlt={heroAlt}
					width={heroWidth}
					height={heroHeight}
					halftone={halftone}
				>
					<slot name="kicker" />
				</Masthead>
			</div>
			<div class="margin-column mx-auto max-w-(--reading-width)">
				{/* Wide screens: "On this page" sticks in the left gutter (1600px+) or heads the right margin */}
				{toc.length >= 2 && <TableOfContents headings={toc} />}
				{/* Notes, credits, buttons: whatever a page puts above its text */}
				<slot name="top" />
				<InlineToc headings={inlineToc} />
				<slot />
				<!-- End mark: the article is over -->
				<Logo text="JK" class="text-paper" style="display:block;margin-top:2rem;font-size:20px" />
				<slot name="end" />
				{/* A review's more reviews come first: a reader who came for a film wants another */}
				<slot name="related" />
				<NewsletterAsk blurb={ask.blurb} location={ask.location} />
				<ShareLinks url={share.url} title={share.title} noun={share.noun} class="mt-10" />
				<AuthorBio />
				{/* Keep reading, More works, an issue's prev/next */}
				<slot name="after" />
			</div>
		</article>
	</div>
</div>

<script>
	// The desktop reading line where CSS scroll timelines aren't supported (global.css), and
	// the Scroll Depth and Reading Complete goals for every article type: filter on the path
	// (/blog/, /newsletter/, /reviews/, /work/, /talks/) to split them
	const progressEl = document.getElementById('reading-progress');
	const article = document.querySelector<HTMLElement>('article.article-frame');
	if (progressEl && article) {
		const depthMilestones = new Set<number>();
		const postTitle =
			article.dataset.postTitle || article.querySelector('h1')?.textContent?.trim() || 'Unknown';

		const trackScrollDepth = (pct: number) => {
			const plausible = window.plausible;
			if (typeof plausible !== 'function') return;
			[25, 50, 75, 100].forEach((milestone) => {
				if (pct < milestone || depthMilestones.has(milestone)) return;
				depthMilestones.add(milestone);
				plausible('Scroll Depth', { props: { depth: `${milestone}%`, post: postTitle } });
				if (milestone === 100) plausible('Reading Complete', { props: { post: postTitle } });
			});
		};

		const update = () => {
			const rect = article.getBoundingClientRect();
			const total = rect.height - window.innerHeight;
			const scrolled = -rect.top;
			const pct = Math.max(0, Math.min(100, total > 0 ? Math.round((scrolled / total) * 100) : 0));
			trackScrollDepth(pct);
			// scale, not width: no layout per scroll. CSS drives it where it can (global.css)
			if (!CSS.supports('animation-timeline: view()')) progressEl.style.scale = `${pct / 100} 1`;
		};

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
			},
			{ passive: true },
		);
		update();
	}
</script>
