---
// The bio at the end of every post, as a poster block: a pink halftone portrait
// (src/scripts/halftone.ts) beside a solid pink panel with my name in poster type
// and one live line from the now-feed snapshot, so it changes with every deploy.
import { SOCIAL_LINKS } from '../consts';
import nowFeed from '../data/now-feed.json';
import { halftoneMode } from '../utils/halftone';

const PORTRAIT = '/images/about/collage/studio.webp';

const { homelab, films } = nowFeed;
const lastFilm = films[0];
const filmStars =
	lastFilm && lastFilm.rating !== null
		? `${lastFilm.rating} ${lastFilm.rating === 1 ? 'star' : 'stars'}`
		: undefined;

const nowLine = `Right now: ${homelab.runningContainers} containers running on my homelab${
	filmStars ? `, and I just gave ${lastFilm.title} ${filmStars}.` : '.'
}`;

const SOCIALS = [
	{ label: 'Bluesky', href: SOCIAL_LINKS.bluesky },
	{ label: 'LinkedIn', href: SOCIAL_LINKS.linkedin },
	{ label: 'GitHub', href: SOCIAL_LINKS.github },
];
---

<section
	class="mt-12 grid overflow-hidden rounded-lg sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]"
	aria-label="About the author"
>
	<div class="relative min-h-[260px] bg-ink">
		<img
			src={PORTRAIT}
			alt="Joe Karlsson at his desk, chin on hand, with a microphone in front of him"
			data-halftone={halftoneMode(PORTRAIT)}
			width="900"
			height="506"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 block size-full object-cover object-[45%_30%]"
		/>
	</div>
	<div class="grid content-end gap-3.5 bg-pink p-7 text-ink">
		<p class="font-display text-[clamp(48px,6.5vw,88px)] leading-[0.9] uppercase">
			Joe
			<br />
			Karlsson
		</p>
		<p>
			Developer Marketing Engineer at CData. I write about databases, self-hosting, and the things I
			build.
		</p>
		<p class="font-semibold">{nowLine}</p>
		<p class="flex flex-wrap gap-x-4 gap-y-1 font-extrabold">
			{SOCIALS.map(({ label, href }) => (
				<a href={href} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-paper">
					{label}
				</a>
			))}
		</p>
	</div>
</section>
