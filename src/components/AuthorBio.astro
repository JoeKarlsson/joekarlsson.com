---
import { SOCIAL_LINKS } from '../consts';
import nowFeed from '../data/now-feed.json';
---

<div class="mt-10 flex items-start gap-4">
	<img
		src="/images/joe-profile.webp"
		alt="Joe Karlsson"
		width="64"
		height="64"
		class="mt-1 rounded-full"
		loading="lazy"
	/>
	<div>
		<p class="mb-1 font-bold text-white">Joe Karlsson</p>
		<p class="mb-2 text-sm text-gray-400">
			Developer Marketing Engineer at CData, leading developer growth for the managed MCP platform
			that connects AI agents to live enterprise data. Writing about databases, self-hosting, and
			the things I build. Runs a {nowFeed.homelab.runningContainers}-container Proxmox homelab with
			AI-powered automations.
		</p>
		<div class="flex gap-3 text-sm">
			<a
				href={SOCIAL_LINKS.bluesky}
				target="_blank"
				rel="noopener noreferrer"
				class="text-pink no-underline hover:text-white"
			>
				Bluesky
			</a>
			<a
				href={SOCIAL_LINKS.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="text-pink no-underline hover:text-white"
			>
				LinkedIn
			</a>
			<a
				href={SOCIAL_LINKS.github}
				target="_blank"
				rel="noopener noreferrer"
				class="text-pink no-underline hover:text-white"
			>
				GitHub
			</a>
		</div>
	</div>
</div>
