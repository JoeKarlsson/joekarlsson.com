---
// The bio at the end of every post, as a poster block: a pink halftone portrait
// (src/scripts/halftone.ts) beside a solid pink panel with my name in poster type,
// one sentence on what I write about, and a link to the About page.
import { SOCIAL_LINKS } from '../consts';
import { halftoneMode } from '../utils/halftone';

const PORTRAIT = '/images/about/collage/studio.webp';

const SOCIALS = [
	{ label: 'Bluesky', href: SOCIAL_LINKS.bluesky },
	{ label: 'LinkedIn', href: SOCIAL_LINKS.linkedin },
	{ label: 'GitHub', href: SOCIAL_LINKS.github },
];
---

<section
	class="mt-12 grid overflow-hidden rounded-lg sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]"
	aria-label="About the author"
>
	<div class="relative min-h-[260px] bg-ink">
		<img
			src={PORTRAIT}
			alt="Joe Karlsson at his desk, chin on hand, with a microphone in front of him"
			data-halftone={halftoneMode(PORTRAIT)}
			width="900"
			height="506"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 block size-full object-cover object-[45%_30%]"
		/>
	</div>
	<div class="grid content-end gap-3.5 bg-pink p-7 text-ink">
		<p class="font-display text-[clamp(44px,5vw,68px)] leading-[0.9] uppercase">
			Joe
			<br />
			Karlsson
		</p>
		<p class="text-lg">
			I write about my homelab, AI tools, databases, and the weird stuff I build on the side.
		</p>
		<!-- py-3 with matching negative margins: 44px tap targets that take no extra room -->
		<a href="/about/" class="-my-3 w-fit py-3 font-extrabold text-ink hover:text-paper">
			More about me →
		</a>
		<p class="-my-3 flex flex-wrap gap-x-4 font-extrabold">
			{SOCIALS.map(({ label, href }) => (
				<a
					href={href}
					target="_blank"
					rel="noopener noreferrer"
					class="py-3 text-ink hover:text-paper"
				>
					{label}
				</a>
			))}
		</p>
	</div>
</section>
