---
// A post's hero as a cut-paper collage that boils: the picture on a torn chalk print,
// taped at two corners, with the post's topic on a pink scrap. The paper edges wobble through the site's #boil filter and every scrap twitches a
// fraction of a degree in stepped frames, like hand-drawn animation; the picture and the
// words never distort. A work thumbnail with the taped look already has its print and tape
// in the image, so it only twitches and gets the tag. An animated thumbnail shows
// its still here (data-still-only, src/integrations/responsive-images.mjs), since the
// paper around it already boils. Still under reduced motion,
// and frozen by the pause-motion button (.motion-paused).
import { CHALK } from '../data/scribbles';

interface Props {
	src: string;
	alt: string;
	width?: number;
	height?: number;
	halftone?: 'flat' | 'dots';
	// The thumbnail already shows a taped print, so no print or tape gets drawn around it
	taped: boolean;
	topic?: string;
	// Picks this post's tear, so it keeps the same edges between builds
	seed: number;
}

const { src, alt, width, height, halftone, taped, topic, seed } = Astro.props;

// A torn edge: a point every few percent along each side, pulled inward by a random sliver.
// As shape(), the sliver is in px, so a big print and a small one tear like the same paper;
// as polygon() (browsers without shape()) it's in %, deeper on a bigger print
function tornEdge(tearSeed: number, depthPx: number, depthPct: number): string {
	let state = tearSeed;
	const random = () => {
		state = (state * 9301 + 49297) % 233280;
		return state / 233280;
	};
	const polygon: string[] = [];
	const shape: string[] = [];
	const side = (
		count: number,
		at: (t: number) => number,
		point: (along: number, px: string, pct: number) => [string, string, string],
	) => {
		for (let i = 0; i < count; i++) {
			const sliver = random();
			const [x, y, pctPoint] = point(
				at(i / count),
				`${(sliver * depthPx).toFixed(1)}px`,
				sliver * depthPct,
			);
			shape.push(`${shape.length ? 'line to' : 'from'} ${x} ${y}`);
			polygon.push(pctPoint);
		}
	};
	const pct = (n: number) => `${n.toFixed(2)}%`;
	side(
		28,
		(t) => t * 100,
		(a, px, d) => [pct(a), px, `${pct(a)} ${pct(d)}`],
	);
	side(
		16,
		(t) => t * 100,
		(a, px, d) => [`calc(100% - ${px})`, pct(a), `${pct(100 - d / 1.8)} ${pct(a)}`],
	);
	side(
		28,
		(t) => 100 - t * 100,
		(a, px, d) => [pct(a), `calc(100% - ${px})`, `${pct(a)} ${pct(100 - d)}`],
	);
	side(
		16,
		(t) => 100 - t * 100,
		(a, px, d) => [px, pct(a), `${pct(d / 1.8)} ${pct(a)}`],
	);
	return `--tear:polygon(${polygon.join(',')});--tear-shape:shape(${shape.join(',')},close)`;
}
---

<div class="paper-hero">
	<div class:list={['ph-print', taped && 'ph-taped']}>
		{!taped && <span class="ph-scrap" style={`background:${CHALK};${tornEdge(seed, 7, 1.4)}`} />}
		{/* Drawn in pink by src/scripts/halftone.ts */}
		<img
			src={src}
			data-still-only
			data-halftone={halftone}
			alt={alt}
			class="ph-picture"
			width={width}
			height={height}
			sizes="(min-width: 1280px) 856px, 100vw"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
	{!taped && (
		<>
			<span class="ph-tape ph-tape-top" aria-hidden="true" />
			<span class="ph-tape ph-tape-bottom" aria-hidden="true" />
		</>
	)}
	{topic && (
		<span class="ph-tag" aria-hidden="true">
			<span class="ph-scrap" style={`${tornEdge(seed + 7, 6, 9)}`} />
			<span class="ph-words">{topic}</span>
		</span>
	)}
	<slot />
</div>

<script>
	import '../scripts/paper-hero-boil';
	import { initPaperHeroDrag } from '../scripts/paper-hero-drag';

	document.querySelectorAll<HTMLElement>('.paper-hero').forEach(initPaperHeroDrag);
</script>

<style>
	.paper-hero {
		position: relative;
		margin-bottom: 2.5rem;
		padding: 1.5% 2% 3.5%;
	}
	.ph-print {
		--tilt: -1.1deg;
		position: relative;
		padding: clamp(6px, 1.4cqi, 14px);
		transform: rotate(var(--tilt));
	}
	/* The baked print is already tilted inside its picture */
	.ph-print.ph-taped {
		--tilt: 0deg;
		padding: 0;
	}
	.ph-scrap {
		position: absolute;
		inset: 0;
		clip-path: var(--tear);
	}
	@supports (clip-path: shape(from 0 0, line to 1px 0, close)) {
		.ph-scrap {
			clip-path: var(--tear-shape);
		}
	}
	.ph-picture {
		position: relative;
		display: block;
		width: 100%;
		max-height: 440px;
		object-fit: cover;
	}
	.ph-tape {
		position: absolute;
		width: 15%;
		height: 6.5%;
		min-height: 14px;
		background: #d6cebe;
	}
	.ph-tape-top {
		--tilt: -32deg;
		left: -0.5%;
		top: 1%;
		transform: rotate(var(--tilt));
	}
	.ph-tape-bottom {
		--tilt: -30deg;
		right: 0;
		bottom: 4.5%;
		transform: rotate(var(--tilt));
	}
	.ph-tag {
		position: absolute;
		display: grid;
		color: #000;
		--tilt: 3deg;
		right: 4%;
		bottom: 0;
		transform: rotate(var(--tilt));
	}
	/* Draggable (src/scripts/paper-hero-drag.ts): a held piece lifts over the others. Mouse
	   and pen only: on a phone a swipe starting on the tape still scrolls the page */
	@media (pointer: fine) {
		.ph-tape,
		.ph-tag {
			cursor: grab;
			touch-action: none;
			user-select: none;
			-webkit-user-select: none;
		}
	}
	:is(.ph-tape, .ph-tag)[data-held] {
		z-index: 2;
		cursor: grabbing;
		scale: 1.06;
	}
	@media (prefers-reduced-motion: no-preference) {
		.ph-tape,
		.ph-tag {
			transition: scale 0.12s var(--ease-enter);
		}
	}
	.ph-tag .ph-scrap {
		background: #ff4fd8;
	}
	.ph-tag .ph-words {
		font-family: Anton, Impact, sans-serif;
		font-size: clamp(18px, 4.4cqi, 44px);
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		padding: 0.35em 0.6em 0.3em;
	}
	.ph-words {
		position: relative;
		white-space: nowrap;
	}

	/* The boil: paper edges through #boil (as the diagrams' paper does), and each scrap
	   twitching through three poses on the same half-second cycle. Words stay still. Only
	   once src/scripts/paper-hero-boil.ts adds .is-boiling: never on a phone, a slow
	   connection or a device that can't keep up, under reduced motion or while paused. */
	.is-boiling :is(.ph-scrap, .ph-tape) {
		filter: url(#boil);
	}
	.is-boiling :is(.ph-print, .ph-tape, .ph-tag) {
		animation: ph-twitch 0.5s steps(1, end) infinite;
	}
	.is-boiling .ph-tape-top {
		animation-delay: -0.17s;
	}
	.is-boiling .ph-tag {
		animation-delay: -0.33s;
	}
	@keyframes ph-twitch {
		0% {
			transform: rotate(var(--tilt));
		}
		33.3% {
			transform: rotate(calc(var(--tilt) + 0.3deg));
		}
		66.6% {
			transform: rotate(calc(var(--tilt) - 0.25deg));
		}
	}
</style>
