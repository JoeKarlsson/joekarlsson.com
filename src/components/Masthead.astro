---
// The top of every post-layout page: posts, reviews, talks (BlogPost.astro) and newsletter
// issues (DECISIONS.md, round 4 C). A kicker line between a pink rule and a thin one (the
// default slot, usually MetaParts), the title fitted to the column (utils/masthead.ts), then
// the picture or video with no tilt or tape, and the description as its italic caption.
import { joinLastWord } from '../plugins/rehype-no-widows.mjs';
import { mastheadFontSize, mastheadLineInset, mastheadLines } from '../utils/masthead';

interface Props {
	title: string;
	/** The section the caption names first: Blog, Reviews, Talks, Newsletter */
	label: string;
	caption?: string;
	heroImage?: string;
	heroVideo?: string;
	heroAlt?: string;
	width?: number;
	height?: number;
	halftone?: 'flat';
}

const { title, label, caption, heroImage, heroVideo, heroAlt, width, height, halftone } =
	Astro.props;
const lines = mastheadLines(title);
// A portrait photo (some newsletter card photos) is cropped to 16:9 like every other masthead,
// so on a phone it doesn't fill the first screen before any text
const portrait = Boolean(width && height && height > width);
---

<header class="masthead mb-10">
	<p class="masthead-kicker">
		<slot />
	</p>
	<h1 class="masthead-title" style={`font-size:${mastheadFontSize(lines)}`}>
		{lines.map((line) => (
			<>
				<span style={`margin-inline-start:${mastheadLineInset(line)}`}>
					{/* balance would break REAL- / TIME at its hyphen; keep such words whole */}
					{line
						.split(/(\S+-\S+)/)
						.map((part, i) => (i % 2 ? <span class="whitespace-nowrap">{part}</span> : part))}
				</span>{' '}
			</>
		))}
	</h1>
	{/* controls on the video for the same WCAG 2.2.2 reason as rehype-gif-video;
	in-view-play starts it, so a remembered pause or reduced motion keeps it still.
	preload="none": a phone shows the poster (data-phone-still), and iPhone Safari pulled
	the whole clip at load for "metadata" (406 KB on connect-ai-doom) */}
	{heroVideo ? (
		<video
			src={heroVideo}
			data-halftone={halftone}
			poster={heroImage}
			data-autoplay-in-view
			data-phone-still
			loop
			muted
			playsinline
			controls
			preload="none"
			aria-label={heroAlt || title}
			data-morph-target
			class="mx-auto h-auto max-h-[min(75vh,640px)] w-full max-w-[856px] object-cover"
			width={width ?? 768}
			height={height ?? 440}
		/>
	) : (
		heroImage && (
			<img
				src={heroImage}
				alt={heroAlt || title}
				data-still-only
				data-halftone={halftone}
				data-morph-target
				width={width}
				height={height}
				sizes="(min-width: 1024px) 856px, 100vw"
				loading="eager"
				fetchpriority="high"
				class:list={[
					'mx-auto h-auto max-h-[min(75vh,640px)] w-full max-w-[856px] object-cover',
					portrait && 'aspect-video',
				]}
			/>
		)
	)}
	{caption && (
		<p class="masthead-caption">
			<b>{label}</b> {joinLastWord(caption)}
		</p>
	)}
</header>
