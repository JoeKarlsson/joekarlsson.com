---
import nowFeed from '../data/now-feed.json';

interface Props {
	columns?: 2 | 4;
}

const { columns = 4 } = Astro.props;
// Live counts from the snapshot scripts/update-now-feed.mjs writes on every deploy
const { homelab } = nowFeed;
const gridClass =
	columns === 2 ? 'grid gap-8 sm:grid-cols-2' : 'grid gap-8 sm:grid-cols-2 lg:grid-cols-4';
---

<div class={gridClass}>
	<div>
		<h3 class="mb-1 font-display text-2xl font-normal text-paper uppercase">Working on</h3>
		<p class="text-sm text-muted">
			Leading developer marketing at <strong class="text-paper">CData</strong>, growing the MCP
			platform that connects AI agents to enterprise data
		</p>
	</div>
	<div>
		<h3 class="mb-1 font-display text-2xl font-normal text-paper uppercase">Tinkering with</h3>
		<p class="text-sm text-muted">
			A <strong class="text-paper">{homelab.runningContainers}-container homelab</strong> on{' '}
			{homelab.proxmoxNodes} Proxmox nodes ({homelab.cpuThreads} CPU threads, {homelab.memoryGB} GB
			of RAM) running Home Assistant and the arr stack
		</p>
	</div>
	<div>
		<h3 class="mb-1 font-display text-2xl font-normal text-paper uppercase">Writing about</h3>
		<p class="text-sm text-muted">
			<a href="/blog/">Self-hosting, databases, smart home, and AI tools</a>
		</p>
	</div>
	<div>
		<h3 class="mb-1 font-display text-2xl font-normal text-paper uppercase">Using</h3>
		<p class="text-sm text-muted">
			M5 Max MacBook Pro, VS Code, two monitors. <a href="/uses/">See my full setup &rarr;</a>
		</p>
	</div>
</div>
