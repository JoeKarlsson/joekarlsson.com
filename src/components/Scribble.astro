---
// A crayon scribble (paths in src/data/scribbles.ts). By default it draws itself
// in, holds, then erases on a slow loop (.redraw in src/styles/motion.css);
// `ring` instead draws it only while its .index-row is hovered or focused. The
// crayon texture is the #crayon filter defined once in BaseLayout. Decorative,
// so hidden from assistive tech.
interface Props {
	path: string;
	color: string;
	class?: string;
	viewBox?: string;
	strokeWidth?: number;
	ring?: boolean;
	// Loop length and start delay, e.g. '10s'
	duration?: string;
	delay?: string;
}

const {
	path,
	color,
	class: className,
	viewBox = '0 0 900 300',
	strokeWidth = 8,
	ring = false,
	duration = '7s',
	delay = '0s',
} = Astro.props;
---

<svg
	class:list={[
		ring ? 'hover-ring' : 'redraw',
		'pointer-events-none absolute overflow-visible',
		className,
	]}
	style={ring ? undefined : `--dur:${duration};--del:${delay}`}
	viewBox={viewBox}
	preserveAspectRatio="none"
	aria-hidden="true"
>
	<g
		fill="none"
		stroke={color}
		stroke-width={strokeWidth}
		stroke-linecap="round"
		stroke-linejoin="round"
		filter="url(#crayon)"
	>
		<path pathLength="1" d={path}></path>
	</g>
</svg>
