---
// A crayon scribble (paths in src/data/scribbles.ts). By default it draws itself
// in, holds, then erases on a slow loop (.redraw in src/styles/motion.css);
// `ring` instead draws it only while its .ring-host is hovered or focused
// (index rows, and cards through src/components/HoverBox.astro). The
// crayon texture is the #crayon filter defined once in BaseLayout. Decorative,
// so hidden from assistive tech.
import { RINGS } from '../data/scribbles';
import { compactPath } from '../utils/compact-path';
interface Props {
	path: string;
	color: string;
	class?: string;
	viewBox?: string;
	strokeWidth?: number;
	ring?: boolean;
	// Stretch the mark to fill its box. Only for marks that trace a target's size: an
	// underline the width of a heading, a box round a picture (MARKS sets it for those,
	// and hover rings always stretch). Every other mark keeps its own proportions and
	// scales to fit its box, so a coil or burst never squashes when a phone changes the
	// box's shape.
	stretch?: boolean;
	// Loop length and start delay, e.g. '10s'
	duration?: string;
	delay?: string;
}

const {
	path,
	color,
	class: className,
	viewBox = '0 0 900 300',
	strokeWidth = 8,
	ring = false,
	stretch = false,
	duration = '7s',
	delay = '0s',
} = Astro.props;

// A mark made of several strokes (a tally, rays, hatching) is one path with a move
// per stroke. SVG dashes restart on every move, so drawn as one path all the
// strokes would appear at once. Split them, and draw them one after another.
const strokes = path
	.split(/(?=M)/)
	.map((stroke) => stroke.trim())
	.filter(Boolean)
	.map(compactPath);
const oneStrokeAtATime = !ring && strokes.length > 1;
// Hover rings are defined once in BaseLayout (#hover-ring-N) and drawn with <use>:
// a full copy per row was a fifth of /uses' HTML
const ringIndex = ring ? RINGS.indexOf(path) : -1;
if (ring && ringIndex < 0) throw new Error('Scribble: a ring must be one of RINGS');
// A hover mark stretches over boxes of any shape, so its line keeps strokeWidth in
// screen pixels instead of thickening on tall cards (vector-effect on its BaseLayout path)
---

<svg
	class:list={[
		ring ? 'hover-ring' : oneStrokeAtATime ? 'redraw-strokes' : 'redraw',
		'pointer-events-none absolute overflow-visible',
		className,
	]}
	style={ring ? undefined : `--dur:${duration};--del:${delay};--n:${strokes.length}`}
	viewBox={viewBox}
	preserveAspectRatio={ring || stretch ? 'none' : 'xMidYMid meet'}
	aria-hidden="true"
>
	<g
		fill="none"
		stroke={color}
		stroke-width={strokeWidth}
		stroke-linecap="round"
		stroke-linejoin="round"
		filter="url(#crayon)"
	>
		{ring ? (
			<use href={`#hover-ring-${ringIndex}`} />
		) : (
			strokes.map((d, i) => (
				<path pathLength="1" d={d} style={oneStrokeAtATime ? `--i:${i}` : undefined} />
			))
		)}
	</g>
</svg>
