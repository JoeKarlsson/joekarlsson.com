---
// The "← Blog" link above a sub-page's title, back to the section it belongs to.
// The label is the section's name in the main nav.
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<nav class="mb-3 text-sm" aria-label="Breadcrumb">
	<!-- A 44px-tall tap target; -my-3 hands back the extra height so the page doesn't move -->
	<a
		href={href}
		class="-my-3 inline-flex min-h-11 items-center text-muted no-underline hover:text-pink"
	>
		← {label}
	</a>
</nav>
