---
// The "Keep exploring" block at the bottom of About, Resume and Projects: the title as
// a pink stacked echo (the footer's effect, src/styles/motion.css) filling the column,
// then the same pages everywhere, minus the one you're on, as huge index rows with one
// line about each.
import IndexRow from './IndexRow.astro';

const TITLE = 'Keep exploring';

const PAGES = [
	{ href: '/blog/', label: 'Blog', blurb: 'Posts on homelab, AI, web dev and my career.' },
	{ href: '/about/', label: 'About', blurb: "Who I am and what I've worked on." },
	{ href: '/resume/', label: 'Resume', blurb: 'My work history, also as a PDF.' },
	{ href: '/work/', label: 'Projects', blurb: "Software, hardware and IoT things I've built." },
	{
		href: '/talk-archive/',
		label: 'Talks',
		blurb: 'Conference talks, workshops and podcasts since 2019.',
	},
	{
		href: '/newsletter/',
		label: 'Newsletter',
		blurb: 'Works on My Machine: tech writing, AI, homelab and open source.',
	},
	{ href: '/uses/', label: 'Uses', blurb: 'The hardware, software and gear I use every day.' },
];

const here = Astro.url.pathname.replace(/\/?$/, '/');
const pages = PAGES.filter(({ href }) => href !== here);
---

<section class="mt-20 mb-12 @container">
	<!-- "KEEP EXPLORING" is about 6.1em wide in Anton caps, so this fills the column -->
	<h2
		class="echo mb-8 font-display text-[calc(100cqw/6.15)] whitespace-nowrap text-pink uppercase"
		style="--echo-fill:#ff4fd8;--echo-stroke:#ff4fd8"
	>
		<span class="sr-only">{TITLE}</span>
		{[0, 1, 2, 3, 4].map((index) => (
			<span aria-hidden="true" style={`--echo-index:${index}`}>
				{TITLE}
			</span>
		))}
	</h2>
	{pages.map(({ href, label, blurb }, i) => (
		<IndexRow href={href} label={label} meta={blurb} index={i} />
	))}
</section>
