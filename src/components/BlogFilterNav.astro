---
// A row of blog filter links with post counts: categories (/blog/category/) or who
// the posts were written for (/blog/written-for/). The current one is pink and
// underlined. `allLink` adds a leading "All" back to /blog/.
import type { CategoryCount } from '../utils/categories';
import { FILTER_ACTIVE, FILTER_INACTIVE, FILTER_ROW } from '../utils/ui';

interface Props {
	label: string;
	items: CategoryCount[];
	basePath: '/blog/category/' | '/blog/written-for/';
	currentSlug?: string;
	allLink?: boolean;
	// Shown before the links, e.g. "Written for"
	heading?: string;
	class?: string;
}

const {
	label,
	items,
	basePath,
	currentSlug,
	allLink = false,
	heading,
	class: className,
} = Astro.props;
---

<nav class:list={[FILTER_ROW, className]} aria-label={label}>
	{heading && <span class="text-muted">{heading}</span>}
	{allLink && (
		<a
			href="/blog/"
			class={currentSlug ? FILTER_INACTIVE : FILTER_ACTIVE}
			aria-current={currentSlug ? undefined : 'page'}
		>
			All
		</a>
	)}
	{items.map(({ name, slug, count }) => (
		<a
			href={`${basePath}${slug}/`}
			class={slug === currentSlug ? FILTER_ACTIVE : FILTER_INACTIVE}
			aria-current={slug === currentSlug ? 'page' : undefined}
		>
			{name} <span class="text-muted">{count}</span>
		</a>
	))}
</nav>
