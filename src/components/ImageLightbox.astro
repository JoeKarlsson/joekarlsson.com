---
// Click (or Enter on) a picture in a post to see its full-size file filling the
// screen. Click anywhere, the Close button or Escape to go back.
import { SECONDARY_BUTTON } from '../utils/ui';
---

<dialog
	id="image-lightbox"
	aria-label="Enlarged image"
	class="m-0 h-dvh max-h-none w-dvw max-w-none cursor-zoom-out bg-ink p-4 backdrop:bg-ink sm:p-8"
>
	<button type="button" class={`${SECONDARY_BUTTON} fixed top-4 right-4 z-10 bg-ink`}>
		Close
	</button>
	<img alt="" class="size-full object-contain" />
</dialog>

<script>
	const dialog = document.getElementById('image-lightbox') as HTMLDialogElement | null;
	const enlarged = dialog?.querySelector('img');
	if (dialog && enlarged) {
		dialog.addEventListener('click', () => dialog.close());
		dialog.addEventListener('close', () => enlarged.removeAttribute('src'));

		const open = (img: HTMLImageElement) => {
			// The original file: the srcset copies stop at 1200px
			enlarged.src = img.getAttribute('src')!;
			enlarged.alt = img.alt;
			dialog.showModal();
		};

		// Only pictures whose file is bigger than they're shown, and not ones that are
		// links or part of an embed
		document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
			const fileWidth = Number(img.getAttribute('width'));
			if (img.closest('a, .prose .\\@container') || !(fileWidth > img.clientWidth + 40)) return;
			img.classList.add('cursor-zoom-in');
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', `Enlarge image: ${img.alt}`);
			img.addEventListener('click', () => open(img));
			img.addEventListener('keydown', (event) => {
				if (event.key !== 'Enter' && event.key !== ' ') return;
				event.preventDefault();
				open(img);
			});
		});
	}
</script>
