---
// One group of /featured/'s ledger rows (year, outlet, title, note), newest first, undated last.
// Built on my work and the press lists below it share it, so every group reads the same.
import { joinLastWord } from '../plugins/rehype-no-widows.mjs';
import { type CoverageKind, coverage } from '../data/coverage';
import { GROUP_HEADING } from '../utils/ui';

interface Props {
	kind: CoverageKind;
	heading: string;
}

const { kind, heading } = Astro.props;
const entries = coverage
	.filter((entry) => entry.kind === kind)
	.sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
---

<section class="mb-12 max-w-4xl md:mb-16">
	<h2 class:list={[GROUP_HEADING, 'mb-3']}>{heading}</h2>
	<ul>
		{entries.map((entry) => (
			<li class="border-t border-surface-4 last:border-b">
				<a
					href={entry.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-1 py-3 text-paper no-underline md:grid-cols-[4rem_13rem_1fr_9rem] md:items-baseline"
				>
					<span class="text-sm font-semibold text-muted tabular-nums max-md:row-span-3">
						{entry.date?.slice(0, 4)}
					</span>
					<span class="font-semibold">{entry.outlet}</span>
					<span class="font-serif text-lg leading-snug group-hover:text-pink">
						{joinLastWord(entry.title)}
					</span>
					<span class="text-sm font-semibold text-muted md:text-right">{entry.note}</span>
				</a>
			</li>
		))}
	</ul>
</section>
