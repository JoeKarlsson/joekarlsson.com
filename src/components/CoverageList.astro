---
// /featured/'s ledger rows (year, outlet, title, note). The papers, Built on my work and the
// press lists below all use it, so every list reads the same. Rows come in the order given:
// papers by how notable the venue is, the rest newest first.
import { joinLastWord } from '../plugins/rehype-no-widows.mjs';
import type { Coverage } from '../data/coverage';
import { GROUP_HEADING } from '../utils/ui';

interface Props {
	rows: (Omit<Coverage, 'kind'> & { cites?: string })[];
	heading?: string;
	// h3 inside the Built on my work section, h2 for the lists that stand on their own
	level?: 'h2' | 'h3';
}

const { rows, heading, level: Heading = 'h2' } = Astro.props;
// An id, so the heading can be linked to (and copies its link when clicked, heading-links.ts)
const id = heading
	?.toLowerCase()
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '');
---

<section class="mb-12 max-w-4xl md:mb-16">
	{heading && (
		<Heading id={id} class:list={[GROUP_HEADING, 'mb-3 w-fit']}>
			{heading}
		</Heading>
	)}
	<ul>
		{rows.map((row) => (
			<li class="border-t border-surface-4 last:border-b">
				<a
					href={row.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-1 py-3 text-paper no-underline md:grid-cols-[4rem_13rem_1fr_9rem] md:items-baseline"
				>
					<span class="text-sm font-semibold text-muted tabular-nums max-md:row-span-3">
						{row.date?.slice(0, 4)}
					</span>
					<span class="font-semibold">{row.outlet}</span>
					<span class="font-serif text-lg leading-snug">
						<span class="group-hover:text-pink">{joinLastWord(row.title)}</span>
						{row.cites && (
							<span class="mt-1 block font-sans text-sm font-semibold text-muted">
								Cites {row.cites}.
							</span>
						)}
					</span>
					<span class="text-sm font-semibold text-muted md:text-right">{row.note}</span>
				</a>
			</li>
		))}
	</ul>
</section>
