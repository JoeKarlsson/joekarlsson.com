---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { NAV_LINKS, SITE_TITLE, SITE_URL, SOCIAL_LINKS } from '../consts';
import { DEFAULT_OG_IMAGE, ogJpegPath } from '../utils/og-image';
import { jsonForScript } from '../utils/json-for-script';

interface Props {
	title: string;
	description: string;
	image?: string;
	// Describes the share image; falls back to the title for pages without one
	imageAlt?: string;
	type?: string;
	publishedDate?: Date;
	modifiedDate?: Date;
	schemaType?: string;
	keywords?: string[];
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	canonicalUrl?: string;
	// Keep the page reachable but out of search results (e.g. the TL;DR in Tech back issues)
	noindex?: boolean;
	// The section an article sits in, for its breadcrumb: the blog unless it says otherwise
	section?: { name: string; path: string };
	// VideoObject nodes for the videos on the page (src/utils/video-schema.ts)
	videoObjects?: Record<string, unknown>[];
}

const {
	title,
	description,
	image = DEFAULT_OG_IMAGE,
	imageAlt,
	type = 'website',
	publishedDate,
	modifiedDate,
	schemaType,
	keywords,
	wordCount,
	faq,
	howToSteps,
	canonicalUrl,
	noindex = false,
	section = { name: 'Blog', path: '/blog/' },
	videoObjects = [],
} = Astro.props;

// Use provided canonical URL for syndicated content, otherwise generate from current path
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);

// The Markdown copy src/integrations/markdown-pages.mjs writes for agents: /about/ -> /about.md
const markdownURL = new URL(
	Astro.url.pathname === '/' ? '/index.md' : Astro.url.pathname.replace(/\/$/, '.md'),
	Astro.site,
);
const ogImageURL = new URL(ogJpegPath(image), Astro.site);
// Link previews already show the site name, so drop the " | Joe Karlsson" suffix there
const socialTitle = title.replace(` | ${SITE_TITLE}`, '');
// Joe's profiles elsewhere: rel="me" links (IndieWeb and Mastodon identity checks) and
// the Person's sameAs in the JSON-LD below
const PROFILE_URLS = [
	SOCIAL_LINKS.github,
	SOCIAL_LINKS.linkedin,
	SOCIAL_LINKS.bluesky,
	SOCIAL_LINKS.youtube,
	SOCIAL_LINKS.threads,
	SOCIAL_LINKS.instagram,
	SOCIAL_LINKS.letterboxd,
	SOCIAL_LINKS.facebook,
];

// Same-origin pages only, minus feeds, the Markdown copies for agents and downloads
// The nav's sections left to right, each as the paths it covers: page changes slide by them
const navSections = NAV_LINKS.map(({ href, also = [] }) => [href, ...also]);
const SPECULATION_TARGETS = {
	and: [
		{ href_matches: '/*' },
		{ not: { href_matches: ['/*.xml', '/*.md', '/*.pdf', '/*.txt', '/cdn-cgi/*'] } },
	],
};
const SPECULATION_RULES = {
	prefetch: [{ where: SPECULATION_TARGETS, eagerness: 'moderate' }],
	prerender: [{ where: SPECULATION_TARGETS, eagerness: 'conservative' }],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta
	name="robots"
	content={
		noindex
			? 'noindex, follow'
			: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
	}
/>

<!-- Fonts: all four are self-hosted (astro.config.mjs), so no visitor IP goes to Google;
the display and body faces are preloaded since nearly every page opens with both.
Only the latin files: latin-ext still loads when a page has those characters. -->
<Font cssVariable="--font-anton" preload={[{ subset: 'latin' }]} />
<Font cssVariable="--font-hanken-grotesk" preload={[{ subset: 'latin' }]} />
<Font cssVariable="--font-jetbrains-mono" />
<Font cssVariable="--font-fraunces" />

<!-- Favicon. Bump ?v= when the icons change: browsers and Cloudflare hold on to old favicons.
public/favicon.ico has no tag: RSS readers and older clients fetch /favicon.ico directly -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#000000" />
<!-- The site is dark-only. Declaring it stops phone browsers (Samsung Internet, Chrome auto-dark) from inverting it when the phone is in dark mode -->
<meta name="color-scheme" content="only dark" />
<!-- Dark Reader (and the iOS browsers built on it, Firefox and Brave) ignores color-scheme and re-darkens the site anyway, turning paper boxes brown -->
<meta name="darkreader-lock" />
<!-- Home-screen bookmarks on iOS: the name under the icon, a black status bar in
standalone mode, and no auto-linking of numbers like "72-container" as phone numbers -->
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<meta name="format-detection" content="telephone=no" />

<!-- Identity -->
{PROFILE_URLS.map((url) => (
	<link rel="me" href={url} />
))}

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title="Works on My Machine by Joe Karlsson (newsletter)"
	href={new URL('newsletter/rss.xml', Astro.site)}
/>

<!-- SEO -->
<link rel="canonical" href={canonicalURL} />
{!noindex && <link rel="alternate" type="text/markdown" href={markdownURL} />}
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Joe Karlsson" />

<!-- Search engine verification (preserved from WordPress) -->
<meta name="google-site-verification" content="QRPrUDjca6IhevyDBOqQCygKZqp45Xyrr2HZooS1LSE" />
<meta name="msvalidate.01" content="BA95135B22E369C003B007BEE5ECC2F2" />
<meta name="p:domain_verify" content="9557bed697f311b040f7e3c0f2c7c503" />
<meta name="yandex-verification" content="993d1db38acd907f" />

<!-- Open Graph -->
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<!-- Always a 1200x630 JPEG from src/pages/og/ (tests/build-output.test.ts checks every page) -->
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt || socialTitle} />
{type === 'article' && (
	<meta property="article:author" content="https://www.joekarlsson.com/about/" />
)}
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{type === 'article' && keywords?.[0] && <meta property="article:section" content={keywords[0]} />}
{type === 'article' && keywords?.map((tag) => <meta property="article:tag" content={tag} />)}
{type === 'profile' && (
	<>
		<meta property="profile:first_name" content="Joe" />
		<meta property="profile:last_name" content="Karlsson" />
		<meta property="profile:username" content="joekarlsson" />
	</>
)}
{type === 'article' && (
	<meta property="article:publisher" content="https://www.facebook.com/joe.karlsson13" />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt || socialTitle} />
<meta name="twitter:site" content="@joekarlsson1" />
<meta name="twitter:creator" content="@joekarlsson1" />

<!-- Fetch the next page while the pointer rests on its link (about 200ms), and render it
in the background on press, so a click lands on a page that's ready. Leaves out feeds, the
Markdown copies for agents and downloads. -->
<script is:inline type="speculationrules" set:html={jsonForScript(SPECULATION_RULES)} />
<!-- JSON-LD Structured Data -->
<script
	is:inline
	type="application/ld+json"
	set:html={jsonForScript({
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'WebSite',
				'@id': `${SITE_URL}/#website`,
				url: SITE_URL,
				name: SITE_TITLE,
				description: 'Developer Marketing Engineer.',
				publisher: { '@id': `${SITE_URL}/#/schema/person` },
				inLanguage: 'en-US',
			},
			{
				'@type': 'Person',
				'@id': `${SITE_URL}/#/schema/person`,
				name: 'Joe Karlsson',
				url: SITE_URL,
				jobTitle: 'Developer Marketing Engineer',
				worksFor: {
					'@type': 'Organization',
					name: 'CData',
				},
				description:
					'Joe Karlsson is a Developer Marketing Engineer. TEDx Speaker, film buff, and homelab enthusiast.',
				image: {
					'@type': 'ImageObject',
					url: `${SITE_URL}/images/joe-headshot.webp`,
					contentUrl: `${SITE_URL}/images/joe-headshot.webp`,
				},
				sameAs: PROFILE_URLS,
			},
			...(type === 'article' && publishedDate
				? [
						{
							'@type': 'BlogPosting',
							'@id': `${canonicalURL}#article`,
							headline: socialTitle,
							description: description,
							image: {
								'@type': 'ImageObject',
								url: ogImageURL.toString(),
								width: 1200,
								height: 630,
							},
							datePublished: publishedDate.toISOString(),
							...(modifiedDate ? { dateModified: modifiedDate.toISOString() } : {}),
							...(keywords && keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
							...(wordCount ? { wordCount } : {}),
							author: { '@id': `${SITE_URL}/#/schema/person` },
							publisher: { '@id': `${SITE_URL}/#/schema/person` },
							mainEntityOfPage: {
								'@type': 'WebPage',
								'@id': canonicalURL.toString(),
							},
							inLanguage: 'en-US',
						},
					]
				: []),
			...(type === 'article'
				? [
						{
							'@type': 'BreadcrumbList',
							itemListElement: [
								{
									'@type': 'ListItem',
									position: 1,
									name: 'Home',
									item: SITE_URL,
								},
								{
									'@type': 'ListItem',
									position: 2,
									name: section.name,
									item: `${SITE_URL}${section.path}`,
								},
								{
									'@type': 'ListItem',
									position: 3,
									name: socialTitle,
								},
							],
						},
					]
				: []),
			...(schemaType && type !== 'article'
				? [
						{
							'@type': schemaType,
							'@id': canonicalURL.toString(),
							url: canonicalURL.toString(),
							name: title,
							description: description,
							isPartOf: { '@id': `${SITE_URL}/#website` },
							about: { '@id': `${SITE_URL}/#/schema/person` },
							inLanguage: 'en-US',
						},
					]
				: []),
			...(faq && faq.length > 0
				? [
						{
							'@type': 'FAQPage',
							mainEntity: faq.map((item) => ({
								'@type': 'Question',
								name: item.question,
								acceptedAnswer: {
									'@type': 'Answer',
									text: item.answer,
								},
							})),
						},
					]
				: []),
			...(howToSteps && howToSteps.length > 0
				? [
						{
							'@type': 'HowTo',
							name: title,
							description: description,
							step: howToSteps.map((s, i) => ({
								'@type': 'HowToStep',
								position: i + 1,
								name: s.name,
								text: s.text,
							})),
						},
					]
				: []),
			...videoObjects,
		],
	})}
/>
<!-- Hides img and video[data-halftone] until src/scripts/halftone.ts draws it in pink, so the
color original never flashes; that script takes the class off again without WebGL -->
<script is:inline>
	document.documentElement.classList.add('halftone-on');
	// Keeps "Pause motion" on across pages (src/scripts/pause-motion.ts writes it).
	// Set before paint, so nothing starts moving and then stops. Storage can be blocked.
	try {
		if (localStorage.getItem('motion-paused') === '1') {
			document.documentElement.classList.add('motion-paused');
		}
	} catch {
		// Not remembered; motion runs until paused on this page
	}
</script>
<!-- Page changes are cross-document View Transitions (motion.css). The nav bar holds still
while the page slides the way you're going: toward a section further right in the nav, or
deeper into one, it comes in from the right; Back plays it in reverse. A thumbnail grows into
the header of the page it opens, and shrinks back on the way back. Keep exploring's links turn
the next page in like a sheet of paper. Inline in the head: pagereveal fires before the
page's own scripts run. -->
<script is:inline define:vars={{ navSections }}>
	(function () {
		const NAME = 'morph-hero';
		const paused = function () {
			return document.documentElement.classList.contains('motion-paused');
		};
		// A skipped or superseded transition rejects with an AbortError, which is expected;
		// anything else still surfaces as an unhandled rejection
		const ignoreAbort = function (error) {
			if (error.name !== 'AbortError') throw error;
		};
		const skip = function (transition) {
			transition.ready.catch(ignoreAbort);
			transition.skipTransition();
		};
		// Storage can be blocked: then nothing is remembered and pages just slide
		const load = function (key) {
			try {
				return sessionStorage.getItem(key);
			} catch {
				return null;
			}
		};
		const save = function (key, value) {
			try {
				if (value === null) sessionStorage.removeItem(key);
				else sessionStorage.setItem(key, value);
			} catch {
				// Not remembered
			}
		};

		// Home (the logo) is left of every section; a page outside the nav has no section
		const sectionOf = function (path) {
			if (path === '/') return -1;
			const index = navSections.findIndex(function (paths) {
				return paths.some(function (prefix) {
					return path.startsWith(prefix);
				});
			});
			return index < 0 ? null : index;
		};
		const depth = function (path) {
			return path.split('/').filter(Boolean).length;
		};
		// A link click is back when it heads left in the nav, or up within a section
		const linkGoesBack = function (from, to) {
			const a = sectionOf(from);
			const b = sectionOf(to);
			if (a !== null && b !== null && a !== b) return b < a;
			return depth(to) < depth(from);
		};
		// Back in history plays the click that came here in reverse; Forward replays it
		const goesBack = function (activation, from, to) {
			if (activation.navigationType !== 'traverse') return linkGoesBack(from, to);
			return activation.entry.index < activation.from.index
				? !linkGoesBack(to, from)
				: linkGoesBack(from, to);
		};
		// A Keep exploring click notes where it's going; the pair is kept so Back and Forward
		// between the same two pages turn the page too
		document.addEventListener('click', function (event) {
			const link = event.target.closest && event.target.closest('[data-page-turn] a[href]');
			const newTab = event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
			if (link && !newTab) save('page-turn', link.pathname);
		});
		const pairs = function () {
			return JSON.parse(load('page-turns') || '[]');
		};
		const turnsPage = function (activation, from, to, back, turningTo) {
			if (activation.navigationType !== 'traverse') return turningTo === to;
			return pairs().includes(back ? to + ' ' + from : from + ' ' + to);
		};

		// The first matching element on screen: a page can carry the same picture twice (a
		// phone and a desktop copy, a project both selected and in the index)
		const onScreen = function (selector) {
			return Array.prototype.find.call(document.querySelectorAll(selector), function (element) {
				const box = element.getBoundingClientRect();
				return box.width > 0 && box.bottom > 0 && box.top < innerHeight;
			});
		};
		const pictureFor = function (path) {
			return onScreen('[data-morph="' + path + '"]');
		};
		const morph = function (element, transition) {
			element.style.viewTransitionName = NAME;
			transition.finished
				.finally(function () {
					element.style.viewTransitionName = '';
				})
				.catch(ignoreAbort);
		};

		// Leaving: forward, name the thumbnail of the page being opened; back, name this
		// page's header so it shrinks into the thumbnail it came from
		addEventListener('pageswap', function (event) {
			const transition = event.viewTransition;
			if (!transition) return;
			if (paused()) return skip(transition);
			// The old page names its own picture below: the header rule would give a second
			// element the same name and the browser would cancel the transition, and with no
			// Navigation API (Safari before 26) the header would fade alone in place
			transition.types.delete('morph');
			const activation = event.activation;
			save('morph-to', null);
			if (!activation || !activation.entry.url) return;
			const from = location.pathname;
			const to = new URL(activation.entry.url).pathname;
			const back = goesBack(activation, from, to);
			// The old page needs the slide's type too, so it names the nav bar (motion.css)
			transition.types.add(back ? 'back' : 'forward');
			if (turnsPage(activation, from, to, back, load('page-turn'))) return;
			const element = back ? onScreen('[data-morph-target]') : pictureFor(to);
			if (!element) return;
			morph(element, transition);
			save('morph-to', to);
		});
		// A page restored by Back can be frozen before its transition's cleanup ran; a name
		// left on its thumbnail would clash with the next one and cancel that transition
		addEventListener('pageshow', function (event) {
			if (!event.persisted) return;
			document.querySelectorAll('[data-morph]').forEach(function (element) {
				element.style.viewTransitionName = '';
			});
		});
		// Arriving: pick the slide, and keep the header morph only when the page left named
		// a picture for it
		addEventListener('pagereveal', function (event) {
			// Read once and cleared before anything can return, so a note left by an
			// unfinished trip never turns some later page
			const turningTo = load('page-turn');
			const morphedTo = load('morph-to');
			save('page-turn', null);
			save('morph-to', null);
			const transition = event.viewTransition;
			if (!transition) return;
			if (paused()) return skip(transition);
			// Safari before 26 has View Transitions but no Navigation API: a plain crossfade,
			// with no header growing out of nothing
			const activation = window.navigation && navigation.activation;
			if (!activation || !activation.from || !activation.from.url) {
				transition.types.delete('morph');
				return;
			}
			const from = new URL(activation.from.url).pathname;
			const here = location.pathname;
			const back = goesBack(activation, from, here);
			transition.types.add(back ? 'back' : 'forward');
			if (turnsPage(activation, from, here, back, turningTo)) {
				transition.types.add('turn');
				if (activation.navigationType !== 'traverse') {
					save(
						'page-turns',
						JSON.stringify(
							pairs()
								.concat(from + ' ' + here)
								.slice(-20),
						),
					);
				}
			}
			const morphed = morphedTo === here;
			// Forward, the header's name comes from motion.css, since Safari reveals the page
			// before it's parsed. Back, this page names the thumbnail it was opened from, and
			// the header rule must stay off or a related card's header could share its name
			if (!morphed || back || transition.types.has('turn')) transition.types.delete('morph');
			if (morphed && back && !transition.types.has('turn')) {
				const picture = pictureFor(from);
				if (picture) morph(picture, transition);
			}
		});
	})();
</script>
<!-- Plausible Analytics (self-hosted) - with bot filtering -->
<script is:inline>
	(function () {
		// Skip analytics for bots and headless browsers
		if (
			navigator.webdriver || // Headless Chrome, Puppeteer, Playwright
			/bot|crawl|spider|scrape|headless/i.test(navigator.userAgent) ||
			!navigator.languages ||
			navigator.languages.length === 0
		) {
			return;
		}
		const PLAUSIBLE_SCRIPT =
			'https://plausible.joekarlsson.io/js/script.tagged-events.outbound-links.file-downloads.js';
		// Trusted Types (src/integrations/script-csp.mjs): this one URL is the only script
		// the site loads at runtime, so the policy passes it and nothing else
		const policy = window.trustedTypes?.createPolicy('plausible', {
			createScriptURL: (url) => {
				if (url !== PLAUSIBLE_SCRIPT) throw new TypeError(`Not the Plausible script: ${url}`);
				return url;
			},
		});
		const s = document.createElement('script');
		s.defer = true;
		s.dataset.domain = 'joekarlsson.com';
		s.src = policy ? policy.createScriptURL(PLAUSIBLE_SCRIPT) : PLAUSIBLE_SCRIPT;
		document.head.appendChild(s);

		// Report the first uncaught error on a page as a "JS Error" event, so breakage on
		// the live site shows up in Plausible. One per page keeps a looping error from flooding it.
		let reported = false;
		const report = (message, source) => {
			if (reported || typeof window.plausible !== 'function') return;
			reported = true;
			window.plausible('JS Error', {
				props: { message: String(message).slice(0, 200), source, path: location.pathname },
			});
		};
		addEventListener('error', (e) => report(e.message, `${e.filename}:${e.lineno}`));
		addEventListener('unhandledrejection', (e) => report(e.reason, 'promise'));
		// The script policy (src/integrations/script-csp.mjs) blocks quietly; this says what
		addEventListener('securitypolicyviolation', (e) =>
			report(`${e.violatedDirective} ${e.blockedURI} ${e.sample}`, 'csp'),
		);
	})();
</script>
