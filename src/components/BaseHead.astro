---
import '../styles/global.css';
import { SITE_TITLE, SITE_URL } from '../consts';
import { DEFAULT_OG_IMAGE, ogJpegPath } from '../utils/og-image';

interface Props {
	title: string;
	description: string;
	image?: string;
	// Describes the share image; falls back to the title for pages without one
	imageAlt?: string;
	type?: string;
	publishedDate?: Date;
	modifiedDate?: Date;
	schemaType?: string;
	keywords?: string[];
	wordCount?: number;
	faq?: { question: string; answer: string }[];
	howToSteps?: { name: string; text: string }[];
	canonicalUrl?: string;
	// Keep the page reachable but out of search results (e.g. the TL;DR in Tech back issues)
	noindex?: boolean;
}

const {
	title,
	description,
	image = DEFAULT_OG_IMAGE,
	imageAlt,
	type = 'website',
	publishedDate,
	modifiedDate,
	schemaType,
	keywords,
	wordCount,
	faq,
	howToSteps,
	canonicalUrl,
	noindex = false,
} = Astro.props;

// Use provided canonical URL for syndicated content, otherwise generate from current path
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);

const ogImageURL = new URL(ogJpegPath(image), Astro.site);
// Link previews already show the site name, so drop the " | Joe Karlsson" suffix there
const socialTitle = title.replace(` | ${SITE_TITLE}`, '');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta
	name="robots"
	content={
		noindex
			? 'noindex, follow'
			: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
	}
/>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Anton&family=Fraunces:opsz,wght@9..144,400..700&family=Hanken+Grotesk:wght@400..900&family=JetBrains+Mono:wght@400;500;700&display=swap"
/>

<!-- Favicon. Bump ?v= when the icons change: browsers and Cloudflare hold on to old favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#000000" />

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title="Works on My Machine by Joe Karlsson (newsletter)"
	href={new URL('newsletter/rss.xml', Astro.site)}
/>

<!-- SEO -->
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{type === 'article' && <meta name="author" content="Joe Karlsson" />}

<!-- Search engine verification (preserved from WordPress) -->
<meta name="google-site-verification" content="QRPrUDjca6IhevyDBOqQCygKZqp45Xyrr2HZooS1LSE" />
<meta name="msvalidate.01" content="BA95135B22E369C003B007BEE5ECC2F2" />
<meta name="p:domain_verify" content="9557bed697f311b040f7e3c0f2c7c503" />
<meta name="yandex-verification" content="993d1db38acd907f" />

<!-- Open Graph -->
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt || socialTitle} />
{type === 'article' && (
	<meta property="article:author" content="https://www.joekarlsson.com/about/" />
)}
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{type === 'article' && (
	<meta property="article:publisher" content="https://www.facebook.com/joe.karlsson13" />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt || socialTitle} />
<meta name="twitter:site" content="@joekarlsson1" />
<meta name="twitter:creator" content="@joekarlsson1" />

<!-- JSON-LD Structured Data -->
<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'WebSite',
				'@id': `${SITE_URL}/#website`,
				url: SITE_URL,
				name: SITE_TITLE,
				description: 'Developer Marketing Engineer.',
				publisher: { '@id': `${SITE_URL}/#/schema/person` },
				inLanguage: 'en-US',
			},
			{
				'@type': 'Person',
				'@id': `${SITE_URL}/#/schema/person`,
				name: 'Joe Karlsson',
				url: SITE_URL,
				jobTitle: 'Developer Marketing Engineer',
				worksFor: {
					'@type': 'Organization',
					name: 'CData',
				},
				description:
					'Joe Karlsson is a Developer Marketing Engineer. TEDx Speaker, film buff, and homelab enthusiast.',
				image: {
					'@type': 'ImageObject',
					url: `${SITE_URL}/images/joe-profile.webp`,
					contentUrl: `${SITE_URL}/images/joe-profile.webp`,
				},
				sameAs: [
					'https://www.joekarlsson.com',
					'https://www.facebook.com/joe.karlsson13',
					'https://www.instagram.com/joekarlsson/',
					'https://www.linkedin.com/in/joekarlsson/',
					'https://bsky.app/profile/joekarlsson.com',
					'https://www.youtube.com/joekarlsson',
					'https://github.com/JoeKarlsson',
					'https://www.threads.net/@joekarlsson',
					'https://letterboxd.com/joekarlsson/',
				],
			},
			...(type === 'article' && publishedDate
				? [
						{
							'@type': 'BlogPosting',
							headline: title,
							description: description,
							image: ogImageURL.toString(),
							datePublished: publishedDate.toISOString(),
							...(modifiedDate ? { dateModified: modifiedDate.toISOString() } : {}),
							...(keywords && keywords.length > 0 ? { keywords: keywords.join(', ') } : {}),
							...(wordCount ? { wordCount } : {}),
							author: { '@id': `${SITE_URL}/#/schema/person` },
							publisher: { '@id': `${SITE_URL}/#/schema/person` },
							mainEntityOfPage: {
								'@type': 'WebPage',
								'@id': canonicalURL.toString(),
							},
							inLanguage: 'en-US',
						},
					]
				: []),
			...(type === 'article'
				? [
						{
							'@type': 'BreadcrumbList',
							itemListElement: [
								{
									'@type': 'ListItem',
									position: 1,
									name: 'Home',
									item: SITE_URL,
								},
								{
									'@type': 'ListItem',
									position: 2,
									name: 'Blog',
									item: `${SITE_URL}/blog/`,
								},
								{
									'@type': 'ListItem',
									position: 3,
									name: title,
								},
							],
						},
					]
				: []),
			...(schemaType && type !== 'article'
				? [
						{
							'@type': schemaType,
							'@id': canonicalURL.toString(),
							url: canonicalURL.toString(),
							name: title,
							description: description,
							isPartOf: { '@id': `${SITE_URL}/#website` },
							about: { '@id': `${SITE_URL}/#/schema/person` },
							inLanguage: 'en-US',
						},
					]
				: []),
			...(faq && faq.length > 0
				? [
						{
							'@type': 'FAQPage',
							mainEntity: faq.map((item) => ({
								'@type': 'Question',
								name: item.question,
								acceptedAnswer: {
									'@type': 'Answer',
									text: item.answer,
								},
							})),
						},
					]
				: []),
			...(howToSteps && howToSteps.length > 0
				? [
						{
							'@type': 'HowTo',
							name: title,
							description: description,
							step: howToSteps.map((s, i) => ({
								'@type': 'HowToStep',
								position: i + 1,
								name: s.name,
								text: s.text,
							})),
						},
					]
				: []),
		],
	})}
/>
<!-- Hides img and video[data-halftone] until src/scripts/halftone.ts draws it in pink, so the
color original never flashes; that script takes the class off again without WebGL -->
<script is:inline>
	document.documentElement.classList.add('halftone-on');
	// Keeps "Pause motion" on across pages (src/scripts/pause-motion.ts writes it).
	// Set before paint, so nothing starts moving and then stops. Storage can be blocked.
	try {
		if (localStorage.getItem('motion-paused') === '1') {
			document.documentElement.classList.add('motion-paused');
		}
	} catch {
		// Not remembered; motion runs until paused on this page
	}
</script>
<!-- Plausible Analytics (self-hosted) - with bot filtering -->
<script is:inline>
	(function () {
		// Skip analytics for bots and headless browsers
		if (
			navigator.webdriver || // Headless Chrome, Puppeteer, Playwright
			/bot|crawl|spider|scrape|headless/i.test(navigator.userAgent) ||
			!navigator.languages ||
			navigator.languages.length === 0
		) {
			return;
		}
		const s = document.createElement('script');
		s.defer = true;
		s.dataset.domain = 'joekarlsson.com';
		s.src =
			'https://plausible.joekarlsson.io/js/script.tagged-events.outbound-links.file-downloads.js';
		document.head.appendChild(s);
	})();
</script>
