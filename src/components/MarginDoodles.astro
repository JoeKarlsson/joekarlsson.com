---
// Joe's sketchbook doodles down the empty side margins of wide screens, like notes in
// a notebook's margin. Placed by a random walk seeded from the page's path, so each
// page has its own arrangement and keeps it between builds: uneven gaps, both sides,
// different sizes and tilts. Each draws in once when scrolled to (the offscreen pause
// in pause-offscreen-scribbles.ts holds it until then) and stays. Only from 1600px
// up, where the margins beside the 72rem column are at least 224px. Decorative.
import Scribble from './Scribble.astro';
import { CHALK, MARKS } from '../data/scribbles';

const PINK = '#ff4fd8';
// Width in px of each doodle in the margin; height follows its viewBox
const DOODLES = [
	{ mark: MARKS.face, width: 118 },
	{ mark: MARKS.spiral, width: 78 },
	{ mark: MARKS.flower, width: 104 },
	{ mark: MARKS.star, width: 70 },
	{ mark: MARKS.cloud, width: 96 },
	{ mark: MARKS.devil, width: 84 },
	{ mark: MARKS.bolt, width: 46 },
	{ mark: MARKS.asterisk, width: 42 },
	{ mark: MARKS.burstDense, width: 62 },
	{ mark: MARKS.tally, width: 96 },
];
// Room for the longest pages; the script below drops any that don't fit
const SLOTS = 30;
const FIRST_TOP = 180;

/** mulberry32: a small seeded random, so a page's layout is the same every build. */
function seededRandom(seed: number) {
	return () => {
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const random = seededRandom(
	[...Astro.url.pathname].reduce((sum, c) => (sum * 31 + c.charCodeAt(0)) | 0, 7),
);
const order = DOODLES.map((d) => ({ d, key: random() }))
	.sort((a, b) => a.key - b.key)
	.map(({ d }) => d);

let top = FIRST_TOP + random() * 160;
let side: 'left' | 'right' = random() < 0.5 ? 'left' : 'right';
const placed = Array.from({ length: SLOTS }, (_, i) => {
	const { mark, width } = order[i % order.length];
	const [, , vbWidth, vbHeight] = mark.viewBox.split(' ').map(Number);
	// Sizes swing by a third either way, so a repeat never matches its first showing
	const w = Math.round(width * (0.85 + random() * 0.65));
	const h = Math.round((w * vbHeight) / vbWidth);
	const tilt = Math.round((random() - 0.5) * 30);
	// Off the gutter's middle by up to 50px
	const nudge = Math.round((random() - 0.5) * 100);
	const doodle = {
		mark,
		color: random() < 0.55 ? CHALK : PINK,
		bottom: Math.round(top + h),
		style: `top:${Math.round(top)}px;${side}:calc((100% - 72rem) / 4 - ${w / 2}px + ${nudge}px);width:${w}px;height:${h}px;transform:rotate(${tilt}deg)`,
	};
	top += h + 220 + random() * 460;
	// Mostly alternate, sometimes two on one side
	if (random() < 0.75) side = side === 'left' ? 'right' : 'left';
	return doodle;
});
---

<div
	class="margin-doodles pointer-events-none absolute inset-0 hidden overflow-hidden min-[1600px]:block"
	aria-hidden="true"
>
	{placed.map(({ mark, color, style, bottom }) => (
		<div class="absolute" style={style} data-bottom={bottom}>
			<Scribble
				{...mark}
				color={color}
				strokeWidth={6}
				once
				duration="9s"
				class="inset-0 size-full"
			/>
		</div>
	))}
</div>

<script>
	// Drop doodles that would run past the end of the page's content, instead of
	// letting the overflow clip them in half. Rechecked as images load and the page grows.
	const layer = document.querySelector<HTMLElement>('.margin-doodles');
	if (layer) {
		const fit = () => {
			for (const doodle of layer.children as HTMLCollectionOf<HTMLElement>) {
				// From its markup, not offsetTop: a hidden doodle measures 0 and would flip back on
				doodle.hidden = Number(doodle.dataset.bottom) > layer.clientHeight - 40;
			}
		};
		fit();
		new ResizeObserver(fit).observe(layer);
	}
</script>
