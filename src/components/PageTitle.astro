---
// The top of a page without a PosterHero (a blog category, who posts were written for,
// Privacy): an optional "← Section" link, the page's name in huge Anton with a pink
// crayon underline, and an optional gray line under it. The default slot adds more
// marks to the title.
import BackLink from './BackLink.astro';
import Scribble from './Scribble.astro';
import { MARKS } from '../data/scribbles';

interface Props {
	title: string;
	back?: { href: string; label: string };
	summary?: string;
}

const { title, back, summary } = Astro.props;
---

<header class="relative mb-10">
	{back && <BackLink href={back.href} label={back.label} />}
	<h1 class="relative inline-block font-display text-[clamp(56px,11vw,170px)] leading-[0.88] font-normal text-paper uppercase">
		{title}
		<Scribble
			{...MARKS.underline}
			color="#ff4fd8"
			strokeWidth={10}
			duration="8s"
			delay="0.4s"
			class="-bottom-[0.12em] left-0 h-[0.18em] w-full"
		/>
		<slot />
	</h1>
	{summary && <p class="mt-6 text-muted">{summary}</p>}
</header>
