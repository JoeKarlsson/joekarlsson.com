---
interface Props {
	// Absolute URL to submit; crossposts and recaps pass their canonical so HN dedupes against it
	url: string;
	title: string;
	// What the reader just finished: "post", "project", "issue"
	noun: string;
	class?: string;
}

const { url, title, noun, class: className } = Astro.props;
const hackerNewsSubmitUrl = `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}`;
---

<p class:list={['text-sm text-gray-400', className]}>
	If you liked this {noun}, consider{' '}
	<a
		href={hackerNewsSubmitUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="plausible-event-name=Hacker+News+Share+Click underline hover:text-coral"
	>
		sharing it on Hacker News
	</a>
	.
</p>
