---
// "Make a mark": a dark board with pre-drawn crayon marks that redraw on a loop,
// where visitors scribble in pink or chalk and their strokes erase themselves.
// Purely decorative, so it's hidden from assistive tech and keyboard focus.
// Off on phones, where it took a screen of scrolling for a toy. A mouse draws whenever
// it moves over the board. On a touch screen (a tablet) a swipe across it
// scrolls the page, until a crayon is tapped: that turns drawing on (data-drawing),
// the board stops scrolling and strokes go any direction, and Done turns it off.
import { BOARD_MARKS, CHALK, MARKS } from '../data/scribbles';
import Scribble from './Scribble.astro';

interface Props {
	// The board's heading (the homepage's "Make a mark", the 404's own)
	title?: string;
	// Size and spacing around the board
	class?: string;
}

const { title = 'Make a mark', class: className = 'mx-4 mt-20 min-h-[72svh]' } = Astro.props;
const PINK = '#ff4fd8';
---

<div
	class:list={[
		'drawing-board relative cursor-crosshair rounded-xl bg-surface-1 max-md:hidden',
		className,
	]}
	aria-hidden="true"
>
	<p class="absolute top-6 left-7 font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-none text-paper uppercase">
		{title}
		<span class="relative ml-2 inline-block size-[1em] align-top">
			<Scribble
				{...MARKS.burstDense}
				color={PINK}
				strokeWidth={7}
				duration="7s"
				delay="0.5s"
				class="inset-0 size-full"
			/>
		</span>
	</p>
	<!-- z-10 lifts the crayons over the drawing pad below, which covers the whole board -->
	<div class="absolute right-6 bottom-6 z-10 flex items-center gap-2.5 sm:top-7 sm:bottom-auto">
		<!-- Touch screens only (styles below): a nudge until drawing is on, then a way out -->
		<span class="board-hint font-semibold text-paper">Tap a crayon to draw</span>
		<button
			type="button"
			tabindex="-1"
			data-board-done
			class="board-done sticker min-h-11 cursor-pointer rounded-md bg-paper px-4 font-semibold text-ink"
		>
			Done
		</button>
		{[
			{ color: PINK, label: 'Pink' },
			{ color: CHALK, label: 'Chalk' },
		].map(({ color, label }, i) => (
			<button
				type="button"
				tabindex="-1"
				data-crayon={color}
				aria-pressed={i === 0 ? 'true' : 'false'}
				aria-label={label}
				class="sticker size-[34px] cursor-pointer rounded-full border-[3px] border-transparent aria-pressed:border-paper pointer-coarse:size-11"
				style={`background:${color}`}
			/>
		))}
	</div>
	{BOARD_MARKS.map(({ color, path }, i) => (
		<Scribble
			path={path}
			color={color === 'pink' ? PINK : CHALK}
			viewBox="0 0 1400 620"
			strokeWidth={6}
			duration="11s"
			delay={`${(i * 1.7).toFixed(1)}s`}
			class="inset-0 size-full"
		/>
	))}
	<!-- Joe's sketchbook doodles, placed by hand so they read like a page of his book:
	different sizes and tilts, uneven gaps, nothing lined up. They draw in once, staggered,
	and stay (the board's own marks keep looping). -->
	{[
		{
			mark: MARKS.face,
			color: CHALK,
			delay: '0.6s',
			class: 'top-[34%] left-[7%] h-[40%] w-[17%] -rotate-[6deg]',
		},
		{
			mark: MARKS.star,
			color: PINK,
			delay: '2.1s',
			class: 'top-[21%] left-[38%] h-[21%] w-[11%] rotate-[14deg]',
		},
		{
			mark: MARKS.spiral,
			color: CHALK,
			delay: '3.9s',
			class: 'top-[60%] left-[31%] h-[27%] w-[13%] -rotate-[11deg]',
		},
		{
			mark: MARKS.flower,
			color: PINK,
			delay: '1.4s',
			class: 'top-[33%] left-[49%] h-[46%] w-[19%] rotate-[9deg]',
		},
		{
			mark: MARKS.cloud,
			color: CHALK,
			delay: '3.1s',
			class: 'top-[16%] left-[73%] h-[38%] w-[18%] rotate-[4deg]',
		},
	].map(({ mark, color, delay, class: placement }) => (
		<Scribble
			{...mark}
			color={color}
			strokeWidth={5}
			once
			duration="11s"
			delay={delay}
			class={placement}
		/>
	))}
	<!-- Runs off the board's bottom edge into the next section -->
	<Scribble
		{...MARKS.lines}
		color={PINK}
		duration="12s"
		delay="4s"
		class="right-[4%] -bottom-[70px] z-10 h-[120px] w-[46%]"
	/>
	<svg class="drawing-board-pad absolute inset-0 size-full">
		<g fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#crayon)"></g>
	</svg>
</div>

<style>
	.board-hint,
	.board-done {
		display: none;
	}
	@media (pointer: coarse) {
		.drawing-board:not([data-drawing]) .board-hint {
			display: inline;
		}
		.drawing-board[data-drawing] .board-done {
			display: inline-flex;
			align-items: center;
		}
	}
	/* While drawing, a finger on the board draws instead of scrolling the page */
	.drawing-board[data-drawing] .drawing-board-pad {
		touch-action: none;
	}
</style>

<script>
	import { initDrawingBoard } from '../scripts/drawing-board';
	document.querySelectorAll<HTMLElement>('.drawing-board').forEach(initDrawingBoard);
</script>
