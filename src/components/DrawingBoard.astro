---
// "Make a mark": a dark board with pre-drawn crayon marks that redraw on a loop,
// where visitors scribble in pink or chalk and their strokes erase themselves.
// Purely decorative, so it's hidden from assistive tech and keyboard focus.
// Touch only draws while pressed, so swiping across it still scrolls the page.
import { BOARD_MARKS, CHALK, MARKS } from '../data/scribbles';
import Scribble from './Scribble.astro';

interface Props {
	// The board's heading (the homepage's "Make a mark", the 404's own)
	title?: string;
	// Size and spacing around the board
	class?: string;
}

const { title = 'Make a mark', class: className = 'mx-4 mt-20 min-h-[72vh]' } = Astro.props;
const PINK = '#ff4fd8';
---

<div
	class:list={['drawing-board relative cursor-crosshair rounded-xl bg-surface-1', className]}
	aria-hidden="true"
>
	<p class="absolute top-6 left-7 font-display text-[clamp(40px,5vw,72px)] leading-none text-paper uppercase">
		{title}
		<span class="relative ml-2 inline-block size-[1em] align-top">
			<Scribble
				{...MARKS.burstDense}
				color={PINK}
				strokeWidth={7}
				duration="7s"
				delay="0.5s"
				class="inset-0 size-full"
			/>
		</span>
	</p>
	<div class="absolute right-6 bottom-6 flex gap-2.5 sm:top-7 sm:bottom-auto">
		{[
			{ color: PINK, label: 'Pink' },
			{ color: CHALK, label: 'Chalk' },
		].map(({ color, label }, i) => (
			<button
				type="button"
				tabindex="-1"
				data-crayon={color}
				aria-pressed={i === 0 ? 'true' : 'false'}
				aria-label={label}
				class="size-[34px] cursor-pointer rounded-full border-[3px] border-transparent aria-pressed:border-paper"
				style={`background:${color}`}
			/>
		))}
	</div>
	{BOARD_MARKS.map(({ color, path }, i) => (
		<Scribble
			path={path}
			color={color === 'pink' ? PINK : CHALK}
			viewBox="0 0 1400 620"
			strokeWidth={6}
			duration="11s"
			delay={`${(i * 1.7).toFixed(1)}s`}
			class="inset-0 size-full"
		/>
	))}
	<!-- Runs off the board's bottom edge into the next section -->
	<Scribble
		{...MARKS.lines}
		color={PINK}
		duration="12s"
		delay="4s"
		class="right-[4%] -bottom-[70px] z-10 h-[120px] w-[46%]"
	/>
	<svg class="drawing-board-pad absolute inset-0 size-full touch-pan-y">
		<g fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#crayon)"></g>
	</svg>
</div>

<script>
	import { initDrawingBoard } from '../scripts/drawing-board';
	document.querySelectorAll<HTMLElement>('.drawing-board').forEach(initDrawingBoard);
</script>
