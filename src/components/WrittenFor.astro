---
// "Written for CloudQuery": which employer a professional post was written for,
// linking to every post written for them. Renders nothing for a personal post.
import { categorySlug } from '../utils/categories';

interface Props {
	employer?: string;
}

const { employer } = Astro.props;
---

{employer && (
	<a
		href={`/blog/written-for/${categorySlug(employer)}/`}
		class="font-semibold text-pink no-underline hover:text-white"
	>
		Written for {employer}
	</a>
)}
