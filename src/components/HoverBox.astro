---
// The loose crayon box every hoverable card draws around its picture on hover
// or keyboard focus: the same box and placement as the one around the
// homepage's newest post. Put it inside the positioned element that holds the
// picture; the nearest ancestor with the `ring-host` class is what triggers it
// (.ring-host in src/styles/motion.css). `featured` sits it tighter around a
// big hero card.
import { CHALK, MARKS } from '../data/scribbles';
import Scribble from './Scribble.astro';

interface Props {
	featured?: boolean;
}

const { featured = false } = Astro.props;
---

<Scribble
	{...MARKS.box}
	color={CHALK}
	strokeWidth={5}
	ring
	class={featured ? '-inset-[4%] z-10 h-[108%] w-[108%]' : '-inset-[8%] z-10 h-[116%] w-[116%]'}
/>
