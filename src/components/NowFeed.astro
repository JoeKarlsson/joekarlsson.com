---
import HoverBox from './HoverBox.astro';
import Scribble from './Scribble.astro';
import { CHALK, RINGS } from '../data/scribbles';
import { GROUP_HEADING } from '../utils/ui';
// Recently shipped repos, watched films and podcast episodes, from the snapshot
// that scripts/update-now-feed.mjs writes on every deploy. Posters and covers are
// never diagrams, so the pink dots never invert them, however light they are.
import nowFeed from '../data/now-feed.json';

const { shippingWindowDays, shippedRepos, films, podcastEpisodes } = nowFeed;

// 10px cells with a 2px gap
const ACTIVITY_CELL_STEP = 12;
// The title of a linked item reads as a link before hover: underlined in pink,
// turning pink when its card (`group`) is hovered or focused
const LINK_TITLE =
	'text-paper underline decoration-pink underline-offset-4 group-hover:text-pink group-focus-visible:text-pink';
// Solid steps from dark gray to hot pink. Empty days stay visible so the strip
// reads as 30 days, not a few dots.
function activityColor(commitCount: number) {
	if (commitCount === 0) return '#262626';
	if (commitCount < 5) return '#5c2350';
	if (commitCount < 20) return '#a8388f';
	return '#ff4fd8';
}

function ratingStars(rating: number) {
	return '★'.repeat(Math.floor(rating)) + (rating % 1 ? '½' : '');
}
---

<div class="mt-6">
	{shippedRepos.length > 0 && (
		<>
			<h3 class={`mb-4 ${GROUP_HEADING}`}>Recently shipped</h3>
			<div class="mb-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
				{shippedRepos.map((repo, i) => (
					<a
						href={repo.url}
						target="_blank"
						rel="noopener noreferrer"
						class="plausible-event-name=Now+Feed+Click plausible-event-source=github ring-host group flex flex-col no-underline"
					>
						{/* The repo name is the headline: what I'm building. It stays on one line and
						shrinks to fit the card when it's long, at about 0.5em per letter in Anton caps */}
						<div class="@container flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-surface-4 pt-2">
							<p
								class="relative inline-block w-fit font-display leading-[0.98] whitespace-nowrap text-paper uppercase group-hover:text-pink group-focus-visible:text-pink"
								style={`font-size:min(clamp(34px,4vw,56px),calc(100cqw / ${repo.name.length * 0.5}))`}
								data-repo-name
							>
								{repo.name}
								<Scribble
									path={RINGS[i % RINGS.length]}
									color={i % 2 ? CHALK : '#ff4fd8'}
									viewBox="0 0 520 150"
									strokeWidth={7}
									ring
									class="-top-[22%] -left-[35px] h-[150%] w-[calc(100%+70px)]"
								/>
							</p>
							{repo.language && (
								<p class="flex items-center gap-1 text-sm text-muted">
									<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
										<circle cx="4" cy="4" r="4" fill="#ff4fd8" />
									</svg>
									{repo.language}
								</p>
							)}
						</div>
						{repo.description && <p class="mt-2 text-paper">{repo.description}</p>}
						<p class="mt-1 text-sm text-muted">Latest commit: {repo.latestCommitMessage}</p>
						{/* Pinned to the bottom so the strips line up across a row */}
						<div class="mt-auto pt-3">
							<svg
								width="100%"
								viewBox={`0 0 ${repo.dailyCommitCounts.length * ACTIVITY_CELL_STEP - 2} 10`}
								role="img"
								aria-label={`Commits per day over the last ${shippingWindowDays} days, oldest first: ${repo.dailyCommitCounts.join(', ')}`}
							>
								{repo.dailyCommitCounts.map((count, index) => (
									<rect
										x={index * ACTIVITY_CELL_STEP}
										width="10"
										height="10"
										rx="2"
										fill={activityColor(count)}
									/>
								))}
							</svg>
							<p class="mt-2 text-sm text-muted">
								{repo.commitCount} commits in the last {shippingWindowDays} days
							</p>
						</div>
					</a>
				))}
			</div>
		</>
	)}

	<h3 class={`mb-4 ${GROUP_HEADING}`}>Recently watched</h3>
	<div class="grid gap-6 grid-cols-2 sm:grid-cols-4">
		{films.map((film, i) => (
			<div>
				<a
					href={film.url}
					target="_blank"
					rel="noopener noreferrer"
					class="plausible-event-name=Now+Feed+Click plausible-event-source=letterboxd ring-host group block no-underline"
				>
					<span class="relative mb-2 block">
						<img
							src={film.poster}
							alt={`Poster for ${film.title} (${film.year})`}
							width="200"
							height="300"
							loading="lazy"
							data-halftone="flat"
							data-halftone-no-invert
							class="block w-full rounded-lg"
						/>
						<HoverBox index={i} />
					</span>
					<p class="text-sm font-semibold">
						<span class={LINK_TITLE}>{film.title}</span> <span class="text-muted">{film.year}</span>
					</p>
				</a>
				{film.rating !== null && (
					<p class="text-sm text-pink" aria-label={`Rated ${film.rating} out of 5`}>
						{ratingStars(film.rating)}
					</p>
				)}
				{film.reviewExcerpt && <p class="mt-1 text-sm text-muted">{film.reviewExcerpt}</p>}
			</div>
		))}
	</div>

	<h3 class={`mt-10 mb-4 ${GROUP_HEADING}`}>Recently listened</h3>
	<div class="grid gap-6 sm:grid-cols-2">
		{podcastEpisodes.map((episode) => {
			const content = (
				<>
					<img
						src={episode.cover}
						alt={`Cover art for ${episode.podcastTitle}`}
						width="48"
						height="48"
						loading="lazy"
						data-halftone="flat"
						data-halftone-no-invert
						class="h-12 w-12 shrink-0 rounded-lg object-cover"
					/>
					<div>
						<p class:list={['text-sm font-semibold', episode.url ? LINK_TITLE : 'text-paper']}>
							{episode.episodeTitle}
						</p>
						<p class="text-sm text-muted">{episode.podcastTitle}</p>
					</div>
				</>
			);
			return (
				<div>
					{episode.url ? (
						<a
							href={episode.url}
							target="_blank"
							rel="noopener noreferrer"
							class="plausible-event-name=Now+Feed+Click plausible-event-source=podcast group relative flex items-center gap-3 no-underline"
						>
							{content}
						</a>
					) : (
						<div class="relative flex items-center gap-3">{content}</div>
					)}
				</div>
			);
		})}
	</div>
</div>
