---
// Recently shipped repos, watched films and podcast episodes, from the snapshot
// that scripts/update-now-feed.mjs writes on every deploy.
import nowFeed from '../data/now-feed.json';

const { updatedAt, shippingWindowDays, shippedRepos, films, podcastEpisodes } = nowFeed;

// Linguist's colors, as GitHub shows them; anything unlisted gets a neutral gray.
const LANGUAGE_COLORS: Record<string, string> = {
	Astro: '#ff5a03',
	CSS: '#663399',
	Go: '#00add8',
	HTML: '#e34c26',
	JavaScript: '#f1e05a',
	Metal: '#8f14e9',
	Python: '#3572a5',
	Rust: '#dea584',
	Shell: '#89e051',
	Swift: '#f05138',
	TypeScript: '#3178c6',
};
function languageColor(language: string) {
	return LANGUAGE_COLORS[language] ?? '#9ca3af';
}

// 10px cells with a 2px gap
const ACTIVITY_CELL_STEP = 12;
// Empty days stay faintly visible so the strip reads as 30 days, not a few dots.
function activityOpacity(commitCount: number) {
	if (commitCount === 0) return 0.12;
	if (commitCount < 5) return 0.4;
	if (commitCount < 20) return 0.7;
	return 1;
}

function ratingStars(rating: number) {
	return '★'.repeat(Math.floor(rating)) + (rating % 1 ? '½' : '');
}

const formattedUpdatedAt = new Date(`${updatedAt}T00:00:00Z`).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<div class="mt-6">
	{shippedRepos.length > 0 && (
		<>
			<p class="mb-3 font-mono text-xs text-gray-400">recently shipped</p>
			<div class="mb-8 grid gap-4 sm:grid-cols-2">
				{shippedRepos.map((repo) => (
					<a
						href={repo.url}
						target="_blank"
						rel="noopener noreferrer"
						class="plausible-event-name=Now+Feed+Click plausible-event-source=github group block rounded-lg border border-surface-3 bg-surface-1 p-4 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-coral/30"
					>
						<div class="flex items-center justify-between gap-2">
							<p class="font-mono text-sm font-semibold text-white group-hover:text-coral">
								{repo.name}
							</p>
							{repo.language && (
								<p class="flex items-center gap-1 text-xs text-gray-400">
									<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
										<circle cx="4" cy="4" r="4" fill={languageColor(repo.language)} />
									</svg>
									{repo.language}
								</p>
							)}
						</div>
						{repo.description && (
							<p class="mt-1 text-xs leading-snug text-gray-400">{repo.description}</p>
						)}
						<svg
							class="mt-3 text-coral"
							width="100%"
							viewBox={`0 0 ${repo.dailyCommitCounts.length * ACTIVITY_CELL_STEP - 2} 10`}
							role="img"
							aria-label={`Commits per day over the last ${shippingWindowDays} days, oldest first: ${repo.dailyCommitCounts.join(', ')}`}
						>
							{repo.dailyCommitCounts.map((count, index) => (
								<rect
									x={index * ACTIVITY_CELL_STEP}
									width="10"
									height="10"
									rx="2"
									fill="currentColor"
									fill-opacity={activityOpacity(count)}
								/>
							))}
						</svg>
						<p class="mt-2 text-xs text-coral">
							{repo.commitCount} commits in the last {shippingWindowDays} days
						</p>
						<p class="mt-1 font-mono text-xs text-gray-400">
							$ git log -1: {repo.latestCommitMessage}
						</p>
					</a>
				))}
			</div>
		</>
	)}

	<p class="mb-3 font-mono text-xs text-gray-400">recently watched</p>
	<div class="grid gap-4 grid-cols-2 sm:grid-cols-4">
		{films.map((film) => (
			<div>
				<a
					href={film.url}
					target="_blank"
					rel="noopener noreferrer"
					class="plausible-event-name=Now+Feed+Click plausible-event-source=letterboxd group block no-underline"
				>
					<img
						src={film.poster}
						alt={`Poster for ${film.title} (${film.year})`}
						width="200"
						height="300"
						loading="lazy"
						class="mb-2 w-full rounded border border-surface-3"
					/>
					<p class="text-sm font-semibold text-white group-hover:text-coral">
						{film.title} <span class="text-gray-400">{film.year}</span>
					</p>
				</a>
				{film.rating !== null && (
					<p class="text-xs text-coral" aria-label={`Rated ${film.rating} out of 5`}>
						{ratingStars(film.rating)}
					</p>
				)}
				{film.reviewExcerpt && <p class="mt-1 text-xs text-gray-400">{film.reviewExcerpt}</p>}
			</div>
		))}
	</div>

	<p class="mb-3 mt-8 font-mono text-xs text-gray-400">recently listened</p>
	<div class="grid gap-4 sm:grid-cols-2">
		{podcastEpisodes.map((episode) => {
			const content = (
				<>
					<img
						src={episode.cover}
						alt={`Cover art for ${episode.podcastTitle}`}
						width="48"
						height="48"
						loading="lazy"
						class="h-12 w-12 shrink-0 rounded border border-surface-3 object-cover"
					/>
					<div>
						<p class="text-sm font-semibold text-white">{episode.episodeTitle}</p>
						<p class="text-xs text-gray-400">{episode.podcastTitle}</p>
					</div>
				</>
			);
			return (
				<div>
					{episode.url ? (
						<a
							href={episode.url}
							target="_blank"
							rel="noopener noreferrer"
							class="plausible-event-name=Now+Feed+Click plausible-event-source=podcast flex items-center gap-3 no-underline"
						>
							{content}
						</a>
					) : (
						<div class="flex items-center gap-3">{content}</div>
					)}
				</div>
			);
		})}
	</div>

	<p class="mt-4 font-mono text-xs text-gray-400">
		as of {formattedUpdatedAt}. Commits via{' '}
		<a href="https://github.com/JoeKarlsson" target="_blank" rel="noopener noreferrer">
			GitHub
		</a>
		, films via{' '}
		<a href="https://letterboxd.com/joekarlsson/" target="_blank" rel="noopener noreferrer">
			Letterboxd
		</a>
		, podcasts from my self-hosted Audiobookshelf.
	</p>
</div>
