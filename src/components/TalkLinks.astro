---
// The link row under a /talks/ card, drawn like ProjectCard's on /work/: my talk page first,
// then slides, the episode, the event and other recordings. Internal pages get the arrow,
// other sites the open-in-new icon.
interface Props {
	links: { label: string; href: string }[];
}

const { links } = Astro.props;
const internal = (href: string) => href.startsWith('/');
---

{links.length > 0 && (
	<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 max-md:col-start-2 max-md:mt-1 max-md:[&>a]:min-h-11">
		{links.map(({ label, href }) => (
			<a
				href={href}
				target={internal(href) ? undefined : '_blank'}
				rel={internal(href) ? undefined : 'noopener noreferrer'}
				class="flex items-center gap-1 text-sm text-pink no-underline hover:text-paper"
			>
				<svg
					aria-hidden="true"
					class="h-3.5 w-3.5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d={
							internal(href)
								? 'M5 12h14M13 5l7 7-7 7'
								: 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'
						}
					/>
				</svg>
				{label}
			</a>
		))}
	</div>
)}
