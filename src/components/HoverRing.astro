---
// The crayon ring every hoverable card and index row draws around itself on
// hover or keyboard focus. Put it inside a positioned element next to what it
// circles; the nearest ancestor with the `ring-host` class is what triggers it
// (.ring-host in src/styles/motion.css). `index` picks which ring, so neighbors
// don't get the same one. Always chalk: pink would vanish on the pink pictures.
// It circles a card's picture; `featured` circles a big hero card more tightly,
// and `class` places it anywhere else.
import { CHALK, RINGS } from '../data/scribbles';
import Scribble from './Scribble.astro';

interface Props {
	index: number;
	featured?: boolean;
	class?: string;
}

const {
	index,
	featured = false,
	class: className = featured
		? '-top-[6%] -left-[5%] z-10 h-[112%] w-[110%]'
		: '-top-[11%] -left-[6%] z-10 h-[122%] w-[112%]',
} = Astro.props;
---

<Scribble
	path={RINGS[index % RINGS.length]}
	color={CHALK}
	viewBox="0 0 520 150"
	strokeWidth={7}
	ring
	class={className}
/>
