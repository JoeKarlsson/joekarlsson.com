---
// The top of a section page, built like the homepage hero: a picture or clip on the
// left (the `media` slot, a grid cell the page builds itself), and on the right the
// pink featured band over a dark panel with a line or two (the default slot) and the
// page's name filling the panel's width. Used by Blog, Work, Talks, Newsletter, About,
// Resume, Uses and Contact.
import FeaturedBand from './FeaturedBand.astro';
import Scribble from './Scribble.astro';
import { CHALK, HERO_COIL, MARKS } from '../data/scribbles';

interface Props {
	title: string;
	// The title's width in ems at font-size 1, so it fills the panel: about 0.47 per
	// letter in Anton caps ("BLOG" is 1.86)
	wordRatio: number;
	// The one thing this page pushes, in the pink band (FeaturedBand)
	featured: { label: string; title: string; href: string; meta?: string };
	// The media is a picture or clip of Joe rather than content (a featured post or
	// project), so phones skip it and open on the title panel
	decorativeMedia?: boolean;
}

const { title, wordRatio, featured, decorativeMedia = false } = Astro.props;
---

<header class="relative mb-8 grid gap-4 md:mb-14 md:grid-cols-2">
	<div class:list={['contents', decorativeMedia && 'poster-media-decorative max-md:hidden']}>
		<slot name="media" />
	</div>
	<!-- First on phones, so the page's name shows before its picture -->
	<div class="relative grid min-w-0 grid-rows-[auto_1fr] gap-4 max-md:order-first">
		<Scribble
			{...MARKS.tally}
			color={CHALK}
			duration="9s"
			delay="0.6s"
			class="-top-[6%] -right-[3%] z-10 hidden h-[12%] w-[18%] md:block"
		/>
		<!-- Phones show the page's name first, then the band -->
		<FeaturedBand {...featured} class="max-md:order-last" />
		<div class="relative flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-5 md:p-7">
			<Scribble
				{...MARKS.hatch}
				color="#ff4fd8"
				duration="8s"
				delay="3.2s"
				class="-right-[4%] -bottom-[9%] z-10 h-[16%] w-[22%]"
			/>
			<!-- z-10: the huge title's text box reaches above its line (leading 0.84) and
			would otherwise sit over this slot's buttons and take their clicks -->
			<div class="relative z-10">
				<slot />
			</div>
			<!-- The title fills the panel's width, but no title gets bigger than ABOUT's (ratio
			2.4): short words like USES and BLOG would otherwise tower over every other page.
			Phones put it first, so every page opens on its name, as the homepage does -->
			<div class="@container max-md:order-first">
				<h1
					class="relative font-display text-[calc(100cqw/max(var(--word-ratio),2.4))] leading-[0.84] font-normal whitespace-nowrap text-paper uppercase"
					style={`--word-ratio:${wordRatio}`}
				>
					{title}
					<Scribble
						path={HERO_COIL}
						color="#ff4fd8"
						duration="9s"
						delay="0.3s"
						class="-bottom-[10%] -left-[4%] h-[60%] w-[104%]"
					/>
				</h1>
			</div>
		</div>
	</div>
</header>
