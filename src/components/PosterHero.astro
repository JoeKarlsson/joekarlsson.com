---
// The top of a section page, built like the homepage hero: a picture or clip on the
// left (the `media` slot, a grid cell the page builds itself), and on the right a pink
// ticker over a dark panel with a line or two (the default slot) and the page's name
// filling the panel's width. Used by Blog, Projects, Uses, Resume, Talks and Contact.
import Scribble from './Scribble.astro';
import { CHALK, HERO_COIL, MARKS } from '../data/scribbles';

interface Props {
	title: string;
	// The title's width in ems at font-size 1, so it fills the panel: about 0.47 per
	// letter in Anton caps ("BLOG" is 1.86)
	wordRatio: number;
	// Scrolls in the pink ticker, separated by dots
	tickerItems: string[];
}

const { title, wordRatio, tickerItems } = Astro.props;
---

<header class="relative mb-14 grid gap-4 md:grid-cols-2">
	<slot name="media" />
	<div class="relative grid min-w-0 grid-rows-[auto_1fr] gap-4">
		<Scribble
			{...MARKS.tally}
			color={CHALK}
			duration="9s"
			delay="0.6s"
			class="-top-[6%] -right-[3%] z-10 hidden h-[12%] w-[18%] md:block"
		/>
		<div class="ticker rounded-xl bg-pink pt-3.5 pb-2 text-ink" aria-hidden="true">
			<div class="ticker-track font-display text-[clamp(52px,6.2vw,96px)] leading-none uppercase">
				{[...tickerItems, ...tickerItems].map((item) => (
					<>
						<span>{item}</span>
						<span class="-translate-y-[0.15em] text-[0.38em]">●</span>
					</>
				))}
			</div>
		</div>
		<div class="relative flex flex-col justify-between gap-6 rounded-xl bg-surface-1 p-7">
			<Scribble
				{...MARKS.hatch}
				color="#ff4fd8"
				duration="8s"
				delay="3.2s"
				class="-right-[4%] -bottom-[9%] z-10 h-[16%] w-[22%]"
			/>
			<div>
				<slot />
			</div>
			<div class="@container">
				<h1
					class="relative font-display text-[calc(100cqw/var(--word-ratio))] leading-[0.84] font-normal whitespace-nowrap text-paper uppercase"
					style={`--word-ratio:${wordRatio}`}
				>
					{title}
					<Scribble
						path={HERO_COIL}
						color="#ff4fd8"
						duration="9s"
						delay="0.3s"
						class="-bottom-[10%] -left-[4%] h-[60%] w-[104%]"
					/>
				</h1>
			</div>
		</div>
	</div>
</header>
