---
import NewsletterSignup from './NewsletterSignup.astro';
// /newsletter/ has its own form at the top, so the footer points back to it instead of
// showing a second one
const onNewsletterPage = Astro.url.pathname.replace(/\/$/, '') === '/newsletter';
---

<div class="relative">
	<p class="mt-3.5 max-w-[620px] text-lg">
		Works on My Machine is my newsletter: tech writing, AI, homelab builds and open source.
	</p>
	{onNewsletterPage ? (
		<p class="mt-5 text-lg">
			<a
				href="#subscribe"
				class="inline-block py-2 font-semibold text-ink underline hover:text-ink hover:decoration-2"
			>
				Subscribe at the top of the page &uarr;
			</a>
		</p>
	) : (
		<>
			<NewsletterSignup location="footer" />
			<p class="mt-2.5 text-sm">
				Free, no spam, unsubscribe anytime. Each email records opens and clicks (
				<a href="/privacy-policy/" class="font-semibold text-ink underline hover:decoration-2">
					privacy
				</a>
				).{' '}
				<a
					href="/newsletter/"
					class="plausible-event-name=Newsletter+CTA+Click font-semibold text-ink underline hover:text-ink hover:decoration-2"
				>
					Read past issues
				</a>
			</p>
		</>
	)}
</div>
