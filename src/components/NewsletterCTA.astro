---
import NewsletterSignup from './NewsletterSignup.astro';
---

<div class="relative">
	<p class="mt-3.5 max-w-[620px] text-lg">
		Works on My Machine is my newsletter: tech writing, AI, homelab builds and open source.
	</p>
	<NewsletterSignup location="footer" />
	<p class="mt-2.5 text-sm">
		Free, no spam, unsubscribe anytime.{' '}
		<a
			href="/newsletter/"
			class="plausible-event-name=Newsletter+CTA+Click font-semibold text-ink underline hover:text-ink hover:decoration-2"
		>
			Read past issues
		</a>
	</p>
</div>
