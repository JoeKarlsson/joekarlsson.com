---
import NewsletterSignup from './NewsletterSignup.astro';
---

<div class="text-center">
	<h2 class="mb-2 text-2xl font-semibold text-white">Subscribe to my newsletter</h2>
	<p class="mx-auto mb-4 max-w-xl text-sm text-gray-400">
		Works on My Machine is my newsletter: thoughts and reactions on tech writing, AI, homelab builds
		and open source, plus whatever I'm working on. It goes out when I have something to say.
	</p>
	<NewsletterSignup location="footer" />
	<p class="mt-3 text-xs text-gray-400">
		Free, no spam, unsubscribe anytime.{' '}
		<a
			href="/newsletter/"
			class="plausible-event-name=Newsletter+CTA+Click underline hover:text-coral"
		>
			Read past issues
		</a>
		.
	</p>
</div>
