---
import NewsletterSignup from './NewsletterSignup.astro';
---

<div class="text-center">
	<h2 class="mb-2 text-3xl font-extrabold text-surface-0">Subscribe to my newsletter</h2>
	<p class="mx-auto mb-5 max-w-xl text-surface-0">
		Works on My Machine is my newsletter: thoughts and reactions on tech writing, AI, homelab builds
		and open source, plus whatever I'm working on. It goes out when I have something to say.
	</p>
	<NewsletterSignup location="footer" />
	<p class="mt-3 text-sm text-surface-0">
		Free, no spam, unsubscribe anytime.{' '}
		<a
			href="/newsletter/"
			class="plausible-event-name=Newsletter+CTA+Click font-semibold text-surface-0 underline hover:text-surface-0 hover:decoration-2"
		>
			Read past issues
		</a>
		.
	</p>
</div>
