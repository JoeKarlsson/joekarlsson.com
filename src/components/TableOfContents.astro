---
interface Props {
	headings: { slug: string; text: string; depth?: number }[];
}
const { headings } = Astro.props;
---

<div class="hidden xl:block">
	<nav class="sticky top-20 text-sm" id="toc-nav" aria-label="Table of contents">
		<p class="mb-3 font-display text-xl text-paper uppercase">On this page</p>
		<ul class="space-y-1.5 border-l border-surface-3">
			{headings.map((h) => (
				<li class="-ml-px border-l-2 border-transparent pl-3 transition-colors duration-150">
					<a
						href={`#${h.slug}`}
						data-toc-slug={h.slug}
						class={[
							'toc-link block leading-snug no-underline transition-colors duration-150',
							h.depth === 3
								? 'pl-3 text-xs text-muted hover:text-paper'
								: 'text-paper hover:text-paper',
						].join(' ')}
					>
						{h.text}
					</a>
				</li>
			))}
		</ul>
	</nav>
</div>

<script>
	(() => {
		const links = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>;
		if (!links.length) return;

		// Track TOC clicks
		links.forEach((link) => {
			link.addEventListener('click', () => {
				if (typeof window.plausible === 'function') {
					window.plausible('TOC Click', {
						props: { section: link.textContent?.trim() || 'unknown' },
					});
				}
			});
		});

		const headingEls = Array.from(links).map((l) => {
			const slug = l.dataset.tocSlug;
			return slug ? document.getElementById(slug) : null;
		});

		const inactiveColors: string[] = Array.from(links).map((l) =>
			l.classList.contains('text-muted') ? 'text-muted' : 'text-paper',
		);

		let currentActive = -1;

		function setActive(index: number) {
			if (index === currentActive) return;

			if (currentActive >= 0) {
				links[currentActive].classList.remove('text-pink');
				links[currentActive].classList.add(inactiveColors[currentActive]);
				links[currentActive].parentElement?.classList.remove('border-pink');
				links[currentActive].parentElement?.classList.add('border-transparent');
			}

			if (index >= 0 && index < links.length) {
				links[index].classList.remove(inactiveColors[index]);
				links[index].classList.add('text-pink');
				links[index].parentElement?.classList.remove('border-transparent');
				links[index].parentElement?.classList.add('border-pink');
			}

			currentActive = index;
		}

		function getActiveIndex(): number {
			const offset = 120;
			let active = 0;

			for (let i = 0; i < headingEls.length; i++) {
				const el = headingEls[i];
				if (!el) continue;
				if (el.getBoundingClientRect().top <= offset) {
					active = i;
				}
			}
			return active;
		}

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						setActive(getActiveIndex());
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true },
		);

		setActive(getActiveIndex());
	})();
</script>
