---
// One row of a huge poster-type index list (projects, topics, contact): the name
// on the left, small metadata on the right, and a crayon ring drawn around the
// name on hover or focus. `external` opens the link in a new tab; `class` adds
// classes to the link (e.g. Plausible event names).
import { CHALK, RINGS } from '../data/scribbles';
import Scribble from './Scribble.astro';

interface Props {
	href: string;
	label: string;
	meta: string;
	// Which ring and color, so neighboring rows don't get the same mark
	index: number;
	external?: boolean;
	// Smaller type, for a list that sits inside a page section (About's Elsewhere)
	compact?: boolean;
	class?: string;
}

const {
	href,
	label,
	meta,
	index,
	external = false,
	compact = false,
	class: className,
} = Astro.props;
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'index-row ring-host relative flex flex-wrap items-baseline justify-between gap-x-6 border-t border-surface-4 pt-1.5 pb-0.5 text-paper no-underline hover:text-paper',
		className,
	]}
>
	<span
		class:list={[
			'relative inline-block font-display leading-[0.98] uppercase',
			compact ? 'text-[clamp(34px,4vw,56px)]' : 'text-[clamp(46px,7.4vw,108px)]',
		]}
	>
		<slot name="icon" />
		{label}
		<Scribble
			path={RINGS[index % RINGS.length]}
			color={index % 2 ? CHALK : '#ff4fd8'}
			viewBox="0 0 520 150"
			strokeWidth={7}
			ring
			class="-top-[22%] -left-[35px] h-[150%] w-[calc(100%+70px)]"
		/>
	</span>
	<span class="text-sm whitespace-nowrap text-muted">{meta}</span>
</a>
