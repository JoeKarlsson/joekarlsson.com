---
// Numbered steps on a project page: How it works, and the steps in How it's made
import { inlineMarkdown } from '../utils/inline-markdown';
import { ITEM_TITLE } from '../utils/ui';

interface Props {
	steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-y-7">
	{steps.map((step, i) => (
		<li class="grid grid-cols-[3.2rem_1fr] gap-x-4 border-t border-surface-4 pt-4">
			<span
				aria-hidden="true"
				class="font-display text-[clamp(40px,4vw,56px)] leading-[0.9] text-pink"
			>
				{i + 1}
			</span>
			<div>
				<h3 class={`mb-1 ${ITEM_TITLE}`}>{step.title}</h3>
				<p class="text-paper" set:html={inlineMarkdown(step.text)} />
			</div>
		</li>
	))}
</ol>
