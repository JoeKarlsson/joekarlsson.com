---
// One post in a list (blog index, category pages, newsletter): the pink
// thumbnail (src/scripts/halftone.ts) on the left, then date, reading time and categories, the title, and
// the description, and which employer a professional post was written for. Same
// row as the homepage's Recent posts.
import { DEFAULT_HERO_IMAGE } from '../consts';
import WrittenFor from './WrittenFor.astro';

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
	heroImage?: string;
	categories?: string[];
	writtenFor?: string;
	readingTime?: number;
	href?: string;
	// One of the ten most-read posts: a flame after the title
	popular?: boolean;
}

const {
	title,
	description,
	date,
	slug,
	heroImage,
	categories,
	writtenFor,
	readingTime,
	href,
	popular = false,
} = Astro.props;
const url = href ?? `/blog/${slug}/`;
const image = heroImage || DEFAULT_HERO_IMAGE;
const formattedDate = date.toLocaleDateString('en-us', {
	timeZone: 'UTC',
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<li class="group grid items-center gap-x-7 gap-y-3 border-t border-surface-4 py-[18px] sm:grid-cols-[clamp(140px,22vw,280px)_1fr]">
	<!-- The thumbnail repeats the title link, so it's skipped by keyboard and screen readers -->
	<a href={url} tabindex="-1" aria-hidden="true" class="relative block">
		<img
			src={image}
			alt=""
			aria-hidden="true"
			data-halftone="flat"
			width="560"
			height="315"
			loading="lazy"
			decoding="async"
			class="block aspect-video w-full rounded-lg object-cover"
		/>
	</a>
	<div>
		<span class="mb-1.5 block text-sm text-muted">
			<time datetime={date.toISOString()}>{formattedDate}</time>
			{readingTime && <> · {readingTime} min read</>}
			{categories && categories.length > 0 && <> · {categories.join(' · ')}</>}
			{popular && (
				<span title="One of my 10 most-read posts">
					{' '}
					<span aria-hidden="true">🔥</span>
					<span class="sr-only">One of my 10 most-read posts</span>
				</span>
			)}
			{writtenFor && (
				<>
					{' · '}
					<WrittenFor employer={writtenFor} />
				</>
			)}
		</span>
		<a
			href={url}
			class="text-[clamp(20px,2.2vw,28px)] leading-tight font-semibold text-paper no-underline group-hover:text-pink"
		>
			{title}
		</a>
		{description && <p class="mt-2 line-clamp-2 max-w-[60ch] text-muted">{description}</p>}
	</div>
</li>
