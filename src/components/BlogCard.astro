---
// One post in a list (blog index, category pages, newsletter): the pink
// thumbnail (src/scripts/halftone.ts) on the left, then date, reading time and categories, the title, and
// the description, and which employer a professional post was written for. Same
// row as the homepage's Recent posts, compact on phones too: a small thumbnail beside
// the text instead of a full-width picture above it, so a screen holds about twice
// as many posts.
import { DEFAULT_HERO_IMAGE } from '../consts';
import { formatDate } from '../utils/ui';
import { CHALK, MARKS } from '../data/scribbles';
import HoverBox from './HoverBox.astro';
import Scribble from './Scribble.astro';
import WrittenFor from './WrittenFor.astro';

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
	heroImage?: string;
	categories?: string[];
	writtenFor?: string;
	readingTime?: number;
	href?: string;
	// One of the ten most-read posts: a flame after the title
	popular?: boolean;
	// Draws a crayon mark on the thumbnail's corner; the number picks which, so
	// neighboring marked rows differ
	markIndex?: number;
	// Position in its list: picks the hover box, so neighbours draw different ones
	index?: number;
}

// Marks for thumbnails, cycled by markIndex, alternating chalk and pink
const THUMBNAIL_MARKS = [
	MARKS.tally,
	MARKS.check,
	MARKS.asterisk,
	MARKS.cross,
	MARKS.rays,
	MARKS.burst,
];

const {
	title,
	description,
	date,
	slug,
	heroImage,
	categories,
	writtenFor,
	readingTime,
	href,
	popular = false,
	markIndex,
	index,
} = Astro.props;
const mark =
	markIndex === undefined ? undefined : THUMBNAIL_MARKS[markIndex % THUMBNAIL_MARKS.length];
const url = href ?? `/blog/${slug}/`;
const image = heroImage || DEFAULT_HERO_IMAGE;
const formattedDate = formatDate(date);
---

<li class="ring-host group grid grid-cols-[112px_1fr] items-start gap-x-4 border-t border-surface-4 py-[18px] sm:grid-cols-[clamp(140px,22vw,280px)_1fr] sm:items-center sm:gap-x-7">
	<!-- The thumbnail repeats the title link, so it's skipped by keyboard and screen readers -->
	<a href={url} tabindex="-1" aria-hidden="true" class="relative block">
		<img
			src={image}
			alt=""
			aria-hidden="true"
			data-halftone="flat"
			width="560"
			height="315"
			loading="lazy"
			decoding="async"
			class="block aspect-video w-full rounded-lg object-cover"
		/>
		{mark && markIndex !== undefined && (
			<Scribble
				{...mark}
				color={markIndex % 2 ? '#ff4fd8' : CHALK}
				duration="9s"
				delay={`${(markIndex % 4) * 0.7}s`}
				class="-top-[20%] -right-[8%] z-10 size-[40%]"
			/>
		)}
		<HoverBox index={index} />
	</a>
	<div>
		<span class="mb-1.5 block text-sm text-muted">
			<time datetime={date.toISOString()}>{formattedDate}</time>
			{readingTime && <> · {readingTime} min read</>}
			{categories && categories.length > 0 && <> · {categories.join(' · ')}</>}
			{popular && (
				<span title="One of my 10 most-read posts">
					{' '}
					<span aria-hidden="true">🔥</span>
					<span class="sr-only">One of my 10 most-read posts</span>
				</span>
			)}
			{writtenFor && (
				<>
					{' · '}
					<WrittenFor employer={writtenFor} />
				</>
			)}
		</span>
		<a
			href={url}
			class="text-lg leading-tight font-semibold text-paper no-underline group-hover:text-pink sm:text-[clamp(20px,2.2vw,28px)]"
		>
			{title}
		</a>
		{description && <p class="mt-2 line-clamp-2 max-w-[60ch] text-paper">{description}</p>}
	</div>
</li>
