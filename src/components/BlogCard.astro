---
import { DEFAULT_HERO_IMAGE } from '../consts';

interface Props {
	title: string;
	description: string;
	date: Date;
	slug: string;
	heroImage?: string;
	heroAlt?: string;
	categories?: string[];
	readingTime?: number;
	href?: string;
}

const { title, description, date, slug, heroImage, heroAlt, categories, readingTime, href } =
	Astro.props;
const image = heroImage || DEFAULT_HERO_IMAGE;
const formattedDate = date.toLocaleDateString('en-us', {
	timeZone: 'UTC',
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<a href={href ?? `/blog/${slug}/`} class="group block no-underline">
	<img
		src={image}
		alt={heroAlt || `Hero image for ${title}`}
		class="mb-3 h-40 w-full rounded-lg object-cover"
		width="600"
		height="160"
		loading="lazy"
	/>
	<h3 class="mb-1 text-lg font-semibold text-white transition-colors group-hover:text-coral">
		{title}
	</h3>
	<p class="mb-2 text-sm text-gray-400">
		{formattedDate}
		{readingTime && <> · {readingTime} min read</>}
		{categories && categories.length > 0 && <> · {categories.join(' · ')}</>}
	</p>
	{description && <p class="line-clamp-2 text-sm text-gray-400">{description}</p>}
</a>
