---
// One film on a poster wall: poster, stars, title and year, linking to its review.
import type { CollectionEntry } from 'astro:content';
import { cardHalftone } from '../utils/halftone';
import { stars } from '../../scripts/update-reviews.mjs';

interface Props {
	review: CollectionEntry<'reviews'>;
}

const { title, year, rating, poster, slug } = Astro.props.review.data;
---

<a href={`/reviews/${slug}/`} class="group block no-underline">
	<span
		class="block aspect-[2/3] overflow-hidden rounded-md bg-surface-1 transition-[translate] duration-(--duration-enter) ease-(--ease-enter) group-hover:-translate-y-1 motion-reduce:transition-none"
		data-morph={`/reviews/${slug}/`}
	>
		{/* No poster from Letterboxd: the title, set like one */}
		{!poster && (
			<span
				aria-hidden="true"
				class="flex size-full items-end p-3 font-display text-xl leading-none text-paper uppercase hyphens-auto [overflow-wrap:anywhere] sm:text-2xl"
			>
				<span class="line-clamp-5">{title}</span>
			</span>
		)}
		{poster && (
			<img
				src={poster}
				alt=""
				aria-hidden="true"
				data-halftone={cardHalftone(poster)}
				width="400"
				height="600"
				loading="lazy"
				class="size-full object-cover"
			/>
		)}
	</span>
	{/* The year rides on the stars line, so the title clamp never hides it */}
	<span class="mt-2 flex justify-between gap-2 text-sm">
		{rating ? (
			<span class="text-pink">
				<span aria-hidden="true">{stars(rating)}</span>
				<span class="sr-only">Rated {rating} out of 5</span>
			</span>
		) : (
			<span />
		)}
		<span class="text-muted">{year}</span>
	</span>
	{/* Two lines at most, so one long title doesn't push its row out of line */}
	<span class="line-clamp-2 leading-snug text-paper group-hover:text-pink">{title}</span>
</a>
