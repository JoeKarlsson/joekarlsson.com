---
import type { Project } from '../data/projects';
import { cardClip } from '../utils/halftone';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const primaryUrl =
	(project.page && `/work/${project.page.slug}/`) ||
	project.sourceUrl ||
	project.blogUrl ||
	project.demoUrl ||
	'#';
const isExternal = primaryUrl.startsWith('http');
const metaLine = [
	project.date.slice(0, 4),
	project.stars && `${project.stars} stars`,
	project.tech.slice(0, 3).join(', '),
]
	.filter(Boolean)
	.join(' · ');
---

<article>
	<a
		href={primaryUrl}
		target={isExternal ? '_blank' : undefined}
		rel={isExternal ? 'noopener noreferrer' : undefined}
		class="plausible-event-name=Project+Click group block no-underline"
	>
		<span class="relative block">
			{project.video ? (
				<video
					src={cardClip(project.video)}
					poster={project.image}
					loop
					muted
					playsinline
					preload="none"
					role="img"
					aria-label={project.imageAlt}
					data-autoplay-in-view
					data-halftone="flat"
					class="block aspect-video w-full rounded-lg object-cover"
				/>
			) : (
				<img
					src={project.image}
					alt={project.imageAlt}
					data-halftone="flat"
					width="560"
					height="315"
					class="block aspect-video w-full rounded-lg object-cover"
					loading="lazy"
					decoding="async"
				/>
			)}
		</span>
		<h3 class="mt-4 font-display text-[clamp(28px,2.4vw,36px)] leading-none font-normal text-paper uppercase group-hover:text-pink">
			{project.title}
		</h3>
		<p class="mt-2 line-clamp-2 text-paper">{project.description}</p>
		<p class="mt-1 text-sm text-muted">{metaLine}</p>
	</a>
	{(project.sourceUrl || project.demoUrl || project.blogUrl) && (
		<div class="mt-3 flex items-center gap-4">
			{project.sourceUrl && (
				<a
					href={project.sourceUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-1 text-sm text-pink no-underline hover:text-paper"
				>
					<svg aria-hidden="true" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
					</svg>
					Source
				</a>
			)}
			{project.demoUrl && (
				<a
					href={project.demoUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-1 text-sm text-pink no-underline hover:text-paper"
				>
					<svg
						aria-hidden="true"
						class="h-3.5 w-3.5"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
						/>
					</svg>
					Demo
				</a>
			)}
			{project.blogUrl && (
				<a
					href={project.blogUrl}
					class="flex items-center gap-1 text-sm text-pink no-underline hover:text-paper"
				>
					<svg
						aria-hidden="true"
						class="h-3.5 w-3.5"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
						/>
					</svg>
					Blog Post
				</a>
			)}
		</div>
	)}
</article>
