---
// A section's masthead (the homepage, Works, Talks): the section's name huge in pink Anton, a plain
// link to the section's page on the right, and a crayon line the full width under both
// (SectionRule). Marks passed as children sit in the header's box (absolute, from Scribble).
interface Props {
	title: string;
	// A link to the section's own page, when it has one
	href?: string;
	linkLabel?: string;
	id?: string;
	// Talks' eras fold behind a +/- on phones (src/scripts/phone-collapse.ts)
	collapse?: boolean;
}

import SectionRule from './SectionRule.astro';

const { title, href, linkLabel, id, collapse } = Astro.props;
---

<header class="relative flex items-end justify-between gap-6 pb-2">
	<h2
		id={id}
		data-collapse-heading={collapse || undefined}
		class:list={[
			'relative font-display text-[clamp(3.25rem,9vw,7.5rem)] leading-[0.8] font-normal text-pink uppercase',
			collapse && 'max-md:w-full',
		]}
	>
		{title}
		<slot />
	</h2>
	{href && (
		<a
			href={href}
			class="shrink-0 border-b-2 border-pink py-3 text-base font-semibold text-paper no-underline hover:text-pink max-md:text-sm"
		>
			<span class="whitespace-nowrap">
				{linkLabel} <span aria-hidden="true">→</span>
			</span>
		</a>
	)}
</header>
{/* A folded era's label sits close under its own line */}
<SectionRule class:list={['mb-7', collapse && 'max-md:mb-3']} />
